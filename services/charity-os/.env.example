DATABASE_URL=postgresql://localhost/charitology_os
BETTER_AUTH_URL=http://localhost:4344
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
OS_ENCRYPTION_KEY=replace-with-an-independent-random-key
OS_MAIL_RELAY_URL=https://mail.charitology.org/api/system/os-mail
OS_MAIL_RELAY_SECRET=replace-with-dedicated-relay-secret
CRON_SECRET=replace-with-independent-cron-secret

# Separate operational participation mail: disabled until controlled acceptance.
OS_PARTICIPATION_DELIVERY_ENABLED=false
# Enable shift handoffs only after installing the restricted verifier and choice schema.
OS_VOLUNTEER_SUBSTITUTIONS_ENABLED=0
OS_PARTICIPATION_TEST_ONLY=true
OS_PARTICIPATION_TEST_RECIPIENT=

# Private volunteer preferences require a separately installed storage schema.
OS_VOLUNTEER_PROFILE_ENABLED=0
OS_VOLUNTEER_PROFILE_STORAGE_SCHEMA=
