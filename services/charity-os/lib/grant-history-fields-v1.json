{
  "schemaVersion": 1,
  "currencies": {
    "USD": 2,
    "EUR": 2,
    "GBP": 2,
    "CAD": 2,
    "AUD": 2,
    "NZD": 2,
    "CHF": 2,
    "JPY": 0,
    "KWD": 3
  },
  "roles": [
    "owner",
    "admin",
    "program_lead",
    "grants_lead",
    "finance_reviewer",
    "contributor",
    "board_reader",
    "external_reviewer"
  ],
  "modules": {
    "programs": {
      "title": "Mission and program design",
      "fields": [
        {
          "key": "title",
          "type": "text",
          "nullable": false,
          "required": true,
          "maxLength": 180
        },
        {
          "key": "kind",
          "type": "select",
          "nullable": false,
          "required": true,
          "options": [
            "program",
            "system-map",
            "assumption"
          ]
        },
        {
          "key": "purpose",
          "type": "textarea",
          "nullable": true,
          "maxLength": 4000
        },
        {
          "key": "community",
          "type": "textarea",
          "nullable": true,
          "maxLength": 4000
        },
        {
          "key": "mechanism",
          "type": "textarea",
          "nullable": true,
          "maxLength": 4000
        },
        {
          "key": "depth",
          "type": "integer",
          "nullable": true,
          "min": 0,
          "max": 4
        },
        {
          "key": "evidence",
          "type": "select",
          "nullable": true,
          "options": [
            "hypothesis",
            "documented",
            "established",
            "debated"
          ]
        },
        {
          "key": "assumptions",
          "type": "textarea",
          "nullable": true,
          "maxLength": 4000
        },
        {
          "key": "sourceUrl",
          "type": "text",
          "nullable": true,
          "maxLength": 1200,
          "format": "https"
        },
        {
          "key": "reviewDate",
          "type": "date",
          "nullable": true
        }
      ]
    },
    "grant-seeking": {
      "title": "Grant seeking",
      "fields": [
        {
          "key": "title",
          "type": "text",
          "nullable": false,
          "required": true,
          "maxLength": 180
        },
        {
          "key": "kind",
          "type": "select",
          "nullable": false,
          "required": true,
          "options": [
            "opportunity",
            "application"
          ]
        },
        {
          "key": "programId",
          "type": "reference",
          "nullable": true,
          "target": "programs"
        },
        {
          "key": "funderId",
          "type": "reference",
          "nullable": true,
          "target": "contacts"
        },
        {
          "key": "eligibility",
          "type": "select",
          "nullable": true,
          "options": [
            "unknown",
            "eligible",
            "ineligible"
          ]
        },
        {
          "key": "requested",
          "type": "money",
          "nullable": true
        },
        {
          "key": "applicationVersion",
          "type": "integer",
          "nullable": true,
          "min": 1,
          "max": 1000000000
        },
        {
          "key": "deadlineAt",
          "type": "datetime",
          "nullable": true
        },
        {
          "key": "timeZone",
          "type": "timezone",
          "nullable": true
        },
        {
          "key": "applicationSummary",
          "type": "textarea",
          "nullable": true,
          "maxLength": 4000
        },
        {
          "key": "documentIds",
          "type": "references",
          "nullable": true,
          "maxItems": 100,
          "target": "documents"
        },
        {
          "key": "submissionReference",
          "type": "text",
          "nullable": true,
          "maxLength": 240
        },
        {
          "key": "decisionDate",
          "type": "date",
          "nullable": true
        }
      ]
    },
    "grant-delivery": {
      "title": "Grant delivery",
      "fields": [
        {
          "key": "title",
          "type": "text",
          "nullable": false,
          "required": true,
          "maxLength": 180
        },
        {
          "key": "kind",
          "type": "select",
          "nullable": false,
          "required": true,
          "options": [
            "agreement",
            "restriction",
            "report",
            "amendment"
          ]
        },
        {
          "key": "programId",
