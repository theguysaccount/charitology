        {
          "key": "restrictionCode",
          "type": "text",
          "nullable": true,
          "maxLength": 240,
          "format": "opaque"
        },
        {
          "key": "allowedPurpose",
          "type": "textarea",
          "nullable": true,
          "maxLength": 4000
        },
        {
          "key": "varianceReason",
          "type": "textarea",
          "nullable": true,
          "maxLength": 4000
        },
        {
          "key": "startDate",
          "type": "date",
          "nullable": true
        },
        {
          "key": "endDate",
          "type": "date",
          "nullable": true
        },
        {
          "key": "reportDue",
          "type": "date",
          "nullable": true
        },
        {
          "key": "documentIds",
          "type": "references",
          "nullable": true,
          "maxItems": 100,
          "target": "documents"
        }
      ]
    },
    "finance": {
