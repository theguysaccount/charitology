    "outcomes": {
      "title": "Evidence and outcomes",
      "fields": [
        {
          "key": "title",
          "type": "text",
          "nullable": false,
          "required": true,
          "maxLength": 180
        },
        {
          "key": "kind",
          "type": "select",
          "nullable": false,
