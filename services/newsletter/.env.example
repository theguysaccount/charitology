# Private production values belong in Vercel, never in the public Astro build.
DATABASE_URL=
NEWSLETTER_ADMIN_TOKEN=
NEWSLETTER_RATE_SECRET=
CRON_SECRET=
NEWSLETTER_ORIGIN=https://mail.charitology.org
NEWSLETTER_ALLOWED_ORIGINS=https://charitology.org
NEWSLETTER_SEND_ENABLED=false
# Begin in controlled test mode. A general issue requires a separate deliberate change.
NEWSLETTER_TEST_ONLY=true
NEWSLETTER_TEST_RECIPIENT=
RESEND_CONNECTOR=resend/charitology-mail
RESEND_SUBJECT_ID=
RESEND_DOMAIN_ID=
RESEND_SEGMENT_ID=
RESEND_TOPIC_ID=
RESEND_WEBHOOK_SECRET=
# Separate server-to-server secret, at least 32 random characters. Never expose in browser code.
OS_MAIL_RELAY_SECRET=
OS_ORIGIN=https://os.charitology.org
