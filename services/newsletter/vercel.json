{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": { "api/index.mjs": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/cron/maintenance", "schedule": "0 6 * * *" }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/confirm", "destination": "/api/index" },
    { "source": "/unsubscribe", "destination": "/api/index" },
    { "source": "/privacy", "destination": "/api/index" },
    { "source": "/", "destination": "/api/index" }
  ]
}
