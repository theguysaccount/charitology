---
// Layout for every single-entry page: programs, tools, record entries,
// conditions and open problems. Slots: "badges" (under the summary),
// "top" (full width, above the article, used by interactive tools),
// default (the article) and "aside" (the sticky meta column).
import Base from './Base.astro';
import Crumbs from '../components/Crumbs.astro';
import ReviewNote from '../components/ReviewNote.astro';
import SourceList from '../components/SourceList.astro';
import PageSections from '../components/PageSections.astro';
import type { SymbolName } from '../lib/site-identities';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  summary?: string;
  crumbs?: { label: string; href?: string }[];
  filePath?: string;
  review?: 'draft' | 'reviewed';
  identityCode?: string;
  sections?: readonly { slug: string; text: string; depth?: number; symbol?: SymbolName }[];
  sources?: { title: string; url: string; publisher?: string; year?: string | number; note?: string }[];
}

const { title, description, eyebrow, summary, crumbs, filePath, review = 'draft', sources = [], identityCode, sections } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<Base title={title} description={description ?? summary}>
  <header class="page-head">
    <div class="wrap">
      {crumbs && <Crumbs items={crumbs} />}
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{identityCode && <span class="identity-code title-code">{identityCode}</span>}{title}</h1>
      {summary && <p class="lede">{summary}</p>}
      {Astro.slots.has('badges') && <div class="badges"><slot name="badges" /></div>}
    </div>
  </header>
  {
    Astro.slots.has('top') && (
      <div class="wrap entry-top">
        <slot name="top" />
      </div>
    )
  }
  <div class="wrap section-tight">
    <div class={hasAside ? 'split' : ''}>
      <article>
        {sections && <PageSections sections={sections} />}
        <div class="prose">
          <slot />
        </div>
        <SourceList sources={sources} />
        <ReviewNote filePath={filePath} review={review} title={title} />
      </article>
      {
        hasAside && (
          <aside class="entry-aside">
            <slot name="aside" />
          </aside>
        )
      }
    </div>
  </div>
</Base>

<style>
  .entry-top {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
