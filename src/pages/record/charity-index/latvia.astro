---
import Entry from '../../../layouts/Entry.astro';
import { url } from '../../../lib/site';
import manifest from '../../../../public/data/charity-registry/latvia/manifest.json';
import '../../../styles/charity-financial-search.css';

const title = 'Latvia nonprofits and public benefit organizations (SLO)';
const dataPath = '/data/charity-registry/latvia/';
const flowPath = '/record/funding-flows/latvia-eu-funds/';
const count = (value: number) => value.toLocaleString('en-US');
const sources = [
  { title: 'Uzņēmumu reģistra atvērtie dati (Enterprise Register)', publisher: 'Uzņēmumu reģistrs (data.gov.lv)', url: manifest.catalogues.urRegister },
  { title: 'Biedrību un nodibinājumu darbības jomas (Areas of Activity)', publisher: 'Uzņēmumu reģistrs (data.gov.lv)', url: manifest.catalogues.urAreas },
  { title: 'Sabiedriskā labuma organizācijas (VID SLO Register)', publisher: 'Valsts ieņēmumu dienests (data.gov.lv)', url: manifest.catalogues.vidSlo },
  { title: 'CC0 1.0 Universal Public Domain Dedication', publisher: 'Creative Commons', url: manifest.license },
];
const formEntries = Object.entries(manifest.forms).sort((a, b) => b[1].count - a[1].count);
---

<Entry title={title} eyebrow="The Record · Global Charity Index · Latvia"
  summary="Search 34,057 Latvian associations, foundations, trade unions and religious organizations by name or 11-digit registration code. Inspect active vs. revoked Public Benefit (SLO) status, statutory activity fields and EU Cohesion fund links."
  crumbs={[{label:'The Record',href:'/record/'},{label:'Global Charity Index',href:'/record/charity-index/'},{label:'Latvia'}]}
  filePath="src/pages/record/charity-index/latvia.astro" sources={sources}>
  <p>This edition joins three official Latvian open-data tables captured <time datetime={manifest.capturedOn}>{manifest.capturedOn}</time> under <a href={manifest.license}>CC0 1.0</a> by exact 11-digit registration code: the Enterprise Register (<em>Uzņēmumu reģistrs</em>, scanning {count(manifest.counts.urTotalEntitiesScanned)} legal entities to extract all <strong>{count(manifest.counts.includedOrganizations - 1)} associations, foundations, trade unions and religious organizations</strong>), the Enterprise Register’s statutory activity-field table (<strong>{count(manifest.counts.withUrAreaOfActivity)}</strong> organizations classified), and the State Revenue Service (VID) Public Benefit Organization (<em>Sabiedriskā labuma organizācija</em>, SLO) register (<strong>{count(manifest.counts.vidSloDistinctOrganizations)}</strong> distinct organizations across {count(manifest.counts.vidSloSourceRows)} decision rows, including <strong>1</strong> parish absent from the current UR extract). Across the combined <strong>{count(manifest.counts.includedOrganizations)}</strong> entities, <strong>{count(manifest.counts.byStatus.active)}</strong> are active, <strong>{count(manifest.counts.vidSloByStatus.activeSlo)}</strong> currently hold active tax-deductible SLO status, and <strong>{count(manifest.counts.vidSloByStatus.revokedSlo)}</strong> have had SLO status revoked.</p>

  <section class="charity-financial-search" data-latvia-registry data-base={url(dataPath)}
    data-flow={url(flowPath)} data-manifest={JSON.stringify(manifest)} aria-labelledby="lv-search-heading">
    <h2 id="lv-search-heading">Search Latvian nonprofits</h2>
    <p id="lv-search-hint">Enter the beginning of an organization’s name (Latvian diacritics optional, with or without <code>Biedrība</code> / <code>Nodibinājums</code>, e.g., <code>samariešu</code>, <code>ziedot</code> or <code>latvijas sarkana</code>) or an exact 11-digit registration code (e.g., <code>40008001803</code>). Search runs locally in your browser.</p>
    <form aria-describedby="lv-search-hint">
      <label for="lv-query">Organization name or 11-digit registration code</label>
      <div class="finance-actions">
        <input type="search" id="lv-query" maxlength="160" autocomplete="off" disabled />
        <span class="inline-field">
          <label for="lv-form">Legal form</label>
          <select id="lv-form" disabled>
            <option value="">All forms ({count(manifest.counts.includedOrganizations)})</option>
            {formEntries.map(([code, info]) => (
              <option value={code}>{info.lv} / {info.en} ({count(info.count)})</option>
            ))}
          </select>
        </span>
        <span class="inline-field">
          <label for="lv-status">Registry status</label>
          <select id="lv-status" disabled>
            <option value="">All statuses</option>
            <option value="A">Active ({count(manifest.counts.byStatus.active)})</option>
            <option value="L">Liquidated ({count(manifest.counts.byStatus.liquidated)})</option>
            <option value="R">Reorganized ({count(manifest.counts.byStatus.reorganized)})</option>
            <option value="U">VID SLO only / absent from UR ({count(manifest.counts.byStatus.absentFromUr)})</option>
          </select>
        </span>
        <span class="inline-field">
          <label for="lv-slo">Public Benefit (SLO)</label>
          <select id="lv-slo" disabled>
            <option value="">All SLO states</option>
            <option value="A">Active SLO ({count(manifest.counts.vidSloByStatus.activeSlo)})</option>
            <option value="R">Revoked SLO ({count(manifest.counts.vidSloByStatus.revokedSlo)})</option>
            <option value="L">Liquidated SLO ({count(manifest.counts.vidSloByStatus.liquidatedSlo)})</option>
            <option value="N">No SLO record</option>
          </select>
        </span>
        <label class="inline-check"><input type="checkbox" id="lv-eu-only" disabled /> Has EU Cohesion/Recovery project</label>
        <button type="submit" class="btn" disabled>Search organizations</button>
        <button type="button" class="btn btn-ghost" data-clear disabled>Clear</button>
      </div>
    </form>
    <p role="status" data-status>Search when you are ready to load a Latvia registry shard.</p>
    <div class="finance-actions">
      <button type="button" class="btn btn-ghost btn-small" data-json disabled>Export displayed results as JSON</button>
      <button type="button" class="btn btn-ghost btn-small" data-csv disabled>Export displayed results as CSV</button>
    </div>
    <ol class="finance-results" data-site-symbol="amber" aria-label="Latvia nonprofit registry results" data-results></ol>
    <noscript><p>Without JavaScript, download the CC0 CSV files directly from <a href={manifest.catalogues.urRegister}>data.gov.lv (Enterprise Register)</a> and <a href={manifest.catalogues.vidSlo}>VID SLO register</a>.</p></noscript>
  </section>

  <h2 id="funding">Follow EU Cohesion &amp; Recovery projects</h2>
  <p>Latvia’s Central Finance and Contracting Agency (CFLA) publishes project-level EU Structural Funds (2014–2020 and 2021–2027) and Recovery &amp; Resilience Facility records with exact 11-digit registration codes and implementation regions. <a class="identity-link" href={url(flowPath)}>Inspect 292 nonprofit-led EU projects totaling EUR 233.47M across {count(manifest.counts.withEuFundsLeadProject)} lead nonprofits and 260 nonprofit cooperation-partner roles</a>.</p>

  <h2 id="coverage">SLO revocations, housing associations and privacy boundaries</h2>
  <p><strong>Associations include non-charitable civic bodies:</strong> Of the {count(manifest.counts.withUrAreaOfActivity)} associations and foundations with a statutory UR activity area, the single largest category is <strong>housing and apartment management (<em>Mājokļu apsaimniekošana</em>, {count(manifest.counts.housingManagementAssociations)} organizations)</strong>, ahead of sports (4,056), culture (2,746), education (1,908) and charity (<em>Labdarība</em>, 1,094). Raw association totals therefore cannot be read as fundraising charities; VID’s <strong>Active SLO</strong> status ({count(manifest.counts.vidSloByStatus.activeSlo)} organizations) identifies entities currently recognized for tax-deductible public-benefit donations.</p>
  <p><strong>More revocations than active SLOs:</strong> Retaining VID’s full decision history shows <strong>{count(manifest.counts.vidSloByStatus.revokedSlo)} revoked SLOs</strong> (<em>Atņemts</em>) and {count(manifest.counts.vidSloByStatus.liquidatedSlo)} liquidated SLOs alongside {count(manifest.counts.vidSloByStatus.activeSlo)} currently active SLOs. One historic parish with revoked SLO status (<code>90002493065</code>, <em>RĪGAS SVĒTĀS TERĒZES ROMAS KATOĻU DRAUDZE</em>) appears in VID’s SLO file but is absent from the November 22, 2026 UR export and stays visible under status <code>U</code>. Street addresses, postal codes and contact emails are omitted from this public index. All source files are published under <a href={manifest.license}>CC0 1.0</a> via <code>data.gov.lv</code>. <a class="identity-link" data-source-symbol="document" href={url(dataPath + 'manifest.json')} download>Download source manifest (JSON)</a> · <a href={url('/record/charity-index/coverage/')}>Read the Index coverage</a>.</p>
</Entry>

<script>
  import { $, h } from '../../../lib/client/dom';
  import { download, toCsv } from '../../../lib/client/files';
  import { financialCsvName, financialShardLoader, normalizeFinancialName, type FinancialShard } from '../../../lib/client/financial-directory';

  type OrgRow = [
    string, string, string, 'A' | 'L' | 'R' | 'U', string | null, string | null,
    'A' | 'R' | 'L' | null, string | null, string | null, string | null, string | null,
    number, number, number,
  ];
  type DirectoryEntry = [string, string];
  type Manifest = {
    format: string; capturedOn: string; publisher: string; license: string;
    forms: Record<string, { lv: string; en: string; count: number }>;
    names: Record<string, FinancialShard>;
    ids: Record<string, FinancialShard>;
  };
  type Result = { total: number; organizations: OrgRow[] };

  const stripDigits = (value: string) => value.replace(/[\s.-]+/g, '');
  const isRegcode = (value: string) => /^[0-9]{11}$/.test(stripDigits(value));
  const bucketFor = (norm: string) => {
    const first = norm[0] ?? '';
    if (first >= 'a' && first <= 'z') return first;
    if (first >= '0' && first <= '9') return '0-9';
    return 'other';
  };
  const statusLabels: Record<'A' | 'L' | 'R' | 'U', string> = {
    A: 'Active',
    L: 'Liquidated',
    R: 'Reorganized',
    U: 'VID SLO only (absent from UR)',
  };
  const sloLabels: Record<'A' | 'R' | 'L', string> = {
    A: 'Active SLO (Public Benefit)',
    R: 'Revoked SLO',
    L: 'Liquidated SLO',
  };
  const fmtEur = (cents: number) =>
    `EUR ${(cents / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const limit = 30;

  const toObject = ([regcode, name, form, status, registered, terminated, sloStatus, sloSince, sloUntil, sloFields, primaryUrArea, euLeadProjects, euLeadTotalCents, euPartnerRoles]: OrgRow) => ({
    regcode, name, form, status, registered, terminated, sloStatus, sloSince, sloUntil, sloFields, primaryUrArea,
    euLeadProjects, euLeadTotalEur: (euLeadTotalCents / 100).toFixed(2), euPartnerRoles,
  });

  for (const root of document.querySelectorAll<HTMLElement>('[data-latvia-registry]')) {
    const manifest: Manifest = JSON.parse(root.dataset.manifest!);
    const base = root.dataset.base!;
    const flowBase = root.dataset.flow!;
    const loadNames = financialShardLoader<OrgRow>(base, manifest.names);
    const loadIds = financialShardLoader<DirectoryEntry>(base, manifest.ids);

    const formEl = $<HTMLFormElement>('form', root);
    const input = $<HTMLInputElement>('#lv-query', formEl);
    const formFilter = $<HTMLSelectElement>('#lv-form', formEl);
    const statusFilter = $<HTMLSelectElement>('#lv-status', formEl);
    const sloFilter = $<HTMLSelectElement>('#lv-slo', formEl);
    const euOnly = $<HTMLInputElement>('#lv-eu-only', formEl);
    const submit = $<HTMLButtonElement>('button[type=submit]', formEl);
    const clear = $<HTMLButtonElement>('[data-clear]', root);
    const statusEl = $('[data-status]', root);
    const results = $('[data-results]', root);
    const jsonBtn = $<HTMLButtonElement>('[data-json]', root);
    const csvBtn = $<HTMLButtonElement>('[data-csv]', root);

    let found: Result | undefined;
    let sequence = 0;
    input.disabled = formFilter.disabled = statusFilter.disabled = sloFilter.disabled = euOnly.disabled = submit.disabled = clear.disabled = false;

    const reset = () => {
      found = undefined;
      results.replaceChildren();
      jsonBtn.disabled = csvBtn.disabled = true;
    };

    function card(row: OrgRow) {
      const [regcode, name, formCode, statusCode, regDate, termDate, sloSt, sloSince, sloUntil, sloFields, urArea, euLeadCnt, euLeadCents, euPartCnt] = row;
      const formInfo = manifest.forms[formCode];
      const formText = formInfo ? `${formInfo.lv} (${formInfo.en})` : formCode;
      const sloText = sloSt
        ? `${sloLabels[sloSt]}${sloSince ? ` (since ${sloSince}${sloUntil ? `, ended ${sloUntil}` : ''})` : ''}${sloFields ? ` · ${sloFields.replace(/\|/g, ', ')}` : ''}`
        : 'No Public Benefit (SLO) status';
      const euText = euLeadCnt > 0 || euPartCnt > 0
        ? [
            euLeadCnt > 0 ? `${euLeadCnt} EU lead ${euLeadCnt === 1 ? 'project' : 'projects'} (${fmtEur(euLeadCents)})` : null,
            euPartCnt > 0 ? `${euPartCnt} EU partner ${euPartCnt === 1 ? 'role' : 'roles'}` : null,
          ].filter(Boolean).join(' · ')
        : 'No CFLA EU Cohesion/Recovery match';
      return h('li', { class: 'card' },
        h('h3', {}, h('span', { class: 'identity-code' }, regcode), ' ', h('span', { lang: 'lv' }, name)),
        h('p', {}, `${formText} · ${statusLabels[statusCode]}${urArea ? ` · ${urArea}` : ''}`),
        h('p', { class: 'note' },
          `Registered ${regDate ?? 'unknown'}${termDate ? ` · Terminated ${termDate}` : ''} · ${sloText}`),
        h('p', { class: 'note' },
          euLeadCnt > 0 || euPartCnt > 0
            ? h('a', { href: `${flowBase}#q=${regcode}` }, `Inspect EU funds: ${euText}`)
            : euText,
          ' · ',
          h('a', { href: `https://info.ur.gov.lv/#/legal-entity/${regcode}`, rel: 'noopener noreferrer' }, 'Check live Enterprise Register (UR)')));
    }

    async function search(value: string): Promise<Result> {
      const cleaned = stripDigits(value);
      const fVal = formFilter.value;
      const sVal = statusFilter.value;
      const sloVal = sloFilter.value;
      const onlyEu = euOnly.checked;
      const matchesFilters = (row: OrgRow) =>
        (!fVal || row[2] === fVal)
        && (!sVal || row[3] === sVal)
        && (!sloVal || (sloVal === 'N' ? row[6] === null : row[6] === sloVal))
        && (!onlyEu || row[11] > 0 || row[13] > 0);

      if (isRegcode(cleaned)) {
        const entry = (await loadIds(cleaned.slice(0, 2))).find(([id]) => id === cleaned);
        if (!entry) return { total: 0, organizations: [] };
        const org = (await loadNames(entry[1])).find(([id]) => id === cleaned);
        if (!org) throw new Error('The registration code could not be matched to the shard.');
        return matchesFilters(org) ? { total: 1, organizations: [org] } : { total: 0, organizations: [] };
      }

      const query = normalizeFinancialName(value);
      if (query.length < 2) throw new Error('Enter at least two characters of a name or an exact 11-digit registration code.');
      const queries = [query];
      const hasPrefix = query.startsWith('biedriba ') || query.startsWith('nodibinajums ') || query.startsWith('fonds ');
      if (!hasPrefix) {
        queries.push(`biedriba ${query}`, `nodibinajums ${query}`, `fonds ${query}`);
      }
      const buckets = [...new Set(queries.map(bucketFor))];
      const organizations: OrgRow[] = [];
      const seen = new Set<string>();
      let total = 0;
      for (const bucket of buckets) {
        for (const row of await loadNames(bucket)) {
          if (seen.has(row[0]) || !matchesFilters(row)) continue;
          const normName = normalizeFinancialName(row[1]);
          if (!queries.some(q => normName.startsWith(q)) && !normName.includes(query)) continue;
          seen.add(row[0]);
          total++;
          if (organizations.length < limit) organizations.push(row);
        }
      }
      return { total, organizations };
    }

    async function runSearch() {
      const ticket = ++sequence;
      reset();
      submit.disabled = true;
      statusEl.textContent = 'Checking the Latvia nonprofit & SLO snapshot.';
      try {
        const matches = await search(input.value);
        if (ticket !== sequence) return;
        found = matches;
        statusEl.textContent = matches.total
          ? `${matches.total.toLocaleString('en-US')} ${matches.total === 1 ? 'match' : 'matches'}. Showing ${matches.organizations.length}.`
          : 'No matching Latvian nonprofit in this snapshot. Try a Latvian name (diacritics optional) or an exact 11-digit registration code.';
        results.append(...matches.organizations.map(card));
        jsonBtn.disabled = csvBtn.disabled = !matches.organizations.length;
      } catch (error) {
        if (ticket === sequence) statusEl.textContent = error instanceof Error ? error.message : 'The organization search failed.';
      } finally { if (ticket === sequence) submit.disabled = false; }
    }

    formEl.addEventListener('submit', event => { event.preventDefault(); void runSearch(); });
    clear.addEventListener('click', () => {
      sequence++;
      reset();
      submit.disabled = false;
      input.value = '';
      formFilter.value = statusFilter.value = sloFilter.value = '';
      euOnly.checked = false;
      statusEl.textContent = 'Search cleared.';
      input.focus();
    });

    const { format, capturedOn, publisher, license } = manifest;
    jsonBtn.addEventListener('click', () => {
      if (!found) return;
      download('latvia-nonprofit-organizations.json', JSON.stringify({
        format, capturedOn, publisher, license,
        total: found.total, organizations: found.organizations.map(toObject),
      }, null, 2) + '\n', 'application/json');
    });
    csvBtn.addEventListener('click', () => {
      if (!found) return;
      const rows = found.organizations.map(row => {
        const obj = toObject(row);
        return {
          ...obj,
          name: financialCsvName(obj.name),
          capturedOn, publisher, license,
        };
      });
      download('latvia-nonprofit-organizations.csv', '\uFEFF' + toCsv(rows), 'text/csv;charset=utf-8');
    });

    const initial = new URLSearchParams(location.search).get('regcode') ?? /^#q=([0-9]{11})$/.exec(location.hash)?.[1];
    if (initial && isRegcode(initial)) {
      input.value = stripDigits(initial);
      void runSearch();
    }
  }
</script>
