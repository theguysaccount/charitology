---
import Entry from '../../../layouts/Entry.astro';
import { url } from '../../../lib/site';
import { wave1c } from '../../../lib/registry-wave1c';
import manifest from '../../../../public/data/charity-registry/denmark/manifest.json';
import '../../../styles/charity-financial-search.css';

const title = 'Denmark tax-approved charities (Skattestyrelsen § 8 A, § 12 stk. 3 & BAL)';
const dataPath = '/data/charity-registry/denmark/';
const count = (value: number) => value.toLocaleString('en-US');

const sources = [
  {
    title: 'Den juridiske vejledning 2026-2 — C.A.4.3.5.9 Liste over godkendte foreninger',
    publisher: manifest.publisher,
    url: manifest.catalogues.skatApprovedList,
  },
  {
    title: 'Central Business Register (CVR)',
    publisher: 'Erhvervsstyrelsen',
    url: manifest.catalogues.cvrRegister,
  },
  {
    title: 'Indsamlingsnævnet (Danish Fundraising Board)',
    publisher: 'Civilstyrelsen',
    url: manifest.catalogues.indsamlingsnaevnet,
  },
];

const comboRows = [
  { key: 's8a', label: 'LL § 8 A only (gift deductions + automatic BAL § 3 stk. 1 g)', count: manifest.counts.byCombination.s8a },
  { key: 's8a+s12', label: 'LL § 8 A + LL § 12 stk. 3 (gifts + recurring gift commitments)', count: manifest.counts.byCombination['s8a+s12'] },
  { key: 'bal', label: 'BAL § 3 stk. 2 only (estate/inheritance-tax exemption)', count: manifest.counts.byCombination.bal },
  { key: 's8a+bal', label: 'LL § 8 A + BAL § 3 stk. 2 listed together', count: manifest.counts.byCombination['s8a+bal'] },
  { key: 's8a+s12+bal', label: 'All three markers (§ 8 A + § 12 stk. 3 + BAL)', count: manifest.counts.byCombination['s8a+s12+bal'] },
];
---

<Entry
  title={title}
  eyebrow="The Record · Global Charity Index · Denmark"
  summary="Search all 1,471 Danish tax-approved charities, foundations and associations published by Skattestyrelsen (Den juridiske vejledning 2026-2, C.A.4.3.5.9), verified to 100% unique 8-digit CVR numbers across LL § 8 A, LL § 12 stk. 3 and BAL § 3 stk. 2."
  crumbs={[{ label: 'The Record', href: '/record/' }, { label: 'Global Charity Index', href: '/record/charity-index/' }, { label: 'Denmark' }]}
  filePath="src/pages/record/charity-index/denmark.astro"
  sources={sources}
>
  <p>
    This edition indexes the official list of tax-approved public-benefit associations, foundations and institutions published by the Danish Tax Agency
    (<em>Skattestyrelsen</em>, <em>Den juridiske vejledning 2026-2</em>, section <code>C.A.4.3.5.9</code>, published <time datetime={manifest.asOf}>{manifest.asOf}</time>,
    captured <time datetime={manifest.capturedOn}>{manifest.capturedOn}</time>). Every one of the <strong>{count(manifest.counts.includedOrganizations)} organizations</strong> carries a unique
    8-digit Danish business identifier (<em>CVR-nummer</em>): <strong>{count(manifest.counts.ll8aTotal)}</strong> approved for tax-deductible gifts under
    <code>LL § 8 A</code> ({count(manifest.counts.ll8aFullYear)} full year, {count(manifest.counts.ll8aPartialYear)} partial year),
    <strong>{count(manifest.counts.ll12Total)}</strong> approved for ongoing gift commitments under <code>LL § 12, stk. 3</code>
    ({count(manifest.counts.ll12FullYear)} full year, {count(manifest.counts.ll12PartialYear)} partial year), and <strong>{count(manifest.counts.balListedTotal)}</strong>
    explicitly listed for inheritance/estate-tax exemption under <code>BAL § 3, stk. 2</code>.
  </p>
  <p>
    Together with <a href={url('/record/charity-index/norway/')}>Norway</a> and <a href={url('/record/charity-index/sweden/')}>Sweden</a>, Denmark completes Charitology’s
    three-country Scandinavian charity index. Unlike Norway’s broad voluntary register (72,968 civic groups including local sports clubs), Denmark’s
    Skattestyrelsen list covers strictly organizations vetted and approved by the tax authority for donor tax deductions or estate-tax exemptions.
  </p>

  <p><a href={url(wave1c().base(wave1c().H.dk.slug))}>Browse {wave1c().registryHubKeys('dk').length} register hubs</a> that group {wave1c().hubs.dk.counts.population.toLocaleString('en-US')} {wave1c().H.dk.population} by the register’s own {wave1c().H.dk.labelPlural}, with each entry as published.</p>
  <section
    class="charity-financial-search"
    data-denmark-registry
    data-base={url(dataPath)}
    data-manifest={JSON.stringify(manifest)}
    aria-labelledby="dk-search-heading"
  >
    <h2 id="dk-search-heading">Search Danish tax-approved charities</h2>
    <p id="dk-search-hint">
      Enter part of an organization’s name (Danish letters <code>æ/ø/å</code> optional, e.g., <code>rode kors</code>, <code>kraeftens bekaempelse</code>,
      <code>unicef</code>, <code>against malaria</code> or <code>folkekirkens nodhjaelp</code>) or an exact 8-digit <em>CVR</em> number (e.g., <code>20700211</code>).
      Search runs locally in your browser.
    </p>
    <form aria-describedby="dk-search-hint">
      <label for="dk-query">Organization name or 8-digit CVR</label>
      <div class="finance-actions">
        <input type="search" id="dk-query" maxlength="160" autocomplete="off" disabled />
        <span class="inline-field">
          <label for="dk-statute">Approval statute</label>
          <select id="dk-statute" disabled>
            <option value="">All approved organizations ({count(manifest.counts.includedOrganizations)})</option>
            <option value="s8a">LL § 8 A gift-deductible ({count(manifest.counts.ll8aTotal)})</option>
            <option value="s12">LL § 12 stk. 3 recurring gifts ({count(manifest.counts.ll12Total)})</option>
            <option value="bal">BAL § 3 stk. 2 estate-tax exempt ({count(manifest.counts.balListedTotal)})</option>
            <option value="partial">Partial-year approval (*) ({count(manifest.counts.ll8aPartialYear)} § 8 A / {count(manifest.counts.ll12PartialYear)} § 12)</option>
            <option value="ceased">Marked OPHØRT (ceased in 2025) ({count(manifest.counts.ceased2025)})</option>
          </select>
        </span>
        <button type="submit" class="btn" disabled>Search organizations</button>
        <button type="button" class="btn btn-ghost" data-clear disabled>Clear</button>
      </div>
    </form>
    <p role="status" data-status>Search when you are ready to load Denmark’s Skattestyrelsen list ({(manifest.artifacts.organizations.bytes / 1024).toFixed(1)} KB compressed).</p>
    <div class="finance-actions">
      <button type="button" class="btn btn-ghost btn-small" data-json disabled>Export displayed results as JSON</button>
      <button type="button" class="btn btn-ghost btn-small" data-csv disabled>Export displayed results as CSV</button>
    </div>
    <ol class="finance-results" data-site-symbol="danishCrown" aria-label="Denmark approved charity results" data-results></ol>
    <noscript>
      <p>
        Without JavaScript, download the <a href={url(dataPath + manifest.artifacts.csv.path)} download>Denmark approved charities CSV ({count(manifest.counts.includedOrganizations)} rows)</a>
        or consult <a href={manifest.catalogues.skatApprovedList}>Skattestyrelsen C.A.4.3.5.9</a> directly.
      </p>
    </noscript>
  </section>

  <h2 id="statutes">Approval statutes and deduction thresholds</h2>
  <p>
    Skattestyrelsen’s 2026-2 legal guidance distinguishes three statutory approval tracks covering the <strong>{manifest.approvalCalendarYear}</strong> approval calendar year.
    Under <strong>LL § 8 A</strong>, donors may deduct charitable gifts up to <strong>DKK {count(manifest.deductionThresholdsDkk.ll8aCap2025)}</strong> in 2025
    (rising to <strong>DKK {count(manifest.deductionThresholdsDkk.ll8aCap2026)}</strong> in 2026); organizations approved under § 8 A also receive automatic inheritance-tax exemption
    under <code>BAL § 3, stk. 1, litra g</code>. Under <strong>LL § 12, stk. 3</strong>, organizations may receive tax-deductible binding multi-year gift commitments
    (<em>løbende ydelser</em>). Organizations listed solely under <strong>BAL § 3, stk. 2</strong> are exempt from estate tax on bequests without general § 8 A gift deductibility.
  </p>
  <div class="table-wrap" role="region" aria-label="Denmark approval statute combinations" tabindex="0">
    <table class="data dk-table">
      <caption>Organizations by statutory approval combination in Skattestyrelsen C.A.4.3.5.9 (2026-2)</caption>
      <thead>
        <tr>
          <th scope="col">Statutory combination</th>
          <th scope="col">Organizations</th>
          <th scope="col">Share</th>
        </tr>
      </thead>
      <tbody>
        {
          comboRows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{count(row.count)}</td>
              <td>{((row.count * 100) / manifest.counts.includedOrganizations).toFixed(1)}%</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="coverage">Scope, partial-year status and boundaries</h2>
  <p>
    <strong>What is included vs. excluded:</strong> This registry covers strictly organizations approved by Skattestyrelsen under <code>LL § 8 A</code>,
    <code>LL § 12, stk. 3</code>, or <code>BAL § 3, stk. 2</code> for the {manifest.approvalCalendarYear} calendar year. Unapproved local clubs, non-deductible associations,
    and research institutions approved separately under <code>LL § 8 H</code> sit outside this extract. Skattestyrelsen’s list does not publish organization-level financial
    statements or donation totals; use the exact 8-digit CVR identifier to check corporate filings on <a href={manifest.catalogues.cvrRegister}>datacvr.virk.dk</a> or fundraising
    permits with <a href={manifest.catalogues.indsamlingsnaevnet}>Indsamlingsnævnet</a>.
  </p>
  <p>
    <strong>Partial-year and ceased entries preserved verbatim:</strong> Twenty-six organizations carry Skattestyrelsen’s partial-year <code>1*</code> flag under § 8 A
    (and 8 carry <code>2*</code> under § 12 stk. 3), meaning tax deductibility applied only during part of the calendar year. Two entries prefixed <code>OPHØRT:</code>
    (<code>47387868</code> Kristent Centrum S/I and <code>43190199</code> Åbenkirke København) ceased operating during the year and remain explicitly flagged rather than
    silently dropped. <a class="identity-link" data-source-symbol="document" href={url(dataPath + 'manifest.json')} download>Download source manifest (JSON)</a> ·{' '}
    <a class="identity-link" data-source-symbol="table" href={url(dataPath + manifest.artifacts.csv.path)} download>Download full CSV ({count(manifest.counts.includedOrganizations)} rows)</a> ·{' '}
    <a href={url('/record/charity-index/coverage/')}>Read the Index coverage</a>.
  </p>
</Entry>

<style>
  .dk-table {
    min-inline-size: 36rem;
  }
</style>

<script>
  import { $, h } from '../../../lib/client/dom';
  import { download, toCsv } from '../../../lib/client/files';
  import { financialCsvName } from '../../../lib/client/financial-directory';
  import { loadVerifiedJson, type VerifiedJsonAsset } from '../../../lib/client/verified-json';

  type DkRow = {
    cvr: string;
    name: string;
    rawName: string;
    norm: string;
    s8a: boolean;
    s8aPartial: boolean;
    s12: boolean;
    s12Partial: boolean;
    bal: boolean;
    ceased2025: boolean;
  };
  type DkManifest = {
    format: string;
    asOf: string;
    capturedOn: string;
    publisher: string;
    artifacts: {
      organizations: VerifiedJsonAsset & { path: string; rows: number };
    };
  };

  const normalize = (value: string) =>
    value
      .toLowerCase()
      .replace(/æ/g, 'ae')
      .replace(/ø/g, 'o')
      .replace(/å/g, 'aa')
      .normalize('NFKD')
      .replace(/\p{M}/gu, '')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  const limit = 40;

  for (const root of document.querySelectorAll<HTMLElement>('[data-denmark-registry]')) {
    const manifest: DkManifest = JSON.parse(root.dataset.manifest!);
    const base = root.dataset.base!;
    const form = $('form', root) as HTMLFormElement;
    const queryEl = $('#dk-query', root) as HTMLInputElement;
    const statuteEl = $('#dk-statute', root) as HTMLSelectElement;
    const statusEl = $('[data-status]', root);
    const listEl = $('[data-results]', root);
    const clearBtn = $('[data-clear]', root) as HTMLButtonElement;
    const jsonBtn = $('[data-json]', root) as HTMLButtonElement;
    const csvBtn = $('[data-csv]', root) as HTMLButtonElement;
    const submitBtn = $('button[type="submit"]', root) as HTMLButtonElement;

    for (const el of [queryEl, statuteEl, submitBtn, clearBtn]) el.disabled = false;

    let cache: Promise<DkRow[]> | null = null;
    let shown: DkRow[] = [];

    const loadAll = () => {
      if (!cache) {
        const asset = manifest.artifacts.organizations;
        cache = loadVerifiedJson(base + asset.path, asset).then((data) => {
          if (!Array.isArray(data) || data.length !== asset.rows) {
            throw new Error('Unexpected Denmark organization count.');
          }
          return data as DkRow[];
        });
      }
      return cache;
    };

    const matchesStatute = (r: DkRow, st: string) => {
      if (!st) return true;
      if (st === 's8a') return r.s8a;
      if (st === 's12') return r.s12;
      if (st === 'bal') return r.bal;
      if (st === 'partial') return r.s8aPartial || r.s12Partial;
      if (st === 'ceased') return r.ceased2025;
      return true;
    };

    const badgesFor = (r: DkRow) => {
      const parts: string[] = [];
      if (r.s8a) parts.push(r.s8aPartial ? 'LL § 8 A (partial year *)' : 'LL § 8 A (gift-deductible)');
      if (r.s12) parts.push(r.s12Partial ? 'LL § 12 stk. 3 (partial year *)' : 'LL § 12 stk. 3 (recurring gifts)');
      if (r.bal) parts.push('BAL § 3 stk. 2 (estate-tax exempt)');
      if (r.ceased2025) parts.push('OPHØRT (ceased in 2025)');
      return parts.join(' · ');
    };

    const render = (rows: DkRow[], total: number, q: string) => {
      shown = rows;
      listEl.replaceChildren();
      jsonBtn.disabled = rows.length === 0;
      csvBtn.disabled = rows.length === 0;
      if (!rows.length) {
        statusEl.textContent = q
          ? `No Danish tax-approved organizations matched “${q}” under the selected filter.`
          : 'No organizations matched the selected filter.';
        return;
      }
      statusEl.textContent =
        total > rows.length
          ? `Showing the first ${rows.length} of ${total.toLocaleString('en-US')} matching organizations.`
          : `Showing ${total.toLocaleString('en-US')} matching organization${total === 1 ? '' : 's'}.`;

      for (const r of rows) {
        listEl.append(
          h(
            'li',
            {},
            h('strong', { lang: 'da' }, r.name),
            ' ',
            h('code', {}, `CVR ${r.cvr}`),
            h('div', { class: 'note' }, badgesFor(r)),
          ),
        );
      }
    };

    const runSearch = async () => {
      const rawQ = queryEl.value.trim();
      const digits = rawQ.replace(/\s+/g, '');
      const normQ = normalize(rawQ);
      const st = statuteEl.value;
      statusEl.textContent = 'Loading Denmark Skattestyrelsen snapshot…';
      try {
        const all = await loadAll();
        const filtered = all.filter((r) => {
          if (!matchesStatute(r, st)) return false;
          if (!rawQ) return true;
          if (/^\d{4,8}$/.test(digits)) return r.cvr.includes(digits);
          return r.norm.includes(normQ) || r.name.toLowerCase().includes(rawQ.toLowerCase());
        });
        render(filtered.slice(0, limit), filtered.length, rawQ);
      } catch (err) {
        statusEl.textContent = err instanceof Error ? err.message : 'Could not load Denmark registry snapshot.';
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void runSearch();
    });
    statuteEl.addEventListener('change', () => {
      void runSearch();
    });
    clearBtn.addEventListener('click', () => {
      queryEl.value = '';
      statuteEl.value = '';
      shown = [];
      listEl.replaceChildren();
      jsonBtn.disabled = true;
      csvBtn.disabled = true;
      statusEl.textContent = 'Search cleared.';
      queryEl.focus();
    });
    jsonBtn.addEventListener('click', () => {
      if (!shown.length) return;
      download(
        'charitology-denmark-approved-charities.json',
        JSON.stringify({ source: manifest.publisher, asOf: manifest.asOf, rows: shown }, null, 2),
        'application/json;charset=utf-8',
      );
    });
    csvBtn.addEventListener('click', () => {
      if (!shown.length) return;
      const csvText = toCsv(
        shown.map((r) => ({
          cvr: r.cvr,
          name: financialCsvName(r.name),
          ll_8a: r.s8a,
          ll_8a_partial: r.s8aPartial,
          ll_12_3: r.s12,
          ll_12_3_partial: r.s12Partial,
          bal_3_2: r.bal,
          ceased_2025: r.ceased2025,
        })),
      );
      download('charitology-denmark-approved-charities.csv', '\uFEFF' + csvText, 'text/csv;charset=utf-8');
    });
  }
</script>
