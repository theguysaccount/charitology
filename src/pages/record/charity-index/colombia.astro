---
import Entry from '../../../layouts/Entry.astro';
import { url } from '../../../lib/site';
import manifest from '../../../../public/data/charity-registry/colombia/manifest.json';
import '../../../styles/charity-financial-search.css';

const title = 'Colombia tax-exempt nonprofits (DIAN Régimen Tributario Especial — ESAL)';
const dataPath = '/data/charity-registry/colombia/';
const count = (value: number) => value.toLocaleString('en-US');

const sources = [
  {
    title: 'DIAN — Entidades sin ánimo de Lucro del Régimen Tributario Especial (datos.gov.co dataset 8tdc-u2ga)',
    publisher: manifest.publisher,
    url: manifest.catalogues.datosGovCoDataset,
  },
  {
    title: 'Datos Abiertos Colombia — SODA CSV API (8tdc-u2ga)',
    publisher: 'Ministerio de Tecnologías de la Información y las Comunicaciones (MinTIC)',
    url: manifest.catalogues.datosGovCoSodaCsv,
  },
  {
    title: 'DIAN — Régimen Tributario Especial (ESAL) regulatory portal',
    publisher: manifest.publisher,
    url: manifest.catalogues.dianRtePortal,
  },
];
---

<Entry
  title={title}
  eyebrow="The Record · Global Charity Index · Colombia"
  summary="Search 112,201 distinct Colombian tax-exempt nonprofits (ESAL) carrying 9-digit NIT identifiers across five years (2018–2022) of DIAN’s Special Tax Regime (Régimen Tributario Especial), tracking the 59,348-entity attrition cliff following Ley 1819 re-qualification."
  crumbs={[
    { label: 'The Record', href: '/record/' },
    { label: 'Global Charity Index', href: '/record/charity-index/' },
    { label: 'Colombia' },
  ]}
  filePath="src/pages/record/charity-index/colombia.astro"
  sources={sources}
>
  <p>
    This edition indexes all <strong>{count(manifest.counts.includedOrganizations)} distinct 9-digit NIT organizations</strong> appearing in
    Colombia’s national tax authority (<strong>{manifest.publisher}</strong>) open dataset of Special Tax Regime nonprofits
    (<em>Entidades sin ánimo de Lucro del Régimen Tributario Especial — RTE</em>, <code>datos.gov.co</code> dataset <code>8tdc-u2ga</code>,
    <code>{count(manifest.sourceCapture.rawRows)}</code> raw annual rows across <strong>2018–2022</strong>, captured{' '}
    <time datetime={manifest.capturedOn}>{manifest.capturedOn}</time>).
  </p>
  <p>
    The five-year longitudinal panel captures one of Latin America’s sharpest nonprofit compliance reforms: after{' '}
    <strong>Ley 1819 de 2016</strong> phased in mandatory annual RTE web disclosure and re-qualification, unique qualified entities dropped by
    more than half — from <strong>{count(manifest.annualSeries[0].uniqueNits)}</strong> in 2018 to{' '}
    <strong>{count(manifest.annualSeries[2].uniqueNits)}</strong> in 2020 and <strong>{count(manifest.counts.activeIn2022)}</strong> in 2022.
    Exactly <strong>{count(manifest.counts.continuousAllFiveYears)}</strong> organizations maintained continuous RTE status across all five
    years, while <strong>{count(manifest.counts.droppedBefore2020)}</strong> legacy 2018–2019 entities did not renew into 2020–2022.
  </p>

  <section
    class="charity-financial-search"
    data-co-registry
    data-base={url(dataPath)}
    data-manifest={JSON.stringify(manifest)}
    aria-labelledby="co-search-heading"
  >
    <h2 id="co-search-heading">Search Colombian DIAN RTE nonprofits</h2>
    <p id="co-search-hint">
      Enter the start of an organization’s Spanish legal name (accents optional — e.g., <code>fundacion</code>, <code>cruz roja</code>,
      <code>asociacion</code>, <code>corporacion</code>, <code>cooperativa</code>) or a 9-digit NIT (e.g., <code>800000383</code> or{' '}
      <code>86000</code>). Only the single compressed shard matching your first letter or two-digit NIT prefix downloads to your browser.
    </p>
    <form aria-describedby="co-search-hint">
      <label for="co-query">Organization name prefix or 9-digit Colombian NIT</label>
      <div class="finance-actions">
        <input type="search" id="co-query" maxlength="160" autocomplete="off" disabled />
        <span class="inline-field">
          <label for="co-cohort">RTE status cohort</label>
          <select id="co-cohort" disabled>
            <option value="">All 2018–2022 NITs ({count(manifest.counts.includedOrganizations)})</option>
            <option value="active2022">Active in 2022 ({count(manifest.counts.activeIn2022)})</option>
            <option value="all5">Continuous all 5 years 2018–2022 ({count(manifest.counts.continuousAllFiveYears)})</option>
            <option value="dropped">2018–2019 only / dropped before 2020 ({count(manifest.counts.droppedBefore2020)})</option>
            <option value="new2020">Entered in 2020–2022 ({count(manifest.counts.newIn2020To2022)})</option>
          </select>
        </span>
        <span class="inline-field">
          <label for="co-form">Derived legal form</label>
          <select id="co-form" disabled>
            <option value="">All forms</option>
            {
              manifest.legalForms.map((f) => (
                <option value={f.code}>
                  {f.labelEn} ({count(f.total)})
                </option>
              ))
            }
          </select>
        </span>
        <button type="submit" class="btn" disabled>Search organizations</button>
        <button type="button" class="btn btn-ghost" data-clear disabled>Clear</button>
      </div>
    </form>
    <p role="status" data-status>
      Enter a name prefix or at least two NIT digits to load the matching verified Colombia DIAN shard ({manifest.counts.idShardCount} NIT shards,{' '}
      {manifest.counts.nameShardCount} name shards).
    </p>
    <div class="finance-actions">
      <button type="button" class="btn btn-ghost btn-small" data-json disabled>Export displayed results as JSON</button>
      <button type="button" class="btn btn-ghost btn-small" data-csv disabled>Export displayed results as CSV</button>
    </div>
    <ol class="finance-results" data-site-symbol="emeraldPrism" aria-label="Colombia DIAN RTE nonprofit results" data-results></ol>
    <noscript>
      <p>
        Without JavaScript, download the{' '}
        <a href={url(dataPath + manifest.artifacts.annualCsv.path)} download>annual summary CSV (2018–2022)</a> or query{' '}
        <a href={manifest.catalogues.datosGovCoDataset}>DIAN dataset 8tdc-u2ga on datos.gov.co</a> directly.
      </p>
    </noscript>
  </section>

  <h2 id="annual-cliff">2018–2022 Ley 1819 re-qualification &amp; retention cliff</h2>
  <p>
    Annual counts show both DIAN’s raw published rows and deduplicated unique NITs (removing 400 same-year duplicate rows across the five-year
    span, documented verbatim in <code>anomalies.json</code>):
  </p>
  <div class="table-wrap" role="region" aria-label="Colombia DIAN RTE annual counts 2018-2022" tabindex="0">
    <table class="data co-table">
      <caption>DIAN Special Tax Regime (RTE) annual rows and deduplicated unique NITs (2018–2022)</caption>
      <thead>
        <tr>
          <th scope="col">Tax year</th>
          <th scope="col">Raw DIAN rows</th>
          <th scope="col">Unique NITs</th>
          <th scope="col">Same-year duplicates removed</th>
        </tr>
      </thead>
      <tbody>
        {
          manifest.annualSeries.map((y) => (
            <tr>
              <th scope="row">{y.year}</th>
              <td>{count(y.rawRows)}</td>
              <td><strong>{count(y.uniqueNits)}</strong></td>
              <td>{count(y.duplicateRowsRemoved)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="legal-forms">Derived Spanish legal-form cohorts &amp; 2022 retention</h2>
  <p>
    Because DIAN dataset <code>8tdc-u2ga</code> omits an explicit entity-type column, the breakdown below uses transparent deterministic Spanish
    legal keywords in <em>razón social</em>. Associations (<em>Asociaciones</em>) retained 57.6% of their 2018–2022 base into 2022, whereas
    cooperatives and employee funds retained only 22.2% after post-2019 regime reclassification.
  </p>
  <div class="table-wrap" role="region" aria-label="Colombia DIAN RTE derived legal forms" tabindex="0">
    <table class="data co-table">
      <caption>Derived legal-form cohorts across all 112,201 NITs vs. active 2022 RTE qualification</caption>
      <thead>
        <tr>
          <th scope="col">Derived legal form</th>
          <th scope="col">Total NITs (2018–2022)</th>
          <th scope="col">Active in 2022</th>
          <th scope="col">2022 retention</th>
        </tr>
      </thead>
      <tbody>
        {
          manifest.legalForms.map((f) => (
            <tr>
              <th scope="row">
                <strong>{f.labelEn}</strong><br />
                <span class="note" lang="es">{f.labelEs}</span>
              </th>
              <td>{count(f.total)}</td>
              <td>{count(f.active2022)}</td>
              <td>{((f.active2022 / f.total) * 100).toFixed(1)}%</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="coverage">Scope, source anomalies, Latin America context and boundaries</h2>
  <p>
    <strong>What is included vs. excluded:</strong> This register covers organizations listed in DIAN’s open Special Tax Regime (RTE) dataset
    <code>8tdc-u2ga</code> for tax years <strong>2018–2022</strong> — joining <a href={url('/record/charity-index/brazil/')}>Brazil (Ipea OSC)</a>{' '}
    and <a href={url('/record/charity-financials/mexico/')}>Mexico (SAT)</a> in Charitology’s Latin American coverage. DIAN’s bulk table publishes
    only 9-digit NIT, legal name (<em>razón social</em>), and fiscal year; financial statements, street addresses, municipalities, and tax-year
    2023+ updates are not included in this dataset (financial fields remain unpublished/<code>null</code>). Check DIAN’s live ESAL portal for
    current-day tax-deduction verification.
  </p>
  <p>
    <strong>Verbatim anomalies &amp; legacy 2018 edge cases:</strong> Exactly <strong>{count(manifest.counts.sameYearDuplicateRowsRemoved)}</strong>{' '}
    same-year duplicate <code>(NIT, year)</code> rows in DIAN’s raw CSV are deduplicated cleanly and logged in{' '}
    <a class="identity-link" data-source-symbol="document" href={url(dataPath + 'anomalies.json')} download>anomalies.json</a>.
    Notice that legacy 2018 rows include commercial/cooperative entities (e.g., <code>800000076 DAGRO S.A.</code>) that exited when DIAN enforced
    Ley 1819 re-qualification in 2020.{' '}
    <a class="identity-link" data-source-symbol="document" href={url(dataPath + 'manifest.json')} download>Download SHA-256 manifest (JSON)</a> ·{' '}
    <a class="identity-link" data-source-symbol="table" href={url(dataPath + manifest.artifacts.annualCsv.path)} download>Download 2018–2022 summary (CSV)</a> ·{' '}
    <a href={url('/record/charity-index/coverage/')}>Read the Index coverage</a>.
  </p>
</Entry>

<style>
  .co-table {
    min-inline-size: 42rem;
  }
  [data-co-registry] .inline-field {
    max-inline-size: 100%;
    min-inline-size: 0;
    flex-wrap: wrap;
  }
  [data-co-registry] select {
    max-inline-size: 100%;
    min-inline-size: 0;
  }
</style>

<script>
  import { $, h } from '../../../lib/client/dom';
  import { download, toCsv } from '../../../lib/client/files';
  import { financialCsvName, financialShardLoader, type FinancialShard } from '../../../lib/client/financial-directory';

  type CoRow = {
    n: string;
    nm: string;
    alt: string[] | null;
    s: string;
    f: string;
    y: number[];
    a22: boolean;
    a5: boolean;
  };
  type CoForm = {
    code: string;
    labelEs: string;
    labelEn: string;
    total: number;
    active2022: number;
  };
  type CoManifest = {
    publisher: string;
    asOf: string;
    capturedOn: string;
    legalForms: CoForm[];
    artifacts: {
      idShards: Record<string, FinancialShard>;
      nameShards: Record<string, FinancialShard>;
    };
  };

  const foldEs = (text: string) =>
    text
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  const bucketFor = (norm: string) => {
    const first = norm[0] ?? '';
    return first >= 'a' && first <= 'z' ? first : '0-9';
  };

  const limit = 40;

  for (const root of document.querySelectorAll<HTMLElement>('[data-co-registry]')) {
    const manifest: CoManifest = JSON.parse(root.dataset.manifest!);
    const base = root.dataset.base!;
    const loadIdShard = financialShardLoader<CoRow>(base, manifest.artifacts.idShards);
    const loadNameShard = financialShardLoader<CoRow>(base, manifest.artifacts.nameShards);
    const formMap = new Map(manifest.legalForms.map((f) => [f.code, f.labelEn]));

    const form = $('form', root) as HTMLFormElement;
    const queryEl = $('#co-query', root) as HTMLInputElement;
    const cohortSel = $('#co-cohort', root) as HTMLSelectElement;
    const formSel = $('#co-form', root) as HTMLSelectElement;
    const statusEl = $('[data-status]', root);
    const listEl = $('[data-results]', root);
    const clearBtn = $('[data-clear]', root) as HTMLButtonElement;
    const jsonBtn = $('[data-json]', root) as HTMLButtonElement;
    const csvBtn = $('[data-csv]', root) as HTMLButtonElement;
    const submitBtn = $('button[type="submit"]', root) as HTMLButtonElement;

    for (const el of [queryEl, cohortSel, formSel, submitBtn, clearBtn]) el.disabled = false;
    let shown: CoRow[] = [];

    const matchesCohort = (r: CoRow, cohort: string) => {
      if (!cohort) return true;
      if (cohort === 'active2022') return r.a22;
      if (cohort === 'all5') return r.a5;
      if (cohort === 'dropped') return !r.y.some((yr) => yr >= 2020);
      if (cohort === 'new2020') return Math.min(...r.y) >= 2020;
      return true;
    };

    const render = (rows: CoRow[], total: number, q: string) => {
      shown = rows;
      listEl.replaceChildren();
      jsonBtn.disabled = rows.length === 0;
      csvBtn.disabled = rows.length === 0;
      if (!rows.length) {
        statusEl.textContent = `No Colombian DIAN RTE organizations matched “${q}” under the selected filters.`;
        return;
      }
      statusEl.textContent =
        total > rows.length
          ? `Showing the first ${rows.length} of ${total.toLocaleString('en-US')} matching organizations.`
          : `Showing ${total.toLocaleString('en-US')} matching organization${total === 1 ? '' : 's'}.`;

      for (const r of rows) {
        const badge = r.a5
          ? 'Continuous RTE (2018–2022)'
          : r.a22
            ? 'Active in 2022'
            : `Last listed ${Math.max(...r.y)}`;
        const meta = [
          badge,
          `Years: ${r.y.join(', ')}`,
          `Derived form: ${formMap.get(r.f) ?? r.f}`,
        ];
        const children: (Node | string)[] = [
          h('strong', { lang: 'es' }, r.nm),
          ' ',
          h('code', {}, `NIT ${r.n}`),
        ];
        if (r.alt && r.alt.length) {
          children.push(h('div', { class: 'note', lang: 'es' }, `Prior name variant: ${r.alt.join(' · ')}`));
        }
        children.push(h('div', { class: 'note' }, meta.join(' · ')));
        listEl.append(h('li', {}, ...children));
      }
    };

    const runSearch = async () => {
      const rawQ = queryEl.value.trim();
      const digitsOnly = rawQ.replace(/[\s.-]+/g, '');
      const isNitQuery = /^\d{2,9}$/.test(digitsOnly);
      const normQ = foldEs(rawQ);
      const cohort = cohortSel.value;
      const formFilter = formSel.value;

      if (!rawQ) {
        statusEl.textContent = 'Enter a name prefix (e.g., fundacion, cruz roja) or at least two NIT digits (e.g., 800000383) to search.';
        return;
      }

      statusEl.textContent = 'Loading verified Colombia DIAN shard…';
      try {
        let shardRows: CoRow[];
        if (isNitQuery) {
          const pref = digitsOnly.slice(0, 2);
          if (!manifest.artifacts.idShards[pref]) {
            render([], 0, rawQ);
            return;
          }
          shardRows = await loadIdShard(pref);
        } else {
          const bucket = bucketFor(normQ);
          if (!manifest.artifacts.nameShards[bucket]) {
            render([], 0, rawQ);
            return;
          }
          shardRows = await loadNameShard(bucket);
        }

        const filtered = shardRows.filter((r) => {
          if (!matchesCohort(r, cohort)) return false;
          if (formFilter && r.f !== formFilter) return false;
          if (isNitQuery) return r.n.startsWith(digitsOnly);
          return r.s.includes(normQ);
        });
        // Rank 2022-active continuous entities first, then alphabetical
        filtered.sort((a, b) => Number(b.a22) - Number(a.a22) || b.y.length - a.y.length || a.nm.localeCompare(b.nm, 'es'));
        render(filtered.slice(0, limit), filtered.length, rawQ);
      } catch (err) {
        statusEl.textContent = err instanceof Error ? err.message : 'Could not load Colombia DIAN shard.';
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void runSearch();
    });
    for (const sel of [cohortSel, formSel]) {
      sel.addEventListener('change', () => {
        if (queryEl.value.trim()) void runSearch();
      });
    }
    clearBtn.addEventListener('click', () => {
      queryEl.value = '';
      cohortSel.value = '';
      formSel.value = '';
      shown = [];
      listEl.replaceChildren();
      jsonBtn.disabled = true;
      csvBtn.disabled = true;
      statusEl.textContent = 'Search cleared.';
      queryEl.focus();
    });
    jsonBtn.addEventListener('click', () => {
      if (!shown.length) return;
      download(
        'charitology-colombia-dian-rte.json',
        JSON.stringify(
          {
            source: manifest.publisher,
            asOf: manifest.asOf,
            capturedOn: manifest.capturedOn,
            rows: shown.map((r) => ({
              nit: r.n,
              razonSocial: r.nm,
              priorNames: r.alt ?? [],
              derivedLegalForm: r.f,
              yearsQualified: r.y,
              activeIn2022: r.a22,
              continuousAllFiveYears: r.a5,
            })),
          },
          null,
          2,
        ),
        'application/json;charset=utf-8',
      );
    });
    csvBtn.addEventListener('click', () => {
      if (!shown.length) return;
      const csvText = toCsv(
        shown.map((r) => ({
          nit: r.n,
          razon_social: financialCsvName(r.nm),
          prior_names: financialCsvName((r.alt ?? []).join('; ')),
          derived_legal_form: formMap.get(r.f) ?? r.f,
          years_qualified: r.y.join(','),
          active_in_2022: r.a22 ? 'true' : 'false',
          continuous_2018_2022: r.a5 ? 'true' : 'false',
        })),
      );
      download('charitology-colombia-dian-rte.csv', '\uFEFF' + csvText, 'text/csv;charset=utf-8');
    });
  }
</script>
