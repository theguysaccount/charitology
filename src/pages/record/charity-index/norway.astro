---
import Entry from '../../../layouts/Entry.astro';
import { url } from '../../../lib/site';
import manifest from '../../../../public/data/charity-registry/norway/manifest.json';
import '../../../styles/charity-financial-search.css';

const title = 'Norway voluntary organization registrations';
const dataPath = '/data/charity-registry/norway/';
const momsPath = '/record/funding-flows/norway-momskompensasjon/';
const count = (value: number) => value.toLocaleString('en-US');
const sources = [
  { title: 'Frivillighetsregisteret dataset listing', publisher: manifest.publisher, url: manifest.catalogue },
  { title: 'Enhetsregisteret bulk entity export', publisher: manifest.publisher, url: manifest.source.url },
  { title: 'Norwegian Licence for Open Government Data (NLOD) 2.0', publisher: 'Norwegian Digitalisation Agency', url: manifest.license },
];
---

<Entry title={title} eyebrow="The Record · Global Charity Index · Norway"
  summary="Find Norwegian voluntary organizations by name or nine-digit organization number. Inspect register overlap, legal form and matched VAT compensation grants."
  crumbs={[{label:'The Record',href:'/record/'},{label:'Global Charity Index',href:'/record/charity-index/'},{label:'Norway'}]}
  filePath="src/pages/record/charity-index/norway.astro" sources={sources}>
  <p>This edition covers <strong>{count(manifest.counts.includedOrganizations)} voluntary organizations</strong> registered in Norway’s Frivillighetsregisteret out of {count(manifest.counts.enhetsregisteretEntities)} legal entities in the Brønnøysund Register Centre export dated <time datetime={manifest.sourceLastModified}>{manifest.sourceLastModified}</time> (captured <time datetime={manifest.capturedOn}>{manifest.capturedOn}</time>). Of those, <strong>{count(manifest.counts.matchedMomskompensasjon2023to2025)}</strong> match an exact nine-digit organization number in the 2023–2025 VAT compensation grant disclosures. Check Brønnøysundregistrene directly for live status.</p>

  <section class="charity-financial-search" data-norway-registry data-base={url(dataPath)}
    data-moms={url(momsPath)} data-manifest={JSON.stringify(manifest)} aria-labelledby="norway-search-heading">
    <h2 id="norway-search-heading">Search voluntary organizations</h2>
    <p id="norway-search-hint">Enter the beginning of a published name (e.g., <code>norges rode kors</code> or <code>norges røde kors</code>) or an exact nine-digit organization number (<code>organisasjonsnummer</code>). Search loads only the matching shard and runs locally in your browser.</p>
    <form aria-describedby="norway-search-hint">
      <label for="norway-query">Organization name or nine-digit number</label>
      <div class="finance-actions">
        <input type="search" id="norway-query" maxlength="160" autocomplete="off" disabled />
        <span class="inline-field">
          <label for="norway-form">Legal form</label>
          <select id="norway-form" disabled>
            <option value="">All forms</option>
            <option value="FLI">FLI — Association or club ({count(manifest.counts.byForm.FLI)})</option>
            <option value="STI">STI — Foundation ({count(manifest.counts.byForm.STI)})</option>
            <option value="AS">AS — Limited company ({count(manifest.counts.byForm.AS)})</option>
          </select>
        </span>
        <label class="inline-check"><input type="checkbox" id="norway-moms-only" disabled /> Only 2023–2025 grant recipients</label>
        <button type="submit" class="btn" disabled>Search organizations</button>
        <button type="button" class="btn btn-ghost" data-clear disabled>Clear</button>
      </div>
    </form>
    <p role="status" data-status>Search when you’re ready to load a snapshot shard.</p>
    <div class="finance-actions">
      <button type="button" class="btn btn-ghost btn-small" data-json disabled>Export displayed results as JSON</button>
      <button type="button" class="btn btn-ghost btn-small" data-csv disabled>Export displayed results as CSV</button>
    </div>
    <ol class="finance-results" data-site-symbol="fjord" aria-label="Norway voluntary organization results" data-results></ol>
    <noscript><p>Without JavaScript, use the <a href={manifest.catalogue}>official Frivillighetsregisteret catalogue</a> or download the <a href={manifest.source.url}>Enhetsregisteret bulk export</a>.</p></noscript>
  </section>

  <h2 id="funding">Follow VAT compensation grants</h2>
  <p>Norway’s Gaming and Foundation Authority (Lotteri- og stiftelsestilsynet) publishes annual VAT compensation grants (Momskompensasjon) for voluntary organizations. <a class="identity-link" href={url(momsPath)}>Search 2023–2025 VAT compensation grant flows, umbrella intermediaries and two-tranche payouts</a>. Both registries share Norway’s nine-digit organisasjonsnummer, enabling exact ID matching without guessing from names.</p>
  <p>Norway’s public annual-accounts API (Regnskapsregisteret) returned an unsupported chart-of-accounts error (<code>IDEELL</code>) when queried for nonprofit filings such as Norges Røde Kors (<code>864139442</code>) on <time datetime={manifest.capturedOn}>{manifest.capturedOn}</time>. Because machine-readable nonprofit financial statements are not currently served through that endpoint, public grant disclosures remain separate from audited annual accounts.</p>

  <h2 id="coverage">Coverage and original records</h2>
  <p>The source extract includes <strong>{count(manifest.counts.byForm.FLI)}</strong> associations and clubs (<code>FLI</code>), <strong>{count(manifest.counts.byForm.STI)}</strong> foundations (<code>STI</code>, all {count(manifest.counts.foundationRegisterOverlap)} also flagged in Stiftelsesregisteret) and <strong>{count(manifest.counts.byForm.AS)}</strong> limited companies (<code>AS</code>) registered in Frivillighetsregisteret. Every retained nine-digit identifier passes Norway’s Modulus-11 check digit. Separate flags record VAT register membership ({count(manifest.counts.vatRegistered)}), active liquidation ({count(manifest.counts.liquidating)}) and bankruptcy ({count(manifest.counts.bankrupt)}).</p>
  <p>Municipality fields come from the published business address or, where absent, the postal address. {count(manifest.counts.unknownMunicipality)} organizations have no published municipality code, and {count(manifest.counts.repeatedNormalizedNames)} normalized names are shared by more than one organization number. Contact emails, phone numbers, street addresses and personal records are omitted from this public edition. Registration describes legal status; it does not establish service locations, financial health or charitable effectiveness.</p>
  <p>Contains data under the <a href={manifest.license}>Norwegian Licence for Open Government Data (NLOD) 2.0</a> made available by {manifest.publisher}. The <a class="identity-link" data-source-symbol="document" href={url(dataPath + 'manifest.json')} download>source manifest</a> pins the original file hash, shard fingerprints and exact counts. <a href={url('/record/charity-index/coverage/')}>Read the Index coverage</a>.</p>
</Entry>

<script>
  import { $, h } from '../../../lib/client/dom';
  import { download, toCsv } from '../../../lib/client/files';
  import { financialCsvName, financialShardLoader, normalizeFinancialName, type FinancialShard } from '../../../lib/client/financial-directory';

  const foldNorwegian = (value: string) =>
    normalizeFinancialName(value.replace(/[øØ]/g, 'o').replace(/[æÆ]/g, 'ae'));

  type Organization = [
    string, string, string, string | null, string | null,
    string | null, string | null, string | null, string, boolean,
  ];
  type DirectoryEntry = [string, string];
  type Manifest = {
    format: string; capturedOn: string; sourceLastModified: string; publisher: string; catalogue: string; license: string;
    source: { url: string; sha256: string; bytes: number };
    names: Record<string, FinancialShard>; ids: Record<string, FinancialShard>;
  };
  type Result = { total: number; organizations: Organization[] };

  const formLabels: Record<string, string> = {
    FLI: 'Association or club (FLI)',
    STI: 'Foundation (STI)',
    AS: 'Limited company (AS)',
  };

  const stripDigits = (value: string) => value.replace(/[\s-]+/g, '');
  const isOrgnr = (value: string) => /^[0-9]{9}$/.test(stripDigits(value));
  const bucketFor = (norm: string) => {
    const first = norm[0] ?? '';
    if (first >= 'a' && first <= 'z') return first;
    if (first >= '0' && first <= '9') return '0-9';
    return 'other';
  };
  const limit = 30;
  const toObject = ([orgnr, name, form, sector, nace, municipalityCode, municipalityName, frivillighetsregisteretDate, flags, hasMomskompensasjon2023to2025]: Organization) => ({
    orgnr, name, form, sector, nace, municipalityCode, municipalityName, frivillighetsregisteretDate, flags, hasMomskompensasjon2023to2025,
  });

  for (const root of document.querySelectorAll<HTMLElement>('[data-norway-registry]')) {
    const manifest: Manifest = JSON.parse(root.dataset.manifest!);
    const base = root.dataset.base!;
    const momsBase = root.dataset.moms!;
    const loadNames = financialShardLoader<Organization>(base, manifest.names);
    const loadIds = financialShardLoader<DirectoryEntry>(base, manifest.ids);
    const formEl = $<HTMLFormElement>('form', root);
    const input = $<HTMLInputElement>('#norway-query', formEl);
    const formFilter = $<HTMLSelectElement>('#norway-form', formEl);
    const momsOnly = $<HTMLInputElement>('#norway-moms-only', formEl);
    const submit = $<HTMLButtonElement>('button[type=submit]', formEl);
    const clear = $<HTMLButtonElement>('[data-clear]', root);
    const status = $('[data-status]', root);
    const results = $('[data-results]', root);
    const json = $<HTMLButtonElement>('[data-json]', root);
    const csv = $<HTMLButtonElement>('[data-csv]', root);
    let found: Result | undefined;
    let sequence = 0;
    input.disabled = formFilter.disabled = momsOnly.disabled = submit.disabled = clear.disabled = false;

    function reset() {
      found = undefined;
      results.replaceChildren();
      json.disabled = csv.disabled = true;
    }

    function flagSummary(flags: string) {
      const parts: string[] = [];
      if (flags.includes('S')) parts.push('Stiftelsesregisteret');
      if (flags.includes('M')) parts.push('VAT register');
      if (flags.includes('L')) parts.push('Under liquidation');
      if (flags.includes('K')) parts.push('Bankrupt');
      return parts.length ? parts.join(' · ') : 'No additional register flags';
    }

    function card(row: Organization) {
      const [orgnr, name, form, sector, nace, muniCode, muniName, regDate, flags, hasMoms] = row;
      const place = muniName ? `${muniName}${muniCode ? ` (${muniCode})` : ''}` : 'Municipality not supplied';
      return h('li', { class: 'card' },
        h('h3', {}, h('span', { class: 'identity-code' }, orgnr), ' ', h('span', { lang: 'nb' }, name)),
        h('p', {}, `${formLabels[form] ?? form} · ${place}`),
        h('p', { class: 'note' },
          `Frivillighetsregisteret since ${regDate ?? 'date unknown'} · Sector ${sector ?? 'n/a'} · NACE ${nace ?? 'n/a'} · ${flagSummary(flags)}`),
        h('p', { class: 'note' },
          h('a', { href: `https://virksomhet.brreg.no/nb/oppslag/enheter/${orgnr}`, rel: 'noopener noreferrer' }, 'Inspect live Brønnøysund record'),
          hasMoms
            ? h('span', {}, ' · ', h('a', { href: `${momsBase}#q=${orgnr}` }, 'Inspect 2023–2025 VAT compensation grants'))
            : ' · No 2023–2025 Momskompensasjon row matched'));
    }

    async function search(value: string): Promise<Result> {
      const cleaned = stripDigits(value);
      const selectedForm = formFilter.value;
      const onlyGrants = momsOnly.checked;
      const matchesFilters = (row: Organization) =>
        (!selectedForm || row[2] === selectedForm) && (!onlyGrants || row[9]);

      if (isOrgnr(cleaned)) {
        const entry = (await loadIds(cleaned.slice(0, 2))).find(([id]) => id === cleaned);
        if (!entry) return { total: 0, organizations: [] };
        const org = (await loadNames(entry[1])).find(([id]) => id === cleaned);
        if (!org) throw new Error('The organization number could not be matched to the shard.');
        return matchesFilters(org) ? { total: 1, organizations: [org] } : { total: 0, organizations: [] };
      }

      const rawNorm = normalizeFinancialName(value);
      const query = foldNorwegian(value);
      if (query.length < 2) throw new Error('Enter at least two characters of a name or an exact nine-digit organization number.');
      const buckets = new Set<string>([bucketFor(rawNorm), bucketFor(query)]);
      if (query[0] === 'o' || query[0] === 'a') buckets.add('other');
      const organizations: Organization[] = [];
      const seen = new Set<string>();
      let total = 0;
      for (const bucket of buckets) {
        for (const row of await loadNames(bucket)) {
          if (seen.has(row[0]) || !matchesFilters(row)) continue;
          if (!foldNorwegian(row[1]).startsWith(query)) continue;
          seen.add(row[0]);
          total++;
          if (organizations.length < limit) organizations.push(row);
        }
      }
      return { total, organizations };
    }

    async function runSearch() {
      const ticket = ++sequence;
      reset();
      submit.disabled = true;
      status.textContent = 'Checking the public Frivillighetsregisteret snapshot.';
      try {
        const matches = await search(input.value);
        if (ticket !== sequence) return;
        found = matches;
        status.textContent = matches.total
          ? `${matches.total.toLocaleString('en-US')} ${matches.total === 1 ? 'match' : 'matches'}. Showing ${matches.organizations.length}.`
          : 'No matching voluntary organization in this snapshot. Try the published Norwegian name or exact nine-digit number.';
        results.append(...matches.organizations.map(card));
        json.disabled = csv.disabled = !matches.organizations.length;
      } catch (error) {
        if (ticket === sequence) status.textContent = error instanceof Error ? error.message : 'The organization search failed.';
      } finally { if (ticket === sequence) submit.disabled = false; }
    }

    formEl.addEventListener('submit', event => { event.preventDefault(); void runSearch(); });
    clear.addEventListener('click', () => {
      sequence++;
      reset();
      submit.disabled = false;
      input.value = '';
      formFilter.value = '';
      momsOnly.checked = false;
      status.textContent = 'Search cleared.';
      input.focus();
    });

    const { format, capturedOn, sourceLastModified, publisher, catalogue, license, source } = manifest;
    json.addEventListener('click', () => {
      if (!found) return;
      download('norway-voluntary-organizations.json', JSON.stringify({
        format, capturedOn, sourceLastModified, publisher, catalogue, license, source,
        total: found.total, organizations: found.organizations.map(toObject),
      }, null, 2) + '\n', 'application/json');
    });
    csv.addEventListener('click', () => {
      if (!found) return;
      const rows = found.organizations.map(row => ({
        ...toObject(row),
        name: financialCsvName(row[1]),
        municipalityName: row[6] ? financialCsvName(row[6]) : '',
        capturedOn, sourceLastModified, publisher, catalogue, license,
        sourceUrl: source.url, sourceSha256: source.sha256,
      }));
      download('norway-voluntary-organizations.csv', '\uFEFF' + toCsv(rows), 'text/csv;charset=utf-8');
    });

    const initial = new URLSearchParams(location.search).get('orgnr') ?? /^#q=([0-9]{9})$/.exec(location.hash)?.[1];
    if (initial && isOrgnr(initial)) {
      input.value = initial;
      void runSearch();
    }
  }
</script>
