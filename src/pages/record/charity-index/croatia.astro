---
import Entry from '../../../layouts/Entry.astro';
import { url } from '../../../lib/site';
import manifest from '../../../../public/data/charity-registry/croatia/manifest.json';
import '../../../styles/charity-financial-search.css';

const title = 'Croatia nonprofit associations & foundations (Registar udruga i zaklada)';
const dataPath = '/data/charity-registry/croatia/';
const count = (value: number) => value.toLocaleString('en-US');

const sources = [
  {
    title: 'Registar udruga Republike Hrvatske — Core & Activity Domains (Otvorena dozvola RH, as of 2026-11-22)',
    publisher: manifest.publisher,
    url: manifest.catalogues.associations,
  },
  {
    title: 'Registar zaklada Republike Hrvatske (Otvorena dozvola RH, as of 2026-11-22)',
    publisher: manifest.publisher,
    url: manifest.catalogues.foundations,
  },
];
---

<Entry
  title={title}
  eyebrow="The Record · Global Charity Index · Croatia"
  summary="Search 71,859 Croatian associations (71,415 Registar udruga) and foundations (444 Registar zaklada) with 68,646 ISO-7064 validated 11-digit OIBs, statutory activity domains, active vs. erased status, and county filters."
  crumbs={[{ label: 'The Record', href: '/record/' }, { label: 'Global Charity Index', href: '/record/charity-index/' }, { label: 'Croatia' }]}
  filePath="src/pages/record/charity-index/croatia.astro"
  sources={sources}
>
  <p>
    This edition joins the official national open-data extracts of Croatia’s <strong>Register of Associations</strong>
    (<em>Registar udruga Republike Hrvatske</em>, <strong>{count(manifest.counts.byForm.association)}</strong> organizations joined with{' '}
    <strong>{count(manifest.counts.activityDomainRowsJoined)}</strong> statutory activity-domain classifications) and{' '}
    <strong>Register of Foundations</strong> (<em>Registar zaklada Republike Hrvatske</em>, <strong>{count(manifest.counts.byForm.foundation)}</strong> foundations),
    published by the Ministry of Justice, Public Administration and Digital Transformation under Croatia’s Open Licence
    (<em>Otvorena dozvola RH</em>, as of <time datetime={manifest.asOf}>{manifest.asOf}</time>, captured{' '}
    <time datetime={manifest.capturedOn}>{manifest.capturedOn}</time>).
  </p>
  <p>
    Across all <strong>{count(manifest.counts.includedOrganizations)}</strong> records, <strong>{count(manifest.counts.byStatus.active)}</strong> are
    currently active (<em>Aktivan</em>), <strong>{count(manifest.counts.byStatus.erased)}</strong> are erased (<em>Brisan</em>), and{' '}
    <strong>{count(manifest.counts.byStatus.ceased)}</strong> have ceased operating (<em>Prestanak djelovanja</em>). Every one of the{' '}
    <strong>{count(manifest.counts.validatedOibs)}</strong> non-blank 11-digit personal/entity identification numbers (<em>OIB</em>) passes
    ISO 7064 Mod 11,10 checksum validation (<code>{manifest.counts.invalidOibs}</code> invalid;{' '}
    <strong>{count(manifest.counts.blankOibs)}</strong> historic records predate Croatia’s 2009 OIB rollout and carry blank OIBs).
  </p>

  <section
    class="charity-financial-search"
    data-croatia-registry
    data-base={url(dataPath)}
    data-manifest={JSON.stringify(manifest)}
    aria-labelledby="hr-search-heading"
  >
    <h2 id="hr-search-heading">Search Croatian associations and foundations</h2>
    <p id="hr-search-hint">
      Enter the beginning of an organization’s name (Croatian diacritics optional, e.g., <code>hrvatski crveni kriz</code>, <code>crveni kriz</code>,
      <code>zaklada solidarna</code>, <code>gong</code>, or <code>roda</code>), an 11-digit OIB (e.g., <code>42128339233</code>), or an 8-digit
      registration number. Search loads one compressed shard locally in your browser.
    </p>
    <form aria-describedby="hr-search-hint">
      <label for="hr-query">Organization name, 11-digit OIB, or registration number</label>
      <div class="finance-actions">
        <input type="search" id="hr-query" maxlength="160" autocomplete="off" disabled />
        <span class="inline-field">
          <label for="hr-form">Legal form</label>
          <select id="hr-form" disabled>
            <option value="">All legal forms ({count(manifest.counts.includedOrganizations)})</option>
            <option value="association">Associations / Udruge ({count(manifest.counts.byForm.association)})</option>
            <option value="foundation">Foundations / Zaklade ({count(manifest.counts.byForm.foundation)})</option>
          </select>
        </span>
        <span class="inline-field">
          <label for="hr-status">Status</label>
          <select id="hr-status" disabled>
            <option value="">All statuses ({count(manifest.counts.includedOrganizations)})</option>
            <option value="active">Active / Aktivan ({count(manifest.counts.byStatus.active)})</option>
            <option value="erased">Erased / Brisan ({count(manifest.counts.byStatus.erased)})</option>
            <option value="ceased">Ceased / Prestanak ({count(manifest.counts.byStatus.ceased)})</option>
          </select>
        </span>
        <span class="inline-field">
          <label for="hr-county">County (associations)</label>
          <select id="hr-county" disabled>
            <option value="">All counties / cities</option>
            {
              manifest.counties.map((item) => (
                <option value={item.county}>
                  {item.county} ({count(item.associations)})
                </option>
              ))
            }
          </select>
        </span>
        <button type="submit" class="btn" disabled>Search organizations</button>
        <button type="button" class="btn btn-ghost" data-clear disabled>Clear</button>
      </div>
    </form>
    <p role="status" data-status>Search when you are ready to load a Croatia registry shard.</p>
    <div class="finance-actions">
      <button type="button" class="btn btn-ghost btn-small" data-json disabled>Export displayed results as JSON</button>
      <button type="button" class="btn btn-ghost btn-small" data-csv disabled>Export displayed results as CSV</button>
    </div>
    <ol class="finance-results" data-site-symbol="adriaticCheck" aria-label="Croatia nonprofit registry results" data-results></ol>
    <noscript>
      <p>
        Without JavaScript, inspect the official bulk JSON extracts directly on{' '}
        <a href={manifest.catalogues.associations}>data.gov.hr (Registar udruga)</a> and{' '}
        <a href={manifest.catalogues.foundations}>data.gov.hr (Registar zaklada)</a>.
      </p>
    </noscript>
  </section>

  <h2 id="domains">Statutory activity domains across Croatian associations</h2>
  <p>
    Every association in <em>Registar udruga</em> declares one or more statutory areas of activity (<em>Područja djelovanja</em>;{' '}
    <strong>{count(manifest.counts.associationsWithActivityDomains)}</strong> of {count(manifest.counts.byForm.association)} associations carry
    joined domain classifications). Associations may declare multiple domains, so domain counts overlap across organizations.
  </p>
  <div class="table-wrap" role="region" aria-label="Top 15 statutory activity domains across Croatian associations" tabindex="0">
    <table class="data hr-table">
      <caption>Top 15 statutory activity domains across Croatian registered associations (as of {manifest.asOf})</caption>
      <thead>
        <tr>
          <th scope="col">Statutory domain (Croatian source code)</th>
          <th scope="col">English label</th>
          <th scope="col">Associations</th>
        </tr>
      </thead>
      <tbody>
        {
          manifest.topDomains.map((d) => (
            <tr>
              <th scope="row"><span lang="hr">{d.raw}</span></th>
              <td>{d.labelEn}</td>
              <td>{count(d.associations)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="coverage">Scope, ISO-7064 OIB validation, anomalies and privacy boundaries</h2>
  <p>
    <strong>What is included vs. excluded:</strong> This edition combines Croatia’s two national nonprofit legal-entity registers
    (associations under the Associations Act and foundations under the Foundations Act), including historical erased and ceased records so
    donors and researchers can verify whether an organization’s status ended. Financial statements filed separately in the Ministry of Finance’s
    <em>Registar neprofitnih organizacija (RNO)</em> and personal officeholder records (<em>Osobe ovlaštene za zastupanje</em>) are outside this
    register capture.
  </p>
  <p>
    <strong>Privacy projection &amp; verbatim anomalies:</strong> Email addresses (<code>MAIL</code>) and street-level registered addresses
    are stripped at build time, retaining only county names (<em>Županija</em>) for associations and city names for foundations; the separate
    personal-names extract is never ingested. One duplicate OIB group (<code>44698834525</code>, assigned to two erased Split associations in the
    upstream Ministry extract) and {count(manifest.counts.blankOibs)} blank legacy OIBs are preserved verbatim without silent merging in{' '}
    <a class="identity-link" data-source-symbol="document" href={url(dataPath + manifest.anomalies.path)} download>anomalies.json</a> ·{' '}
    <a class="identity-link" data-source-symbol="document" href={url(dataPath + 'manifest.json')} download>Download SHA-256 manifest (JSON)</a> ·{' '}
    <a href={url('/record/charity-index/coverage/')}>Read the Index coverage</a>.
  </p>
</Entry>

<style>
  .hr-table {
    min-inline-size: 40rem;
  }
  [data-croatia-registry] .inline-field {
    max-inline-size: 100%;
    min-inline-size: 0;
    flex-wrap: wrap;
  }
  [data-croatia-registry] select {
    max-inline-size: 100%;
    min-inline-size: 0;
  }
</style>

<script>
  import { $, h } from '../../../lib/client/dom';
  import { download, toCsv } from '../../../lib/client/files';
  import { financialCsvName, financialShardLoader, type FinancialShard } from '../../../lib/client/financial-directory';

  type HrRow = {
    id: string;
    oib: string | null;
    form: 'association' | 'foundation';
    name: string;
    short: string | null;
    norm: string;
    status: 'active' | 'erased' | 'ceased' | 'other';
    county: string;
    regDate: string | null;
    statusDate: string | null;
    domains: string[];
    web: string | null;
  };
  type HrManifest = {
    publisher: string;
    asOf: string;
    shards: {
      names: Record<string, FinancialShard>;
      ids: Record<string, FinancialShard>;
    };
  };

  const foldHr = (text: string) =>
    text
      .replace(/[Đđ]/g, 'd')
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  const bucketFor = (norm: string) => {
    const first = norm[0] ?? '';
    return first >= 'a' && first <= 'z' ? first : '0-9';
  };

  const statusLabel: Record<string, string> = {
    active: 'Active (Aktivan)',
    erased: 'Erased (Brisan)',
    ceased: 'Ceased (Prestanak)',
    other: 'Other',
  };
  const formLabel: Record<string, string> = {
    association: 'Association (Udruga)',
    foundation: 'Foundation (Zaklada)',
  };
  const limit = 35;

  for (const root of document.querySelectorAll<HTMLElement>('[data-croatia-registry]')) {
    const manifest: HrManifest = JSON.parse(root.dataset.manifest!);
    const base = root.dataset.base!;
    const loadNameShard = financialShardLoader<HrRow>(base, manifest.shards.names);
    const loadIdShard = financialShardLoader<HrRow>(base, manifest.shards.ids);

    const form = $('form', root) as HTMLFormElement;
    const queryEl = $('#hr-query', root) as HTMLInputElement;
    const formSel = $('#hr-form', root) as HTMLSelectElement;
    const statusSel = $('#hr-status', root) as HTMLSelectElement;
    const countySel = $('#hr-county', root) as HTMLSelectElement;
    const statusEl = $('[data-status]', root);
    const listEl = $('[data-results]', root);
    const clearBtn = $('[data-clear]', root) as HTMLButtonElement;
    const jsonBtn = $('[data-json]', root) as HTMLButtonElement;
    const csvBtn = $('[data-csv]', root) as HTMLButtonElement;
    const submitBtn = $('button[type="submit"]', root) as HTMLButtonElement;

    for (const el of [queryEl, formSel, statusSel, countySel, submitBtn, clearBtn]) el.disabled = false;
    let shown: HrRow[] = [];

    const render = (rows: HrRow[], total: number, q: string) => {
      shown = rows;
      listEl.replaceChildren();
      jsonBtn.disabled = rows.length === 0;
      csvBtn.disabled = rows.length === 0;
      if (!rows.length) {
        statusEl.textContent = q
          ? `No Croatian nonprofits matched “${q}” under the selected filters.`
          : 'No Croatian nonprofits matched the selected filters.';
        return;
      }
      statusEl.textContent =
        total > rows.length
          ? `Showing the first ${rows.length} of ${total.toLocaleString('en-US')} matching organizations.`
          : `Showing ${total.toLocaleString('en-US')} matching organization${total === 1 ? '' : 's'}.`;

      for (const r of rows) {
        const metaParts = [
          formLabel[r.form] ?? r.form,
          statusLabel[r.status] ?? r.status,
          r.county || null,
          r.regDate ? `Registered ${r.regDate}` : null,
          r.status !== 'active' && r.statusDate ? `Status date ${r.statusDate}` : null,
        ].filter(Boolean);

        listEl.append(
          h(
            'li',
            {},
            h('strong', { lang: 'hr' }, r.name),
            r.short && r.short !== r.name ? ` (${r.short})` : null,
            ' ',
            h('code', {}, r.oib ? `OIB ${r.oib}` : `Reg ${r.id}`),
            r.oib ? ' ' : null,
            r.oib ? h('span', { class: 'note' }, `Reg #${r.id}`) : null,
            h('div', { class: 'note' }, metaParts.join(' · ')),
            r.domains.length ? h('div', { class: 'note' }, `Domains: ${r.domains.join('; ')}`) : null,
            r.web
              ? h('div', { class: 'note' }, 'Website: ', h('a', { href: r.web, rel: 'noopener noreferrer' }, r.web))
              : null,
          ),
        );
      }
    };

    const runSearch = async () => {
      const rawQ = queryEl.value.trim();
      const formVal = formSel.value;
      const statusVal = statusSel.value;
      const countyVal = countySel.value;

      if (!rawQ) {
        if (formVal === 'foundation') {
          // Allow browsing all 444 foundations directly by loading shards that contain foundations
          statusEl.textContent = 'Loading Croatian foundations…';
          try {
            const keys = Object.keys(manifest.shards.names);
            const chunks = await Promise.all(keys.map((k) => loadNameShard(k)));
            const allFoundations = chunks.flat().filter((r) => {
              if (r.form !== 'foundation') return false;
              if (statusVal && r.status !== statusVal) return false;
              if (countyVal && r.county !== countyVal) return false;
              return true;
            });
            allFoundations.sort((a, b) => (a.status === 'active' ? 0 : 1) - (b.status === 'active' ? 0 : 1) || a.name.localeCompare(b.name, 'hr'));
            render(allFoundations.slice(0, limit), allFoundations.length, 'Foundations');
          } catch (err) {
            statusEl.textContent = err instanceof Error ? err.message : 'Could not load Croatia registry shards.';
          }
          return;
        }
        statusEl.textContent = 'Enter the beginning of an organization name, an 11-digit OIB, or a registration number (or select Foundations to browse all 444).';
        return;
      }

      const digits = rawQ.replace(/[^0-9]/g, '');
      const isId = digits.length >= 6 && /^\d+$/.test(rawQ.replace(/[\s-]/g, ''));
      const normQ = foldHr(rawQ);

      statusEl.textContent = 'Loading Croatia registry shard…';
      try {
        let rows: HrRow[];
        if (isId) {
          const prefix = digits.slice(0, 2);
          const shardRows = manifest.shards.ids[prefix] ? await loadIdShard(prefix) : [];
          rows = shardRows.filter((r) => r.oib === digits || r.id === digits);
        } else {
          const bkt = bucketFor(normQ);
          rows = (await loadNameShard(bkt)).filter((r) => r.norm.startsWith(normQ) || r.norm.includes(normQ));
        }
        const filtered = rows.filter((r) => {
          if (formVal && r.form !== formVal) return false;
          if (statusVal && r.status !== statusVal) return false;
          if (countyVal && r.county !== countyVal) return false;
          return true;
        });
        filtered.sort((a, b) => {
          const aExact = a.norm.startsWith(normQ) ? 0 : 1;
          const bExact = b.norm.startsWith(normQ) ? 0 : 1;
          const aAct = a.status === 'active' ? 0 : 1;
          const bAct = b.status === 'active' ? 0 : 1;
          return aAct - bAct || aExact - bExact || a.name.localeCompare(b.name, 'hr');
        });
        render(filtered.slice(0, limit), filtered.length, rawQ);
      } catch (err) {
        statusEl.textContent = err instanceof Error ? err.message : 'Could not load Croatia registry shard.';
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void runSearch();
    });
    for (const el of [formSel, statusSel, countySel]) {
      el.addEventListener('change', () => {
        if (queryEl.value.trim() || formSel.value === 'foundation') void runSearch();
      });
    }
    clearBtn.addEventListener('click', () => {
      queryEl.value = '';
      formSel.value = '';
      statusSel.value = '';
      countySel.value = '';
      shown = [];
      listEl.replaceChildren();
      jsonBtn.disabled = true;
      csvBtn.disabled = true;
      statusEl.textContent = 'Search cleared.';
      queryEl.focus();
    });
    jsonBtn.addEventListener('click', () => {
      if (!shown.length) return;
      download(
        'charitology-croatia-nonprofits.json',
        JSON.stringify({ source: manifest.publisher, asOf: manifest.asOf, rows: shown }, null, 2),
        'application/json;charset=utf-8',
      );
    });
    csvBtn.addEventListener('click', () => {
      if (!shown.length) return;
      const csvText = toCsv(
        shown.map((r) => ({
          reg_number: r.id,
          oib: r.oib ?? '',
          legal_form: r.form,
          name: financialCsvName(r.name),
          short_name: financialCsvName(r.short ?? ''),
          status: r.status,
          county_or_city: r.county,
          registered_date: r.regDate ?? '',
          status_date: r.statusDate ?? '',
          domains: financialCsvName(r.domains.join('; ')),
          website: r.web ?? '',
        })),
      );
      download('charitology-croatia-nonprofits.csv', '\uFEFF' + csvText, 'text/csv;charset=utf-8');
    });
  }
</script>
