---
import Entry from '../../../layouts/Entry.astro';
import { url } from '../../../lib/site';
import PageSections from '../../../components/PageSections.astro';
import SiteSymbol from '../../../components/SiteSymbol.astro';
import { pageIdentity } from '../../../lib/site-identities';
import australia from '../../../../public/data/charity-financials/manifest.json';
import canada from '../../../../public/data/charity-financials/ca/manifest.json';
import englandWales from '../../../../public/data/charity-financials/ew/manifest.json';
import scotland from '../../../../public/data/charity-financials/scotland/manifest.json';
import france from '../../../../public/data/charity-financials/fr-dila/manifest.json';
import usa from '../../../../public/data/charity-financials/us/manifest.json';
import usaShort from '../../../../public/data/charity-financials/us-990-ez/manifest.json';
import usaFoundation from '../../../../public/data/charity-financials/us-990-pf/manifest.json';
import registry from '../../../../public/data/irs-registry/manifest.json';
import japan from '../../../../public/data/charity-registry/japan-npo/manifest.json';
import israel from '../../../../public/data/charity-registry/israel/manifest.json';
import newZealand from '../../../../public/data/charity-registry/new-zealand/manifest.json';
import netherlands from '../../../../public/data/charity-registry/netherlands/manifest.json';
import norway from '../../../../public/data/charity-registry/norway/manifest.json';
import poland from '../../../../public/data/charity-registry/poland/manifest.json';
import taiwan from '../../../../public/data/charity-registry/taiwan/manifest.json';
import brazil from '../../../../public/data/charity-registry/brazil-osc/manifest.json';
import mexico from '../../../../public/data/charity-financials/mx/manifest.json';
import manchester from '../../../data/home-from-hospital.json';

const title = 'Charity Index coverage';
const number = (value: number) => value.toLocaleString('en-US');
const australianPeriods = australia.sources.reduce((sum, source) => sum + source.includedPeriods, 0);
const panels = [
  {
    id: 'australia', name: 'Australia', source: 'Annual Information Statements', route: '/record/charity-financials/',
    label: 'Search Australian filings', date: australia.date,
    coverage: `${number(australia.organizations)} ABNs and ${number(australianPeriods)} dated records in the selected extracts.`,
    history: `${number(australia.organizationsWithBothYears)} ABNs have dated reporting in both source years, 2023 and 2024.`,
    boundary: 'The 2024 extract sets the identity scope. Earlier unmatched and undated records are left out. The grant fields distinguish money for use inside and outside Australia.',
    manifest: '/data/charity-financials/manifest.json',
  },
  {
    id: 'brazil', name: 'Brazil', source: 'Ipea and Transferegov', route: '/record/charity-index/brazil/',
    label: 'Compare Brazil registry and transfer records', date: brazil.source.accessedOn,
    coverage: `The Brazil registry comparison finds one exact CNPJ match in Ipea for ${number(brazil.coverage.exact.identifiers)} of ${number(brazil.transfers.identifiers)} registration numbers in the federal transfer edition.`,
    history: 'The August 2026 registry snapshot appears alongside separate 2024 and 2025 bank-order periods.',
    manifest: '/data/charity-registry/brazil-osc/manifest.json',
  },
  {
    id: 'canada', name: 'Canada', source: 'Canada Revenue Agency T3010', route: '/record/charity-financials/canada/',
    label: 'Search Canadian financial filings', date: canada.capturedOn,
    coverage: `${number(canada.accounts)} charity accounts with a dated financial record in the two extracts.`,
    history: `${number(canada.financialPeriods)} periods ending in 2023 or 2024. ${number(canada.multiYearAccounts)} accounts have records in both years.`,
    boundary: 'Income, expenditure, gifts and grants are reported in CAD. Returns keep their accounting basis, fiscal period and original records.',
    manifest: '/data/charity-financials/ca/manifest.json',
  },
  {
    id: 'england-wales', name: 'England and Wales', source: 'Charity Commission annual returns', route: '/record/charity-financials/england-wales/',
    label: 'Search England and Wales returns', date: englandWales.date,
    coverage: `${number(englandWales.organizations)} of ${number(englandWales.registeredMain)} main registered charities with eligible records.`,
    history: `${number(englandWales.counts.included)} received annual returns for periods ending in 2023–2025. ${number(englandWales.multiPeriod)} charities have multiple periods.`,
    boundary: 'The figures are gross income and expenditure in GBP. Linked, suppressed and unreceived records are outside the included scope.',
    manifest: '/data/charity-financials/ew/manifest.json',
  },
  {
    id: 'france', name: 'France', source: 'DILA published annual account notices', route: '/record/charity-financials/france/',
    label: 'Search French annual account notices', date: france.capturedOn,
    coverage: `${number(france.counts.notices)} notices for fiscal closings from 2022 to 2025. ${number(france.counts.candidateSirens)} distinct identifiers pass the format checks.`,
    history: `${number(france.counts.multiPeriodCandidateSirens)} candidate identifiers have filings for more than one fiscal closing date.`,
    boundary: 'Originals and corrected versions remain searchable. The capture covers published filing notices. It cannot measure the size of the association sector.',
    manifest: '/data/charity-financials/fr-dila/manifest.json',
  },
  {
    id: 'israel', name: 'Israel', source: 'Ministry of Justice Amutot, Public Benefit Companies and Proper Management', route: '/record/charity-index/israel/',
    label: 'Search Israeli nonprofits and Proper Management', date: israel.capturedOn,
    coverage: `${number(israel.counts.includedOrganizations)} merged registered associations and public benefit companies (${number(israel.counts.byStatus.active)} active, ${number(israel.counts.withReportedRevenue)} with reported annual revenue, ${number(israel.counts.withProperManagement2026Or2027)} with signed 2026–2027 Proper Management).`,
    history: 'A paired funding-flows edition covers 15 years (2012–2026) of statutory quarterly foreign-state donation disclosures across 516 recipients totaling ILS 7.53 billion net.',
    boundary: 'Unreported expense cells default to 0 in the source export and stay shown as not reported. Two production software test IDs inside the live foreign-state donations table remain flagged in anomalies.json.',
    manifest: '/data/charity-registry/israel/manifest.json',
  },
  {
    id: 'japan', name: 'Japan', source: 'Cabinet Office NPO Portal', route: '/record/charity-index/japan/',
    label: 'Search Japan NPO Portal records', date: japan.capturedOn,
    coverage: `${number(japan.counts.portalRows)} dated portal entries across ${number(japan.authorities.length)} supervising authorities.`,
    history: `${number(japan.counts.financialSummaries)} entries link to a dated organization-entered financial summary.`,
    boundary: 'The portal includes dissolution records. Corporate numbers can be repeated, and the reported financial figures cover only matched records.',
    manifest: '/data/charity-registry/japan-npo/manifest.json',
  },
  {
    id: 'kenya', name: 'Kenya', source: 'Public Benefit Organizations Regulatory Authority', route: '/record/charity-financials/kenya/',
    label: 'Compare Kenya’s sector reports',
    coverage: 'The Kenya edition compares aggregate filing counts and receipts across three regulator reports, with a spending breakdown for the latest report year.',
    boundary: 'The regulator’s live register supplies organization names and references.',
  },
  {
    id: 'mexico', name: 'Mexico', source: 'SAT financial reports and authorization directories', route: '/record/charity-financials/mexico/',
    label: 'Search Mexico’s charity financial reports', date: mexico.capturedOn,
    coverage: `${number(mexico.coverage.identities)} exact institutional RFCs across three financial reports and two directories.`,
    history: `${number(mexico.coverage.financialPeriods)} fiscal-year records from 2023–2025. ${number(mexico.coverage.exactPeriodHistories['3'])} RFCs appear in all three.`,
    boundary: 'Amounts stay in MXN. Financial periods and dated directory entries describe different observations. The edition covers SAT’s authorized-entity publications.',
    manifest: '/data/charity-financials/mx/manifest.json',
  },
  {
    id: 'netherlands', name: 'Netherlands', source: 'Belastingdienst ANBI register and Rijksfinanciën subsidies', route: '/record/charity-index/netherlands/',
    label: 'Search Dutch ANBI public benefit organizations', date: netherlands.capturedOn,
    coverage: `${number(netherlands.counts.distinctOrganizations)} distinct nine-digit RSIN organizations (${number(netherlands.counts.activeOrganizations)} active, ${number(netherlands.counts.revokedOrEndedOrganizations)} revoked or ended, ${number(netherlands.counts.culturalActiveOrganizations)} active Cultural ANBIs).`,
    history: 'A paired funding-flows edition covers 17,868 nonprofit recipients across five budget years (2020–2024) of central-government subsidies totaling EUR 15,540,383k net.',
    boundary: 'Belastingdienst uses RSIN while Rijksfinanciën uses KvK-nummer with no free public crosswalk, so subsidy links stay labeled as unverified name candidates and statutory Bekostiging block funding (EUR 70.88B) stays separate.',
    manifest: '/data/charity-registry/netherlands/manifest.json',
  },
  {
    id: 'new-zealand', name: 'New Zealand', source: 'Charities Services register and Tier 3 filings', route: '/record/charity-index/new-zealand/',
    label: 'Search New Zealand charities and Tier 3 filings', date: newZealand.capturedAt.slice(0, 10),
    coverage: `${number(newZealand.registry.included)} searchable organization entries, including deregistered and removed entries.`,
    history: `${number(newZealand.registry.withBothYears)} entries have selected Tier 3 returns for periods ending in both 2024 and 2025.`,
    boundary: 'The financial selection covers individual Tier 3 returns. Currency follows the reporting standard where the source field is blank.',
    manifest: '/data/charity-registry/new-zealand/manifest.json',
  },
  {
    id: 'norway', name: 'Norway', source: 'Brønnøysundregistrene Frivillighetsregisteret and Lottstift Momskompensasjon', route: '/record/charity-index/norway/',
    label: 'Search Norwegian voluntary organizations', date: norway.capturedOn,
    coverage: `${number(norway.counts.includedOrganizations)} voluntary organizations with validated nine-digit organization numbers, including ${number(norway.counts.matchedMomskompensasjon2023to2025)} matched to 2023–2025 VAT compensation grants.`,
    history: 'A paired funding-flows edition spans three grant years (2023–2025), two 2025 disbursement tranches and 264 central umbrella intermediaries.',
    boundary: 'Public annual accounts in Regnskapsregisteret return an unsupported chart-of-accounts error (IDEELL) for nonprofits, so grant disclosures stay separate from audited accounts.',
    manifest: '/data/charity-registry/norway/manifest.json',
  },
  {
    id: 'poland', name: 'Poland', source: 'NIW-CRSO Public Benefit Organizations (OPP) and Ministry of Finance 1.5% PIT', route: '/record/charity-index/poland/',
    label: 'Search Polish public benefit organizations', date: poland.capturedOn,
    coverage: `${number(poland.counts.includedOrganizations)} distinct 10-digit KRS organizations across 2023–2025 NIW eligibility registers (${number(poland.counts.eligible2025)} eligible for 2025/2026; ${number(poland.counts.withValidatedNip)} with mod-11 validated NIPs).`,
    history: 'A paired funding-flows edition covers four years of 1.5% PIT tax designations (2022–2025, paid 2023–2026) totaling PLN 8.32 billion across 10,395 funded OPPs with disclosed taxpayer counts.',
    boundary: 'OPP status covers statutory 1.5%-eligible charities rather than all Polish associations. Top-10 concentration (45.69% in 2025) reflects sub-account (cel szczegółowy) intermediaries; taxpayer counts omit OPPs below 0.1k taxpayers.',
    manifest: '/data/charity-registry/poland/manifest.json',
  },
  {
    id: 'scotland', name: 'Scotland', source: 'Scottish Charity Regulator register and annual returns', route: '/record/charity-financials/scotland/',
    label: 'Search Scottish registrations and returns', date: scotland.date,
    coverage: `${number(scotland.identities)} searchable registration numbers, including ${number(scotland.withReturns)} with an included return.`,
    history: `${number(scotland.counts.included)} dated returns in GBP. ${number(scotland.multiPeriod)} registrations have multiple periods.`,
    boundary: 'The period start is unavailable. Three confirmed cross-register matches show where the regulators agree and where their figures or receipt dates differ.',
    manifest: '/data/charity-financials/scotland/manifest.json',
  },
  {
    id: 'taiwan', name: 'Taiwan', source: 'Ministry of Finance institutional registrations', route: '/record/charity-index/taiwan/',
    label: 'Search Taiwan institutional registrations', date: taiwan.capturedOn,
    coverage: `${number(taiwan.counts.includedIdentities)} exact institutional withholding-unit numbers with published names.`,
    history: 'A separate Fund edition follows reported execution for projects across two reporting years.',
    boundary: 'Registration location and a tax change code describe the filed identity. Active charity status and where services happened require other evidence.',
    manifest: '/data/charity-registry/taiwan/manifest.json',
  },
  {
    id: 'united-states', name: 'United States', source: 'IRS identity and Form 990 extracts', route: '/record/charity-financials/united-states/',
    label: 'Search U.S. Form 990 finances', date: usa.capturedOn,
    coverage: `${number(registry.recordCount)} dated federal registry identities. Separately, ${number(usa.counts.organizations)} EINs have a selected full Form 990 period.`,
    history: `${number(usa.counts.includedPeriods)} processed financial records for periods ending in 2022–2024. ${number(usa.counts.multiPeriod)} EINs have multiple periods.`,
    boundary: 'The full-form financial edition covers subsection 03. The other U.S. editions below use their own extract populations.',
    manifest: '/data/charity-financials/us/manifest.json',
  },
].map(panel => ({ ...panel, ...pageIdentity(panel.route) }));
const sources = [
  { title: 'Download charity register data', publisher: 'Australian Charities and Not-for-profits Commission', url: 'https://www.acnc.gov.au/charity/about-charity-register/download-charity-register-data' },
  { title: '2024 List of charities', publisher: canada.publisher, url: canada.editions['2024'].catalogue },
  { title: 'Full register download', publisher: 'Charity Commission for England and Wales', url: 'https://register-of-charities.charitycommission.gov.uk/en/register/full-register-download' },
  { title: 'Scottish register and annual return downloads', publisher: scotland.sources.register.publisher, url: scotland.catalogue },
  { title: 'French association accounts dataset', publisher: france.source.publisher, url: france.source.dataset },
  { title: 'Registry of Associations and Public Benefit Companies (moj-amutot)', publisher: israel.publisher, url: israel.catalogue },
  { title: 'Open data — Algemeen Nut Beogende Instellingen (ANBI)', publisher: netherlands.publisher, url: netherlands.catalogue },
  { title: 'Frivillighetsregisteret dataset listing', publisher: norway.publisher, url: norway.catalogue },
  { title: 'Wykaz OPP uprawnionych do 1,5% PIT za 2025 r.', publisher: 'NIW-CRSO (dane.gov.pl)', url: poland.catalogues.niw2025 },
  { title: 'Taiwan nonprofit institution and organization dataset', publisher: taiwan.publisher, url: taiwan.catalogue },
  { title: 'National NPO Portal bulk downloads', publisher: japan.publisher, url: japan.portal + 'download/all' },
  { title: 'Annual extract of tax-exempt organization financial data', publisher: 'Internal Revenue Service', url: usa.sourcePage },
];
---

<Entry title={title} eyebrow="The Record · Global Charity Index" summary="See which organizations, financial periods and funding stages each source covers." crumbs={[{label:'The Record',href:'/record/'},{label:'Global Charity Index',href:'/record/charity-index/'},{label:'Coverage'}]} sources={sources}>
  <p>The Index separates registry identities, reported financial periods and individual funding records. This page describes the current editions and where each one leaves questions open. Coverage counts describe the included source records. Organization identities, currencies and reporting rules differ across jurisdictions.</p>
  <h2 id="filings">Registry and financial editions</h2>
  <PageSections label="Jump to a jurisdiction" sections={panels.map(({ id, name, symbol }) => ({ slug: id, text: name, symbol }))} />
  <ul class="coverage-list" aria-labelledby="filings" role="list">
    {panels.map(panel => <li class="card" id={panel.id} data-site-tone={panel.tone}>
      <h3 class="identity-label"><SiteSymbol name={panel.symbol} />{panel.name}</h3>
      <p class="eyebrow">{panel.source}</p>
      <p><strong>{panel.coverage}</strong></p>
      {panel.history && <p>{panel.history}</p>}
      {panel.boundary && <p>{panel.boundary}</p>}
      {panel.date && <p class="note">Captured on <time datetime={panel.date}>{panel.date}</time>.</p>}
      <p class="coverage-links">
        <a class="identity-link" href={url(panel.route)}>{panel.label}</a>
        {panel.manifest && <a class="identity-link" data-source-symbol="document" href={url(panel.manifest)}>Source and coverage manifest</a>}
      </p>
    </li>)}
  </ul>
  <h3>Additional United States financial editions</h3>
  <ul>
    {[usaShort, usaFoundation].map(manifest => <li>
      <a href={url(`/record/charity-financials/united-states/${manifest.form.toLowerCase()}/`)}>Form {manifest.form}</a> covers {number(manifest.counts.includedPeriods)} periods for {number(manifest.counts.organizations)} EINs.
      {' '}{number(manifest.counts.multiPeriod)} EINs have more than one period.
    </li>)}
  </ul>
  <p>The same EIN can appear in different form editions. These counts describe each edition separately.</p>
  <h2 id="funding">Where money goes</h2>
  <p><a class="identity-link" href={url('/record/funding-flows/')}>Browse all funding-flow searches and cases</a>.</p>
  <p><a href={url('/record/funding-flows/canada-qualified-donees/')}>Trace gifts reported by Canadian charities</a> by filer or recipient account. The lookup links original CRA worksheet records to dated filer financial returns and keeps differences between worksheet and annual return totals visible.</p>
  <p><a href={url('/record/funding-flows/canada-grant-geography/')}>Explore where Canadian charities reported grant activities</a> by country and see how much of the reported amount remains unallocated.</p>
  <p>The <a href={url('/record/funding-flows/brazil-transferegov/')}>Brazil federal transfer edition</a> joins official proposals, agreements and bank orders by their source identifiers. It covers two calendar years of selected orders. Where the work happened requires separate evidence.</p>
  <p>The <a href={url('/record/funding-flows/brazil-planned-geography/')}>planned-location lookup</a> joins work-plan goals to those Brazilian agreements. It shows which goals link to an IBGE municipality and where locations remain unknown.</p>
  <p>The <a class="identity-link" href={url('/record/funding-flows/brazil-project-execution/')}>infrastructure project directory</a> links paired budget commitments to Obrasgov. It compares work-plan and registered locations, tracks reported physical progress and keeps bank orders in their own stage.</p>
  <p>The <a class="identity-link" href={url('/record/funding-flows/brazil-project-contracts/')}>infrastructure contract lookup</a> pairs CIPI, SICONV contract and procurement records. It preserves repeated source rows and uses a separate amount for each matched contract.</p>
  <p>The <a class="identity-link" href={url('/record/funding-flows/brazil-works-measurements/')}>works monitoring lookup</a> connects measurement periods and accumulated work-item values to the original proposals. The measurement and procurement identifiers stay in their separate source systems.</p>
  <p>The <a class="identity-link" href={url('/record/funding-flows/brazil-infrastructure-account-movements/')}>infrastructure account movement lookup</a> shows institutional payments and holder transfers by agreement and year. Onward counts flag the transfers with missing amounts.</p>
  <p>The <a class="identity-link" href={url('/record/funding-flows/brazil-infrastructure-invoice-items/')}>infrastructure invoice item comparison</a> links the institutional payments to expense documents by their published IDs. It preserves gross item amounts and reported payments as separate figures.</p>
  <p>The <a class="identity-link" href={url('/record/funding-flows/brazil-infrastructure-procurement-payments/')}>infrastructure procurement payments lookup</a> connects the same institutional payments to procurements and the subset with verified contracts.</p>
  <p>The <a class="identity-link" href={url('/record/funding-flows/brazil-infrastructure-work-lots/')}>infrastructure contract lots lookup</a> follows CIPI-linked contracts to planned subgoals and recorded start authorizations.</p>
  <p>The <a class="identity-link" href={url('/record/funding-flows/brazil-infrastructure-procurement-lots/')}>procurement and works-lot comparison</a> connects paid procurements to work packages through their shared IDs. The Joaçaba case links two signed contracts to the clinic and includes an independent census baseline for its referral area.</p>
  <p>The <a class="identity-link" href={url('/record/funding-flows/brazil-infrastructure-procurement-lots/joacaba-outpatient/')}>Joaçaba outpatient records</a> show approved procedure units by facility and reporting month, and compare selected hearing-care codes with the signed annex.</p>
  <p>The <a href={url('/record/funding-flows/brazil-solidarity-kitchens/account-payments/')}>solidarity kitchens payment trace</a> matches reported movements to the selected agreements. It follows internal transfer IDs to onward records and shows which amounts are missing.</p>
  <p>The <a href={url('/record/funding-flows/brazil-cisterns/')}>Cisternas case</a> follows one agreement to reported payments for two named organizations. It compares tender locations with two 2022 census measures and includes one operator-reported delivery.</p>
  <p>The <a href={url('/record/funding-flows/greater-manchester-home-from-hospital/')}>Greater Manchester discharge-support case</a> connects {manchester.awards.length} reported awards to a delivery period and shows independent NHS discharge figures from the same place. The source does not establish a matching payment or expense for each award. Follow the <a href={url('/record/gap-map/')}>Gap Map</a> for more comparisons between funding and need.</p>
  <p>The <a href={url('/record/funding-flows/yes-i-do-alliance/')}>Yes I Do Alliance trace</a> compares reported disbursements and receipts across six publisher activities. The same reported amount can appear at more than one stage. Candidate matches and unresolved rows are shown separately.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/western-cape-transfers/')}>Follow nonprofit funding in Western Cape, South Africa</a>. Two provincial editions show separate transfer and reported spending columns, including discrepancies in the earlier published totals.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/taiwan-municipal-assistance/')}>Follow Taiwan municipal assistance grants</a>. Compare the audit, disclosure files and separately measured access barriers.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/chile-residential-care/')}>Trace residential care funding in Chile</a>. Read the scope of the public donee register and compare four different ways of reporting the same foundation’s finances.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/chile-residential-payments/')}>Compare Chile’s residence awards with the public budget ledger</a>. Search by institutional tax ID, inspect recorded payment dates and compare reported service counts with separate survey estimates for 16 regions.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/chile-coanil-agreements/')}>Trace COANIL’s agreements, accounts and reported payments</a>. The case retains the institutional ID and both sources where payment reports differ.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/france-emmaus-solidarite/')}>Follow regional grants to Emmaüs Solidarité in France</a>. The case connects one French association’s register and four filings to five regional decisions and payment rows. The winter plans and independently counted need retain their own dates and boundaries.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/israel-foreign-state-donations/')}>Search Israel’s 2012–2026 foreign-state entity donation disclosures</a>. Follow 516 recipients across 13,436 quarterly disclosures totaling ILS 7.53 billion net, joined by exact nine-digit ID to the Amutot/PBC registry with published source anomalies kept transparent.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/netherlands-rijksfinancien/')}>Search Netherlands central-government nonprofit subsidies (2020–2024)</a>. Follow 17,868 KvK-identified foundations, associations and religious bodies across 16 budget chapters totaling EUR 15,540,383k net, with conservative ANBI name-candidate links kept distinct from statutory ID joins.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/norway-momskompensasjon/')}>Search Norway’s 2023–2025 VAT compensation grants (Momskompensasjon)</a>. Follow 28,011 distinct voluntary organizations, 264 central umbrella intermediaries and a krone-level reconciliation between 2025 approvals and two-tranche payouts.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/poland-pit-1-5-percent/')}>Search Poland’s 2022–2025 1.5% personal income tax designations</a>. Follow 10,395 funded public benefit organizations totaling PLN 8.32 billion, inspect disclosed taxpayer counts and sub-account concentration, and reconcile NIW eligibility lists against Ministry of Finance disbursements.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/taiwan-new-resident-fund/')}>Compare Taiwan New Resident Development Fund reports</a>. Use the project ID to follow recurring approvals and see where the reports differ on execution figures or dates.</p>
  <p><a class="identity-link" href={url('/record/funding-flows/heal-nepal/')}>Compare Heal Nepal funding in the UK and Nepal</a>. The case keeps pounds and rupees in their original records and shows where a single disbursement may correspond to two receipts.</p>
  <p><a href={url('/record/funding-flows/kenya-nutrition/')}>Follow nutrition funding from the UK to western Kenya</a>. The case links a UK charity registration to two reporting activities and a grant manager’s exact project reference. County food poverty comes from a separate survey.</p>
  <p><a href={url('/record/funding-flows/ripple-effect-kenya-accounts/')}>Read Ripple Effect’s annual grant and expenditure records in Kenya</a>. Nine disclosed entity periods preserve the different full NGO identifiers, an initial three-month period and the two grant figures printed for FY2021.</p>
  <p><a href={url('/record/funding-flows/hokkaido-child-support/')}>Follow Hokkaido child-support awards</a> from published selection records to corporate numbers, and read the separate household survey on food affordability.</p>
  <p>The <a href={url('/record/funding-flows/iberia-hrsa/')}>Iberia health center case</a> links four HRSA grants to three annual audit schedules. Federal award years and the center’s fiscal periods remain separate.</p>
  <p>The <a href={url('/record/funding-flows/us-schedule-i/')}>U.S. Schedule I lookup</a> connects filer and recipient EINs in one IRS archive. It shows the two reported amount types, the tax period and the original filing coordinates.</p>
  <h2 id="contribute">Help close a gap</h2>
  <p>Suggest a source with a public download, an identifier definition, a period, and published reuse terms. For a correction, use the link below and give the source record or organization identifier and the reported period. Use public source references when reporting an error.</p>
  <p><a href="https://github.com/theguysaccount/charitology/blob/main/docs/GLOBAL_CHARITY_INDEX.md">Read the reproducible build steps and priority list</a>.</p>
</Entry>

