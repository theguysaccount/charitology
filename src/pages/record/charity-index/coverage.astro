---
import Entry from '../../../layouts/Entry.astro';
import { url } from '../../../lib/site';
import SiteSymbol from '../../../components/SiteSymbol.astro';
import { pageIdentity } from '../../../lib/site-identities';
import australia from '../../../../public/data/charity-financials/manifest.json';
import canada from '../../../../public/data/charity-financials/ca/manifest.json';
import englandWales from '../../../../public/data/charity-financials/ew/manifest.json';
import usa from '../../../../public/data/charity-financials/us/manifest.json';
import usaShort from '../../../../public/data/charity-financials/us-990-ez/manifest.json';
import usaFoundation from '../../../../public/data/charity-financials/us-990-pf/manifest.json';
import registry from '../../../../public/data/irs-registry/manifest.json';
import japan from '../../../../public/data/charity-registry/japan-npo/manifest.json';
import newZealand from '../../../../public/data/charity-registry/new-zealand/manifest.json';
import brazil from '../../../../public/data/charity-registry/brazil-osc/manifest.json';
import mexico from '../../../../public/data/charity-financials/mx/manifest.json';
import manchester from '../../../data/home-from-hospital.json';

const title = 'Charity Index coverage';
const number = (value: number) => value.toLocaleString('en-US');
const australianPeriods = australia.sources.reduce((sum, source) => sum + source.includedPeriods, 0);
const panels = [
  {
    name: 'Australia', flag: 'Annual Information Statements', route: '/record/charity-financials/',
    label: 'Search Australian filings', date: australia.date,
    coverage: `${number(australia.organizations)} ABNs and ${number(australianPeriods)} dated records in the selected extracts.`,
    history: `${number(australia.organizationsWithBothYears)} ABNs have dated reporting in both source years, 2023 and 2024.`,
    boundary: 'The 2024 extract sets the identity scope. Earlier unmatched and undated records are left out. The grant fields distinguish money for use inside and outside Australia.',
    manifest: '/data/charity-financials/manifest.json',
  },
  {
    name: 'Canada', flag: 'Canada Revenue Agency T3010', route: '/record/charity-financials/canada/',
    label: 'Search Canadian financial filings', date: canada.capturedOn,
    coverage: `${number(canada.accounts)} charity accounts with a dated financial record in the two extracts.`,
    history: `${number(canada.financialPeriods)} periods ending in 2023 or 2024. ${number(canada.multiYearAccounts)} accounts have records in both years.`,
    boundary: 'Income, expenditure, gifts and grants are reported in CAD. Returns keep their accounting basis, fiscal period and original records.',
    manifest: '/data/charity-financials/ca/manifest.json',
  },
  {
    name: 'England and Wales', flag: 'Charity Commission annual returns', route: '/record/charity-financials/england-wales/',
    label: 'Search England and Wales returns', date: englandWales.date,
    coverage: `${number(englandWales.organizations)} of ${number(englandWales.registeredMain)} main registered charities with eligible records.`,
    history: `${number(englandWales.counts.included)} received annual returns for periods ending in 2023–2025. ${number(englandWales.multiPeriod)} charities have multiple periods.`,
    boundary: 'The figures are gross income and expenditure in GBP. Linked, suppressed and unreceived records are outside the included scope.',
    manifest: '/data/charity-financials/ew/manifest.json',
  },
  {
    name: 'Japan', flag: 'Cabinet Office NPO Portal', route: '/record/charity-index/japan/',
    label: 'Search Japan NPO Portal records', date: japan.capturedOn,
    coverage: `${number(japan.counts.portalRows)} dated portal entries across ${number(japan.authorities.length)} supervising authorities.`,
    history: `${number(japan.counts.financialSummaries)} entries link to a dated organization-entered financial summary.`,
    boundary: 'The portal includes dissolution records. Corporate numbers can be repeated, and the reported financial figures cover only matched records.',
    manifest: '/data/charity-registry/japan-npo/manifest.json',
  },
  {
    name: 'Mexico', flag: 'SAT financial reports and authorization directories', route: '/record/charity-financials/mexico/',
    label: 'Search Mexico’s charity financial reports', date: mexico.capturedOn,
    coverage: `${number(mexico.coverage.identities)} exact institutional RFCs across three financial reports and two directories.`,
    history: `${number(mexico.coverage.financialPeriods)} fiscal-year records from 2023–2025. ${number(mexico.coverage.exactPeriodHistories['3'])} RFCs appear in all three.`,
    boundary: 'Amounts stay in MXN. Financial periods and dated directory entries describe different observations. The edition covers SAT’s authorized-entity publications.',
    manifest: '/data/charity-financials/mx/manifest.json',
  },
  {
    name: 'New Zealand', flag: 'Charities Services register and Tier 3 filings', route: '/record/charity-index/new-zealand/',
    label: 'Search New Zealand charities and Tier 3 filings', date: newZealand.capturedAt.slice(0, 10),
    coverage: `${number(newZealand.registry.included)} searchable organization entries, including deregistered and removed entries.`,
    history: `${number(newZealand.registry.withBothYears)} entries have selected Tier 3 returns for periods ending in both 2024 and 2025.`,
    boundary: 'The financial selection covers individual Tier 3 returns. Currency follows the reporting standard where the source field is blank.',
    manifest: '/data/charity-registry/new-zealand/manifest.json',
  },
  {
    name: 'United States', flag: 'IRS identity and Form 990 extracts', route: '/record/charity-financials/united-states/',
    label: 'Search U.S. Form 990 finances', date: usa.capturedOn,
    coverage: `${number(registry.recordCount)} dated federal registry identities. Separately, ${number(usa.counts.organizations)} EINs have a selected full Form 990 period.`,
    history: `${number(usa.counts.includedPeriods)} processed financial records for periods ending in 2022–2024. ${number(usa.counts.multiPeriod)} EINs have multiple periods.`,
    boundary: 'The full-form financial edition covers subsection 03. The other U.S. editions below use their own extract populations.',
    manifest: '/data/charity-financials/us/manifest.json',
  },
];
const sources = [
  { title: 'Download charity register data', publisher: 'Australian Charities and Not-for-profits Commission', url: 'https://www.acnc.gov.au/charity/about-charity-register/download-charity-register-data' },
  { title: '2024 List of charities', publisher: canada.publisher, url: canada.editions['2024'].catalogue },
  { title: 'Full register download', publisher: 'Charity Commission for England and Wales', url: 'https://register-of-charities.charitycommission.gov.uk/en/register/full-register-download' },
  { title: 'National NPO Portal bulk downloads', publisher: japan.publisher, url: japan.portal + 'download/all' },
  { title: 'Annual extract of tax-exempt organization financial data', publisher: 'Internal Revenue Service', url: usa.sourcePage },
];
---

<Entry title={title} eyebrow="The Record · Global Charity Index" summary="See which organizations, financial periods and funding stages each source covers." crumbs={[{label:'The Record',href:'/record/'},{label:'Global Charity Index',href:'/record/charity-index/'},{label:'Coverage'}]} sources={sources}>
  <p>The Index separates registry identities, reported financial periods and individual funding records. This page describes the current editions and where each one leaves questions open. Coverage counts describe the included source records. Organization identities, currencies and reporting rules differ across jurisdictions.</p>
  <h2 id="filings">Registry and financial editions</h2>
  <div class="coverage-list" aria-labelledby="filings">
    {panels.map(panel => <section class="card">
      <p class="eyebrow identity-label"><SiteSymbol name={pageIdentity(panel.route).symbol} />{panel.flag}</p>
      <h3>{panel.name}</h3>
      <p><strong>{panel.coverage}</strong></p>
      <p>{panel.history}</p>
      <p>{panel.boundary}</p>
      <p>Captured on <time datetime={panel.date}>{panel.date}</time>. <a href={url(panel.route)}>{panel.label}</a> · <a href={url(panel.manifest)}>Source and coverage manifest</a>.</p>
    </section>)}
  </div>
  <h3>Brazil civil society registry links</h3>
  <p>The <a href={url('/record/charity-index/brazil/')}>Brazil registry comparison</a> finds one exact CNPJ match in Ipea for {number(brazil.coverage.exact.identifiers)} of {number(brazil.transfers.identifiers)} registration numbers in the federal transfer edition. The comparison shows the August 2026 registry snapshot alongside separate 2024 and 2025 bank-order periods.</p>
  <h3>Kenya sector report coverage</h3>
  <p>The <a href={url('/record/charity-financials/kenya/')}>Kenya edition</a> compares aggregate filing counts and receipts across three regulator reports, with a spending breakdown for the latest report year. It links to the regulator’s live register for organization names and references.</p>
  <h3>Additional United States financial editions</h3>
  <ul>
    {[usaShort, usaFoundation].map(manifest => <li>
      <a href={url(`/record/charity-financials/united-states/${manifest.form.toLowerCase()}/`)}>Form {manifest.form}</a> covers {number(manifest.counts.includedPeriods)} periods for {number(manifest.counts.organizations)} EINs.
      {' '}{number(manifest.counts.multiPeriod)} EINs have more than one period.
    </li>)}
  </ul>
  <p>The same EIN can appear in different form editions. These counts describe each edition separately.</p>
  <h2>Where money goes</h2>
  <p><a class="identity-link" href={url('/record/funding-flows/')}>Browse all funding-flow searches and cases</a>.</p>
  <p><a href={url('/record/funding-flows/canada-qualified-donees/')}>Trace gifts reported by Canadian charities</a> by filer or recipient account. The lookup links original CRA worksheet records to dated filer financial returns and keeps differences between worksheet and annual return totals visible.</p>
  <p><a href={url('/record/funding-flows/canada-grant-geography/')}>Explore where Canadian charities reported grant activities</a> by country and see how much of the reported amount remains unallocated.</p>
  <p>The <a href={url('/record/funding-flows/brazil-transferegov/')}>Brazil federal transfer edition</a> joins official proposals, agreements and bank orders by their source identifiers. It covers two calendar years of selected orders. Where the work happened requires separate evidence.</p>
  <p>The <a href={url('/record/funding-flows/brazil-solidarity-kitchens/account-payments/')}>solidarity kitchens payment trace</a> matches reported movements to the selected agreements. It follows internal transfer IDs to onward records and shows which amounts are missing.</p>
  <p>The <a href={url('/record/funding-flows/brazil-cisterns/')}>Cisternas case</a> follows one agreement to reported payments for two named organizations. It compares tender locations with two 2022 census measures and includes one operator-reported delivery.</p>
  <p>The <a href={url('/record/funding-flows/greater-manchester-home-from-hospital/')}>Greater Manchester discharge-support case</a> connects {manchester.awards.length} reported awards to a delivery period and shows independent NHS discharge figures from the same place. The source does not establish a matching payment or expense for each award. Follow the <a href={url('/record/gap-map/')}>Gap Map</a> for more comparisons between funding and need.</p>
  <p>The <a href={url('/record/funding-flows/yes-i-do-alliance/')}>Yes I Do Alliance trace</a> compares reported disbursements and receipts across six publisher activities. The same reported amount can appear at more than one stage. Candidate matches and unresolved rows are shown separately.</p>
  <p><a href={url('/record/funding-flows/hokkaido-child-support/')}>Follow Hokkaido child-support awards</a> from published selection records to corporate numbers, and read the separate household survey on food affordability.</p>
  <p>The <a href={url('/record/funding-flows/iberia-hrsa/')}>Iberia health center case</a> links four HRSA grants to three annual audit schedules. Federal award years and the center’s fiscal periods remain separate.</p>
  <p>The <a href={url('/record/funding-flows/us-schedule-i/')}>U.S. Schedule I lookup</a> connects filer and recipient EINs in one IRS archive. It shows the two reported amount types, the tax period and the original filing coordinates.</p>
  <h2>Help close a gap</h2>
  <p>Suggest a source with a public download, an identifier definition, a period, and published reuse terms. For a correction, use the link below and give the source record or organization identifier and the reported period. Use public source references when reporting an error.</p>
  <p><a href="https://github.com/theguysaccount/charitology/blob/main/docs/GLOBAL_CHARITY_INDEX.md">Read the reproducible build steps and priority list</a>.</p>
</Entry>

<style>
  .coverage-list { display: grid; gap: 1rem; }
  .coverage-list h3 { margin-block-start: 0; }
</style>
