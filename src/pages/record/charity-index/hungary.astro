---
import Entry from '../../../layouts/Entry.astro';
import { url } from '../../../lib/site';
import { wave1d } from '../../../lib/registry-wave1d';
import manifest from '../../../../public/data/charity-registry/hungary/manifest.json';
import flowManifest from '../../../../public/data/funding-flows/hungary-szja-1-percent/manifest.json';
import '../../../styles/charity-financial-search.css';

const title = 'Hungary 1% SZJA civil-organization recipients (2024–2026)';
const dataPath = '/data/charity-registry/hungary/';
const flowPath = '/record/funding-flows/hungary-szja-1-percent/';
const count = (value: number) => value.toLocaleString('en-US');
const hufB = (huf: number) => `HUF ${(huf / 1_000_000_000).toFixed(2)}B`;
const hufM = (huf: number) => `HUF ${(huf / 1_000_000).toFixed(2)}M`;

const sources = [
  {
    title: 'Szja 1%-os felajánlásban részesült regisztrált civil kedvezményezettek (2024–2026 official XLSX announcements)',
    publisher: manifest.publisher,
    url: manifest.catalogues.navCivil2026,
  },
  {
    title: 'Szja 1%-os felajánlásban részesült technikai számos kedvezményezettek (2026 XLSX)',
    publisher: manifest.publisher,
    url: manifest.catalogues.navTech2026,
  },
];
---

<Entry
  title={title}
  eyebrow="The Record · Global Charity Index · Hungary"
  summary="Search 34,109 Hungarian civil organizations that received statutory 1% SZJA personal income-tax allocations across 2024–2026 (HUF 58.97B across 5.40M taxpayer designations), with exact HUF amounts and exact donor counts down to every recipient."
  crumbs={[{ label: 'The Record', href: '/record/' }, { label: 'Global Charity Index', href: '/record/charity-index/' }, { label: 'Hungary' }]}
  filePath="src/pages/record/charity-index/hungary.astro"
  sources={sources}
>
  <p>
    Hungary operates Europe’s oldest dual <strong>1%+1% personal income-tax allocation</strong> system (<em>SZJA 1+1%</em>), allowing taxpayers to redirect
    1% of paid personal income tax to a registered civil-society organization and a separate 1% to a religious community or national priority budget line.
    This edition joins three consecutive official annual announcements published by Hungary’s National Tax and Customs Administration
    (<em>Nemzeti Adó- és Vámhivatal / NAV</em>, <strong>2024–2026</strong>, 2026 snapshot as of <time datetime={manifest.asOf}>{manifest.asOf}</time>,
    captured <time datetime={manifest.capturedOn}>{manifest.capturedOn}</time>): <strong>{count(manifest.counts.includedOrganizations)} distinct 8-digit tax-ID</strong>
    (<em>adószám</em>) civil organizations ({count(manifest.counts.active2026Organizations)} active in 2026; {count(manifest.counts.presentAll3Years)} funded in all three years),
    totaling <strong>{hufB(manifest.counts.total3YearCivilHuf)}</strong> across <strong>{count(manifest.counts.total3YearCivilDonors)}</strong> taxpayer designations
    — plus <strong>{count(manifest.counts.technicalNumber2026Count)}</strong> technical-number 2026 recipients totaling <strong>{hufB(manifest.counts.technicalNumber2026Huf)}</strong>.
  </p>
  <p>
    Together with <a href={url('/record/charity-index/poland/')}>Poland</a> (1.5% individual PIT), <a href={url('/record/charity-index/czechia/')}>Czechia</a>,
    and <a href={url('/record/charity-index/slovakia/')}>Slovakia</a> (2%/3% individual + 1%/2% corporate PIT), Hungary completes Charitology’s four-country
    Visegrád comparative index. Unlike Poland (which omits taxpayer counts below 100) and Slovakia (which omits donor counts entirely), Hungary’s NAV
    publishes the <strong>exact taxpayer headcount for every single civil recipient</strong>, letting readers inspect both total HUF and average HUF per donor.
  </p>

  <p>For {wave1d().sorted.hu.length.toLocaleString('en-US')} of these organizations, a <a href={url(wave1d().base('hu'))}>verified charity dossier</a> (Wave 1d) puts the official record and every published figure on one page, copied exactly as the official file prints it, with its source record. They are the organizations whose record reports {wave1d().D.hu.thresholdText}.</p>
  <section
    class="charity-financial-search"
    data-hungary-registry
    data-base={url(dataPath)}
    data-flow={url(flowPath)}
    data-manifest={JSON.stringify(manifest)}
    aria-labelledby="hu-search-heading"
  >
    <h2 id="hu-search-heading">Search Hungarian 1% SZJA civil organizations</h2>
    <p id="hu-search-hint">
      Enter the beginning of an organization’s name (Hungarian accents optional, e.g., <code>partizan</code>, <code>telex</code>, <code>heim pal</code>,
      <code>bator tabor</code> or <code>orszagos mentoszolgalat</code>) or an exact 8-digit tax ID (<em>adószám</em>, e.g., <code>19286031</code> or
      <code>18252831</code>). Search loads one compressed shard locally in your browser.
    </p>
    <form aria-describedby="hu-search-hint">
      <label for="hu-query">Organization name or 8-digit Adószám</label>
      <div class="finance-actions">
        <input type="search" id="hu-query" maxlength="160" autocomplete="off" disabled />
        <span class="inline-field">
          <label for="hu-hint">Name category (token hint)</label>
          <select id="hu-hint" disabled>
            <option value="">All civil recipients ({count(manifest.counts.includedOrganizations)})</option>
            <option value="foundation_named">Named Alapítvány / Foundation ({count(manifest.counts.byNameHint.foundation_named)})</option>
            <option value="association_named">Named Egyesület / Association ({count(manifest.counts.byNameHint.association_named)})</option>
            <option value="health_named">Hospital / Ambulance / Health named ({count(manifest.counts.byNameHint.health_named)})</option>
            <option value="education_named">School / Kindergarten / Education named ({count(manifest.counts.byNameHint.education_named)})</option>
            <option value="animal_env_named">Animal shelter / Nature named ({count(manifest.counts.byNameHint.animal_env_named)})</option>
            <option value="other_civil">Other eligible civil orgs ({count(manifest.counts.byNameHint.other_civil)})</option>
          </select>
        </span>
        <label class="inline-check"><input type="checkbox" id="hu-active-2026" disabled /> Funded in 2026 ({count(manifest.counts.active2026Organizations)})</label>
        <label class="inline-check"><input type="checkbox" id="hu-all-3y" disabled /> Present all 3 years ({count(manifest.counts.presentAll3Years)})</label>
        <button type="submit" class="btn" disabled>Search organizations</button>
        <button type="button" class="btn btn-ghost" data-clear disabled>Clear</button>
      </div>
    </form>
    <p role="status" data-status>Search when you are ready to load a Hungary registry shard.</p>
    <div class="finance-actions">
      <button type="button" class="btn btn-ghost btn-small" data-json disabled>Export displayed results as JSON</button>
      <button type="button" class="btn btn-ghost btn-small" data-csv disabled>Export displayed results as CSV</button>
    </div>
    <ol class="finance-results" data-site-symbol="danubeArch" aria-label="Hungary civil 1% SZJA results" data-results></ol>
    <noscript>
      <p>Without JavaScript, inspect the official annual Excel files directly on <a href={manifest.catalogues.navSzjaPortal}>nav.gov.hu</a>.</p>
    </noscript>
  </section>

  <h2 id="top-2026">Top 20 civil recipients in 2026</h2>
  <p>
    Click any 8-digit <em>adószám</em> below to load its full 2024–2026 HUF and donor-count history in the search tool above.
  </p>
  <div class="table-wrap" role="region" aria-label="Top 20 Hungarian civil 1% SZJA recipients in 2026" tabindex="0">
    <table class="data hu-table">
      <caption>Top 20 Hungarian registered civil recipients of 1% SZJA in 2026 (HUF and exact donor headcounts)</caption>
      <thead>
        <tr>
          <th scope="col">Adószám</th>
          <th scope="col">Organization</th>
          <th scope="col">Municipality</th>
          <th scope="col">2026 amount</th>
          <th scope="col">2026 donors</th>
          <th scope="col">Avg HUF / donor</th>
          <th scope="col">3-year total</th>
        </tr>
      </thead>
      <tbody>
        {
          flowManifest.top20Civil2026.map((item) => (
            <tr>
              <td>
                <button type="button" class="inline-lookup-btn" data-lookup-hu={item.tax8}>
                  <code>{item.tax8}</code>
                </button>
              </td>
              <th scope="row">
                <span lang="hu">{item.name}</span>
              </th>
              <td>{item.muni || '—'}</td>
              <td>{hufM(item.y2026Huf ?? 0)}</td>
              <td>{count(item.y2026Donors ?? 0)}</td>
              <td>{item.y2026Donors ? count(Math.round((item.y2026Huf ?? 0) / item.y2026Donors)) : '—'}</td>
              <td>{hufM(item.total3yHuf)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="funding">Follow Hungary’s 1%+1% SZJA civil and church allocations</h2>
  <p>
    Compare Hungary’s Top-250 civil recipients alongside all <strong>186 technical-number 1% recipients</strong> (churches and the National Talent Program,
    HUF 23.95B from 2.50M taxpayers) and examine why independent journalism foundations lead Hungary’s civil 1% table while pediatric hospitals and ambulance
    foundations dominate the rest of the top ten.{' '}
    <a class="identity-link" href={url(flowPath)}>Open Hungary’s 2024–2026 1%+1% SZJA explorer (HUF 45.35B in 2026)</a>.
  </p>

  <h2 id="coverage">Scope, privacy projection and Visegrád comparison</h2>
  <p>
    <strong>What is included vs. excluded:</strong> NAV’s annual <code>egyszaz_kiut</code> civil statements include every registered Hungarian civil
    organization that received a positive 1% SZJA allocation in 2024, 2025, or 2026. Eligible organizations that received HUF 0, organizations excluded
    under <code>kizart_civil</code>, and broader non-registered clubs sit outside this payout-derived dataset. Technical-number 1% church and national
    budget recipients are kept strictly separate in the paired funding-flows explorer rather than mixed into the civil-organization denominator.
  </p>
  <p>
    <strong>Privacy projection &amp; name hints:</strong> Street-level registered addresses (<em>utca, házszám, emelet, ajtó</em>) from NAV’s source Excel
    workbooks are stripped at build time, keeping only municipality names. Category filters use transparent Hungarian name-token hints (<em>Alapítvány</em>,
    <em>Egyesület</em>, etc.) rather than an external court legal-form join.{' '}
    <a class="identity-link" data-source-symbol="document" href={url(dataPath + 'manifest.json')} download>Download source manifest (JSON)</a> ·{' '}
    <a href={url('/record/charity-index/coverage/')}>Read the Index coverage</a>.
  </p>
</Entry>

<style>
  .hu-table {
    min-inline-size: 46rem;
  }
  [data-hungary-registry] .inline-field {
    max-inline-size: 100%;
    min-inline-size: 0;
    flex-wrap: wrap;
  }
  [data-hungary-registry] select {
    max-inline-size: 100%;
    min-inline-size: 0;
  }
</style>

<script>
  import { $, h } from '../../../lib/client/dom';
  import { download, toCsv } from '../../../lib/client/files';
  import { financialCsvName, financialShardLoader, normalizeFinancialName, type FinancialShard } from '../../../lib/client/financial-directory';

  type HuRow = {
    tax8: string;
    taxFull: string;
    name: string;
    norm: string;
    muni: string;
    nameHint: string;
    yearsCount: number;
    total3yHuf: number;
    total3yDonors: number;
    y2026Huf: number | null;
    y2026Donors: number | null;
    y2025Huf: number | null;
    y2025Donors: number | null;
    y2024Huf: number | null;
    y2024Donors: number | null;
  };
  type HuManifest = {
    publisher: string;
    asOf: string;
    shards: {
      names: Record<string, FinancialShard>;
      ids: Record<string, FinancialShard>;
    };
  };

  const bucketFor = (norm: string) => {
    const first = norm[0] ?? '';
    return first >= 'a' && first <= 'z' ? first : '0-9';
  };
  const fmtHuf = (n: number) => `HUF ${n.toLocaleString('en-US')}`;
  const limit = 30;

  for (const root of document.querySelectorAll<HTMLElement>('[data-hungary-registry]')) {
    const manifest: HuManifest = JSON.parse(root.dataset.manifest!);
    const base = root.dataset.base!;
    const loadNameShard = financialShardLoader<HuRow>(base, manifest.shards.names);
    const loadIdShard = financialShardLoader<HuRow>(base, manifest.shards.ids);

    const form = $('form', root) as HTMLFormElement;
    const queryEl = $('#hu-query', root) as HTMLInputElement;
    const hintSel = $('#hu-hint', root) as HTMLSelectElement;
    const active26 = $('#hu-active-2026', root) as HTMLInputElement;
    const all3y = $('#hu-all-3y', root) as HTMLInputElement;
    const statusEl = $('[data-status]', root);
    const listEl = $('[data-results]', root);
    const clearBtn = $('[data-clear]', root) as HTMLButtonElement;
    const jsonBtn = $('[data-json]', root) as HTMLButtonElement;
    const csvBtn = $('[data-csv]', root) as HTMLButtonElement;
    const submitBtn = $('button[type="submit"]', root) as HTMLButtonElement;

    for (const el of [queryEl, hintSel, active26, all3y, submitBtn, clearBtn]) el.disabled = false;
    let shown: HuRow[] = [];

    const render = (rows: HuRow[], total: number, q: string) => {
      shown = rows;
      listEl.replaceChildren();
      jsonBtn.disabled = rows.length === 0;
      csvBtn.disabled = rows.length === 0;
      if (!rows.length) {
        statusEl.textContent = `No Hungarian civil organizations matched “${q}” under the selected filters.`;
        return;
      }
      statusEl.textContent =
        total > rows.length
          ? `Showing the first ${rows.length} of ${total.toLocaleString('en-US')} matching organizations.`
          : `Showing ${total.toLocaleString('en-US')} matching organization${total === 1 ? '' : 's'}.`;

      for (const r of rows) {
        const yParts: string[] = [];
        if (r.y2026Huf !== null) yParts.push(`2026: ${fmtHuf(r.y2026Huf)} (${r.y2026Donors?.toLocaleString('en-US')} donors)`);
        if (r.y2025Huf !== null) yParts.push(`2025: ${fmtHuf(r.y2025Huf)} (${r.y2025Donors?.toLocaleString('en-US')})`);
        if (r.y2024Huf !== null) yParts.push(`2024: ${fmtHuf(r.y2024Huf)} (${r.y2024Donors?.toLocaleString('en-US')})`);

        listEl.append(
          h(
            'li',
            {},
            h('strong', { lang: 'hu' }, r.name),
            ' ',
            h('code', {}, r.taxFull),
            r.muni ? h('div', { class: 'note' }, `${r.muni} · 3-year total: ${fmtHuf(r.total3yHuf)} (${r.total3yDonors.toLocaleString('en-US')} designations)`) : null,
            h('div', { class: 'note' }, yParts.join(' · ')),
          ),
        );
      }
    };

    const runSearch = async () => {
      const rawQ = queryEl.value.trim();
      if (!rawQ) {
        statusEl.textContent = 'Enter the beginning of an organization name or an 8-digit Adószám.';
        return;
      }
      const digits = rawQ.replace(/[^0-9]/g, '');
      const isTax = /^\d{8,11}$/.test(digits);
      const normQ = normalizeFinancialName(rawQ);
      const hint = hintSel.value;
      const need26 = active26.checked;
      const need3y = all3y.checked;

      statusEl.textContent = 'Loading Hungary registry shard…';
      try {
        let rows: HuRow[];
        if (isTax) {
          const tax8 = digits.slice(0, 8);
          rows = (await loadIdShard(tax8.slice(0, 2))).filter((r) => r.tax8 === tax8);
        } else {
          const bkt = bucketFor(normQ);
          rows = (await loadNameShard(bkt)).filter((r) => r.norm.startsWith(normQ) || r.norm.includes(normQ));
        }
        const filtered = rows.filter((r) => {
          if (hint && r.nameHint !== hint) return false;
          if (need26 && r.y2026Huf === null) return false;
          if (need3y && r.yearsCount < 3) return false;
          return true;
        });
        filtered.sort((a, b) => (b.y2026Huf ?? 0) - (a.y2026Huf ?? 0) || b.total3yHuf - a.total3yHuf);
        render(filtered.slice(0, limit), filtered.length, rawQ);
      } catch (err) {
        statusEl.textContent = err instanceof Error ? err.message : 'Could not load Hungary registry shard.';
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void runSearch();
    });
    clearBtn.addEventListener('click', () => {
      queryEl.value = '';
      hintSel.value = '';
      active26.checked = false;
      all3y.checked = false;
      shown = [];
      listEl.replaceChildren();
      jsonBtn.disabled = true;
      csvBtn.disabled = true;
      statusEl.textContent = 'Search cleared.';
      queryEl.focus();
    });
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-lookup-hu]')) {
      btn.addEventListener('click', () => {
        queryEl.value = btn.dataset.lookupHu ?? '';
        hintSel.value = '';
        active26.checked = false;
        all3y.checked = false;
        void runSearch();
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
    jsonBtn.addEventListener('click', () => {
      if (!shown.length) return;
      download(
        'charitology-hungary-1pct-civil.json',
        JSON.stringify({ source: manifest.publisher, asOf: manifest.asOf, rows: shown }, null, 2),
        'application/json;charset=utf-8',
      );
    });
    csvBtn.addEventListener('click', () => {
      if (!shown.length) return;
      const csvText = toCsv(
        shown.map((r) => ({
          tax_id: r.taxFull,
          name: financialCsvName(r.name),
          municipality: r.muni,
          huf_2026: r.y2026Huf ?? '',
          donors_2026: r.y2026Donors ?? '',
          huf_2025: r.y2025Huf ?? '',
          donors_2025: r.y2025Donors ?? '',
          huf_2024: r.y2024Huf ?? '',
          donors_2024: r.y2024Donors ?? '',
          total_3y_huf: r.total3yHuf,
        })),
      );
      download('charitology-hungary-1pct-civil.csv', '\uFEFF' + csvText, 'text/csv;charset=utf-8');
    });
  }
</script>
