---
import Entry from '../../../../layouts/Entry.astro';
import Faq from '../../../../components/registry/Faq.astro';
import '../../../../styles/registry-wave1.css';
import { absolute, url } from '../../../../lib/site';
import { faqNode, hubNodes, count, US_BASE, EW_BASE, WAVE1_BASE, WAVE1_DATA_PATH } from '../../../../lib/registry-wave1';
import { wave1b, sentence, REGISTRY_NAMES, CLASSIFICATION_NAMES, SC_BASE, AU_BASE, CA_BASE, WAVE1B_DATA_PATH, type Registry } from '../../../../lib/registry-wave1b';
import { wave1c, DOSSIER_KEYS, WAVE1C_DATA_PATH, type CauseKey, type HubKey } from '../../../../lib/registry-wave1c';
import { wave1d, W1D_KEYS, WAVE1D_DATA_PATH } from '../../../../lib/registry-wave1d';

const w = wave1b();
const c = wave1c();
const faqsBase = w.causeFaqs();
const C = c.CAUSE_KEYS;
const cIndex = (r: CauseKey) => c.base(r === 'ni' || r === 'se' || r === 'mx' ? c.D[r].slug : c.H[r as HubKey].slug);
const noLabels = DOSSIER_KEYS.filter((k) => !c.D[k].hubSegment);
const cHubPaths = [...new Set(c.causes.groups.flatMap((g: any) => C.flatMap((r) => (g.matches[r] as string[]).map((k) => c.causeHub(r, k)).filter(Boolean) as string[])))];
const cHubName = new Map<string, string>();
for (const g of c.causes.groups) for (const r of C) for (const k of g.matches[r] as string[]) {
  const hub = c.causeHub(r, k);
  if (hub && !cHubName.has(hub)) cHubName.set(hub, `${c.causeName[r]}: ${c.causeDisplay(r, k)}`);
}
const languageNames: Record<string, string> = { sv: 'Swedish', es: 'Spanish', de: 'German', lv: 'Latvian', hr: 'Croatian' };
// Wave 1d: Israel and Italy publish category labels; Estonia, Hungary and Slovenia do not.
const d = wave1d();
const DK = d.CAUSE_KEYS;
const dNoLabels = W1D_KEYS.filter((k) => !d.D[k].hubSegment);
const dLanguageNames: Record<string, string> = { he: 'Hebrew', it: 'Italian' };
const dHubPaths = [...new Set(d.causes.groups.flatMap((g: any) => DK.flatMap((r) => (g.matches[r] as string[]).map((k) => d.causeHub(r, k)).filter(Boolean) as string[])))];
const dHubName = new Map<string, string>();
for (const g of d.causes.groups) for (const r of DK) for (const k of g.matches[r] as string[]) {
  const hub = d.causeHub(r, k);
  if (hub && !dHubName.has(hub)) dHubName.set(hub, `${d.causeName[r]}: ${d.causeDisplay(r, k)}`);
}
// The Wave 1b answers, with the Wave 1c registers added where the question covers them.
const faqs = faqsBase.map((f, i) => (i === 0
  ? { ...f, answer: `${f.answer} Wave 1c applies the same rule to the labels of ${C.map((r) => c.causeName[r]).join(', ')}, adding stems for labels published in ${Object.values(languageNames).join(', ')}; they are listed in a second table and in the Wave 1c cause-groups.json. Wave 1d does the same for ${DK.map((r) => d.causeName[r]).join(' and ')}, with stems for labels in ${Object.values(dLanguageNames).join(' and ')}, in a third table and the Wave 1d cause-groups.json.` }
  : i === 5
    ? { ...f, answer: `${f.answer} For the Wave 1c registers: ${C.map((r) => `${c.causeName[r]} ${count(c.causes.ungrouped[r].length)}`).join(', ')}. For the Wave 1d registers: ${DK.map((r) => `${d.causeName[r]} ${count(d.causes.ungrouped[r].length)}`).join(', ')}.` }
    : f));
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const origin = absolute('/', Astro.site);
const R = w.REGISTRIES;
const indexPath: Record<Registry, string> = { us: US_BASE, ew: EW_BASE, scotland: SC_BASE, australia: AU_BASE, canada: CA_BASE };
const display = (r: Registry, key: string) => (r === 'scotland' ? sentence(w.labelName(r, key)) : w.labelName(r, key));
const title = 'Cause × Country: charity dossiers by registry category';
const description = `${count(w.causes.groups.length)} label-level cause groups across the IRS NTEE, Charity Commission, OSCR, ACNC and CRA classifications, plus the published labels of ${[...C.map((r) => c.causeName[r]), ...DK.map((r) => d.causeName[r])].join(', ')}, with hubs for each country.`;
const hubPaths = [...new Set(w.causes.groups.flatMap((g) => R.flatMap((r) => g.matches[r].map((k) => w.labelHub(r, k)).filter(Boolean) as string[])))];
const hubName = new Map<string, string>();
for (const g of w.causes.groups) for (const r of R) for (const k of g.matches[r]) {
  const hub = w.labelHub(r, k);
  if (hub && !hubName.has(hub)) hubName.set(hub, `${REGISTRY_NAMES[r]}: ${display(r, k)}`);
}
const jsonLd = [
  ...hubNodes({
    name: title, description, canonical, origin, dateModified: w.manifest.edition,
    items: [
      ...R.map((r) => ({ name: `${REGISTRY_NAMES[r]} charity dossiers`, url: absolute(indexPath[r], Astro.site) })),
      ...hubPaths.map((p) => ({ name: hubName.get(p)!, url: absolute(p, Astro.site) })),
      ...C.map((r) => ({ name: `${c.causeName[r]} ${r === 'ni' || r === 'se' || r === 'mx' ? 'charity dossiers' : 'register hubs'}`, url: absolute(cIndex(r), Astro.site) })),
      ...cHubPaths.map((p) => ({ name: cHubName.get(p)!, url: absolute(p, Astro.site) })),
      ...DK.map((r) => ({ name: `${d.causeName[r]} charity dossiers`, url: absolute(d.base(r), Astro.site) })),
      ...dHubPaths.map((p) => ({ name: dHubName.get(p)!, url: absolute(p, Astro.site) })),
    ],
    spatialCoverage: ['United States', 'England and Wales', 'Scotland', 'Australia', 'Canada', ...C.map((r) => c.causeName[r]), ...DK.map((r) => d.causeName[r])].join('; '),
    dataFiles: [absolute(`${WAVE1B_DATA_PATH}cause-groups.json`, Astro.site), absolute(`${WAVE1B_DATA_PATH}manifest.json`, Astro.site), absolute(`${WAVE1_DATA_PATH}manifest.json`, Astro.site), absolute(`${WAVE1C_DATA_PATH}cause-groups.json`, Astro.site), absolute(`${WAVE1C_DATA_PATH}manifest.json`, Astro.site), absolute(`${WAVE1D_DATA_PATH}cause-groups.json`, Astro.site), absolute(`${WAVE1D_DATA_PATH}manifest.json`, Astro.site)],
    isBasedOn: [w.cra.source.url, w.acnc.source.url, w.src.oscrRegister.url, 'https://www.irs.gov/pub/foia/ig/tege/eo-info.pdf', 'https://ccewuksprdoneregsadata1.blob.core.windows.net/data/txt/publicextract.charity_classification.zip'],
    license: 'https://creativecommons.org/licenses/by/4.0/',
    creditText: 'Category labels published by the IRS, the Charity Commission for England and Wales, the Office of the Scottish Charity Regulator, the ACNC and the Canada Revenue Agency; grouped by label text by Charitology.',
  }),
  faqNode(faqs),
];
const sources = [
  { title: 'IRS EO BMF code tables (NTEE major groups)', publisher: 'Internal Revenue Service', url: 'https://www.irs.gov/pub/foia/ig/tege/eo-info.pdf' },
  { title: 'Register of charities: classification extract', publisher: 'Charity Commission for England and Wales', url: 'https://ccewuksprdoneregsadata1.blob.core.windows.net/data/txt/publicextract.charity_classification.zip' },
  { title: `Scottish Charity Register download (${w.src.oscrRegister.member})`, publisher: w.src.oscrRegister.publisher, url: w.src.oscrRegister.url },
  { title: w.acnc.source.title, publisher: w.acnc.source.publisher, url: w.acnc.source.url },
  { title: w.cra.source.title, publisher: w.cra.source.publisher, url: w.cra.source.url },
];
---

<Entry
  title={title}
  eyebrow="Verified charity dossiers · Wave 1b"
  identityCode="5 registers"
  summary="Comparable causes across five charity registers, grouped only where the registers’ own published category labels share a word. The categories are not identical, and nothing here is an official crosswalk."
  description={description}
  crumbs={[
    { label: 'The Record', href: '/record/' },
    { label: 'Charity dossiers', href: WAVE1_BASE },
    { label: 'Cause × Country' },
  ]}
  sources={sources}
  jsonLd={jsonLd}
  sections={[
    { slug: 'method', text: 'How the groups are made', symbol: 'filter' },
    { slug: 'groups', text: 'Cause groups by register', symbol: 'compare' },
    { slug: 'registers', text: 'The five classifications', symbol: 'archive' },
    { slug: 'ungrouped', text: 'Labels in no group', symbol: 'layers' },
    { slug: 'wave1c', text: 'Wave 1c registers', symbol: 'globe' },
    { slug: 'wave1c-stems', text: 'Stems by label language', symbol: 'table' },
    { slug: 'wave1c-ungrouped', text: 'Wave 1c labels in no group', symbol: 'bookmark' },
    { slug: 'wave1d', text: 'Wave 1d registers', symbol: 'map' },
    { slug: 'wave1d-stems', text: 'Wave 1d stems by label language', symbol: 'notes' },
    { slug: 'wave1d-ungrouped', text: 'Wave 1d labels in no group', symbol: 'stack' },
    { slug: 'questions', text: 'Questions answered from the record', symbol: 'question' },
    { slug: 'limits', text: 'Sources and limits', symbol: 'alert' },
  ]}
>
  <p><strong>The categories are not identical across registers.</strong> The IRS, the Charity Commission for England and Wales, the Office of the Scottish Charity Regulator, the Australian Charities and Not-for-profits Commission and the Canada Revenue Agency each classify charities in their own way, with their own definitions, and assign categories by different processes. This page sets their labels side by side as a reading aid. It is not an equivalence, a crosswalk or a ranking.</p>

  <h2 id="method">How the groups are made</h2>
  <p>{w.causes.rule}</p>
  <p>Each group below shows its stems. A stem matches the start of any word in a label, ignoring case: “educat” matches “Education/training” and “Educational organizations”. Counts are the number of Charitology dossiers in that register that carry the label; dossier thresholds differ by register, so counts are never added across a row.</p>

  <h2 id="groups">Cause groups by register</h2>
  <div class="table-wrap">
    <table class="data rw-table" data-figures="cause-groups">
      <caption>Published category labels by cause group. Dossier counts in brackets; a linked label has a hub page with at least {w.hubMin} dossiers (Wave 1 hubs for the United States and England and Wales).</caption>
      <thead>
        <tr><th scope="col">Cause group (stems)</th>{R.map((r) => <th scope="col">{REGISTRY_NAMES[r]}<span class="rw-sub">{CLASSIFICATION_NAMES[r]}</span></th>)}</tr>
      </thead>
      <tbody>
        {w.causes.groups.map((g) => (
          <tr data-group={g.id}>
            <th scope="row">{g.name}<span class="rw-sub">{g.stems.map((s) => `“${s}”`).join(', ')}</span></th>
            {R.map((r) => (
              <td data-registry={r}>
                {g.matches[r].length
                  ? g.matches[r].map((k, i) => {
                      const hub = w.labelHub(r, k);
                      return <>{i > 0 && <br />}{hub ? <a href={url(hub)}>{display(r, k)}</a> : display(r, k)} ({count(w.labelCount(r, k))})</>;
                    })
                  : 'No matching label'}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="registers">The five classifications</h2>
  <ul>
    <li><a href={url(US_BASE)}>United States</a>: {count(w.causes.labels.us.length)} NTEE major groups from the IRS EO BMF code tables. A dossier counts under the major group of its standard NTEE code.</li>
    <li><a href={url(EW_BASE)}>England and Wales</a>: {count(w.causes.labels.ew.length)} Charity Commission “What” classifications. A charity can list several.</li>
    <li><a href={url(SC_BASE)}>Scotland</a>: the {count(w.causes.labels.scotland.length)} charitable purposes in the Scottish Charity Register download dated {w.registerDate}. A charity can list several.</li>
    <li><a href={url(AU_BASE)}>Australia</a>: {count(w.causes.labels.australia.length)} ACNC charity subtypes, named as in the ACNC user guide. A charity can hold several.</li>
    <li><a href={url(CA_BASE)}>Canada</a>: {count(w.causes.labels.canada.length)} CRA charity categories from the CRA codes list. Each account carries one.</li>
  </ul>

  <h2 id="ungrouped">Labels in no group</h2>
  <p>These labels contain none of the stems. They are shown so that nothing is silently dropped.</p>
  <dl class="rw-facts">
    {R.map((r) => <><dt>{REGISTRY_NAMES[r]}</dt><dd>{w.causes.ungrouped[r].length ? w.causes.ungrouped[r].map((k) => `${display(r, k)} (${count(w.labelCount(r, k))})`).join('; ') : 'None'}</dd></>)}
  </dl>

  <h2 id="wave1c">Wave 1c registers</h2>
  <p>Wave 1c adds the published labels of {C.length} more registers: {C.map((r, i) => <>{i > 0 && ', '}<a href={url(cIndex(r))}>{c.causeName[r]}</a> ({c.causeClassification[r]})</>)}. The same rule applies: a label joins a group when one of its words starts with one of the group’s stems. The Wave 1b English stems apply to every label; for labels published in another language, each group also has stems in that language, listed below. Counts are Wave 1c dossiers for Northern Ireland, Sweden and Mexico, and registered organizations for the register-hub countries, so they are never added across a row. {noLabels.map((k) => c.D[k].country).join(', ')} {noLabels.length > 1 ? 'have' : 'has'} no category field in the committed edition and no column here.</p>
  <p>Word-start matching is mechanical. Finnish industry labels such as “Other social work activities without accommodation” match the housing stem “accommodation” although they describe the opposite, so read every match against its label.</p>
  <div class="table-wrap">
    <table class="data rw-table" data-figures="cause-groups-wave1c">
      <caption>Published category labels of the Wave 1c registers by cause group. Counts in brackets; a linked label has a hub with at least {c.hubMin} dossiers or organizations.</caption>
      <thead>
        <tr><th scope="col">Cause group</th>{C.map((r) => <th scope="col">{c.causeName[r]}<span class="rw-sub">{c.causeClassification[r]}</span></th>)}</tr>
      </thead>
      <tbody>
        {c.causes.groups.map((g: any) => (
          <tr data-group-1c={g.id}>
            <th scope="row">{g.name}</th>
            {C.map((r) => (
              <td data-registry={r}>
                {g.matches[r].length
                  ? (g.matches[r] as string[]).map((k, i) => {
                      const hub = c.causeHub(r, k);
                      return <>{i > 0 && <br />}{hub ? <a href={url(hub)}>{c.causeDisplay(r, k)}</a> : c.causeDisplay(r, k)} ({count(c.causeCount(r, k))})</>;
                    })
                  : 'No matching label'}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="wave1c-stems">Stems by label language</h2>
  <p>Northern Ireland and Finland publish English labels, so only the Wave 1b stems apply to them; Denmark’s approval markers are statute references and match no stem.</p>
  <div class="table-wrap">
    <table class="data rw-table" data-figures="cause-stems-wave1c">
      <caption>Stems per cause group. English stems are unchanged from Wave 1b; the other stems apply only to labels published in that language.</caption>
      <thead><tr><th scope="col">Cause group</th><th scope="col">English (all labels)</th>{Object.values(languageNames).map((n) => <th scope="col">{n}</th>)}</tr></thead>
      <tbody>
        {c.causes.groups.map((g: any) => (
          <tr data-stems={g.id}>
            <th scope="row">{g.name}</th>
            <td>{g.stems.map((x: string) => `“${x}”`).join(', ')}</td>
            {Object.keys(languageNames).map((l) => <td data-language={l}>{g.languageStems[l].length ? g.languageStems[l].map((x: string) => `“${x}”`).join(', ') : 'None'}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="wave1c-ungrouped">Wave 1c labels in no group</h2>
  <p>These labels contain none of the stems that apply to them. They are listed so that nothing is silently dropped.</p>
  <dl class="rw-facts" data-ungrouped="wave1c">
    {C.map((r) => <><dt>{c.causeName[r]}</dt><dd>{c.causes.ungrouped[r].length ? (c.causes.ungrouped[r] as string[]).map((k) => `${c.causeDisplay(r, k)} (${count(c.causeCount(r, k))})`).join('; ') : 'None'}</dd></>)}
  </dl>

  <h2 id="wave1d">Wave 1d registers</h2>
  <p>Wave 1d adds the published labels of {DK.length} more registers: {DK.map((r, i) => <>{i > 0 && ' and '}<a href={url(d.base(r))}>{d.causeName[r]}</a> ({d.causeClassification[r]})</>)}. The same rule applies, with one clarification for Hebrew: a word starts where no Latin or Hebrew letter precedes it. The Wave 1b English stems apply to every label; Hebrew and Italian labels also have the stems listed below. Counts are Wave 1d dossiers, so they are never added across a row. Each label is shown as published, with Charitology’s English translation in brackets. {dNoLabels.map((k) => d.D[k].country).join(', ')} publish no category field in the files Wave 1d uses and have no column here.</p>
  <p>Stems are mechanical. The Italian stem “asd” matches the list’s column “ASD” (associazioni sportive dilettantistiche, amateur sports associations), and the Hebrew stem “ובעלי חיים” is the published wording “and animals” with its joined conjunction.</p>
  <div class="table-wrap">
    <table class="data rw-table" data-figures="cause-groups-wave1d">
      <caption>Published category labels of the Wave 1d registers by cause group. Dossier counts in brackets; a linked label has a hub with at least {d.hubMin} dossiers.</caption>
      <thead>
        <tr><th scope="col">Cause group</th>{DK.map((r) => <th scope="col">{d.causeName[r]}<span class="rw-sub">{d.causeClassification[r]}</span></th>)}</tr>
      </thead>
      <tbody>
        {d.causes.groups.map((g: any) => (
          <tr data-group-1d={g.id}>
            <th scope="row">{g.name}</th>
            {DK.map((r) => (
              <td data-registry={r}>
                {g.matches[r].length
                  ? (g.matches[r] as string[]).map((k, i) => {
                      const hub = d.causeHub(r, k);
                      return <>{i > 0 && <br />}{hub ? <a href={url(hub)}>{d.causeDisplay(r, k)}</a> : d.causeDisplay(r, k)} ({count(d.causeCount(r, k))})</>;
                    })
                  : 'No matching label'}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="wave1d-stems">Wave 1d stems by label language</h2>
  <div class="table-wrap">
    <table class="data rw-table" data-figures="cause-stems-wave1d">
      <caption>Stems per cause group for the Wave 1d registers. English stems are unchanged from Wave 1b; the Hebrew and Italian stems apply only to labels published in that language.</caption>
      <thead><tr><th scope="col">Cause group</th><th scope="col">English (all labels)</th>{Object.values(dLanguageNames).map((n) => <th scope="col">{n}</th>)}</tr></thead>
      <tbody>
        {d.causes.groups.map((g: any) => (
          <tr data-stems-1d={g.id}>
            <th scope="row">{g.name}</th>
            <td>{g.stems.map((x: string) => `“${x}”`).join(', ')}</td>
            {Object.keys(dLanguageNames).map((l) => <td data-language={l}>{g.languageStems[l].length ? g.languageStems[l].map((x: string) => `“${x}”`).join(', ') : 'None'}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="wave1d-ungrouped">Wave 1d labels in no group</h2>
  <p>These labels contain none of the stems that apply to them. They are listed so that nothing is silently dropped.</p>
  <dl class="rw-facts" data-ungrouped="wave1d">
    {DK.map((r) => <><dt>{d.causeName[r]}</dt><dd>{d.causes.ungrouped[r].length ? (d.causes.ungrouped[r] as string[]).map((k) => `${d.causeDisplay(r, k)} (${count(d.causeCount(r, k))})`).join('; ') : 'None'}</dd></>)}
  </dl>

  <Faq faqs={faqs} />

  <h2 id="limits">Sources and limits</h2>
  <p>Labels are copied from each register’s published classification: the IRS EO BMF code tables, the Charity Commission classification extract, the OSCR register download, the ACNC Registered Charities user guide and the CRA codes list. The same organization can appear in more than one register, especially Cross Border charities registered in Scotland and in England and Wales, so dossier counts are not totals of distinct organizations and are never summed across countries.</p>
  <p>Downloads: <a href={url(`${WAVE1D_DATA_PATH}cause-groups.json`)} download="charitology-cause-groups-wave1d.json">Wave 1d cause groups with every label, stem and match</a> · <a href={url(`${WAVE1C_DATA_PATH}cause-groups.json`)} download="charitology-cause-groups-wave1c.json">Wave 1c cause groups with every label, stem and match</a> · <a href={url(`${WAVE1B_DATA_PATH}cause-groups.json`)} download="charitology-cause-groups.json">cause groups with every label, stem and match</a> · <a href={url(`${WAVE1B_DATA_PATH}manifest.json`)} download="charitology-registry-wave1b-manifest.json">Wave 1b manifest</a> · <a href={url(`${WAVE1_DATA_PATH}manifest.json`)} download="charitology-registry-wave1-manifest.json">Wave 1 manifest</a>.</p>
</Entry>
