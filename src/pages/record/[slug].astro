---
import { getCollection, render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import Badges from '../../components/Badges.astro';
import CatalogAside from '../../components/CatalogAside.astro';

// An info base can have a listing or live view at src/components/record/<entry id>.astro.
// It renders under the entry's own text.
const views = import.meta.glob<{ default: any }>('../../components/record/*.astro', { eager: true });

export async function getStaticPaths() {
  const entries = await getCollection('record');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const View = views[`../../components/record/${entry.id}.astro`]?.default;
---

<Entry
  title={entry.data.title}
  eyebrow={`The Record · ${entry.data.group}`}
  summary={entry.data.summary}
  crumbs={[{ label: 'Record', href: '/record/' }, { label: entry.data.title }]}
  filePath={entry.filePath}
  review={entry.data.review}
  sources={entry.data.sources}
>
  <Badges slot="badges" status={entry.data.status} />
  <Content />
  {View && <View />}
  <CatalogAside slot="aside" entry={entry} />
</Entry>
