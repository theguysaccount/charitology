---
// One template for every entry inside an info base:
// /record/encyclopedia/<id>/, /record/interventions/<id>/, /record/case-studies/<id>/ and so on.
import ReaderNotebook from "../../../components/ReaderNotebook.astro";
import { getCollection, render } from "astro:content";
import Entry from "../../../layouts/Entry.astro";
import Badges from "../../../components/Badges.astro";
import ConditionLinks from "../../../components/ConditionLinks.astro";
import {
  RECORD_SECTIONS,
  titleForPath,
  type RecordSectionCollection,
} from "../../../lib/content";
import { CASE_KIND, VERDICT } from "../../../lib/labels";
import { editUrl, formatDate, url } from "../../../lib/site";
import causesData from "../../../data/causes.json";

const LABELS: Record<RecordSectionCollection, string> = {
  encyclopedia: "The Charitology Encyclopedia",
  interventions: "Intervention Database",
  cases: "Historical Case Studies",
  traditions: "Giving Traditions Library",
  myths: "Myth-Busting Series",
  disagreements: "Disagreement Register",
  principles: "Principles of Charitology",
  journal: "Journal of Charitology",
};

export async function getStaticPaths() {
  const out = [];
  for (const [collection, section] of Object.entries(RECORD_SECTIONS)) {
    const entries = await getCollection(collection as RecordSectionCollection);
    for (const entry of entries)
      out.push({
        params: { section, id: entry.id },
        props: { entry, collection },
      });
  }
  return out;
}

const { entry, collection } = Astro.props as {
  entry: any;
  collection: RecordSectionCollection;
};
const { Content } = await render(entry);
const d = entry.data;
const section = RECORD_SECTIONS[collection];
const sectionLabel = LABELS[collection];
const causeName = (id: string) =>
  causesData.causes.find((c) => c.id === id)?.name ?? id;

const related: { path: string; title: string }[] = await Promise.all(
  (d.related ?? []).map(async (path: string) => ({
    path,
    title: (await titleForPath(path)) ?? path,
  })),
);

let prev: any;
let next: any;
if (collection === "principles") {
  const chapters = (await getCollection("principles")).sort(
    (a, b) => a.data.chapter - b.data.chapter,
  );
  const i = chapters.findIndex((c) => c.id === entry.id);
  prev = chapters[i - 1];
  next = chapters[i + 1];
}

const eyebrow =
  collection === "myths"
    ? "Myth-Busting Series"
    : collection === "principles"
      ? `Principles of Charitology · Chapter ${d.chapter}`
      : collection === "journal"
        ? `Journal of Charitology · Vol. ${d.volume}, No. ${d.issue}`
        : sectionLabel;
const title = collection === "myths" ? `“${d.title}”` : d.title;
---

<Entry
  title={title}
  eyebrow={eyebrow}
  summary={d.summary}
  crumbs={[
    { label: "Record", href: "/record/" },
    { label: sectionLabel, href: `/record/${section}/` },
    { label: d.title },
  ]}
  filePath={entry.filePath}
  review={d.review}
  sources={d.sources ?? []}
>
  <Fragment slot="badges">
    {
      collection === "interventions" && (
        <Badges depth={d.depth} grade={d.evidence} />
      )
    }
    {
      collection === "cases" && (
        <Badges
          depth={d.depth}
          extra={[CASE_KIND[d.kind as keyof typeof CASE_KIND], d.era]}
        />
      )
    }
    {
      collection === "myths" && (
        <Badges
          extra={[`Verdict: ${VERDICT[d.verdict as keyof typeof VERDICT]}`]}
        />
      )
    }
    {
      collection === "disagreements" && (
        <Badges extra={[`Status: ${d.status}`]} />
      )
    }
    {collection === "traditions" && <Badges extra={[d.tradition]} />}
    {
      collection === "journal" && (
        <Badges extra={[d.author, formatDate(d.date)]} />
      )
    }
  </Fragment>

  {
    collection === "disagreements" && (
      <div class="positions">
        {d.positions.map((p: { name: string; claim: string }) => (
          <div class="position">
            <h3>{p.name}</h3>
            <p>{p.claim}</p>
          </div>
        ))}
      </div>
    )
  }

  <Content />
  {
    collection === "principles" && (
      <ReaderNotebook id={entry.id} title={d.title} />
    )
  }

  {
    collection === "disagreements" && (
      <>
        <h2>The cruxes</h2>
        <p>What would have to be true for each side to change its mind:</p>
        <ul>
          {d.cruxes.map((c: string) => (
            <li>{c}</li>
          ))}
        </ul>
      </>
    )
  }

  {
    collection === "cases" && (
      <>
        <h2>Lessons for the system</h2>
        <ol>
          {d.lessons.map((l: string) => (
            <li>{l}</li>
          ))}
        </ol>
      </>
    )
  }

  {
    collection === "principles" && (prev || next) && (
      <nav class="chapter-nav" aria-label="Chapters">
        {prev ? (
          <a href={url(`/record/principles/${prev.id}/`)}>
            <span class="meta">← Chapter {prev.data.chapter}</span>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={url(`/record/principles/${next.id}/`)} class="next">
            <span class="meta">Chapter {next.data.chapter} →</span>
            {next.data.title}
          </a>
        )}
      </nav>
    )
  }

  <Fragment slot="aside">
    {
      collection === "interventions" && (
        <>
          <div class="aside-box">
            <h2>How it works</h2>
            <p>{d.mechanism}</p>
          </div>
          <div>
            <h2>Profile</h2>
            <dl class="facts">
              <dt>Causes</dt>
              <dd>{d.causes.map(causeName).join(", ")}</dd>
              <dt>Time to effect</dt>
              <dd>{d.timeToEffect}</dd>
              <dt>Durability</dt>
              <dd>{d.durability}</dd>
              <dt>Feedback</dt>
              <dd>{d.feedback}</dd>
              <dt>Who steers</dt>
              <dd>{d.agency}</dd>
            </dl>
          </div>
          {d.cost && (
            <div class="aside-box">
              <h2>Cost data</h2>
              <p>
                <strong>
                  ${d.cost.low.toLocaleString("en-US")}–$
                  {d.cost.high.toLocaleString("en-US")}
                </strong>{" "}
                per {d.cost.outcome}
              </p>
              <p class="note">
                {d.cost.asOf} ·{" "}
                <a href={d.cost.source.url}>
                  {d.cost.source.publisher ?? d.cost.source.title}
                </a>
                {d.cost.note && <> · {d.cost.note}</>}
              </p>
            </div>
          )}
        </>
      )
    }
    {
      collection === "cases" && (
        <div>
          <h2>Case</h2>
          <dl class="facts">
            <dt>When</dt>
            <dd>{d.era}</dd>
            <dt>Where</dt>
            <dd>{d.place}</dd>
            <dt>Result</dt>
            <dd>{CASE_KIND[d.kind as keyof typeof CASE_KIND]}</dd>
          </dl>
        </div>
      )
    }
    {
      collection === "traditions" && (
        <div>
          <h2>Tradition</h2>
          <dl class="facts">
            <dt>Origin</dt>
            <dd>{d.origin}</dd>
            <dt>Practice</dt>
            <dd>{d.practice}</dd>
          </dl>
          <div class="aside-box lens">
            <h2>Through the source lens</h2>
            <p>{d.lens}</p>
          </div>
        </div>
      )
    }
    {
      collection === "encyclopedia" && d.aliases.length > 0 && (
        <div>
          <h2>Also called</h2>
          <p>{d.aliases.join(", ")}</p>
        </div>
      )
    }
    {
      d.conditions && (
        <ConditionLinks refs={d.conditions} heading="Related conditions" />
      )
    }
    {
      related.length > 0 && (
        <div>
          <h2>Related</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={url(r.path)}>{r.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <div>
      <a class="btn btn-ghost btn-small" href={editUrl(entry.filePath)}
        >Edit this page on GitHub</a
      >
    </div>
  </Fragment>
</Entry>

<style>
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 0.9rem;
    margin: 0;
  }
  .facts dt {
    color: var(--ink-3);
  }
  .facts dd {
    margin: 0;
    color: var(--ink);
  }
  .lens {
    margin-top: 1rem;
  }
  .positions {
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin-bottom: 2rem;
  }
  .position {
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--surface);
    padding: 1rem 1.1rem;
  }
  .position h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }
  .position p {
    margin: 0;
    font-size: 0.98rem;
    color: var(--ink-2);
  }
  .chapter-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .chapter-nav a {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
    max-width: 45%;
  }
  .chapter-nav .next {
    text-align: right;
    margin-left: auto;
  }
</style>
