---
import PageSections from "../../../components/PageSections.astro";
import Crumbs from "../../../components/Crumbs.astro";
import SiteSymbol from "../../../components/SiteSymbol.astro";
import { publicationSymbols } from "../../../lib/list-identities";
import Base from "../../../layouts/Base.astro";
import PublicationProposal from "../../../components/PublicationProposal.astro";
import type { Family } from "../../../lib/publication-editions-types";
import { loadPublicationEditions } from "../../../lib/publication-editions";
import { PUBLICATION_FAMILIES, publicationHref } from "../../../lib/publication-editions-view";
import { url } from "../../../lib/site";
import "../../../styles/publication-editions.css";
const { input, catalog, inventory } = loadPublicationEditions();
const families = (Object.entries(PUBLICATION_FAMILIES) as [Family, string][]).map(([family, label]) => ({
  family,
  slug: `captures-${family}`,
  text: label,
  symbol: publicationSymbols[family],
  editions: input.editions.filter(e => e.core.family === family).sort((a, b) => b.core.sequence - a.core.sequence),
}));
---
<Base title="Fixed publications and proposal desk" description="Read retained publication captures with their complete sources, compare their limits and prepare private, source-linked proposals.">
  <div class="wrap publication-editions">
    <Crumbs items={[{ label: "Record", href: "/record/" }, { label: "Fixed captures" }]} />
    <p class="eyebrow">The Record · accountable publication</p><h1>Keep the evidence with the edition.</h1><p class="lede">A report should keep the facts, sources and limits that its readers saw. These fixed captures make later changes inspectable.</p>
    <p>The archive distinguishes newly captured sources from preserved artifacts. A capture date does not turn an earlier label into historical proof. Every initial edition is an editorial draft; hashes preserve identity, not independent review.</p>
    <nav class="pe-actions" aria-label="Publication archive"><a class="btn btn-ghost" href={url("/record/editions/compare/")}>Compare with limits</a><a class="btn btn-ghost" href="#proposal-desk">Open the private proposal desk</a><a href={url("/api/v1/publication-editions.json")}>Public metadata API</a></nav>
    <PageSections sections={families} label="Browse by publication" />
    <section id="captures">
      <h2>The retained editions</h2>
      {families.map(({ family, slug, text, symbol, editions }) => (
        <section aria-labelledby={slug}>
          <h3 id={slug} class="identity-label"><SiteSymbol name={symbol} />{text}</h3>
          <div class="pe-grid">
            {editions.map(({ core, hash }) => (
              <article class="pe-card">
                <p class="eyebrow">Capture {core.sequence} · {core.provenance.replaceAll("-", " ")}</p>
                <h4><a class="identity-label" href={url(publicationHref(core.id))}><SiteSymbol name={symbol} size="inline" />{core.title}</a></h4>
                <p>Captured <time datetime={core.capturedAt}>{core.capturedAt}</time>. Declared publication day: {core.declaredPublicationDate ?? "unknown / not declared"}.</p>
                <p>{core.members.length} retained members · {core.sourcePins.length} exact source pins · editorial draft.</p>
                <p>{core.coverage.scope}</p>
                {input.registry.current[family] === core.id && <p>Selected current capture for this family.</p>}
                <p class="pe-hash">{hash}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </section>
    <details><summary>Archive identity, size and scope</summary><p>{input.editions.length} immutable captures, {input.sources.length} shared source snapshots and {input.artifacts.length} textual artifacts. Stored registry/source/artifact files: {inventory.storedBytes.toLocaleString("en-US")} UTF-8 bytes. Complete basis downloads: {inventory.basisBytes.toLocaleString("en-US")} bytes. Combined shipped evidence: {inventory.shippedBytes.toLocaleString("en-US")} of 20,971,520 bytes.</p><p class="pe-hash">Registry {input.registry.hash}</p><p>Current source pages and external cited websites can change. The archive keeps the exact captured repository text; it does not claim fresh external retrieval or independent source review.</p></details>
    <section id="proposal-desk"><h2 data-section-symbol="notes">Prepare a private publication proposal</h2><p>Choose a fixed source basis, write an argument and keep explicit versions. Download a selected proposal for your own redaction and a manual pull request. Nothing here publishes a page, submits a paper or sends email.</p><PublicationProposal catalog={catalog}/></section>
  </div>
</Base>
