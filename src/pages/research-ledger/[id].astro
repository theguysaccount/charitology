---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import ResearchLedger from '../../components/ResearchLedger.astro';
import { loadResearchLedger } from '../../lib/research-ledger';
export async function getStaticPaths() {
  const { current } = await loadResearchLedger();
  return current.graph.records.map((record:any)=>({params:{id:record.id},props:{recordId:record.id}}));
}
const {recordId} = Astro.props;
const ledger = await loadResearchLedger();
---
<Base title={`${recordId}: research history`} description="Exact source versions, recorded changes and review limitations for this public record.">
  <header class="page-head"><div class="wrap"><Crumbs items={[{label:'Record',href:'/record/'},{label:'Research ledger',href:'/research-ledger/'},{label:recordId}]}/><h1>Research history</h1></div></header>
  <section class="wrap section-tight"><ResearchLedger projection={ledger.current} selectedRecordId={recordId} currentEditionId={ledger.input.manifest.currentEditionId}/></section>
</Base>
