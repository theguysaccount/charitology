---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import PageSections from '../../components/PageSections.astro';
import SiteSymbol from '../../components/SiteSymbol.astro';
import { pageIdentity, type SymbolName } from '../../lib/site-identities';
import { url } from '../../lib/site';
const groups = [
  { slug: 'get-started', text: 'Get started', symbol: 'compass', cards: [
    ['Start with one job', 'Choose a practical task, inspect a first-week checklist and download the plan you reviewed. No account is needed.', '/for-charities/start/'],
    ['Website improvements and OS pilots', 'Review a private website concept, keep publication decisions with your team and choose whether a separate one-workflow OS pilot fits.', '/for-charities/website-pilots/'],
    ['Help shape Charitology', 'Share one practical problem, review a resource or explore a voluntary, bounded Charity OS trial.', '/for-charities/collaborate/'],
  ] },
  { slug: 'workspaces', text: 'Organize your work', symbol: 'board', cards: [
    ['Shared Charity OS', 'Coordinate your team across 26 modules, with accounts, roles, linked work, independent approvals and recovery.', 'https://os.charitology.org'],
    ['Local Charity OS', 'A local workspace for programs, grant deadlines, tasks and outcome records. Export your work when you need to share it.', '/tools/charity-os/'],
    ['Research and implementation plan', 'Compare ten existing systems, explore twenty public user discussions and see the remaining public-participation and integration work.', '/for-charities/os-plan/'],
  ] },
  { slug: 'resources', text: 'Find tools, benefits and peers', symbol: 'tools', cards: [
    ['Tools for charities', 'Browse external tools by the job you need to do. Check the costs, limits and official sources before choosing.', '/for-charities/tools/'],
    ['Benefits for charities', 'Find donated services, credits and discounts, with eligibility and application links. Each provider decides who qualifies.', '/for-charities/benefits/'],
    ['Networks, founders and peers', 'Find founder programs, leadership communities and organizations that connect the sector. Read the fit, access and official sources.', '/for-charities/networks/'],
    ['Teach and learn', 'Bring a systems-and-evidence lesson to a class, adapt a seminar or start a student-led discussion group.', '/learn/'],
  ] },
  { slug: 'program-learning', text: 'Fundraise and learn', symbol: 'flask', cards: [
    ['Fundraising knowledge and practice', 'Explore ads, events, appeals and donor follow-up. Read the sources, count full costs and give the next task an owner.', '/for-charities/fundraising/'],
    ['Measure and learn', 'Build a theory of change, choose indicators and plan how people served can send feedback.', '/tools/impact-measurement-toolkit/'],
    ['Model a program', 'Explore the cost per outcome and uncertainty in a model whose inputs and assumptions you can inspect.', '/tools/cost-effectiveness-model-kit/'],
    ['Evaluate a proposal', 'Use a private worksheet to consider evidence, learning and the voice of people served.', '/tools/grant-evaluator/'],
  ] },
] as const satisfies readonly {
  slug: string; text: string; symbol: SymbolName;
  cards: readonly (readonly [title: string, description: string, href: string])[];
}[];
---
<Base title="For charities" description="A workspace, practical tools and sourced directories for people running charities.">
  <header class="page-head"><div class="wrap"><Crumbs items={[{label:'For charities'}]} /><span class="eyebrow">For the people doing the work</span><h1>More room for the mission.</h1><p class="lede">Keep track of the work, find useful resources and build a clearer path from activity to learning. Start with a local browser tool or use the shared OS to coordinate your team.</p><div class="charity-actions"><a class="btn" href={url("/for-charities/start/")}>Start with one job</a><a class="btn btn-ghost" href={url("/for-charities/collaborate/")}>Discuss a practical problem</a><a class="btn btn-ghost" href={url("/for-charities/website-pilots/") + "#shift-handoff-pilot"}>Try a shift handoff</a></div></div></header>
  <div class="wrap section-tight charity-catalog">
    <PageSections sections={groups} label="Browse resources for charities" />
    {groups.map(({ slug, text, symbol, cards }) => (
      <section aria-labelledby={slug}>
        <h2 id={slug} data-section-symbol={symbol}>{text}</h2>
        <ul class="grid charity-cards" role="list">
          {cards.map(([title, description, path]) => (
            <li>
              <a class="card" href={path.startsWith('https:') ? path : url(path)}>
                <SiteSymbol name={path.startsWith('https:') ? 'teamBoard' : pageIdentity(path).symbol} />
                <h3>{title}</h3>
                <p>{description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <section class="wrap section-tight prose"><h2>Start with the system around your work</h2><p>What signals move money toward your mission? How does feedback reach the people making decisions? Where does your work act on the chain from relief to source? Use <a href={url('/method/')}>the Method</a> to put those questions beside the daily work.</p><p>These tools support planning and record keeping. Your organization remains responsible for its own accounting, legal obligations, security and decisions. The directories link to third parties; they do not imply endorsement or guaranteed eligibility.</p><p><a href={url('/roadmap/')}>See the full roadmap</a> or <a href={url('/contribute/')}>help improve a tool</a>.</p></section>
</Base>
<style>
  .charity-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .charity-catalog > section + section { margin-block-start: 2.25rem; }
  .charity-catalog h2 { margin-block-end: 0.85rem; }
  .charity-cards { list-style: none; padding: 0; margin: 0; }
  .charity-cards .card { height: 100%; }
  .charity-cards h3 { font-size: 1.3rem; }

  @media (min-width: 540px) {
    .charity-catalog :global(.page-sections ul) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
