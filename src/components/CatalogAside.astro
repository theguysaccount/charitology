---
import ConditionLinks from './ConditionLinks.astro';
import MarkedList from './MarkedList.astro';
import { editorialListSymbol } from '../lib/editorial-list-symbol';
import { STATUS } from '../lib/labels';
import { editUrl, url } from '../lib/site';
import { titleForPath, type CatalogEntry } from '../lib/content';

interface Props {
  entry: CatalogEntry;
}
const { entry } = Astro.props;
const d = entry.data;
const related = await Promise.all(
  d.related.map(async (path) => ({ path, title: (await titleForPath(path)) ?? path })),
);
---

<div class="aside-box">
  <h2>Status</h2>
  <p><strong>{STATUS[d.status].label}.</strong> {d.statusNote ?? STATUS[d.status].note}</p>
</div>
<ConditionLinks refs={d.conditions} />
{
  d.firstMilestone && (
    <div>
      <h2>First milestone</h2>
      <p>{d.firstMilestone}</p>
    </div>
  )
}
{
  d.help.length > 0 && (
    <div>
      <h2>How to help</h2>
      <MarkedList items={d.help.map((help) => [help, editorialListSymbol(help)] as const)} />
    </div>
  )
}
{
  related.length > 0 && (
    <div>
      <h2>Related</h2>
      <ul>
        {related.map((r) => (
          <li>
            <a href={url(r.path)}>{r.title}</a>
          </li>
        ))}
      </ul>
    </div>
  )
}
<div>
  <a class="btn btn-ghost btn-small" href={editUrl(entry.filePath)}>Edit this page on GitHub</a>
</div>
