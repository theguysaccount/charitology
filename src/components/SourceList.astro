---
interface Source {
  title: string;
  url: string;
  publisher?: string;
  year?: string | number;
  note?: string;
}
interface Props {
  sources: Source[];
  heading?: string;
}
const { sources, heading = 'Sources' } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="sources" aria-label={heading}>
      <h2>{heading}</h2>
      <ol>
        {sources.map((s) => (
          <li>
            <a href={s.url} rel="noopener">
              {s.title}
            </a>
            {(s.publisher || s.year) && (
              <span class="src-meta">
                {' · '}
                {[s.publisher, s.year].filter(Boolean).join(', ')}
              </span>
            )}
            {s.note && <span class="src-meta"> · {s.note}</span>}
          </li>
        ))}
      </ol>
    </section>
  )
}
