---
// The Charitology mark (geometry in src/lib/mark.mjs): a compass rose behind
// an open C, with the needle aiming out through the opening.
import { markSvg } from '../lib/mark.mjs';

interface Props {
  size?: number;
  id?: string;
}
const { size = 28, id = 'mark' } = Astro.props;
const inner = markSvg({
  id,
  accent: 'var(--accent)',
  accent2: 'color-mix(in srgb, var(--accent) 62%, #000)',
  pivot: 'var(--bg)',
});
---

<svg class="mark" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false" set:html={inner} />
