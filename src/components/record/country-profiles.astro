  [data-private-form-controls] { border:0; padding:0; margin:0; min-width:0; }
  #country-comparison :global(td details) { overflow-wrap: anywhere; }
  .country-controls {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    align-items: end;
    margin: 1rem 0;
  }
  .country-controls label {
    flex: 1;
    min-width: min(100%, 180px);
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
  input,
  select,
  textarea {
    max-width: 100%;
    width: 100%;
  }
  .country-list {
    list-style: none;
    padding: 0;
    max-height: 30rem;
    overflow: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    margin: 1.5rem 0;
  }
  .country-list li {
    padding: 0.65rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--rule);
  }
  .country-list li[hidden] {
    display: none;
  }
  .country-list li > a {
    flex: 1;
  }
  .country-list .note {
    font-size: 0.72rem;
  }
  details {
    margin: 1rem 0;
  }
  textarea {
    margin-bottom: 1rem;
  }
  .table-wrap {
    overflow: auto;
    max-width: 100%;
  }
</style>
