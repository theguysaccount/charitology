---
import { loadObservations, observationEditionHref, observationSourceHref } from "../../lib/observations";
import { countryObservationFacts, countryMissingFacts, observationCoverageAnchor } from "../../lib/observation-view";
import { url } from "../../lib/site";
const { countries, projection } = loadObservations();
const regions = [...new Set(countries.countries.map((c) => c.region))].sort();
const factViews = Object.fromEntries(countries.countries.map(c=>[c.id,Object.fromEntries(Object.entries(countryObservationFacts(projection,c.id)).map(([key,f])=>[key,{
  value:f.valueText,token:f.record.reported.token,scale:f.scaleText,unit:f.unitText,period:f.periodText,
  source:url(observationSourceHref(f.source.id,f.source.version)),sourceUrl:f.source.url,retrievedAt:f.source.retrievedAt,
  sourceId:f.source.id,sourceVersion:f.source.version,sourceHash:f.source.hash,observationId:f.record.id,observationVersion:f.record.version,observationHash:f.record.hash,precision:f.precisionText,uncertainty:f.uncertaintyText,refs:JSON.stringify([f.record.reported.valueRef,...f.record.sourceRefs]),
}]))]));
const missingViews=Object.fromEntries(countries.countries.map(c=>[c.id,Object.fromEntries(Object.entries(countryMissingFacts(projection,c.id)).map(([key,m])=>[key,{
  source:m.source?url(observationSourceHref(m.source.id,m.source.version)):null,sourceUrl:m.source?.url??null,sourceId:m.source?.id??null,sourceVersion:m.source?.version??null,sourceHash:m.source?.hash??null,
  coverageId:m.coverage.id,coverageVersion:m.coverage.version,coverageHash:m.coverage.hash,cellIndex:m.index,cellHref:url(`${observationEditionHref(projection.edition.id)}#${observationCoverageAnchor(m.coverage.id,m.coverage.version,m.index)}`),refs:JSON.stringify(m.cell.sourceRefs),
}]))]));
---

<section id="country-desk" data-countries={JSON.stringify(countries)} data-facts={JSON.stringify(factViews)} data-missing={JSON.stringify(missingViews)} data-edition={projection.edition.id} data-edition-hash={projection.edition.hash}>
  <h2>Country data desk</h2>
  <p>
    Search {countries.countries.length} countries and economies. This is a reproducible
    statistical snapshot, not a locally authored needs assessment or a list of places
    to donate. Observations may have different years. Missing data stays unknown.
  </p>
  <div class="country-controls">
    <label
      >Search countries<input
        id="country-search"
        type="search"
        placeholder="Name or country code"
      /></label
    ><label
      >Region<select id="country-region"
        ><option value="">All regions</option>{
          regions.map((r) => <option>{r}</option>)
        }</select
      ></label
    ><button id="country-reset" type="button" class="btn btn-ghost"
      >Reset filters</button
    >
  </div>
  <p id="country-count" role="status"></p>
  <div class="country-controls">
    <label
      >First country<select id="country-a" disabled
        >{
          countries.countries.map((c) => (
            <option value={c.id} selected={c.id === "KEN"}>
              {c.name}
            </option>
          ))
        }</select
      ></label
    ><label
      >Compare with<select id="country-b"
        ><option value="">No comparison</option>{
          countries.countries.map((c) => <option value={c.id}>{c.name}</option>)
        }</select
      ></label
    >
  </div>
  <div id="country-comparison" class="table-wrap"></div>
  <p class="note">
    Source: World Bank World Development Indicators and the original statistical
    producers linked below. Snapshot retrieved {countries.retrieved}; latest
    non-empty observations in 2020–2025. Exact source-normalized decimals and
    reported tokens remain visible. National averages can hide differences within a
    country. No combined need score is calculated.
  </p>
  <p><a href={url(observationEditionHref(projection.edition.id))}>Read this fixed edition, missing coverage and source-specific reuse terms</a>. Captured {projection.capturedAt}; source retrieval and observation years are distinct.</p>
  <div class="country-controls">
    <button id="country-csv" class="btn">Download comparison CSV</button><button
      id="country-note"
      class="btn btn-ghost">Download research brief</button
    >
  </div>
  <details>
    <summary>Local context worksheet</summary><p>
      These notes remain in this browser. Add public sources and consented
      perspectives; do not enter personal details about the people a program
      serves. Writing notes does not establish local coauthorship or review.
    </p><form id="country-notes-form"><fieldset data-private-form-controls disabled><label
      >What do people living here identify as priorities?<textarea
        id="country-voices" name="voices"
        maxlength="10000"
        rows="4"></textarea></label
    ><label
      >Institutions, funding and public sources to investigate<textarea
        id="country-institutions" name="institutions"
        maxlength="10000"
        rows="4"></textarea></label
    ><label
      >What the national data misses<textarea
        id="country-gaps" name="gaps"
        maxlength="10000"
        rows="4"></textarea></label
    ></fieldset></form><p id="country-storage" role="status"></p>
    <noscript><p>Local note editing needs JavaScript. Its fields stay disabled until editing is ready; no notes are submitted.</p></noscript>
    <button type="button" id="country-notes-json" class="btn btn-ghost">Download all country notes</button>
    <div id="country-navigation" hidden><p id="country-navigation-message"></p><div class="country-controls"><button type="button" id="country-navigation-save" class="btn">Try saving previous notes and open</button><button type="button" id="country-navigation-discard" class="btn btn-ghost">Discard this local version, load saved notes and open</button><button type="button" id="country-navigation-cancel" class="btn btn-ghost">Keep current country</button></div></div>
    <div id="country-notes-recovery"></div>
  </details>
  <ul id="country-list" class="country-list">
    {
      countries.countries.map((c) => (
        <li
          id={`country=${c.id}`}
          data-country={c.id}
          data-region={c.region}
          data-name={`${c.name} ${c.id} ${c.iso2}`.toLowerCase()}
        >
          <a href={url(`/record/countries/${c.id.toLowerCase()}/`)}>{c.name}</a>{" "}
          <>
            <span class="note">{c.region}</span>
            <button
              type="button"
              data-open={c.id}
              class="btn btn-small btn-ghost"
            >
              Explore {c.id}
            </button>
          </>
        </li>
      ))
    }
  </ul>
  <p id="country-empty" hidden>
    No matching countries. Try a shorter search or reset the region.
  </p>
  <details>
    <summary
      >Indicator definitions, original producers and retrieval links</summary
    >{
      countries.indicators.map((i) => (
        <section>
          <>
            <h3>
              <a href={i.url}>{i.label}</a>
            </h3>
            <p>{i.definition}</p>
            <p>{i.note}</p>
            <p class="note">{i.organization}</p>
            <a href={i.apiUrl}>
              Exact API query · source updated {i.lastUpdated}
            </a>
          </>
        </section>
      ))
    }
  </details>
</section>
<script>
  import { download, toCsv } from "../../lib/client/files";
  import {
    createRemainingRecordView,
    openRemainingRecordSession,
    remainingRecordHydratedString,
    type RRSession,
    type RRCountryNotes,
    type RRReadonly,
    type RRHydratedString,
    type RRViewToken,
  } from "../../lib/client/remaining-record-recovery";
  import {
    mountRemainingRecordRecoveryControls,
    createRemainingRecordDraftAutosaver,
    type RRRecoveryControls,
    type RRDraftAutosaver,
  } from "../../lib/client/remaining-record-recovery-controls";
  import { remainingRecordBackup } from "../../lib/client/remaining-record-recovery-formats";
  const root = document.querySelector<HTMLElement>("#country-desk");
  if (root) {
    let resumeCheckRequested = false;
    root.dataset.rrInitialization = "opening";
    const notesForm = root.querySelector<HTMLFormElement>("#country-notes-form")!;
    notesForm.addEventListener("submit", (event) => event.preventDefault(), true);
    const data = JSON.parse(root!.dataset.countries!);
    const facts = JSON.parse(root!.dataset.facts!) as Record<
      string,
      Record<
        string,
        {
          value: string;
          token: string;
          scale: string;
          unit: string;
          period: string;
          source: string;
          sourceUrl: string;
          retrievedAt: string;
          sourceId: string;
          sourceVersion: number;
          sourceHash: string;
          observationId: string;
          observationVersion: number;
          observationHash: string;
          precision: string;
          uncertainty: string;
          refs: string;
        }
      >
    >;
    const missing = JSON.parse(root!.dataset.missing!) as Record<
      string,
      Record<
        string,
        {
          source: string | null;
          sourceUrl: string | null;
          sourceId: string | null;
          sourceVersion: number | null;
          sourceHash: string | null;
          coverageId: string;
          coverageVersion: number;
          coverageHash: string;
          cellIndex: number;
          cellHref: string;
          refs: string;
        }
      >
    >;
    const countries = data.countries as any[];
    const indicators = data.indicators as any[];
    const a = root.querySelector<HTMLSelectElement>("#country-a")!;
    const b = root.querySelector<HTMLSelectElement>("#country-b")!;
    const q = root.querySelector<HTMLInputElement>("#country-search")!;
    const region = root.querySelector<HTMLSelectElement>("#country-region")!;
    const notes = ["voices", "institutions", "gaps"] as const;
    const key = "charitology-country-notes-v1" as const,
      view = createRemainingRecordView(key);
    let session: RRSession<typeof key> | null = null,
      controls: RRRecoveryControls | null = null,
      autosaver: RRDraftAutosaver<typeof key> | null = null;
    let memory: RRReadonly<RRCountryNotes> | null = null,
      primary = a.value,
      initialized = false,
      disposed = false,
      navEpoch = 0;
    const hydrated = new Map<string, RRHydratedString>();
    const storage = root.querySelector<HTMLElement>("#country-storage")!,
      fieldset = root.querySelector<HTMLFieldSetElement>(
        "[data-private-form-controls]",
      )!;
    const navPanel = root.querySelector<HTMLElement>("#country-navigation")!,
      navMessage = root.querySelector<HTMLElement>(
        "#country-navigation-message",
      )!;
    let pendingNavigation: {
      next: string;
      prior: string;
      token: RRViewToken;
      epoch: number;
    } | null = null;
    const noteField = (name: (typeof notes)[number]) => {
      const el = root!.querySelector<HTMLTextAreaElement>("#country-" + name);
      if (!el) throw Error("Missing country note field: " + name);
      return el;
    };
    const rawNotes = () =>
      Object.fromEntries(
        notes.map((name) => [name, noteField(name).value]),
      ) as RRCountryNotes[string];
    const currentNotes = () =>
      Object.fromEntries(
        notes.map((name) => [
          name,
          remainingRecordHydratedString(
            noteField(name).value,
            hydrated.get(name) ?? null,
          ),
        ]),
      ) as RRCountryNotes[string];
    function readCandidate(): RRCountryNotes {
      if (!memory)
        throw Error(
          "No admitted current note map is available. Keep the protected saved copy.",
        );
      return { ...memory, [primary]: currentNotes() };
    }
    function fillEditor() {
      hydrated.clear();
      for (const name of notes) {
        const original = memory?.[primary]?.[name] ?? "",
          el = noteField(name);
        el.value = original;
        hydrated.set(name, Object.freeze({ original, display: el.value }));
      }
    }
    function revokeNavigation() {
      navEpoch++;
      pendingNavigation = null;
      navPanel.hidden = true;
    }
    function dispose() {
      if (disposed) return;
      disposed = true;
      initialized = false;
      revokeNavigation();
      autosaver?.dispose();
      controls?.dispose();
      session?.dispose();
      view.dispose();
      fieldset.disabled = true;
      a.disabled = true;
    }
    function makeAutosaver() {
      autosaver?.dispose();
      autosaver = null;
      if (!session || !memory || disposed) return;
      const form = `country:${primary}` as const;
      autosaver = createRemainingRecordDraftAutosaver({
        session,
        view,
        form,
        readCandidate,
        onResult(result) {
          if (disposed || !view.isCurrent(result.view)) return;
          controls?.refresh();
          if (result.outcome === "saved" || result.outcome === "no-op") {
            view.markClean(form, result.view);
            storage.textContent =
              "Notes saved in this browser. No public submission or local review is implied.";
          } else
            storage.textContent =
              "The exact note map is retained in memory. Use Retry or keep native and unfinished-form backups; newer fields remain here.";
        },
        onError(error) {
          if (disposed) return;
          controls?.refresh();
          storage.textContent =
            (error instanceof Error ? error.message : "Saving was refused.") +
            " Keep this country and its unfinished fields until you resolve the saved copy.";
        },
      });
    }
    function commitPrimary(next: string) {
      const token = view.capture();
      view.markClean(`country:${primary}`, token);
      autosaver?.cancel();
      view.changedView();
      controls?.noteViewMutation();
      revokeNavigation();
      primary = next;
      a.value = next;
      fillEditor();
      makeAutosaver();
      render();
    }
    async function navigate(next: string) {
      a.value = primary;
      if (
        !initialized ||
        disposed ||
        !countries.some((country) => country.id === next) ||
        next === primary
      )
        return;
      autosaver?.cancel();
      view.changedView();
      controls?.noteViewMutation();
      revokeNavigation();
      const epoch = navEpoch,
        prior = primary;
      const state = session!.snapshot(),
        local =
          view.snapshot().dirtyForms.includes(`country:${primary}`) ||
          state.pendingPersist ||
          state.persistence === "unsaved";
      if (!local) {
        commitPrimary(next);
        return;
      }
      if (!state.pendingPersist && autosaver) {
        const saving = autosaver.flush(),
          token = view.capture();
        const result = await saving;
        if (
          disposed ||
          epoch !== navEpoch ||
          primary !== prior ||
          !view.isCurrent(token)
        )
          return;
        if (
          result &&
          (result.outcome === "saved" || result.outcome === "no-op") &&
          !session!.snapshot().pendingPersist
        ) {
          commitPrimary(next);
          return;
        }
      }
      if (disposed || epoch !== navEpoch || primary !== prior) return;
      pendingNavigation = { next, prior, token: view.capture(), epoch };
      navPanel.hidden = false;
      navMessage.textContent = `Keep ${prior}'s unfinished notes before opening ${next}. Retry any exact failed save below, then try saving these fields again. Or explicitly discard this captured local version and load the saved note map first.`;
    }
    const noteChanged = (event: Event) => {
      if (!initialized || disposed) return;
      const target = event.target as HTMLTextAreaElement | null;
      const name = notes.find((name) => noteField(name) === target);
      if (name) hydrated.delete(name);
      else hydrated.clear();
      revokeNavigation();
      view.changedForm(`country:${primary}`);
      controls?.noteViewMutation();
      autosaver?.noteInput();
    };
    notesForm.addEventListener("input", noteChanged);
    notesForm.addEventListener("change", noteChanged);
    function selected() {
      return [
        countries.find((c) => c.id === primary),
        countries.find((c) => c.id === b.value),
      ].filter(Boolean);
    }
    function render() {
      const cs = selected();
      const table = document.createElement("table");
      table.className = "data";
      const cap = table.createCaption();
      cap.textContent = "Country comparison — values and observation years";
      const head = table.createTHead().insertRow();
      for (const t of ["Indicator", ...cs.map((c) => c.name)]) {
        const th = document.createElement("th");
        th.textContent = t;
        th.scope = "col";
        head.append(th);
      }
      const body = table.createTBody();
      for (const i of indicators) {
        const row = body.insertRow();
        const th = document.createElement("th");
        th.textContent = i.label + " (" + i.unit + ")";
        th.scope = "row";
        row.append(th);
        for (const c of cs) {
          const v = c.values[i.id],
            fact = facts[c.id]?.[i.id];
          const td = row.insertCell();
          td.dataset.editionId = root!.dataset.edition!;
          td.dataset.editionHash = root!.dataset.editionHash!;
          td.textContent = fact
            ? `${fact.value} ${fact.unit} · ${fact.period}${v.status ? " · status " + v.status : ""}`
            : "Unknown: producer null throughout the selection window";
          if (v?.footnote) td.append(document.createTextNode(" · " + v.footnote));
          if (fact) {
            const link = document.createElement("a");
            link.href = fact.source;
            link.textContent = " Source, exact token and limits";
            td.append(link);
          } else if (missing[c.id]?.[i.id]?.source) {
            const link = document.createElement("a");
            link.href = missing[c.id][i.id].source!;
            link.textContent = " Source for missing-coverage finding";
            td.append(link);
          }
          const identity = document.createElement("details"),
            summary = document.createElement("summary"),
            description = document.createElement("p");
          summary.textContent = fact
            ? "Observation identity"
            : "Missing-cell identity";
          identity.append(summary, description);
          if (fact) {
            td.dataset.observationId = fact.observationId;
            td.dataset.observationVersion = String(fact.observationVersion);
            td.dataset.observationHash = fact.observationHash;
            description.textContent = `Observation ${fact.observationId} v${fact.observationVersion}; hash ${fact.observationHash}. Edition ${root!.dataset.edition}; hash ${root!.dataset.editionHash}. Source ${fact.sourceId} v${fact.sourceVersion}; hash ${fact.sourceHash}.`;
          } else {
            const absent = missing[c.id]?.[i.id];
            if (absent) {
              td.dataset.coverageId = absent.coverageId;
              td.dataset.coverageVersion = String(absent.coverageVersion);
              td.dataset.coverageHash = absent.coverageHash;
              td.dataset.cellIndex = String(absent.cellIndex);
              description.textContent = `Coverage ${absent.coverageId} v${absent.coverageVersion}, cell ${absent.cellIndex}; hash ${absent.coverageHash}. Edition ${root!.dataset.edition}; hash ${root!.dataset.editionHash}.`;
              const exact = document.createElement("a");
              exact.href = absent.cellHref;
              exact.textContent = "Read this exact missing cell";
              identity.append(exact);
            }
          }
          td.append(identity);
        }
      }
      root!.querySelector("#country-comparison")!.replaceChildren(table);
      const params = new URLSearchParams();
      params.set("country", primary);
      if (b.value) params.set("compare", b.value);
      history.replaceState(null, "", "#" + params);
    }
    function filter() {
      const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let count = 0;
      root!.querySelectorAll<HTMLElement>("[data-country]").forEach((el) => {
        el.hidden = !(
          words.every((w) => el.dataset.name!.includes(w)) &&
          (!region.value || el.dataset.region === region.value)
        );
        if (!el.hidden) count++;
      });
      root!.querySelector("#country-count")!.textContent =
        `${count} countries and economies shown`;
      root!.querySelector<HTMLElement>("#country-empty")!.hidden = count !== 0;
    }
    a.addEventListener("change", () => {
      void navigate(a.value).catch((error) => {
        if (!disposed)
          storage.textContent =
            error instanceof Error
              ? error.message
              : "Keep the prior country and unfinished notes.";
      });
    });
    b.addEventListener("change", render);
    q.addEventListener("input", filter);
    region.addEventListener("change", filter);
    root.querySelector("#country-reset")!.addEventListener("click", () => {
      q.value = "";
      region.value = "";
      filter();
    });
    root.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((el) =>
      el.addEventListener("click", () => {
        void navigate(el.dataset.open!)
          .then(() => {
            if (!disposed) {
              a.scrollIntoView({ block: "center" });
              a.focus();
            }
          })
          .catch((error) => {
            if (!disposed)
              storage.textContent =
                error instanceof Error
                  ? error.message
                  : "Keep the previous country's notes.";
          });
      }),
    );
    root
      .querySelector("#country-navigation-cancel")!
      .addEventListener("click", () => {
        if (disposed) return;
        revokeNavigation();
        view.changedView();
        controls?.noteViewMutation();
        a.value = primary;
        storage.textContent =
          "Country change canceled. The previous country's unfinished fields remain here.";
      });
    root
      .querySelector("#country-navigation-save")!
      .addEventListener("click", () => {
        const selected = pendingNavigation;
        if (
          !selected ||
          disposed ||
          selected.epoch !== navEpoch ||
          selected.prior !== primary
        )
          return;
        void navigate(selected.next).catch((error) => {
          if (!disposed)
            storage.textContent =
              error instanceof Error
                ? error.message
                : "Saving was refused; notes remain here.";
        });
      });
    root
      .querySelector("#country-navigation-discard")!
      .addEventListener("click", () => {
        const selected = pendingNavigation;
        if (
          !selected ||
          disposed ||
          !session ||
          selected.epoch !== navEpoch ||
          selected.prior !== primary ||
          !view.isCurrent(selected.token)
        )
          return;
        autosaver?.cancel();
        view.changedView();
        controls?.noteViewMutation();
        revokeNavigation();
        const epoch = navEpoch;
        const promise = session.reload({ discardLocal: true }),
          token = view.capture();
        void promise
          .then((state) => {
            if (
              disposed ||
              epoch !== navEpoch ||
              primary !== selected.prior ||
              !view.isCurrent(token)
            )
              return;
            controls?.refresh();
            if (
              state.hasCurrent &&
              (state.code === "ready" || state.code === "read-only") &&
              (state.persistence === "saved" || state.persistence === "absent")
            ) {
              memory = state.value;
              commitPrimary(selected.next);
              storage.textContent =
                "Loaded the saved note map and opened the selected country. The explicitly discarded local version was not saved.";
            } else
              storage.textContent =
                "Saved notes could not be adopted. The previous country's unfinished fields remain here. " +
                state.message;
          })
          .catch((error) => {
            if (!disposed && epoch === navEpoch && view.isCurrent(token))
              storage.textContent =
                (error instanceof Error ? error.message : "Reload was refused.") +
                " The previous notes remain here.";
          });
      });
    root.querySelector("#country-notes-json")!.addEventListener("click", () => {
      if (disposed || !initialized) return;
      try {
        download(
          "charitology-country-notes.json",
          remainingRecordBackup(key, readCandidate()),
          "application/json;charset=utf-8",
        );
        storage.textContent =
          "Requested every current country note, with this primary country's unfinished fields included. This read-only backup does not save, clear or submit them.";
      } catch (error) {
        storage.textContent =
          (error instanceof Error
            ? error.message
            : "The complete backup was refused.") +
          " Keep the fields and use unfinished-field recovery.";
      }
    });
    window.addEventListener("beforeunload", (event) => {
      if (!session || disposed) return;
      const state = session.snapshot();
      if (
        autosaver?.hasPending() ||
        state.pendingPersist ||
        state.persistence === "unsaved" ||
        view.snapshot().dirtyForms.length
      ) {
        event.preventDefault();
        event.returnValue = "";
      }
    });
    window.addEventListener("pagehide", (event) => {
      if (!event.persisted) {
        dispose();
        return;
      }
      if (disposed || !initialized) return;
      autosaver?.cancel();
      view.changedView();
      controls?.noteViewMutation();
      revokeNavigation();
      storage.textContent =
        "This page is preserved with its unfinished fields. Pending review and save authority was canceled.";
    });
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted || disposed) return;
      if (!initialized || !session) {
        resumeCheckRequested = true;
        return;
      }
      autosaver?.cancel();
      controls?.noteViewMutation();
      const notice = session.noticeExternalChange(),
        token = view.capture();
      void notice
        .then((state) => {
          if (disposed || !view.isCurrent(token)) return;
          controls?.refresh();
          storage.textContent = state.pendingPersist
            ? "The saved copy was rechecked. The exact failed operation is still pending; use Retry. Newer unfinished fields were retained."
            : state.code === "conflict" ||
                state.code === "unavailable" ||
                state.code === "corrupt"
              ? state.message +
                " Unfinished fields were retained. Review recovery before saving."
              : "The actual saved copy was rechecked. Unfinished fields were retained. Edit again to save the current fields, or keep a form backup.";
        })
        .catch((error) => {
          if (!disposed && view.isCurrent(token))
            storage.textContent =
              (error instanceof Error
                ? error.message
                : "Saved-copy check was refused.") +
              " Unfinished fields remain here.";
        });
    });
    root.querySelector("#country-csv")!.addEventListener("click", () => {
      const rows = selected().flatMap((c) =>
        indicators.map((i) => ({
          country: c.name,
          code: c.id,
          indicator: i.id,
          label: i.label,
          unit: facts[c.id]?.[i.id]?.unit ?? i.unit,
          definition: i.definition,
          value: facts[c.id]?.[i.id]?.value ?? "",
          reported_token: facts[c.id]?.[i.id]?.token ?? "",
          source_multiplier: facts[c.id]?.[i.id]?.scale ?? "",
          coverage: facts[c.id]?.[i.id]
            ? "present"
            : "producer-null-throughout-window",
          year: c.values[i.id]?.year ?? "",
          status: c.values[i.id]?.status ?? "",
          footnote: c.values[i.id]?.footnote ?? "",
          source:
            facts[c.id]?.[i.id]?.sourceUrl ??
            missing[c.id]?.[i.id]?.sourceUrl ??
            i.apiUrl,
          source_detail:
            facts[c.id]?.[i.id]?.source ?? missing[c.id]?.[i.id]?.source ?? "",
          source_hash:
            facts[c.id]?.[i.id]?.sourceHash ??
            missing[c.id]?.[i.id]?.sourceHash ??
            "",
          source_id:
            facts[c.id]?.[i.id]?.sourceId ??
            missing[c.id]?.[i.id]?.sourceId ??
            "",
          source_version:
            facts[c.id]?.[i.id]?.sourceVersion ??
            missing[c.id]?.[i.id]?.sourceVersion ??
            "",
          source_refs_json:
            facts[c.id]?.[i.id]?.refs ?? missing[c.id]?.[i.id]?.refs ?? "[]",
          coverage_hash: missing[c.id]?.[i.id]?.coverageHash ?? "",
          coverage_id: missing[c.id]?.[i.id]?.coverageId ?? "",
          coverage_version: missing[c.id]?.[i.id]?.coverageVersion ?? "",
          coverage_cell_index: missing[c.id]?.[i.id]?.cellIndex ?? "",
          coverage_cell_detail: missing[c.id]?.[i.id]?.cellHref ?? "",
          observation_hash: facts[c.id]?.[i.id]?.observationHash ?? "",
          observation_id: facts[c.id]?.[i.id]?.observationId ?? "",
          observation_version: facts[c.id]?.[i.id]?.observationVersion ?? "",
          reporting_precision: facts[c.id]?.[i.id]?.precision ?? "",
          numerical_uncertainty: facts[c.id]?.[i.id]?.uncertainty ?? "",
          edition: root!.dataset.edition,
          edition_hash: root!.dataset.editionHash,
          retrieved: data.retrieved,
        })),
      );
      download(
        "charitology-country-comparison.csv",
        toCsv(
          rows.map((row) =>
            Object.fromEntries(
              Object.entries(row).map(([key, value]) => [
                key,
                typeof value === "string" &&
                (/^[\s\u0000-\u001f]*[=+\-@]/.test(value) ||
                  /^[\t\r\n]/.test(value))
                  ? "'" + value
                  : value,
              ]),
            ),
          ),
        ),
        "text/csv;charset=utf-8",
      );
    });
    root.querySelector("#country-note")!.addEventListener("click", () => {
      const current = memory ? readCandidate() : {};
      const c = selected()[0];
      const brief = [
        `# Research brief: ${c.name}`,
        "Statistical snapshot; not locally coauthored, not reviewed, not a donation recommendation.",
        `Retrieved ${data.retrieved}. Fixed edition ${root!.dataset.edition}; hash ${root!.dataset.editionHash}.`,
        ...indicators.map((i) => {
          const v = c.values[i.id],
            fact = facts[c.id]?.[i.id];
          const absent = missing[c.id]?.[i.id];
          return `- ${i.label}: ${fact ? fact.value + " " + fact.unit + " (" + fact.period + ")" : "Unknown — producer null throughout selected window"}.${v?.footnote ? " Observation note: " + v.footnote + "." : ""}${v?.status ? " Observation status: " + v.status + "." : ""} Interpretation: ${i.note} Source: ${fact?.sourceUrl ?? absent?.sourceUrl ?? i.apiUrl}${fact ? ` Exact token: ${fact.token}; multiplier ${fact.scale}. ${fact.precision}. ${fact.uncertainty}. Source detail: ${new URL(fact.source, location.origin).href}; source ${fact.sourceId} v${fact.sourceVersion}, hash ${fact.sourceHash}; observation ${fact.observationId} v${fact.observationVersion}, hash ${fact.observationHash}.` : absent ? ` Missing coverage ${absent.coverageId} v${absent.coverageVersion}, cell ${absent.cellIndex}; hash ${absent.coverageHash}; exact cell ${new URL(absent.cellHref, location.origin).href}; source detail ${absent.source ? new URL(absent.source, location.origin).href : "not available"}.` : ""}`;
        }),
        ...notes.map(
          (n) => `\n## ${n}\n${current[c.id]?.[n] || "Not recorded."}`,
        ),
        "\n## Before publication\nAsk local coauthors to check the framing, within-country differences, public source interpretation and whose voices are absent. Obtain independent source review.",
      ].join("\n");
      download("country-" + c.id.toLowerCase() + "-research-brief.md", brief);
    });
    const params = new URLSearchParams(location.hash.slice(1));
    if (countries.some((c) => c.id === params.get("country")))
      a.value = params.get("country")!;
    if (countries.some((c) => c.id === params.get("compare")))
      b.value = params.get("compare")!;
    primary = a.value;
    render();
    filter();
    async function initializeRemainingCountries() {
      try {
        session = await openRemainingRecordSession(key, { view });
        if (resumeCheckRequested) {
          resumeCheckRequested = false;
          await session.noticeExternalChange();
        }
        const state = session.snapshot();
        memory = state.hasCurrent ? state.value : null;
        fillEditor();
        makeAutosaver();
        controls = mountRemainingRecordRecoveryControls({
          host: root!.querySelector<HTMLElement>("#country-notes-recovery")!,
          session,
          view,
          readForms: () => [
            { form: `country:${primary}`, editingId: null, values: rawNotes() },
          ],
          onStatus(state) {
            if (disposed) return;
            memory = state.hasCurrent ? state.value : null;
            fieldset.disabled = !state.hasCurrent;
          },
          onAdopt(state, token) {
            if (disposed || !state.hasCurrent || !view.isCurrent(token)) return;
            autosaver?.cancel();
            revokeNavigation();
            memory = state.value;
            fillEditor();
            for (const form of view.snapshot().dirtyForms)
              view.markClean(form, token);
            makeAutosaver();
            storage.textContent =
              "Adopted the reviewed complete note map for this country. Nothing submitted.";
          },
        });
        window.addEventListener("storage", (event) => {
          if (disposed || (event.key !== key && event.key !== null) || !session)
            return;
          autosaver?.cancel();
          revokeNavigation();
          controls?.noteViewMutation();
          const notice = session.noticeExternalChange(),
            noticeToken = view.capture();
          void notice
            .then(() => {
              if (!disposed) controls?.refresh();
            })
            .catch((error) => {
              if (!disposed && view.isCurrent(noticeToken))
                storage.textContent =
                  error instanceof Error
                    ? error.message
                    : "Saved notes changed. Keep the current country and unfinished fields.";
            });
        });
        initialized = true;
        a.disabled = false;
        root!.dataset.rrInitialization = "ready";
        storage.textContent =
          state.message ||
          "Notes stay in this browser. Statistical comparison and filters do not replace these fields.";
      } catch (error) {
        dispose();
        root!.dataset.rrInitialization = "failed";
        storage.textContent =
          "Local note editing could not start. Fields stay disabled. " +
          (error instanceof Error ? error.message : "");
        throw error;
      }
    }
    void initializeRemainingCountries().catch(() => {});
  }
</script>
