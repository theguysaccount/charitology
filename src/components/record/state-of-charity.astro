---
import PublicationEdition from "../PublicationEdition.astro";
import { loadPublicationEditions } from "../../lib/publication-editions";
import { url } from "../../lib/site";
const editionId = loadPublicationEditions().input.registry.current["state-of-charity"];
---
<PublicationEdition editionId={editionId}/>
<section>
  <h2>Questions this report cannot answer</h2>
  <p>The project has not measured these system-wide questions. Each needs evidence, a stated method and people able to challenge the result.</p>
  <ul>
    <li><a href={url("/open-problems/the-depth-census/")}>How much giving reaches sources rather than symptoms?</a></li>
    <li><a href={url("/open-problems/the-replication-rate/")}>How often do headline impact findings replicate?</a></li>
    <li><a href={url("/open-problems/the-counterfactual-problem/")}>What would a gift have achieved otherwise?</a></li>
    <li><a href={url("/open-problems/the-overhead-replacement/")}>What useful public measures could replace overhead ratios?</a></li>
    <li><a href={url("/open-problems/the-payout-question/")}>How fast should philanthropic money be spent?</a></li>
  </ul>
</section>
