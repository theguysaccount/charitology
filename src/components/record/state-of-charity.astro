---
import { getCollection } from "astro:content";
import SourceList from "../SourceList.astro";
import { EVIDENCE } from "../../lib/labels";
import { conditionsInOrder } from "../../lib/content";
import { url } from "../../lib/site";
import figures from "../../data/figures.json";

const conditions = await conditionsInOrder();
const problems = await getCollection("problems");
const programs = await getCollection("programs");
const tools = await getCollection("tools");
const record = await getCollection("record");
const catalog = [...programs, ...tools, ...record];
const datasets = [
  "conditions",
  "programs",
  "tools",
  "record",
  "interventions",
  "charities",
  "encyclopedia",
  "cases",
  "myths",
  "disagreements",
  "traditions",
  "principles",
  "journal",
] as const;
const collections = await Promise.all(
  datasets.map(async (name) => ({ name, entries: await getCollection(name) })),
);
const census = collections.map((c) => ({
  collection: c.name,
  entries: c.entries.length,
  drafts: c.entries.filter((e: any) => e.data.review === "draft").length,
}));

const solved = problems.filter((p) => p.data.status === "solved").length;
const evidenceCounts = (Object.keys(EVIDENCE) as (keyof typeof EVIDENCE)[]).map(
  (k) => ({
    key: k,
    label: EVIDENCE[k].label,
    count: conditions.filter((c) => c.data.evidence === k).length,
  }),
);
const UNKNOWNS = [
  [
    "How much giving reaches sources rather than symptoms",
    "/open-problems/the-depth-census/",
  ],
  [
    "How often headline impact findings replicate",
    "/open-problems/the-replication-rate/",
  ],
  [
    "What a gift would have achieved if it hadn’t been made",
    "/open-problems/the-counterfactual-problem/",
  ],
  [
    "What simple public measure should replace overhead ratios",
    "/open-problems/the-overhead-replacement/",
  ],
  [
    "How fast philanthropic money should be spent",
    "/open-problems/the-payout-question/",
  ],
];
const report = {
  edition: "Edition 0",
  published: "2026-10-25",
  scope:
    "U.S. financial baseline and the Charitology project, not worldwide charity totals.",
  figures,
  census,
  statuses: Object.fromEntries(
    ["live", "seeded", "designed", "partners"].map((status) => [
      status,
      catalog.filter((c) => c.data.status === status).length,
    ]),
  ),
  unknowns: UNKNOWNS,
};
---

<section class="soc" data-report={JSON.stringify(report)}>
  <p class="note">
    Published October 25, 2026. This edition combines dated U.S. financial
    estimates with a census of this project. It does not estimate worldwide
    giving or claim changes in the system that have not been measured.
  </p>
  <button class="btn" id="report-download"
    >Download the complete report and sources</button
  >
  <button class="btn btn-ghost" id="report-print">Print report</button>
  <h2>Edition 0 in numbers</h2>
  <div class="kpis">
    <div class="kpi">
      <div class="k-label">Given, U.S., {figures.usGiving.year}</div>
      <div class="k-value">${figures.usGiving.billions}B</div>
      <div class="k-note">{figures.usGiving.growth}</div>
    </div>
    <div class="kpi">
      <div class="k-label">In donor-advised funds, {figures.dafs.year}</div>
      <div class="k-value">${figures.dafs.assetsBillions}B</div>
      <div class="k-note">
        Aggregate payout {figures.dafs.payoutRate}%; prior year-end assets
        denominator
      </div>
    </div>
    <div class="kpi">
      <div class="k-label">Registered U.S. charities</div>
      <div class="k-value">1M+</div>
      <div class="k-note">{figures.registered.label}</div>
    </div>
    <div class="kpi">
      <div class="k-label">Share reaching sources</div>
      <div class="k-value">Unknown</div>
      <div class="k-note">Not measured by this project</div>
    </div>
  </div>

  <h2>The Diagnosis at Edition 0</h2>
  <p>
    {conditions.length} conditions of the charity system:
    {
      evidenceCounts
        .map(
          (e, i) =>
            `${i ? (i === evidenceCounts.length - 1 ? " and " : ", ") : ""}${e.count} ${e.label.toLowerCase()}`,
        )
        .join("")
    }.
    {problems.length} open problems, {solved} solved.
  </p>

  <h2>What the project has published</h2><p>
    Availability does not mean independent verification. The table counts
    catalog entries, reference records and textbook chapters separately; a
    collection is not a representative sample of the charitable sector.
  </p><div class="table-wrap">
    <table class="data">
      <thead
        ><tr
          ><th>Collection</th><th>Entries</th><th>Awaiting human review</th></tr
        ></thead
      ><tbody
        >{
          census.map((c) => (
            <tr>
              <>
                <th scope="row">{c.collection}</th>
                <td>{c.entries}</td>
                <td>{c.drafts}</td>
              </>
            </tr>
          ))
        }</tbody>
    </table>
  </div><p>
    <a href={url("/roadmap/")}>The original 66-item roadmap</a> distinguishes the
    actual software from operating institutions. <a
      href={url("/contribute/review/")}>The review queue</a
    > shows what still needs independent source checks.
  </p><h2>How to read the financial baseline</h2><p>
    {figures.byRecipient.note}
  </p><p>{figures.dafs.note}</p><p>
    Source categories and recipient categories describe different views of
    giving. They are not depth categories. Donor-advised fund assets are a
    stock; yearly grants are a flow. Adding those quantities would count unlike
    things. The national data below does not identify the counterfactual impact
    of a gift.
  </p>
  <h2>What Edition 0 can’t tell you</h2>
  <ul class="unknowns">
    {
      UNKNOWNS.map(([text, href]) => (
        <li>
          <a href={url(href)}>{text}</a>
        </li>
      ))
    }
  </ul>
  <p class="note">
    Each of these is an open problem. Next year’s report gets better as they are
    solved.
  </p>

  <SourceList
    sources={[
      ...figures.usGiving.sources,
      ...figures.dafs.sources,
      ...figures.registered.sources,
    ]}
    heading="Sources for these figures"
  />
</section>

<style>
  .soc {
    margin-top: 2rem;
  }
  .soc h2 {
    font-size: 1.3rem;
    margin-top: 2rem;
  }
  .soc h2:first-child {
    margin-top: 0;
  }
  .unknowns {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.4rem;
  }
</style>

<script>
  import { download } from "../../lib/client/files";
  const root = document.querySelector<HTMLElement>(".soc");
  if (root) {
    const report = JSON.parse(root.dataset.report!);
    root
      .querySelector("#report-print")!
      .addEventListener("click", () => window.print());
    root.querySelector("#report-download")!.addEventListener("click", () => {
      const f = report.figures;
      const text = [
        "# State of Charity — Edition 0",
        `Published ${report.published}. ${report.scope}`,
        "Editorial draft; independent human review remains pending.",
        "## Financial baseline",
        `U.S. giving ${f.usGiving.year}: $${f.usGiving.billions} billion. ${f.usGiving.growth}.`,
        ...f.usGiving.sources.map((s: any) => s.title + ": " + s.url),
        "### Sources of giving",
        ...f.bySource.rows.map(
          (r: any) => `${r.name}: $${r.billions} billion (${r.share}% rounded)`,
        ),
        "### Recipient categories",
        f.byRecipient.note,
        ...f.byRecipient.rows.map(
          (r: any) => `${r.name}: $${r.billions} billion`,
        ),
        "### Donor-advised funds",
        `FY ${f.dafs.year} assets: $${f.dafs.assetsBillions} billion; grants: $${f.dafs.grantsBillions} billion; contributions: $${f.dafs.contributionsBillions} billion. Aggregate payout: ${f.dafs.payoutRate}%.`,
        f.dafs.note,
        ...f.dafs.sources.map((s: any) => s.title + ": " + s.url),
        "## Project coverage",
        ...report.census.map(
          (c: any) =>
            `${c.collection}: ${c.entries} entries; ${c.drafts} drafts awaiting human review.`,
        ),
        "## Unanswered questions",
        ...report.unknowns.map(
          (u: any) => u[0] + ": https://charitology.org" + u[1],
        ),
        "## Limits",
        "These are dated source estimates and counts of this project. No global depth share, causal effect, cross-year trend or approved charity ranking is inferred. Updates must preserve source dates and definitions.",
      ].join("\n\n");
      download("state-of-charity-edition-0.md", text);
    });
  }
</script>
