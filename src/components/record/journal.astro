---
import { getCollection } from "astro:content";
import PublicationCurrent from "../PublicationCurrent.astro";
import EntryList from "../EntryList.astro";
import { formatDate, url } from "../../lib/site";
import { loadResearchLedger } from "../../lib/research-ledger";
import { ledgerHref } from "../../lib/research-ledger-model.mjs";

const ledger = await loadResearchLedger();
const journalView = (id: string) => {
  const binding = ledger.input.manifest.currentSources.find((item: any) => item.sourceKey === `journal/${id}`);
  const view = ledger.current.views.find((item: any) => item.id === binding?.recordId);
  if (!binding || !view) throw new Error(`Missing journal source history: ${id}`);
  return { binding, view };
};

const issues = (await getCollection("journal")).sort(
  (a, b) => a.data.volume - b.data.volume || a.data.issue - b.data.issue,
);
const items = issues.map((j) => ({
  href: j.id === "ten-dollars" ? "/manifesto/" : `/record/journal/${j.id}/`,
  title: j.data.title,
  summary: j.data.summary,
  kicker: `Vol. ${j.data.volume}, No. ${j.data.issue}`,
  tags: [j.data.author, formatDate(j.data.date), journalView(j.id).view.qualification.peerReview === "peer-reviewed" ? "Recorded peer review" : "Not peer-reviewed"],
}));
---

<PublicationCurrent family="journal"/>

<EntryList items={items} layout="cards" />
<details>
  <summary>Source versions and peer-review history</summary>
  <ul>{issues.map((j) => <li><a href={url(ledgerHref(journalView(j.id).binding.recordId))}>{j.data.title}: exact versions and recorded declarations</a></li>)}</ul>
</details>
<section id="journal-desk">
  <h2>Prepare a submission</h2><p>
    This browser desk produces a manuscript and review checklist. Nothing is
    sent automatically. Download the file, then open a pull request through the
    contributor guide. Publication and peer review are separate states; the
    current Volume 0 essays are editorial drafts.
  </p><form id="manuscript-form">
    <fieldset data-private-form-controls disabled>
    <label>Title<input name="title" required maxlength="200" /></label><label
      >Public author or project name<input
        name="author"
        required
        maxlength="150"
      /></label
    ><label
      >One-paragraph summary<textarea
        name="summary"
        required
        maxlength="1500"
        rows="3"></textarea></label
    ><label
      >Article type<select name="kind"
        ><option>Proposed method</option><option>Research result</option><option
          >Replication</option
        ><option>Null result or failure report</option><option>Essay</option
        ></select
      ></label
    ><label
      >Question and why it matters<textarea
        name="question"
        required
        maxlength="10000"
        rows="3"></textarea></label
    ><label
      >Methods, sampling, data and reproducibility<textarea
        name="methods"
        required
        maxlength="20000"
        rows="5"></textarea></label
    ><label
      >Results or explicitly untested proposal<textarea
        name="results"
        required
        maxlength="20000"
        rows="5"></textarea></label
    ><label
      >Limitations, harms, missing voices and strongest objections<textarea
        name="limits"
        required
        maxlength="10000"
        rows="4"></textarea></label
    ><label
      >Public source links, conflicts and funding disclosures<textarea
        name="sources"
        required
        maxlength="10000"
        rows="4"></textarea></label
    ><button class="btn" type="submit">Download manuscript draft</button><button
      class="btn btn-ghost"
      id="manuscript-backup"
      type="button">Download form backup</button>
    </fieldset>
  </form><noscript
    ><p>
      This local form needs JavaScript. Its fields stay disabled until local
      editing is ready; nothing is submitted by this form.
    </p></noscript
  ><div id="manuscript-recovery"></div><p id="manuscript-status" role="status"></p><p>
    <a
      href="https://github.com/theguysaccount/charitology/blob/main/CONTRIBUTING.md"
      >Open the contribution instructions</a
    >. Peer review requires recorded statements from two distinct eligible humans, independent of the manuscript’s authors, bound to its exact source version and inspected by a different human maintainer. Ordinary source review is a separate gate. The public ledger records the declarations and their limits; this browser form cannot grant them.
  </p>
</section>
<script>
  import { download } from "../../lib/client/files";
  import { manuscriptFields as fields } from "../../lib/client/completion-models";
  import {
    createRemainingRecordView,
    openRemainingRecordSession,
    remainingRecordHydratedString,
    type RRSession,
    type RRManuscript,
    type RRManuscriptField,
    type RRHydratedString,
  } from "../../lib/client/remaining-record-recovery";
  import {
    mountRemainingRecordRecoveryControls,
    createRemainingRecordDraftAutosaver,
    type RRRecoveryControls,
    type RRDraftAutosaver,
  } from "../../lib/client/remaining-record-recovery-controls";
  import { remainingRecordBackup } from "../../lib/client/remaining-record-recovery-formats";
  const root = document.querySelector<HTMLElement>("#journal-desk");
  if (root) {
    let resumeCheckRequested = false;
    root.dataset.rrInitialization = "opening";
    const form = root.querySelector<HTMLFormElement>("form")!;
    form.addEventListener("submit", (event) => event.preventDefault(), true);
    const fieldset = root.querySelector<HTMLFieldSetElement>(
      "[data-private-form-controls]",
    )!;
    const key = "charitology-manuscript-v1" as const,
      view = createRemainingRecordView(key);
    let session: RRSession<typeof key> | null = null,
      controls: RRRecoveryControls | null = null,
      autosaver: RRDraftAutosaver<typeof key> | null = null,
      disposed = false,
      initialized = false;
    const hydrated = new Map<RRManuscriptField, RRHydratedString>();
    const status = root.querySelector<HTMLElement>("#manuscript-status")!;
    const field = (name: RRManuscriptField) => {
      const control = form.elements.namedItem(name);
      if (!(
        control instanceof HTMLInputElement ||
        control instanceof HTMLTextAreaElement ||
        control instanceof HTMLSelectElement
      ))
        throw Error("Missing manuscript field: " + name);
      return control;
    };
    const rawValues = () =>
      Object.fromEntries(
        fields.map((name) => [name, field(name).value]),
      ) as RRManuscript;
    const values = () =>
      Object.fromEntries(
        fields.map((name) => [
          name,
          remainingRecordHydratedString(
            field(name).value,
            hydrated.get(name) ?? null,
          ),
        ]),
      ) as RRManuscript;
    function fill(value: RRManuscript | Readonly<RRManuscript>) {
      hydrated.clear();
      for (const name of fields) {
        const input = field(name);
        input.value = value[name];
        hydrated.set(
          name,
          Object.freeze({ original: value[name], display: input.value }),
        );
      }
    }
    function dispose() {
      if (disposed) return;
      disposed = true;
      initialized = false;
      autosaver?.dispose();
      controls?.dispose();
      session?.dispose();
      view.dispose();
      fieldset.disabled = true;
    }
    function changed(event: Event) {
      if (!initialized || disposed) return;
      const target = event.target as HTMLInputElement | null;
      if (target && fields.includes(target.name as RRManuscriptField))
        hydrated.delete(target.name as RRManuscriptField);
      else hydrated.clear();
      view.changedForm("manuscript");
      controls?.noteViewMutation();
      autosaver?.noteInput();
    }
    form.addEventListener("input", changed);
    form.addEventListener("change", changed);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!initialized || disposed) return;
      try {
        const v = values();
        remainingRecordBackup(key, v);
        if (fields.some((name) => !v[name].trim()))
          throw Error(
            "Complete every section, explicitly recording unknowns where needed.",
          );
        const now = new Date(),
          date = [
            now.getFullYear(),
            String(now.getMonth() + 1).padStart(2, "0"),
            String(now.getDate()).padStart(2, "0"),
          ].join("-");
        const text = `---\ntitle: ${JSON.stringify(v.title)}\nauthor: ${JSON.stringify(v.author)}\ndate: ${date}\nsummary: ${JSON.stringify(v.summary)}\nvolume: 0\nissue: 4\nreview: draft\n---\n\n**Article type: ${v.kind}. Not peer-reviewed.**\n\n## Question\n\n${v.question}\n\n## Methods and reproducibility\n\n${v.methods}\n\n## Results or proposed method\n\n${v.results}\n\n## Limitations and objections\n\n${v.limits}\n\n## Sources, conflicts and funding\n\n${v.sources}\n\n<!-- Maintainers assign the final volume and issue after review. Disclose AI assistance in the PR. -->\n`;
        download("manuscript-draft.md", text);
        status.textContent =
          "Requested the manuscript draft. Nothing sent. Include source checks and AI disclosure in your pull request. Unfinished work remains on this page.";
      } catch (error) {
        status.textContent =
          error instanceof Error
            ? error.message
            : "Keep the current form and use unfinished-field recovery.";
      }
    });
    window.addEventListener("beforeunload", (event) => {
      if (!session || disposed) return;
      if (
        autosaver?.hasPending() ||
        session.snapshot().pendingPersist ||
        session.snapshot().persistence === "unsaved" ||
        view.snapshot().dirtyForms.length
      ) {
        event.preventDefault();
        event.returnValue = "";
      }
    });
    window.addEventListener("pagehide", (event) => {
      if (!event.persisted) {
        dispose();
        return;
      }
      if (disposed || !initialized) return;
      autosaver?.cancel();
      view.changedView();
      controls?.noteViewMutation();

      status.textContent =
        "This page is preserved with its unfinished fields. Pending review and save authority was canceled.";
    });
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted || disposed) return;
      if (!initialized || !session) {
        resumeCheckRequested = true;
        return;
      }
      autosaver?.cancel();
      controls?.noteViewMutation();
      const notice = session.noticeExternalChange(),
        token = view.capture();
      void notice
        .then((state) => {
          if (disposed || !view.isCurrent(token)) return;
          controls?.refresh();
          status.textContent = state.pendingPersist
            ? "The saved copy was rechecked. The exact failed operation is still pending; use Retry. Newer unfinished fields were retained."
            : state.code === "conflict" ||
                state.code === "unavailable" ||
                state.code === "corrupt"
              ? state.message +
                " Unfinished fields were retained. Review recovery before saving."
              : "The actual saved copy was rechecked. Unfinished fields were retained. Edit again to save the current fields, or keep a form backup.";
        })
        .catch((error) => {
          if (!disposed && view.isCurrent(token))
            status.textContent =
              (error instanceof Error
                ? error.message
                : "Saved-copy check was refused.") +
              " Unfinished fields remain here.";
        });
    });
    async function initializeRemainingManuscript() {
      try {
        session = await openRemainingRecordSession(key, { view });
        if (resumeCheckRequested) {
          resumeCheckRequested = false;
          await session.noticeExternalChange();
        }
        const initial = session.snapshot();
        if (initial.hasCurrent) fill(initial.value);
        autosaver = createRemainingRecordDraftAutosaver({
          session,
          view,
          form: "manuscript",
          readCandidate: values,
          onResult(result) {
            if (disposed || !view.isCurrent(result.view)) return;
            controls?.refresh();
            if (result.outcome === "saved" || result.outcome === "no-op") {
              view.markClean("manuscript", result.view);
              status.textContent =
                "Draft saved in this browser. No submission sent.";
            } else
              status.textContent =
                "The exact draft is retained in memory. Retry that save or keep native and unfinished-form backups before leaving.";
          },
          onError(error) {
            if (!disposed) {
              controls?.refresh();
              status.textContent =
                (error instanceof Error
                  ? error.message
                  : "Draft save was refused.") +
                " Unfinished fields remain on this page.";
            }
          },
        });
        controls = mountRemainingRecordRecoveryControls({
          host: root!.querySelector<HTMLElement>("#manuscript-recovery")!,
          session,
          view,
          readForms: () => [
            { form: "manuscript", editingId: null, values: rawValues() },
          ],
          onStatus(state) {
            if (disposed) return;
            fieldset.disabled = !state.hasCurrent;
          },
          onAdopt(state, token) {
            if (disposed || !state.hasCurrent || !view.isCurrent(token)) return;
            autosaver?.cancel();
            fill(state.value);
            view.markClean("manuscript", token);
            status.textContent =
              "Adopted the reviewed manuscript draft. No submission sent.";
          },
        });
        root!
          .querySelector("#manuscript-backup")!
          .addEventListener("click", () => {
            if (disposed || !initialized) return;
            try {
              download(
                "manuscript-form.json",
                remainingRecordBackup(key, values()),
                "application/json;charset=utf-8",
              );
              status.textContent =
                "Requested a complete backup of this current partial form. This does not save or submit it.";
            } catch (error) {
              status.textContent =
                (error instanceof Error
                  ? error.message
                  : "The native form backup was refused.") +
                " Keep the form and use unfinished-field recovery.";
            }
          });
        window.addEventListener("storage", (event) => {
          if (disposed || (event.key !== key && event.key !== null) || !session)
            return;
          autosaver?.cancel();
          controls?.noteViewMutation();
          const notice = session.noticeExternalChange(),
            noticeToken = view.capture();
          void notice
            .then(() => {
              if (!disposed) controls?.refresh();
            })
            .catch((error) => {
              if (!disposed && view.isCurrent(noticeToken))
                status.textContent =
                  error instanceof Error
                    ? error.message
                    : "Saved notes changed; keep this form.";
            });
        });
        status.textContent =
          initial.message ||
          "Draft editing is ready. Nothing is submitted by this form.";
        initialized = true;
        root!.dataset.rrInitialization = "ready";
      } catch (error) {
        dispose();
        root!.dataset.rrInitialization = "failed";
        status.textContent =
          "Local editing could not start. Fields stay disabled. " +
          (error instanceof Error ? error.message : "Keep existing saved data.");
        throw error;
      }
    }
    void initializeRemainingManuscript().catch(() => {});
  }
</script>
<style>
  [data-private-form-controls] {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: grid;
    gap: 1rem;
  }
  #journal-desk {
    margin-top: 2rem;
  }
  #journal-desk form {
    display: grid;
    gap: 1rem;
  }
  #journal-desk label {
    display: grid;
    gap: 0.35rem;
    font: 0.9rem var(--font-sans);
  }
  #journal-desk input,
  #journal-desk textarea,
  #journal-desk select {
    width: 100%;
  }
</style>
