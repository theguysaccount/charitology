---
import { getCollection } from 'astro:content';
import EntryList from '../EntryList.astro';

const entries = (await getCollection('traditions')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const items = entries.map((e) => ({ href: `/record/traditions/${e.id}/`, title: e.data.title, summary: e.data.summary, kicker: e.data.tradition }));
---

<EntryList items={items} />
