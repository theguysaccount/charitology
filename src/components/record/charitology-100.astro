---
import { url } from "../../lib/site";
---

<section id="hundred-lab">
  <h2>Nomination and method lab</h2><p>
    Prepare a source-linked nomination and challenge the criteria. This tool
    does not rank, endorse or approve organizations. The public rating gate
    remains closed until independent red-team review. A complete packet is ready
    for discussion, not a recommendation.
  </p><form id="nomination-form">
    <fieldset data-private-form-controls disabled>
    <label
      >Public activity or research title<input
        name="title"
        maxlength="180"
        required
      /></label
    ><label
      >Who or what is being considered?<input
        name="subject"
        maxlength="180"
        required
      /></label
    ><label
      >Depth described<select name="depth"
        ><option value="unknown">Unclassified or disputed</option><option
          >0 · Relief</option
        ><option>1 · Repair</option><option>2 · Prevention</option><option
          >3 · Structure</option
        ><option>4 · Source</option><option
          >Multiple levels; explain below</option
        ></select
      ></label
    ><label
      >Mechanism and why that description fits<textarea
        name="mechanism"
        maxlength="5000"
        required
        rows="3"></textarea></label
    ><label
      >Relevant moral lenses and disagreements<textarea
        name="lenses"
        maxlength="5000"
        required
        rows="3"></textarea></label
    ><label
      >Evidence, dates, outcome units and public HTTPS sources<textarea
        name="evidence"
        maxlength="10000"
        required
        rows="4"></textarea></label
    ><label
      >Additional funding: use, limits and unknowns<textarea
        name="funding"
        maxlength="5000"
        required
        rows="3"></textarea></label
    ><label
      >Affected communities: agency, consent and missing voices<textarea
        name="voice"
        maxlength="5000"
        required
        rows="3"></textarea></label
    ><label
      >Strongest objection and what would change the claim<textarea
        name="objection"
        maxlength="5000"
        required
        rows="3"></textarea></label
    ><label
      >Conflicts of interest, including none known or unknown<textarea
        name="conflicts"
        maxlength="3000"
        required
        rows="2"></textarea></label
    ><div class="lab-actions">
      <button class="btn" type="submit">Save nomination</button><button
        class="btn btn-ghost"
        type="button"
        id="nomination-new">Start another</button>
    </div>
    </fieldset>
  </form><noscript
    ><p>
      This local form needs JavaScript. Its fields stay disabled until local
      editing is ready; nothing is submitted by this form.
    </p></noscript
  ><p id="nomination-status" role="status"></p><div id="nomination-list">
  </div><div class="lab-actions">
    <button class="btn" id="nomination-export"
      >Download nomination packets</button
    ><button class="btn btn-ghost" id="nomination-json"
      >Export JSON backup</button
    >
  </div><div id="nomination-recovery"></div><h3>What public review must decide</h3><ol>
    <li>
      Whether any list should be ranked at all, given disagreement across values
      and outcome units.
    </li><li>
      What evidence supports activity-level depth labels and how dissent is
      preserved.
    </li><li>
      How funding limits, harms, agency, conflicts and excluded alternatives
      change a recommendation.
    </li><li>
      Who can review, appeal or withdraw an entry, and how corrections reach
      people who relied on it.
    </li>
  </ol><p>
    <a href={url("/programs/red-team/")}>Challenge the method in public</a>.
    Public submission is a separate, deliberate action through GitHub; this
    browser form sends nothing.
  </p>
</section>
<script>
  import { download } from "../../lib/client/files";
  import {
    nominationFields as fields,
    type Nomination,
  } from "../../lib/client/completion-models";
  import {
    createRemainingRecordView,
    openRemainingRecordSession,
    remainingRecordHydratedString,
    type RRSession,
    type RRHydratedString,
    type RRReadonly,
    type RRViewToken,
  } from "../../lib/client/remaining-record-recovery";
  import {
    mountRemainingRecordRecoveryControls,
    type RRRecoveryControls,
  } from "../../lib/client/remaining-record-recovery-controls";
  const root = document.querySelector<HTMLElement>("#hundred-lab");
  if (root) {
    let resumeCheckRequested = false;
    root.dataset.rrInitialization = "opening";
    const form = root.querySelector<HTMLFormElement>("form")!;
    form.addEventListener("submit", (event) => event.preventDefault(), true);
    const fieldset = root.querySelector<HTMLFieldSetElement>(
        "[data-private-form-controls]",
      )!,
      status = root.querySelector<HTMLElement>("#nomination-status")!;
    const key = "charitology-nominations-v1" as const,
      view = createRemainingRecordView(key);
    let session: RRSession<typeof key> | null = null,
      controls: RRRecoveryControls | null = null,
      rows: RRReadonly<Nomination[]> | null = null,
      initialized = false,
      disposed = false,
      busy = false;
    let editing: { id: string; admittedNew: boolean } | null = null;
    const hydrated = new Map<string, RRHydratedString>();
    const field = (name: string) => {
      const el = form.elements.namedItem(name);
      if (!(
        el instanceof HTMLInputElement ||
        el instanceof HTMLSelectElement ||
        el instanceof HTMLTextAreaElement
      ))
        throw Error("Missing nomination field: " + name);
      return el;
    };
    const values = (native: boolean) =>
      Object.fromEntries(
        fields.map((name) => [
          name,
          native
            ? remainingRecordHydratedString(
                field(name).value,
                hydrated.get(name) ?? null,
              )
            : field(name).value,
        ]),
      );
    function reset() {
      editing = null;
      hydrated.clear();
      form.reset();
    }
    function localIntent() {
      view.changedView();
      controls?.noteViewMutation();
    }
    function resetReviewed() {
      localIntent();
      const token = view.capture();
      if (
        view.snapshot().dirtyForms.includes("nomination") &&
        !window.confirm(
          "Discard this unfinished nomination form? Keep a field backup first if needed.",
        )
      )
        return;
      if (!view.isCurrent(token)) return;
      reset();
      view.markClean("nomination", token);
    }
    function dispose() {
      if (disposed) return;
      disposed = true;
      initialized = false;
      controls?.dispose();
      session?.dispose();
      view.dispose();
      fieldset.disabled = true;
    }
    function refreshCapabilities() {
      if (!session || disposed) return;
      fieldset.disabled = !session.snapshot().hasCurrent;
      form.querySelector<HTMLButtonElement>('button[type="submit"]')!.disabled =
        busy || !session.snapshot().canWrite;
    }
    async function persist(
      candidate: Nomination[],
      tokenAction?: () => void,
      resetEditor = false,
    ) {
      if (!session || disposed || busy) return;
      controls?.noteViewMutation();
      let captured;
      let token = view.capture();
      try {
        try {
          captured = session.captureSave(candidate, { form: "nomination" });
        } finally {
          token = view.capture();
        }
      } catch (error) {
        if (!disposed && view.isCurrent(token))
          status.textContent =
            error instanceof Error
              ? error.message
              : "Saving was refused. Unfinished fields remain.";
        return;
      }
      tokenAction?.();
      busy = true;
      root!.dataset.rrBusy = "true";
      controls?.noteViewMutation();
      refreshCapabilities();
      try {
        const result = await session.saveCaptured(captured);
        if (disposed) return;
        rows = result.snapshot.hasCurrent ? result.snapshot.value : null;
        render();
        controls?.refresh();
        if (view.isCurrent(result.view)) {
          if (result.outcome === "saved" || result.outcome === "no-op") {
            if (resetEditor) {
              reset();
              view.markClean("nomination", result.view);
            }
            status.textContent =
              "Saved locally. No public review or recommendation has been completed.";
          } else
            status.textContent =
              "The exact nomination is retained in memory. Newer unfinished fields stay here; use Retry or keep both backups.";
        }
      } catch (error) {
        if (!disposed && view.isCurrent(token))
          status.textContent =
            error instanceof Error
              ? error.message
              : "Saving was refused. Unfinished fields remain.";
      } finally {
        busy = false;
        root!.dataset.rrBusy = "false";
        refreshCapabilities();
      }
    }
    function render() {
      const list = root!.querySelector<HTMLElement>("#nomination-list")!;
      list.replaceChildren();
      if (!rows) {
        const p = document.createElement("p");
        p.textContent =
          "No validated saved nominations are available. Use the protected copy and reviewed recovery below.";
        list.append(p);
        return;
      }
      if (!rows.length) {
        const p = document.createElement("p");
        p.textContent =
          "No nominations saved. Create the first source-linked packet above.";
        list.append(p);
      }
      for (const row of rows) {
        const card = document.createElement("article");
        card.className = "nomination-card";
        card.dataset.recordId = row.id;
        const heading = document.createElement("h3");
        heading.textContent = row.title;
        const p = document.createElement("p");
        p.textContent = `${row.subject} · ${row.depth} · Editorial draft; not reviewed`;
        const edit = document.createElement("button");
        edit.type = "button";
        edit.className = "btn btn-small btn-ghost";
        edit.textContent = "Edit packet";
        edit.addEventListener("click", () => {
          if (!initialized || disposed || busy) return;
          localIntent();
          const token = view.capture();
          if (
            view.snapshot().dirtyForms.includes("nomination") &&
            !window.confirm(
              "Replace this unfinished form with the selected saved packet? Keep a field backup first if needed.",
            )
          )
            return;
          if (!view.isCurrent(token)) return;
          editing = { id: row.id, admittedNew: false };
          hydrated.clear();
          for (const name of fields) {
            const el = field(name);
            el.value = row[name];
            hydrated.set(
              name,
              Object.freeze({ original: row[name], display: el.value }),
            );
          }
          view.markClean("nomination", token);
          form.scrollIntoView({ block: "start" });
        });
        const del = document.createElement("button");
        del.type = "button";
        del.className = "btn btn-small btn-ghost";
        del.textContent = "Delete packet";
        let armed: RRViewToken | null = null;
        del.addEventListener("click", () => {
          if (!initialized || disposed || busy || !session || !rows) return;
          if (!armed || !view.isCurrent(armed)) {
            localIntent();
            armed = view.capture();
            del.textContent = "Confirm delete";
            status.textContent =
              "Press Confirm delete again for this packet and this version of unfinished fields. Keep backups first if needed.";
            return;
          }
          const next = rows
            .filter((item) => item.id !== row.id)
            .map((item) => ({ ...item }));
          void persist(next, undefined, editing?.id === row.id).catch((error) => {
            if (!disposed)
              status.textContent =
                error instanceof Error
                  ? error.message
                  : "Deletion was refused. Fields remain.";
          });
        });
        del.disabled = !session?.snapshot().canWrite;
        card.append(heading, p, edit, document.createTextNode(" "), del);
        list.append(card);
      }
    }
    const changed = (event: Event) => {
      if (!initialized || disposed) return;
      const target = event.target as HTMLInputElement | null;
      if (target && fields.includes(target.name as (typeof fields)[number]))
        hydrated.delete(target.name);
      else hydrated.clear();
      view.changedForm("nomination");
      controls?.noteViewMutation();
    };
    form.addEventListener("input", changed);
    form.addEventListener("change", changed);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!initialized || disposed || busy || !rows || !session) return;
      try {
        const prior = editing;
        if (
          prior &&
          !prior.admittedNew &&
          !rows.some((row) => row.id === prior.id)
        )
          throw Error(
            "The packet being edited is no longer in current records. Keep its unfinished fields, then start a deliberate new packet.",
          );
        const proposed = prior ?? { id: crypto.randomUUID(), admittedNew: true };
        const row = { id: proposed.id, ...values(true) } as Nomination;
        const next = rows.some((item) => item.id === row.id)
          ? rows.map((item) => (item.id === row.id ? row : { ...item }))
          : [...rows.map((item) => ({ ...item })), row];
        // The new ID becomes the editor target only after complete synchronous admission.
        void persist(
          next,
          () => {
            editing = proposed;
          },
          true,
        ).catch((error) => {
          if (!disposed)
            status.textContent =
              error instanceof Error
                ? error.message
                : "The save was refused. Keep this form.";
        });
      } catch (error) {
        status.textContent =
          error instanceof Error
            ? error.message
            : "The nomination was refused. Fields remain.";
      }
    });
    root.querySelector("#nomination-new")!.addEventListener("click", () => {
      if (initialized && !disposed && !busy) resetReviewed();
    });
    window.addEventListener("beforeunload", (event) => {
      if (!session || disposed) return;
      const state = session.snapshot();
      if (
        busy ||
        state.pendingPersist ||
        state.persistence === "unsaved" ||
        view.snapshot().dirtyForms.length
      ) {
        event.preventDefault();
        event.returnValue = "";
      }
    });
    window.addEventListener("pagehide", (event) => {
      if (!event.persisted) {
        dispose();
        return;
      }
      if (disposed || !initialized) return;

      view.changedView();
      controls?.noteViewMutation();
      render();
      status.textContent =
        "This page is preserved with its unfinished fields. Pending review and save authority was canceled.";
    });
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted || disposed) return;
      if (!initialized || !session) {
        resumeCheckRequested = true;
        return;
      }

      controls?.noteViewMutation();
      const notice = session.noticeExternalChange(),
        token = view.capture();
      void notice
        .then((state) => {
          if (disposed || !view.isCurrent(token)) return;
          controls?.refresh();
          status.textContent = state.pendingPersist
            ? "The saved copy was rechecked. The exact failed operation is still pending; use Retry. Newer unfinished fields were retained."
            : state.code === "conflict" ||
                state.code === "unavailable" ||
                state.code === "corrupt"
              ? state.message +
                " Unfinished fields were retained. Review recovery before saving."
              : "The actual saved copy was rechecked. Unfinished fields were retained. Submit deliberately to save current unfinished fields, or keep a form backup.";
        })
        .catch((error) => {
          if (!disposed && view.isCurrent(token))
            status.textContent =
              (error instanceof Error
                ? error.message
                : "Saved-copy check was refused.") +
              " Unfinished fields remain here.";
        });
    });
    async function initializeRemainingNominations() {
      try {
        session = await openRemainingRecordSession(key, { view });
        if (resumeCheckRequested) {
          resumeCheckRequested = false;
          await session.noticeExternalChange();
        }
        rows = session.snapshot().hasCurrent ? session.snapshot().value : null;
        controls = mountRemainingRecordRecoveryControls({
          host: root!.querySelector<HTMLElement>("#nomination-recovery")!,
          session,
          view,
          readForms: () => [
            {
              form: "nomination",
              editingId: editing?.id ?? null,
              values: values(false),
            },
          ],
          onStatus(state) {
            if (disposed) return;
            rows = state.hasCurrent ? state.value : null;
            render();
            refreshCapabilities();
          },
          onAdopt(state, token) {
            if (disposed || !view.isCurrent(token)) return;
            rows = state.hasCurrent ? state.value : null;
            reset();
            view.markClean("nomination", token);
            render();
          },
        });
        root!.querySelector("#nomination-json")!.addEventListener("click", () => {
          try {
            if (!session || disposed) return;
            const out = session.exportNative();
            download(
              "charitology-nominations.json",
              out.text,
              "application/json;charset=utf-8",
            );
            status.textContent = `Requested all admitted nomination records (${out.persistence}). Unfinished fields have a separate backup.`;
          } catch (error) {
            status.textContent =
              error instanceof Error
                ? error.message
                : "No admitted native records are available.";
          }
        });
        root!
          .querySelector("#nomination-export")!
          .addEventListener("click", () => {
            if (!rows || !session || disposed) return;
            download(
              "charitology-nomination-packets.md",
              "# Nomination packets\n\nEditorial drafts, not rankings, recommendations or approved reviews.\n\n" +
                `Persistence: ${session.snapshot().persistence}. Unfinished forms are excluded.\n\n` +
                rows
                  .map((row) =>
                    fields.map((name) => `## ${name}\n${row[name]}`).join("\n\n"),
                  )
                  .join("\n\n---\n\n"),
            );
            status.textContent =
              "Requested every admitted nomination packet. Nothing submitted; unfinished fields remain on this page.";
          });
        window.addEventListener("storage", (event) => {
          if (disposed || (event.key !== key && event.key !== null) || !session)
            return;
          controls?.noteViewMutation();
          const notice = session.noticeExternalChange(),
            noticeToken = view.capture();
          void notice
            .then(() => {
              if (!disposed) controls?.refresh();
            })
            .catch((error) => {
              if (!disposed && view.isCurrent(noticeToken))
                status.textContent =
                  error instanceof Error
                    ? error.message
                    : "Saved nominations changed; keep unfinished fields.";
            });
        });
        initialized = true;
        render();
        refreshCapabilities();
        root!.dataset.rrInitialization = "ready";
        status.textContent =
          session.snapshot().message ||
          "Nomination editing is ready. Nothing is sent by this form.";
      } catch (error) {
        dispose();
        root!.dataset.rrInitialization = "failed";
        status.textContent =
          "Local editing could not start. Fields stay disabled. " +
          (error instanceof Error ? error.message : "");
        throw error;
      }
    }
    void initializeRemainingNominations().catch(() => {});
  }
</script>
<style>
  [data-private-form-controls] {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: grid;
    gap: 1rem;
  }
  #hundred-lab {
    margin-block: 2rem;
  }
  form {
    display: grid;
    gap: 1rem;
  }
  label {
    display: grid;
    gap: 0.35rem;
    font: 0.9rem var(--font-sans);
  }
  input,
  textarea,
  select {
    width: 100%;
  }
  .lab-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
  }
  #hundred-lab :global(.nomination-card) {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1rem;
    margin: 1rem 0;
  }
  #hundred-lab :global(.nomination-card h3) {
    margin-top: 0;
  }
  input[type="file"] {
    max-width: 230px;
  }
</style>
