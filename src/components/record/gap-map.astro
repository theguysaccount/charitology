---
import DepthCensus from "../DepthCensus.astro";
import StaticBars from "../StaticBars.astro";
import SourceList from "../SourceList.astro";
import { DEPTH } from "../../lib/labels";
import { url } from "../../lib/site";
import figures from "../../data/figures.json";
import HumanitarianFundingReference from "../HumanitarianFundingReference.astro";
import HumanitarianPlanClusterObservation from '../HumanitarianPlanClusterObservation.astro';

const bySource = figures.bySource.rows.map((r) => ({
  label: r.name,
  value: r.billions,
  display: `$${r.billions.toLocaleString("en-US")}B · ${r.share}%`,
}));
const byRecipient = figures.byRecipient.rows.map((r) => ({
  label: r.name,
  value: r.billions,
  display: `$${r.billions.toLocaleString("en-US")}B`,
}));
const byDepth = DEPTH.map((d) => ({
  label: `${d.level} · ${d.name}`,
  value: null,
  display: "Not measured",
  note: "Charitology has not assembled a giving-by-depth estimate",
}));
const allSources = [
  ...figures.usGiving.sources,
  ...figures.byRecipient.sources,
  ...figures.dafs.sources,
];
---

<div class="gap">
  <HumanitarianFundingReference />
  <HumanitarianPlanClusterObservation />
  <p><a href={url("/observations/")}>Inspect the observation and coverage register</a>. Its national statistics and selected historical financial panels are separate from these U.S. giving estimates. They do not supply a global funding/need gap or a giving-by-depth distribution. Recipient categories and giving sources are not combined into an invented residual.</p>
  <p><a class="identity-link" href={url("/record/funding-flows/")}>Browse funding cases and record searches</a>.</p>
  <p><a href={url("/record/funding-flows/iberia-hrsa/#parish")}>Read Iberia Parish’s health insurance estimates alongside a local health center’s federal grant records</a>. The case links the patient geography named in the audit notes to independent Census estimates.</p>
  <p><a href={url("/record/funding-flows/kenya-nutrition/#need")}>Compare the western Kenya nutrition project with earlier county food poverty estimates</a>. The survey describes Busia and Bungoma independently of the project’s financial reports.</p>
  <p><a href={url("/record/funding-flows/brazil-cisterns/#need")}>Compare plans for rainwater systems in Pará with an independent census baseline</a>. The case shows where the tender planned work and how residents in those municipalities reported getting water.</p>
  <p><a href={url("/record/funding-flows/taiwan-municipal-assistance/#survey-comparison")}>Read Taiwan municipal assistance beside a resident survey</a>. The two sources share three city labels in 2023 and measure different populations.</p>
  <section class="gap-panel">
    <h2 id="giving-sources">Who gives</h2>
    <p class="note">
      U.S. charitable giving by source, {figures.bySource.year}. Total ${
        figures.usGiving.billions
      } billion.
    </p>
    <StaticBars rows={bySource} label="U.S. giving by source" />
  </section>

  <section class="gap-panel">
    <h2 id="giving-recipients">What kind of organization receives</h2>
    <p class="note">
      Recipient categories, {figures.byRecipient.year}. {
        figures.byRecipient.note
      }
    </p>
    <StaticBars
      rows={byRecipient}
      label="U.S. giving to selected recipient categories"
    />
  </section>

  <section class="gap-panel">
    <h2 id="donor-advised-funds">Money waiting in donor-advised funds</h2>
    <div class="kpis">
      <div class="kpi">
        <div class="k-label">Held, {figures.dafs.year}</div>
        <div class="k-value">${figures.dafs.assetsBillions}B</div>
        <div class="k-note">assets in donor-advised funds</div>
      </div>
      <div class="kpi">
        <div class="k-label">Granted, {figures.dafs.year}</div>
        <div class="k-value">${figures.dafs.grantsBillions}B</div>
        <div class="k-note">
          to charities, a {figures.dafs.payoutRate}% payout rate
        </div>
      </div>
    </div>
    <p class="note">
      See <a href={url("/diagnosis/parked-money/")}>Parked Money</a>, a debated
      condition.
    </p>
  </section>

  <section class="gap-panel gap-missing">
    <h2 id="depth-gap">The missing axis: depth</h2>
    <p>
      How much of this money acts at each depth? <strong
        >Charitology has not measured it.</strong
      > These bars stay empty until the <a
        href={url("/open-problems/the-depth-census/")}>Depth Census</a
      > fills them.
    </p>
    <StaticBars
      rows={byDepth}
      label="Giving by depth: not yet measured"
      max={1}
    />
  </section>

  <DepthCensus />
  <SourceList sources={allSources} heading="Sources for these figures" />
</div>

<style>
  .gap {
    display: grid;
    gap: 2.5rem;
    margin-top: 2rem;
  }
  .gap-panel h2 {
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
  }
  .gap-panel .note {
    margin: 0 0 1rem;
  }
  .gap-missing {
    border: 1px dashed var(--rule);
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .gap-missing p {
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }
</style>
