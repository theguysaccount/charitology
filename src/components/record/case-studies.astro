---
import { getCollection } from 'astro:content';
import EntryList from '../EntryList.astro';
import { CASE_KIND } from '../../lib/labels';

const cases = await getCollection('cases');
const groups = (['success', 'mixed', 'failure'] as const).map((kind) => ({
  kind,
  items: cases
    .filter((c) => c.data.kind === kind)
    .sort((a, b) => a.data.era.localeCompare(b.data.era))
    .map((c) => ({ href: `/record/case-studies/${c.id}/`, title: c.data.title, summary: c.data.summary, kicker: c.data.era, depth: c.data.depth })),
}));
---

{
  groups.map((g) => (
    <section class="cs-group">
      <h2>{CASE_KIND[g.kind]}</h2>
      <EntryList items={g.items} empty="No cases of this kind yet." />
    </section>
  ))
}

<style>
  .cs-group {
    margin-top: 2.5rem;
  }
  .cs-group h2 {
    font-size: 1.35rem;
    margin: 0;
  }
  .cs-group :global(.entry-list) {
    margin-top: 1rem;
  }
</style>
