---
import { getCollection, getEntries } from 'astro:content';
import Badges from '../Badges.astro';
import { DEPTH } from '../../lib/labels';
import { url } from '../../lib/site';
import causesData from '../../data/causes.json';
import ecosystem from '../../data/ecosystem.json';

const charities = (await getCollection('charities')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const withInterventions = await Promise.all(
  charities.map(async (c) => ({ c, interventions: c.data.interventions.length ? await getEntries(c.data.interventions) : [] })),
);
const causeName = (id: string) => causesData.causes.find((x) => x.id === id)?.name ?? id;
const propublica = ecosystem.registries.find((r) => r.name.startsWith('ProPublica'))!;
const whofunds = ecosystem.registries.find((r) => r.name.startsWith('WHOFUNDS'))!;
---

<section class="ci">
  <p class="callout">
    <strong>Depth is a description, not a rating.</strong> Each classification below is a hypothesis about where an
    organization’s main work acts, based on its own description of that work. Every level is needed. Challenge any
    classification in public.
  </p>
  {charities.length === 0 && <p class="empty">No organizations classified yet. Add the first one.</p>}
  {
    DEPTH.map((d) => {
      const group = withInterventions.filter(({ c }) => c.data.depth === d.level);
      return (
        group.length > 0 && (
          <section class="ci-group">
            <h2>
              <span class={`swatch d${d.level}`} aria-hidden="true" />
              {d.level} · {d.name} <span class="meta">{d.verb}</span>
            </h2>
            <div class="grid">
              {group.map(({ c, interventions }) => (
                <article class="card" id={c.id}>
                  <h3>{c.data.name}</h3>
                  <p>{c.data.summary}</p>
                  {c.data.note && <p class="note">{c.data.note}</p>}
                  <div class="card-meta">
                    <Badges depth={c.data.depth} extra={c.data.causes.map(causeName)} />
                  </div>
                  <p class="links">
                    <a href={c.data.website}>Website</a>
                    <a href={`${propublica.search}${encodeURIComponent(c.data.name)}`}>Filings</a>
                    <a href={`${whofunds.search}${encodeURIComponent(c.data.name)}`}>Funders</a>
                    {interventions.map((i) => (
                      <a href={url(`/record/interventions/${i.id}/`)}>{i.data.title}</a>
                    ))}
                  </p>
                </article>
              ))}
            </div>
          </section>
        )
      );
    })
  }
</section>

<style>
  .ci {
    margin-top: 2rem;
  }
  .ci-group {
    margin-top: 2.5rem;
  }
  .ci-group h2 {
    font-size: 1.25rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .swatch {
    display: inline-block;
    width: 20px;
    height: 10px;
    border-radius: 2px;
  }
  .card {
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .card:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
  }
</style>
