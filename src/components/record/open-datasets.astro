---
import { availableEndpoints } from '../../lib/api';
import { url } from '../../lib/site';
import ecosystem from '../../data/ecosystem.json';

const endpoints = await availableEndpoints();
const externalProjects = [
  ...ecosystem.instruments,
  ...ecosystem.registries.filter((registry) => !ecosystem.instruments.some((project) => project.url === registry.url)),
  ...ecosystem.evaluators,
];
---

<section class="ds">
  <h2>Charitology datasets</h2>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Dataset</th><th>What it holds</th></tr></thead>
      <tbody>
        {
          endpoints.map((e) => (
            <tr>
              <td>
                <a class="identity-link" href={url(`/api/v1/${e.name}.json`)}><code>{e.name}.json</code></a>
              </td>
              <td>{e.description}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Open data the field builds on</h2>
  <ul class="ext">
    {
      externalProjects.map((x) => (
        <li>
          <a class="identity-link" href={x.url}>{x.name}</a> · {x.summary}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .ds {
    margin-top: 2rem;
  }
  .ds h2 {
    font-size: 1.3rem;
    margin-top: 2rem;
  }
  .ext {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.45rem;
  }
</style>
