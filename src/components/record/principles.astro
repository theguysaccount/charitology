---
import { getCollection } from 'astro:content';
import EntryList from '../EntryList.astro';

const chapters = (await getCollection('principles')).sort((a, b) => a.data.chapter - b.data.chapter);
const items = chapters.map((c) => ({
  href: `/record/principles/${c.id}/`,
  title: c.data.title,
  summary: c.data.summary,
  kicker: String(c.data.chapter).padStart(2, '0'),
}));
---

<EntryList items={items} layout="rows" />
