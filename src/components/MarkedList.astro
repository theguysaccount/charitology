---
import SiteSymbol from './SiteSymbol.astro';
import type { SymbolName } from '../lib/site-symbols';

interface Props {
  items: readonly (readonly [text: string, symbol: SymbolName])[];
  ordered?: boolean;
}
const { items, ordered = false } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---

<Tag class:list={['marked-list', ordered && 'marked-steps']} role={ordered ? undefined : 'list'}>
  {items.map(([text, symbol]) => (
    <li><span class="marked-line"><SiteSymbol name={symbol} size="inline" /> <span>{text}</span></span></li>
  ))}
</Tag>

<style>
  ul.marked-list {
    list-style: none;
    padding-inline-start: 0;
  }
  .marked-line {
    display: inline-grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.45rem;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .marked-list > li + li {
    margin-block-start: 0.6rem;
  }
  .marked-steps > li::marker {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
</style>
