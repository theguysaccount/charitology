---
// Alphabetical list of England and Wales dossiers. Ordering is by register name, never by amount.
import { url } from '../../lib/site';
import { dayLabel, ewDossierPath, gbp, type EwDossier } from '../../lib/registry-wave1';

interface Props {
  items: EwDossier[];
  caption: string;
}
const { items, caption } = Astro.props;
---

<div class="table-wrap">
  <table class="data rw-table">
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Charity (register name)</th>
        <th scope="col">Charity type</th>
        <th scope="col">Latest financial year ending</th>
        <th scope="col" class="num">Gross income</th>
        <th scope="col" class="num">Gross expenditure</th>
      </tr>
    </thead>
    <tbody>
      {items.map((d) => {
        const p = d.periods[0];
        return (
          <tr>
            <th scope="row"><a href={url(ewDossierPath(d.number))}>{d.name}</a><span class="rw-sub">Charity number {d.number}</span></th>
            <td>{d.charityType ?? 'Not supplied'}</td>
            <td>{dayLabel(p.end)}</td>
            <td class="num">{p.grossIncome === null ? 'Not supplied' : gbp(p.grossIncome)}</td>
            <td class="num">{p.grossExpenditure === null ? 'Not supplied' : gbp(p.grossExpenditure)}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
