---
import { markSvg } from '../lib/mark.mjs';

interface Props {
  id?: string;
  size?: number;
}
const { id = 'seal', size = 160 } = Astro.props;
const r = 78;
const circumference = 2 * Math.PI * r;
const mark = markSvg({
  id: `${id}-mark`,
  accent: 'var(--accent)',
  accent2: 'color-mix(in srgb, var(--accent) 62%, #000)',
  pivot: 'var(--bg)',
});
---

<svg class="seal" viewBox="0 0 200 200" width={size} height={size} role="img" aria-label="Charitology seal: the science of doing the most good, established 2026">
  <defs>
    <path id={`${id}-ring`} d={`M100,100 m-${r},0 a${r},${r} 0 1,1 ${r * 2},0 a${r},${r} 0 1,1 -${r * 2},0`}></path>
  </defs>
  <circle cx="100" cy="100" r="97" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
  <circle cx="100" cy="100" r="92" fill="none" stroke="currentColor" stroke-width="0.6"></circle>
  <circle cx="100" cy="100" r="62" fill="none" stroke="currentColor" stroke-width="0.8"></circle>
  <text fill="currentColor" font-size="10.4" font-weight="560" style="font-family: var(--font-display); letter-spacing: 0.08em">
    <textPath href={`#${id}-ring`} textLength={circumference - 6} lengthAdjust="spacing">
      CHARITOLOGY · THE SCIENCE OF DOING THE MOST GOOD · EST. MMXXVI ·
    </textPath>
  </text>
  <g transform="translate(52 52) scale(1.5)" set:html={mark} />
</svg>

<style>
  .seal {
    color: var(--ink);
    display: block;
  }
</style>
