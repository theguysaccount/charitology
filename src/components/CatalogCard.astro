---
import SiteSymbol from './SiteSymbol.astro';
import { pageIdentity } from '../lib/site-identities';
import Badges from './Badges.astro';
import { url } from '../lib/site';
import type { CatalogEntry } from '../lib/content';

interface Props {
  entry: CatalogEntry;
  base: string;
}
const { entry, base } = Astro.props;
const path = `${base}${entry.id}/`;
---

<a class="card" id={`item-${entry.id}`} href={url(path)}>
  <SiteSymbol name={pageIdentity(path).symbol} />
  <h3>{entry.data.title}</h3>
  <p>{entry.data.summary}</p>
  <div class="card-meta">
    <Badges status={entry.data.status} />
  </div>
</a>
