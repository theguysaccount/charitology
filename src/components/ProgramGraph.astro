---
import '../styles/program-graph.css';
import { knownProgram, programGraphLabel } from '../lib/client/program-graph-ui-helpers';
import type { Program } from '../lib/client/program-graph-model';
const { initialProgram } = Astro.props as { initialProgram: Program };
if (!knownProgram(initialProgram)) throw new Error('Unknown program graph configuration.');
---

<section class="tool program-graph" data-program-graph data-initial-program={initialProgram} data-base={import.meta.env.BASE_URL.replace(/\/$/, '')}>
  <h2>Connect your program work</h2>
  <p>Keep chosen copies of records from {programGraphLabel(initialProgram)} and the other partner workspaces together. Explain how a plan, evidence note or decision connects to another record, then review that connection when a copy changes.</p>
  <p class="note">This private browser notebook records your own snapshots and explanations. It does not establish permission, independent review, causation or observed results. The original workspaces stay separate. Files and records are not sent anywhere.</p>
  <div class="program-graph-mount"><p>The companion notebook is loading. The original workspace remains available above.</p></div>
  <noscript><p>The private program graph needs JavaScript. The original workspace description remains readable.</p></noscript>
</section>
<script>
  import { mountProgramGraph } from '../lib/client/program-graph-ui';
  import { download } from '../lib/client/files';
  document.querySelectorAll<HTMLElement>('[data-program-graph]').forEach(root => {
    mountProgramGraph(root).catch(() => {
      const host = root.querySelector<HTMLElement>('.program-graph-mount');
      if (!host) return;
      host.replaceChildren();
      const message = document.createElement('p'); message.setAttribute('role', 'alert');
      message.textContent = 'The companion notebook could not open safely. No source workspace was read or changed.';
      const button = document.createElement('button'); button.type = 'button'; button.textContent = 'Download saved graph recovery copy';
      button.addEventListener('click', () => {
        try { const raw = localStorage.getItem('charitology.program-graph.v1');
          if (raw === null) { message.textContent = 'No saved graph was found. Nothing was changed.'; return; }
          download('charitology-program-graph-saved-recovery.txt', raw);
          message.textContent = 'A download of the unchanged saved bytes was requested. This recovery text may need repair; it is not a claim of a valid backup.';
        } catch { message.textContent = 'The saved graph could not be read. No replacement was attempted.'; }
      }); host.append(message, button);
    });
  });
</script>
