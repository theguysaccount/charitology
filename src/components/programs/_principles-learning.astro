---
import LearningPortfolio from '../LearningPortfolio.astro';
import { loadCourseCriteria } from '../../lib/course-criteria';
const { certificate = false } = Astro.props;
const bundle = await loadCourseCriteria();
---

<LearningPortfolio {...bundle} mode={certificate ? 'completion' : 'course'} base={import.meta.env.BASE_URL} />
