---
import { programWorkspaces } from "../../data/partner-programs";
const { program } = Astro.props;
const config = programWorkspaces[program];
---

<section
  class="tool pw-tool"
  id={`partner-workspace-${program}`}
  data-program={program}
  aria-labelledby="pw-title"
>
  <h2 id="pw-title">{config.title}</h2><p>{config.purpose}</p><p class="note">
    {config.limits}
  </p>
  <p class="note">
    Your work stays in this browser. No account or server submission. Save each
    form, then export a backup before sharing or changing devices. Sample
    records are fictional. Backups support up to 500 records (250 per
    collection) and 8 MB, including formatting; large projects must be split
    before that limit.
  </p>
  <p id="pw-storage" class="callout" hidden>
    Browser saving is blocked or full. Your current work remains on this page;
    export JSON before leaving.
  </p>
  <div id="pw-conflict" class="callout" hidden>
    <p id="pw-conflict-text"></p><button
      type="button"
      class="btn btn-small btn-ghost"
      id="pw-reload">Load stored version</button
    ><button type="button" class="btn btn-small btn-ghost" id="pw-raw"
      >Download original stored data</button
    >
  </div>
  <p id="pw-status" role="status" class="note"></p>
  <section class="partner-readiness">
    <h3>Software and institutional readiness are separate</h3><p>
      This workspace is available now. These requirements are not established by
      using it:
    </p><ul>
      {
        config.readiness.map((item) => (
          <li>
            <strong>{item.title}.</strong> {item.reason}
          </li>
        ))
      }
    </ul><p class="note">
      Track evidence and outside authorization in the readiness records below.
      No local status confers legal approval, funding, accreditation or
      independent review.
    </p>
  </section>
  <details id="pw-context-detail" open>
    <summary>1. Set the scope and assumptions</summary><form id="pw-context">
      <div class="tool-grid" id="pw-context-fields"></div><button
        type="submit"
        class="btn btn-small">Save context and recalculate</button
      ><p class="hint">
        Calculations use the saved context. Required fields are marked with an
        asterisk.
      </p>
    </form>
  </details>
  <h3>2. Review the current picture</h3><div class="kpis" id="pw-kpis">
  </div><div class="pw-notes" id="pw-summary"></div>
  <div class="field">
    <label for="pw-search">Filter records by any word</label><input
      type="search"
      id="pw-search"
      maxlength="200"
      placeholder="Search names, sources, status or notes"
    />
  </div><p id="pw-filter-count" class="hint"></p>
  <div id="pw-collections"></div>
  <h3>3. Prepare a usable draft</h3><p>
    Preview the generated kit below. It includes the context, every saved
    record, calculations, working documents and unresolved review prompts.
    Exports include all records even while a filter is active.
  </p>
  <div class="btn-row">
    <button type="button" class="btn btn-small" id="pw-preview"
      >Refresh draft preview</button
    ><button type="button" class="btn btn-small" id="pw-markdown"
      >Export complete kit Markdown</button
    ><button type="button" class="btn btn-small btn-ghost" id="pw-csv"
      >Export records CSV</button
    ><button type="button" class="btn btn-small btn-ghost" id="pw-export"
      >Export backup JSON</button
    >
  </div>
  {
    program === "the-charitology-fund" && (
      <p>
        <>
          <button
            class="btn btn-small btn-ghost"
            type="button"
            id="pw-transparency"
          >
            Export selected-field transparency draft
          </button>
          <span class="hint">
            Review authority, sources and privacy before sharing. Internal
            conflict records are excluded; no publication occurs.
          </span>
        </>
      </p>
    )
  }
  {
    program === "charitology-summit" && (
      <p>
        <>
          <button
            class="btn btn-small btn-ghost"
            type="button"
            id="pw-calendar"
          >
            Export tentative planning calendar (.ics)
          </button>
          <span class="hint">
            Only complete noncancelled UTC slots are included. No invitation or
            event announcement is sent.
          </span>
        </>
      </p>
    )
  }
  <details id="pw-preview-detail">
    <summary>Read generated draft</summary><pre
      id="pw-draft"
      tabindex="0"
      aria-label="Generated draft preview">
    </pre>
  </details>
  <div class="btn-row pw-actions">
    <button type="button" class="btn btn-small btn-ghost" id="pw-import"
      >Import backup JSON</button
    ><button type="button" class="btn btn-small btn-ghost" id="pw-sample"
      >Load fictional example</button
    ><button type="button" class="btn btn-small btn-ghost" id="pw-undo" disabled
      >Undo last change</button
    ><button type="button" class="btn btn-small btn-ghost" id="pw-reset"
      >Clear workspace</button
    ><input type="file" id="pw-file" accept=".json,application/json" hidden />
  </div>
  <noscript
    >This workspace needs JavaScript for local editing, calculations and
    exports. The program charter above remains readable.</noscript
  >
</section>
<style>
  .pw-tool :global([hidden]) {
    display: none !important;
  }
  .pw-tool details {
    border-top: 1px solid var(--rule);
    padding: 1rem 0;
  }
  .pw-tool summary {
    font-weight: 700;
    cursor: pointer;
  }
  .pw-tool form {
    padding-top: 1rem;
  }
  .pw-tool .tool-grid {
    align-items: start;
  }
  .pw-tool :global(.pw-wide) {
    grid-column: 1/-1;
  }
  .pw-tool :global(.pw-cards) {
    display: grid;
    gap: 1rem;
    margin-block: 1rem;
  }
  .pw-tool :global(.pw-card) {
    border: 1px solid var(--rule);
    padding: 1rem;
    min-width: 0;
  }
  .pw-tool :global(.pw-card h4) {
    margin-top: 0;
    overflow-wrap: anywhere;
  }
  .pw-tool :global(.pw-facts) {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(0, 2fr);
    gap: 0.4rem 1rem;
    font-size: 0.9rem;
  }
  .pw-tool :global(.pw-facts dt) {
    font-weight: 600;
  }
  .pw-tool :global(.pw-facts dd) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .pw-tool :global(.pw-analysis) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    font-size: 0.9rem;
  }
  .pw-tool :global(.pw-editor) {
    background: var(--bg-2);
    padding: 1rem;
  }
  .pw-notes {
    font-size: 0.9rem;
  }
  .pw-actions {
    margin-top: 1.5rem;
  }
  #pw-draft {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-height: 65vh;
    overflow: auto;
    border: 1px solid var(--rule);
    padding: 1rem;
    font: inherit;
    font-size: 0.85rem;
  }
  #pw-context-detail {
    margin-block: 1rem;
  }
  @media (max-width: 600px) {
    .pw-tool :global(.pw-facts) {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .pw-tool :global(.pw-facts dd) {
      margin-bottom: 0.6rem;
    }
  }
</style>
<script>
  import { $, clear, h } from "../../lib/client/dom";
  import { url } from "../../lib/site";
  import {
    programWorkspaces,
    type ProgramField,
  } from "../../data/partner-programs";
  import {
    emptyWorkspace,
    sampleWorkspace,
    parseWorkspace,
    validValues,
    defaults,
    partnerStorage,
    recordId,
    workspaceSummary,
    workspaceMarkdown,
    workspaceCsv,
    recordAnalysis,
    savePartnerRecord,
    deletePartnerRecord,
    savePartnerContext,
    PartnerSession,
    partnerBackup,
    MAX_PARTNER_BACKUP_BYTES,
    type ProgramState,
  } from "../../lib/client/partner-programs";
  import {
    fundTransparency,
    summitCalendar,
  } from "../../lib/client/partner-programs";
  import { canPersist } from "../../lib/client/persist";
  import { download } from "../../lib/client/files";
  import { confirmTwice } from "../../lib/client/confirm";
  const root = $(".pw-tool");
  const config = programWorkspaces[(root as HTMLElement).dataset.program!];
  const { key: storageKey, guard } = partnerStorage(config.id);
  let state = emptyWorkspace(config);
  const session = new PartnerSession();
  let blocked = "";
  let originalRaw = "";
  const dirtyForms = new Set<string>();
  const say = (message: string) => {
    $("#pw-status").textContent = message;
  };
  $("#pw-storage").hidden = canPersist();
  function readStored() {
    try {
      originalRaw = guard.read() ?? "";
    } catch {
      $("#pw-storage").hidden = false;
      blocked = "";
      showBlock();
      return false;
    }
    try {
      state = originalRaw
        ? parseWorkspace(JSON.parse(originalRaw), config)
        : emptyWorkspace(config);
      session.loaded();
      $<HTMLButtonElement>("#pw-undo").disabled = true;
      blocked = "";
    } catch {
      blocked =
        "Stored data could not be read. Editing is paused to protect it. Download the original data, then import a valid backup, load the example or clear this workspace.";
    }
    showBlock();
    return !blocked;
  }
  function showBlock() {
    $("#pw-conflict").hidden = !blocked;
    $("#pw-conflict-text").textContent = blocked;
    $<HTMLButtonElement>("#pw-raw").hidden = !originalRaw;
  }
  function allowed() {
    if (blocked) {
      say(
        "Editing is paused. Load the stored version, import a valid backup or use the confirmed reset/example action.",
      );
      $("#pw-conflict").scrollIntoView({ block: "center" });
      return false;
    }
    return true;
  }
  function persist(message: string) {
    state.updated = new Date().toISOString();
    try {
      const next = JSON.stringify(state);
      guard.write(next);
      session.persisted();
      originalRaw = next;
      $("#pw-storage").hidden = true;
      say(message);
    } catch (error) {
      session.failed();
      $("#pw-storage").hidden = false;
      blocked = error instanceof Error ? error.message : "Saving failed.";
      showBlock();
      say(
        `${message} Changes remain on this page only. ${blocked} Export your version before reloading.`,
      );
    }
  }
  function remember() {
    session.remember(state);
    $<HTMLButtonElement>("#pw-undo").disabled = false;
  }
  function inputFor(
    field: ProgramField,
    prefix: string,
    values: Record<string, string>,
  ) {
    const id = `${prefix}-${field.key}`;
    const attrs = {
      id,
      name: field.key,
      required: !field.optional,
      maxlength: field.kind === "textarea" ? 5000 : 500,
    };
    let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    if (field.kind === "textarea") input = h("textarea", { ...attrs, rows: 3 });
    else if (field.kind === "select")
      input = h(
        "select",
        { ...attrs },
        ...(field.options ?? []).map((v) => h("option", { value: v }, v)),
      );
    else
      input = h("input", {
        ...attrs,
        type: field.kind ?? "text",
        ...(field.kind === "number"
          ? {
              min: field.key === "years" ? 1 : (field.min ?? 0),
              max: Math.min(field.max ?? 1e9, 1e9),
              step: ["employees", "years"].includes(field.key) ? "1" : "any",
            }
          : {}),
      });
    input.value = values[field.key] ?? "";
    input.addEventListener("input", () => dirtyForms.add(prefix));
    return h(
      "div",
      { class: `field ${field.kind === "textarea" ? "pw-wide" : ""}` },
      h(
        "label",
        { for: id },
        field.label + (field.optional ? " (optional)" : " *"),
      ),
      input,
      field.hint ? h("span", { class: "hint" }, field.hint) : null,
    );
  }
  function formValues(form: HTMLFormElement, fields: ProgramField[]) {
    const data = new FormData(form);
    return validValues(
      Object.fromEntries(
        fields.map((f) => [f.key, String(data.get(f.key) ?? "")]),
      ),
      fields,
    );
  }
  function renderContext() {
    const target = $("#pw-context-fields");
    clear(target);
    config.context.forEach((f) =>
      target.append(inputFor(f, "pw-context", state.context)),
    );
  }
  const collectionEditors = new Map<
    string,
    {
      detail: HTMLDetailsElement;
      form: HTMLFormElement;
      fields: HTMLElement;
      cancel: HTMLButtonElement;
      title: HTMLElement;
      edit: string;
    }
  >();
  function buildCollections() {
    const target = $("#pw-collections");
    clear(target);
    config.collections.forEach((c) => {
      const heading = h("h3", {}, c.label);
      const title = h("summary", {}, `Add ${c.singular}`);
      const fields = h("div", { class: "tool-grid" });
      const form = h("form", {});
      const cancel = h(
        "button",
        { type: "button", class: "btn btn-small btn-ghost", hidden: true },
        "Cancel edit",
      );
      const detail = h("details", { class: "pw-editor" }, title, form);
      const editor = { detail, form, fields, cancel, title, edit: "" };
      collectionEditors.set(c.key, editor);
      form.append(
        fields,
        h(
          "div",
          { class: "btn-row" },
          h(
            "button",
            { type: "submit", class: "btn btn-small" },
            `Save ${c.singular}`,
          ),
          cancel,
        ),
      );
      const resetEditor = () => {
        editor.edit = "";
        clear(fields);
        c.fields.forEach((f) =>
          fields.append(inputFor(f, `pw-${c.key}`, defaults(c.fields))),
        );
        title.textContent = `Add ${c.singular}`;
        cancel.hidden = true;
        detail.open = false;
        dirtyForms.delete(`pw-${c.key}`);
      };
      resetEditor();
      cancel.addEventListener("click", () => {
        resetEditor();
        say("Edit canceled. Saved records did not change.");
      });
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!allowed()) return;
        try {
          const values = formValues(form, c.fields);
          const total = Object.values(state.records).reduce(
            (sum, r) => sum + r.length,
            0,
          );
          if (
            !editor.edit &&
            (state.records[c.key].length >= 250 || total >= 500)
          )
            throw new Error(
              "Record limit reached. Export and split a larger project into separate workspaces.",
            );
          remember();
          state = savePartnerRecord(state, config, c.key, values, editor.edit);
          persist(
            `${c.singular[0].toUpperCase() + c.singular.slice(1)} saved.`,
          );
          resetEditor();
          render();
        } catch (error) {
          say(
            error instanceof Error
              ? error.message
              : "The record could not be saved.",
          );
        }
      });
      target.append(
        h(
          "section",
          { "aria-label": c.label },
          heading,
          h("p", { class: "note" }, c.description),
          detail,
          h("div", { class: "pw-cards", id: `pw-rows-${c.key}` }),
        ),
      );
    });
  }
  function render() {
    const summary = workspaceSummary(config, state);
    clear($("#pw-kpis"));
    summary.metrics.forEach((m) =>
      $("#pw-kpis").append(
        h(
          "div",
          { class: "kpi" },
          h("div", { class: "k-label" }, m.label),
          h("div", { class: "k-value" }, m.value),
        ),
      ),
    );
    clear($("#pw-summary"));
    summary.notes.forEach((note) => $("#pw-summary").append(h("p", {}, note)));
    const search = $<HTMLInputElement>("#pw-search").value.toLowerCase().trim();
    let shown = 0,
      total = 0;
    config.collections.forEach((c) => {
      const target = $(`#pw-rows-${c.key}`);
      clear(target);
      const records = state.records[c.key];
      total += records.length;
      const filtered = records.filter(
        (r) =>
          !search ||
          Object.values(r.values).some((v) => v.toLowerCase().includes(search)),
      );
      shown += filtered.length;
      if (!filtered.length)
        target.append(
          h(
            "p",
            { class: "note" },
            records.length
              ? "No records match this filter. Clear the search to see your saved work."
              : `No ${c.label.toLowerCase()} yet. Add ${/^[aeiou]/i.test(c.singular) ? "an" : "a"} ${c.singular} above, or load the fictional example to explore the workflow.`,
          ),
        );
      filtered.forEach((record) => {
        const v = record.values;
        const facts = h("dl", { class: "pw-facts" });
        c.fields
          .filter((f) => f.key !== "title" && v[f.key])
          .forEach((f) => {
            const value =
              f.kind === "url"
                ? h(
                    "a",
                    {
                      href: v[f.key],
                      target: "_blank",
                      rel: "noopener noreferrer",
                    },
                    v[f.key],
                  )
                : f.key === "reading" && /^\/(?!\/)/.test(v[f.key])
                  ? h("a", { href: url(v[f.key]) }, "Open reading or tool")
                  : v[f.key];
            facts.append(h("dt", {}, f.label), h("dd", {}, value));
          });
        const edit = h(
          "button",
          { type: "button", class: "btn btn-small btn-ghost" },
          `Edit ${v.title || c.singular}`,
        );
        const remove = h(
          "button",
          { type: "button", class: "btn btn-small btn-ghost" },
          `Delete ${v.title || c.singular}`,
        );
        edit.addEventListener("click", () => {
          if (!allowed()) return;
          if (
            dirtyForms.has(`pw-${c.key}`) &&
            !confirm(
              "Discard unsaved edits in this collection and load the selected record?",
            )
          )
            return;
          dirtyForms.delete(`pw-${c.key}`);
          const editor = collectionEditors.get(c.key)!;
          editor.edit = record.id;
          clear(editor.fields);
          c.fields.forEach((f) =>
            editor.fields.append(inputFor(f, `pw-${c.key}`, v)),
          );
          editor.title.textContent = `Edit ${c.singular}`;
          editor.cancel.hidden = false;
          editor.detail.open = true;
          editor.detail.scrollIntoView({ block: "center", behavior: "smooth" });
          editor.form
            .querySelector<HTMLInputElement>("input, textarea, select")
            ?.focus({ preventScroll: true });
        });
        confirmTwice(remove, {
          prompt: `Confirm delete ${c.singular}`,
          announce: say,
          action: () => {
            if (!allowed()) return;
            remember();
            state = deletePartnerRecord(state, c.key, record.id);
            persist("Record deleted. Undo is available.");
            render();
          },
        });
        const analysis = recordAnalysis(config, state, c.key, v);
        target.append(
          h(
            "article",
            { class: "pw-card" },
            h("h4", {}, v.title || c.singular),
            facts,
            analysis.length
              ? h(
                  "div",
                  { class: "pw-analysis" },
                  ...analysis.map((line) => h("p", {}, line)),
                )
              : null,
            h("div", { class: "btn-row" }, edit, remove),
          ),
        );
      });
    });
    $("#pw-filter-count").textContent =
      `${shown} of ${total} saved records shown. Exports include every saved record.`;
    $("#pw-draft").textContent = workspaceMarkdown(config, state);
  }
  $("#pw-context").addEventListener("submit", (event) => {
    event.preventDefault();
    if (!allowed()) return;
    try {
      const next = formValues(
        event.currentTarget as HTMLFormElement,
        config.context,
      );
      remember();
      state = savePartnerContext(state, config, next);
      dirtyForms.delete("pw-context");
      persist("Context saved and calculations updated.");
      render();
    } catch (error) {
      say(
        error instanceof Error ? error.message : "Context could not be saved.",
      );
    }
  });
  $("#pw-search").addEventListener("input", render);
  $("#pw-preview").addEventListener("click", () => {
    $("#pw-draft").textContent = workspaceMarkdown(config, state);
    $<HTMLDetailsElement>("#pw-preview-detail").open = true;
    say(
      "Draft refreshed from saved forms. Unsaved form edits are not included.",
    );
  });
  $("#pw-markdown").addEventListener("click", () => {
    download(
      `charitology-${config.id}-kit.md`,
      workspaceMarkdown(config, state),
    );
    say(
      "Complete kit exported from saved forms. Read and review before sharing.",
    );
  });
  $("#pw-csv").addEventListener("click", () => {
    download(
      `charitology-${config.id}-records.csv`,
      workspaceCsv(config, state),
      "text/csv;charset=utf-8",
    );
    say(
      "All saved context and record fields exported in a long-format CSV. Text that looks like a spreadsheet formula is escaped.",
    );
  });
  $("#pw-export").addEventListener("click", () => {
    download(
      `charitology-${config.id}-backup.json`,
      partnerBackup(state),
      "application/json",
    );
    say("Saved workspace exported. Unsaved forms are not included.");
  });
  $("#pw-raw").addEventListener("click", () =>
    download(`charitology-${config.id}-original.txt`, originalRaw),
  );
  $("#pw-reload").addEventListener("click", () => {
    if (
      session.needsDiscard(dirtyForms.size) &&
      !confirm(
        "Discard unsaved forms and any in-memory-only workspace changes? Export your work first, then load the stored version.",
      )
    )
      return;
    if (!readStored()) return;
    renderContext();
    buildCollections();
    render();
    dirtyForms.clear();
    if (!blocked) say("Stored version loaded.");
  });
  const file = $<HTMLInputElement>("#pw-file");
  $("#pw-import").addEventListener("click", () => file.click());
  file.addEventListener("change", async () => {
    const selected = file.files?.[0];
    file.value = "";
    if (!selected) return;
    if (selected.size > MAX_PARTNER_BACKUP_BYTES)
      return void say(
        "Choose a JSON backup no larger than 8 MB. Exported workspaces use the same size limit.",
      );
    try {
      const next = parseWorkspace(JSON.parse(await selected.text()), config);
      if (
        !confirm(
          `Import ${Object.values(next.records).reduce((s, rows) => s + rows.length, 0)} records and replace this ${config.id} workspace? ${session.needsDiscard(dirtyForms.size) ? "This discards unsaved forms and in-memory-only changes. " : ""}Export a backup first if needed.`,
        )
      )
        return;
      remember();
      state = next;
      dirtyForms.clear();
      blocked = "";
      showBlock();
      persist(
        "Backup imported and calculations recomputed. Undo is available.",
      );
      renderContext();
      buildCollections();
      render();
    } catch (error) {
      say(
        error instanceof Error
          ? error.message
          : "This file could not be read. Nothing changed.",
      );
    }
  });
  confirmTwice($<HTMLButtonElement>("#pw-sample"), {
    prompt: "Confirm replace with example",
    announce: say,
    action: () => {
      if (
        session.needsDiscard(dirtyForms.size) &&
        !confirm(
          "Discard unsaved forms and in-memory-only changes to load the example? Export first if needed.",
        )
      )
        return;
      remember();
      state = sampleWorkspace(config);
      dirtyForms.clear();
      blocked = "";
      showBlock();
      persist(
        "Fictional example loaded. Replace every assumption before using it for real work. Undo is available.",
      );
      renderContext();
      buildCollections();
      render();
    },
  });
  confirmTwice($<HTMLButtonElement>("#pw-reset"), {
    prompt: "Confirm clear workspace",
    announce: say,
    action: () => {
      if (
        session.needsDiscard(dirtyForms.size) &&
        !confirm(
          "Discard unsaved forms and in-memory-only changes to clear this workspace? Export first if needed.",
        )
      )
        return;
      remember();
      state = emptyWorkspace(config);
      dirtyForms.clear();
      blocked = "";
      showBlock();
      persist(
        "Workspace cleared. Undo is available until you make another saved change.",
      );
      renderContext();
      buildCollections();
      render();
    },
  });
  $("#pw-undo").addEventListener("click", () => {
    if (!session.undo || !allowed()) return;
    if (
      session.needsDiscard(dirtyForms.size) &&
      !confirm(
        "Discard unsaved forms and in-memory-only changes and undo the last saved change?",
      )
    )
      return;
    state = session.undo;
    dirtyForms.clear();
    session.undo = undefined;
    $<HTMLButtonElement>("#pw-undo").disabled = true;
    persist("Last saved change undone.");
    renderContext();
    buildCollections();
    render();
  });
  document.getElementById("pw-transparency")?.addEventListener("click", () => {
    download("fund-transparency-planning-draft.md", fundTransparency(state));
    say(
      "Selected-field transparency draft downloaded. No publication, grant or payment occurred. Review it before sharing.",
    );
  });
  document.getElementById("pw-calendar")?.addEventListener("click", () => {
    const calendar = summitCalendar(state);
    download(
      "tentative-summit-planning.ics",
      calendar.text,
      "text/calendar;charset=utf-8",
    );
    say(
      `Tentative calendar exported: ${calendar.included} complete planning slot(s); ${calendar.excluded} incomplete or cancelled. No event announced or invitation sent.`,
    );
  });
  window.addEventListener("storage", (event) => {
    if (event.key !== storageKey && event.key !== null) return;
    if (event.key === storageKey) originalRaw = event.newValue ?? "";
    blocked =
      "This workspace changed in another tab. Editing is paused to avoid replacing newer work. Export your current version, then load the stored version.";
    showBlock();
    say(blocked);
  });
  window.addEventListener("beforeunload", (event) => {
    if (session.needsDiscard(dirtyForms.size)) {
      event.preventDefault();
      event.returnValue = "";
    }
  });
  readStored();
  renderContext();
  buildCollections();
  render();
</script>
