---
import ProgramGraph from "../ProgramGraph.astro";
import { programWorkspaces } from "../../data/partner-programs";
const { program } = Astro.props;
const config = programWorkspaces[program];
---

<section
  class="tool pw-tool"
  id={`partner-workspace-${program}`}
  data-program={program}
  aria-labelledby="pw-title"
>
  <h2 id="pw-title">{config.title}</h2><p>{config.purpose}</p><p class="note">
    {config.limits}
  </p>
  <p class="note">
    Your work stays in this browser. No account or server submission. Save each
    form, then export a backup before sharing or changing devices. Sample
    records are fictional. Backups support up to 500 records (250 per
    collection) and 8 MB, including formatting; large projects must be split
    before that limit.
  </p>
  <p id="pw-save-state" class="note">Opening the local record snapshot…</p>
  <p id="pw-storage" class="callout" hidden><span id="pw-storage-message"></span></p>
  <div id="pw-record-recovery"></div>
  <p id="pw-status" role="status" class="note"></p>
  <section class="partner-readiness">
    <h3>Software and institutional readiness are separate</h3><p>
      This workspace is available now. These requirements are not established by
      using it:
    </p><ul>
      {
        config.readiness.map((item) => (
          <li>
            <strong>{item.title}.</strong> {item.reason}
          </li>
        ))
      }
    </ul><p class="note">
      Track evidence and outside authorization in the readiness records below.
      No local status confers legal approval, funding, accreditation or
      independent review.
    </p>
  </section>
  <details id="pw-context-detail" open>
    <summary>1. Set the scope and assumptions</summary><form id="pw-context">
      <div class="tool-grid" id="pw-context-fields"></div><button
        type="submit"
        data-pw-save
        disabled
        class="btn btn-small">Save context and recalculate</button
      ><button type="button" id="pw-context-replace" class="btn btn-small btn-ghost" disabled>Review replacing failed save with this context</button><p class="hint">
        Calculations use the saved context. Required fields are marked with an
        asterisk.
      </p>
    </form>
  </details>
  <h3>2. Review the current picture</h3><div class="kpis" id="pw-kpis">
  </div><div class="pw-notes" id="pw-summary"></div>
  <div class="field">
    <label for="pw-search">Filter records by any word</label><input
      type="search"
      id="pw-search"
      maxlength="200"
      placeholder="Search names, sources, status or notes"
    />
  </div><p id="pw-filter-count" class="hint"></p>
  <div id="pw-collections"></div>
  <h3>3. Prepare a usable draft</h3><p>
    Preview the generated kit below. It includes the context, every saved
    record, calculations, working documents and unresolved review prompts.
    Exports include all records even while a filter is active.
  </p>
  <div class="btn-row">
    <button type="button" class="btn btn-small" id="pw-preview" disabled
      >Refresh draft preview</button
    ><button type="button" class="btn btn-small" id="pw-markdown" disabled
      >Export complete kit Markdown</button
    ><button type="button" class="btn btn-small btn-ghost" id="pw-csv" disabled
      >Export records CSV</button
    ><button type="button" class="btn btn-small btn-ghost" id="pw-export" disabled
      >Export backup JSON</button
    >
  </div>
  {
    program === "the-charitology-fund" && (
      <p>
        <>
          <button
            class="btn btn-small btn-ghost"
            type="button"
            id="pw-transparency" disabled
          >
            Export selected-field transparency draft
          </button>
          <span class="hint">
            Review authority, sources and privacy before sharing. Internal
            conflict records are excluded; no publication occurs.
          </span>
        </>
      </p>
    )
  }
  {
    program === "charitology-summit" && (
      <p>
        <>
          <button
            class="btn btn-small btn-ghost"
            type="button"
            id="pw-calendar" disabled
          >
            Export tentative planning calendar (.ics)
          </button>
          <span class="hint">
            Only complete noncancelled UTC slots are included. No invitation or
            event announcement is sent.
          </span>
        </>
      </p>
    )
  }
  <details id="pw-preview-detail">
    <summary>Read generated draft</summary><pre
      id="pw-draft"
      tabindex="0"
      aria-label="Generated draft preview">
    </pre>
  </details>
  <div class="btn-row pw-actions">
    <button type="button" class="btn btn-small btn-ghost" id="pw-sample" disabled
      >Review fictional example</button>
  </div>
  <p class="note">
    Use Backups and recovery above to restore native JSON, remove this saved key,
    undo a record change or retry a failed save. Unfinished fields have a separate
    recovery download.
  </p>
  <label class="note"><input type="checkbox" id="pw-sample-discard" /> Allow the
    reviewed replacement to discard this local version and unfinished fields.
  </label>
  <p class="hint">After a failed save, Retry keeps that exact change. To replace it instead,
    review the context or an existing record form below. Before adding a new record
    in another form, resolve the failed save; keep unfinished-field copies first.</p>
  <div id="pw-sample-preview" class="callout" hidden>
    <p id="pw-sample-summary"></p>
    <div class="btn-row">
      <button type="button" class="btn btn-small" id="pw-sample-apply"
        >Apply reviewed replacement</button>
      <button type="button" class="btn btn-small btn-ghost" id="pw-sample-cancel"
        >Cancel replacement</button>
    </div>
  </div>
  <noscript
    >This workspace needs JavaScript for local editing, calculations and
    exports. The program charter above remains readable.</noscript
  >
</section>
<ProgramGraph initialProgram={program} />
<style>
  .pw-tool :global([hidden]) {
    display: none !important;
  }
  .pw-tool details {
    border-top: 1px solid var(--rule);
    padding: 1rem 0;
  }
  .pw-tool summary {
    font-weight: 700;
    cursor: pointer;
  }
  .pw-tool form {
    padding-top: 1rem;
  }
  .pw-tool .tool-grid {
    align-items: start;
  }
  .pw-tool :global(.pw-wide) {
    grid-column: 1/-1;
  }
  .pw-tool :global(.pw-cards) {
    display: grid;
    gap: 1rem;
    margin-block: 1rem;
  }
  .pw-tool :global(.pw-card) {
    border: 1px solid var(--rule);
    padding: 1rem;
    min-width: 0;
  }
  .pw-tool :global(.pw-card h4) {
    margin-top: 0;
    overflow-wrap: anywhere;
  }
  .pw-tool :global(.pw-facts) {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(0, 2fr);
    gap: 0.4rem 1rem;
    font-size: 0.9rem;
  }
  .pw-tool :global(.pw-facts dt) {
    font-weight: 600;
  }
  .pw-tool :global(.pw-facts dd) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .pw-tool :global(.pw-analysis) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    font-size: 0.9rem;
  }
  .pw-tool :global(.pw-editor) {
    background: var(--bg-2);
    padding: 1rem;
  }
  .pw-notes {
    font-size: 0.9rem;
  }
  .pw-actions {
    margin-top: 1.5rem;
  }
  #pw-draft {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-height: 65vh;
    overflow: auto;
    border: 1px solid var(--rule);
    padding: 1rem;
    font: inherit;
    font-size: 0.85rem;
  }
  #pw-context-detail {
    margin-block: 1rem;
  }
  @media (max-width: 600px) {
    .pw-tool :global(.pw-facts) {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .pw-tool :global(.pw-facts dd) {
      margin-bottom: 0.6rem;
    }
  }
</style>
<script>
  import { $, $$, clear, h } from "../../lib/client/dom";
  import { url } from "../../lib/site";
  import {
    programWorkspaces,
    type ProgramField,
  } from "../../data/partner-programs";
  import {
    emptyWorkspace,
    sampleWorkspace,
    defaults,
    recordId,
    workspaceSummary,
    workspaceMarkdown,
    workspaceCsv,
    recordAnalysis,
    fundTransparency,
    summitCalendar,
    type ProgramState,
  } from "../../lib/client/partner-programs";
  import { download } from "../../lib/client/files";
  import {
    createRemainingRecordView,
    openRemainingRecordSession,
    type RRPartnerKey,
    type RRSession,
    type RRSnapshot,
    type RRViewToken,
    type RRFormId,
    type RRRawForm,
    type RRRestorePreview,
    type RRCapturedSave,
  } from "../../lib/client/remaining-record-recovery";
  import {
    mountRemainingRecordRecoveryControls,
    type RRRecoveryControls,
  } from "../../lib/client/remaining-record-recovery-controls";
  const root = $<HTMLElement>(".pw-tool"),
    config = programWorkspaces[root.dataset.program!];
  const key = ("charitology.partner-workspace-v1." + config.id) as RRPartnerKey;
  const view = createRemainingRecordView(key);
  let session: RRSession<typeof key> | undefined,
    controls: RRRecoveryControls | undefined;
  let state = emptyWorkspace(config); // Form defaults only until actual admission.
  let hasCurrent = false,
    busy = false,
    disposed = false,
    resumeCheckRequested = false;
  let sample: RRRestorePreview<typeof key> | undefined;
  type FieldInput = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
  // Native controls can sanitize an admitted string while displaying it. Keep
  // its original bytes until an explicit input/change owns the displayed text.
  const hydratedValues = new WeakMap<
    FieldInput,
    { original: string; display: string }
  >();
  function fieldValue(input: FieldInput) {
    const hydrated = hydratedValues.get(input);
    return hydrated && input.value === hydrated.display
      ? hydrated.original
      : input.value;
  }
  const collectionForm = (name: string) => ("collection:" + name) as RRFormId;
  const say = (message: string) => {
    if (!disposed) $("#pw-status").textContent = message;
  };
  const errorText = (error: unknown) =>
    error instanceof Error
      ? error.message
      : "This local action could not finish.";
  function invalidateSample() {
    sample = undefined;
    $("#pw-sample-preview").hidden = true;
    $<HTMLInputElement>("#pw-sample-discard").checked = false;
  }
  function changed(form?: RRFormId) {
    if (disposed) return;
    if (form) view.changedForm(form);
    else view.changedView();
    controls?.noteViewMutation();
    invalidateSample();
    refreshStatus();
  }
  function writable() {
    if (disposed || busy || !session?.snapshot().canWrite) {
      say(
        "Saving is unavailable. Keep unfinished fields or use reviewed recovery.",
      );
      return false;
    }
    return true;
  }
  function refreshStatus(refreshControls = true) {
    if (disposed) return;
    const snapshot = session?.snapshot(),
      canWrite = !!snapshot?.canWrite;
    $$<HTMLButtonElement>("[data-pw-save], [data-pw-mutation]").forEach(
      (button) => (button.disabled = busy || !canWrite),
    );
    $$<HTMLButtonElement>("[data-pw-edit]").forEach(
      (button) => (button.disabled = busy || !hasCurrent),
    );
    for (const id of [
      "pw-export",
      "pw-markdown",
      "pw-csv",
      "pw-preview",
      "pw-transparency",
      "pw-calendar",
    ])
      document.getElementById(id)?.setAttribute("data-pw-output", "true");
    $$<HTMLButtonElement>("[data-pw-output]").forEach(
      (button) => (button.disabled = !hasCurrent),
    );
    $<HTMLButtonElement>("#pw-sample").disabled =
      busy ||
      !snapshot ||
      ["read-only", "unavailable", "disposed"].includes(snapshot.code);
    $<HTMLButtonElement>("#pw-sample-apply").disabled = busy || !sample;
    $("#pw-save-state").textContent = !snapshot
      ? "Opening the local record snapshot…"
      : !snapshot.hasCurrent
        ? "No validated record snapshot loaded"
        : snapshot.persistence === "saved"
          ? "Validated records saved in this browser"
          : snapshot.persistence === "absent"
            ? "Empty workspace · not saved"
            : "Current records are unsaved memory";
    if (view.snapshot().dirtyForms.length)
      $("#pw-save-state").textContent += " · unfinished fields";
    $("#pw-storage").hidden = !snapshot || snapshot.code === "ready";
    $("#pw-storage-message").textContent = snapshot?.message || "";
    $<HTMLButtonElement>("#pw-context-replace").disabled =
      busy || !hasCurrent || !snapshot?.pendingPersist;
    $$<HTMLButtonElement>("[data-pw-replace]").forEach((button) => {
      const editor = collectionEditors.get(button.dataset.pwReplace!);
      button.disabled = busy || !snapshot?.pendingPersist || !editor?.edit;
    });
    if (refreshControls) controls?.refresh();
  }
  function readForms(): readonly RRRawForm[] {
    // Raw-field recovery records the actual exposed controls. Original admitted
    // source spelling is retained separately by the native snapshot and backup.
    const read = (form: HTMLFormElement, fields: ProgramField[]) =>
      Object.fromEntries(
        fields.map((field) => [
          field.key,
          form.querySelector<FieldInput>('[name="' + field.key + '"]')!.value,
        ]),
      );
    return [
      {
        form: "context",
        editingId: null,
        values: read($<HTMLFormElement>("#pw-context"), config.context),
      },
      ...config.collections.map((c) => {
        const editor = collectionEditors.get(c.key)!;
        return {
          form: collectionForm(c.key),
          editingId: editor.edit || null,
          values: read(editor.form, c.fields),
        };
      }),
    ];
  }
  function accept(
    snapshot: RRSnapshot<typeof key>,
    token?: RRViewToken,
    reset = false,
    refreshControls = true,
  ) {
    if (disposed || (token && !view.isCurrent(token))) return;
    const actual = session?.snapshot();
    if (actual && actual.generation !== snapshot.generation) return;
    hasCurrent = snapshot.hasCurrent;
    if (snapshot.hasCurrent)
      state = structuredClone(snapshot.value) as ProgramState;
    if (reset && snapshot.hasCurrent) {
      renderContext();
      buildCollections();
      for (const form of view.snapshot().dirtyForms) view.markClean(form, token!);
      invalidateSample();
    }
    render();
    refreshStatus(refreshControls);
  }
  function captureChange(next: ProgramState, form: RRFormId | null = null) {
    if (!writable() || !session) return null;
    controls?.noteViewMutation();
    invalidateSample();
    // One timestamp belongs to this explicit command; Retry retains it exactly.
    next.updated = new Date().toISOString();
    return session.captureSave(next, { form });
  }
  async function persistCaptured(
    captured: RRCapturedSave<typeof key>,
    message: string,
  ) {
    if (!session) return { saved: false, current: false };
    busy = true;
    refreshStatus();
    try {
      const result = await session.saveCaptured(captured);
      if (disposed) return { saved: false, current: false };
      accept(result.snapshot);
      const saved = result.outcome === "saved" || result.outcome === "no-op",
        current = result.viewCurrent && view.isCurrent(result.view);
      if (saved && current && captured.form)
        view.markClean(captured.form, result.view);
      if (current)
        say(
          saved
            ? message
            : result.outcome === "unsaved"
              ? "Saving failed. This exact validated change remains in memory for native backup or Retry; unfinished fields were kept."
              : "A newer edit replaced this save. Its unfinished fields were kept.",
        );
      return { saved, current };
    } catch (error) {
      if (!disposed && view.isCurrent(captured.view)) say(errorText(error));
      return { saved: false, current: false };
    } finally {
      busy = false;
      refreshStatus();
    }
  }
  async function commit(
    next: ProgramState,
    message: string,
    form: RRFormId | null = null,
  ) {
    try {
      const captured = captureChange(next, form);
      return captured
        ? await persistCaptured(captured, message)
        : { saved: false, current: false };
    } catch (error) {
      say(errorText(error));
      refreshStatus();
      return { saved: false, current: false };
    }
  }
  function inputFor(
    field: ProgramField,
    prefix: string,
    values: Record<string, string>,
    form: RRFormId,
  ) {
    const id = `${prefix}-${field.key}`;
    const numericHint =
      field.kind === "number"
        ? `Enter a finite ${field.key === "minutes" ? "whole " : ""}number from ${field.min ?? 0} to ${Math.min(field.max ?? 1e9, 1e9)}.${["amount", "budget"].includes(field.key) ? " Use at most two decimal places." : ""}`
        : "";
    const hint = [numericHint, field.hint].filter(Boolean).join(" ");
    const attrs = {
      id,
      name: field.key,
      "data-pw-field": true,
      disabled: !session,
      required: !field.optional,
      maxlength: field.kind === "textarea" ? 5000 : 500,
      ...(hint ? { "aria-describedby": id + "-hint" } : {}),
    };
    let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    if (field.kind === "textarea") input = h("textarea", { ...attrs, rows: 3 });
    else if (field.kind === "select")
      input = h(
        "select",
        { ...attrs },
        ...(field.options ?? []).map((v) => h("option", { value: v }, v)),
      );
    else
      input = h("input", {
        ...attrs,
        type: field.kind === "number" ? "text" : (field.kind ?? "text"),
        ...(field.kind === "number" ? { inputmode: "decimal" } : {}),
      });
    const original = values[field.key] ?? "";
    input.value = original;
    hydratedValues.set(input, { original, display: input.value });
    const edited = () => {
      // Original source spelling protects untouched fields only. An explicit
      // input/change owns its displayed spelling, including a return or clear.
      hydratedValues.delete(input);
      changed(form);
      if (form.startsWith("collection:")) {
        const editor = collectionEditors.get(form.slice("collection:".length));
        if (editor) editor.cancel.hidden = false;
      }
    };
    input.addEventListener("input", edited);
    input.addEventListener("change", edited);
    return h(
      "div",
      { class: `field ${field.kind === "textarea" ? "pw-wide" : ""}` },
      h(
        "label",
        { for: id },
        field.label + (field.optional ? " (optional)" : " *"),
      ),
      input,
      hint ? h("span", { class: "hint", id: id + "-hint" }, hint) : null,
    );
  }
  function formValues(form: HTMLFormElement, fields: ProgramField[]) {
    const values = Object.fromEntries(
      fields.map((field) => [
        field.key,
        fieldValue(form.querySelector<FieldInput>('[name="' + field.key + '"]')!),
      ]),
    );
    for (const field of fields) {
      if (!values[field.key].trim() && !field.optional)
        throw Error(
          field.label + " is required; missing numbers are not treated as zero.",
        );
    }
    return values; // The fixed schema validates the whole candidate without cleaning strings.
  }

  function renderContext() {
    const target = $("#pw-context-fields");
    clear(target);
    config.context.forEach((f) =>
      target.append(inputFor(f, "pw-context", state.context, "context")),
    );
  }
  const collectionEditors = new Map<
    string,
    {
      detail: HTMLDetailsElement;
      form: HTMLFormElement;
      fields: HTMLElement;
      cancel: HTMLButtonElement;
      title: HTMLElement;
      edit: string;
      admittedNew: boolean;
      revision: number;
      reset: () => void;
    }
  >();
  function buildCollections() {
    const target = $("#pw-collections");
    clear(target);
    collectionEditors.clear();
    config.collections.forEach((c) => {
      const heading = h("h3", {}, c.label);
      const title = h("summary", {}, `Add ${c.singular}`);
      const fields = h("div", { class: "tool-grid" });
      const form = h("form", {});
      const cancel = h(
        "button",
        { type: "button", class: "btn btn-small btn-ghost", hidden: true },
        "Cancel edit",
      );
      const detail = h("details", { class: "pw-editor" }, title, form);
      const editor = {
        detail,
        form,
        fields,
        cancel,
        title,
        edit: "",
        admittedNew: false,
        revision: 0,
        reset: () => {},
      };
      collectionEditors.set(c.key, editor);
      form.append(
        fields,
        h(
          "div",
          { class: "btn-row" },
          h(
            "button",
            {
              type: "submit",
              class: "btn btn-small",
              "data-pw-save": true,
              disabled: true,
            },
            `Save ${c.singular}`,
          ),
          cancel,
          h(
            "button",
            {
              type: "button",
              class: "btn btn-small btn-ghost",
              "data-pw-replace": c.key,
              disabled: true,
              onclick: () => {
                if (!session?.snapshot().pendingPersist || !editor.edit || busy)
                  return;
                try {
                  const next = structuredClone(state),
                    record = next.records[c.key].find(
                      (r) => r.id === editor.edit,
                    );
                  if (!record)
                    throw Error(
                      "Retry the pending new record before replacing it with this form.",
                    );
                  record.values = formValues(form, c.fields);
                  next.updated = new Date().toISOString();
                  reviewReplacement(
                    next,
                    "replace",
                    "Current " + c.singular + " form",
                  );
                } catch (error) {
                  say(errorText(error));
                }
              },
            },
            "Review replacing failed save with this form",
          ),
        ),
      );
      const resetEditor = () => {
        editor.revision++;
        editor.edit = "";
        editor.admittedNew = false;
        clear(fields);
        c.fields.forEach((f) =>
          fields.append(
            inputFor(f, "pw-" + c.key, defaults(c.fields), collectionForm(c.key)),
          ),
        );
        title.textContent = `Add ${c.singular}`;
        cancel.hidden = true;
        detail.open = false;
      };
      editor.reset = resetEditor;
      resetEditor();
      cancel.addEventListener("click", () => {
        changed();
        resetEditor();
        view.markClean(collectionForm(c.key), view.capture());
        say(
          "Unfinished fields in this record form were discarded. Records did not change.",
        );
        refreshStatus();
      });
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!writable()) return;
        try {
          const values = formValues(form, c.fields),
            next = structuredClone(state),
            editingId = editor.edit,
            editorRevision = editor.revision,
            candidateId = editingId || recordId(),
            existing = next.records[c.key].find((r) => r.id === candidateId);
          if (existing) existing.values = values;
          else {
            if (editingId && !editor.admittedNew)
              throw Error(
                "That existing record disappeared. Keep a field copy and explicitly reset this editor.",
              );
            const total = Object.values(next.records).reduce(
              (sum, rows) => sum + rows.length,
              0,
            );
            if (next.records[c.key].length >= 250 || total >= 500)
              throw Error(
                "Record limit reached. Export and split a larger project.",
              );
            next.records[c.key].push({ id: candidateId, values });
          }
          const captured = captureChange(next, collectionForm(c.key));
          if (!captured) return;
          // Install identity only after synchronous complete admission, before
          // awaiting persistence. A superseded save may not yet be in memory.
          if (!editingId) {
            editor.edit = candidateId;
            editor.admittedNew = true;
            title.textContent = "Edit " + c.singular;
            cancel.hidden = false;
          }
          const result = await persistCaptured(
            captured,
            "Record saved in this browser.",
          );
          const sameEditor =
            collectionEditors.get(c.key) === editor &&
            editor.revision === editorRevision &&
            editor.edit === candidateId;
          if (result.current && result.saved && sameEditor) {
            resetEditor();
            changed();
          }
        } catch (error) {
          say(errorText(error));
        }
      });
      target.append(
        h(
          "section",
          { "aria-label": c.label },
          heading,
          h("p", { class: "note" }, c.description),
          detail,
          h("div", { class: "pw-cards", id: `pw-rows-${c.key}` }),
        ),
      );
    });
  }
  function render() {
    if (disposed) return;
    if (!hasCurrent) {
      for (const id of ["pw-kpis", "pw-summary", "pw-draft"]) clear($("#" + id));
      config.collections.forEach((c) => {
        const target = $("#pw-rows-" + c.key);
        clear(target);
        target.append(
          h(
            "p",
            { class: "note" },
            "No validated records loaded. Saved bytes stay protected; use recovery.",
          ),
        );
      });
      $("#pw-filter-count").textContent = "No validated record snapshot loaded.";
      return;
    }
    const summary = workspaceSummary(config, state);
    clear($("#pw-kpis"));
    summary.metrics.forEach((m) =>
      $("#pw-kpis").append(
        h(
          "div",
          { class: "kpi" },
          h("div", { class: "k-label" }, m.label),
          h("div", { class: "k-value" }, m.value),
        ),
      ),
    );
    clear($("#pw-summary"));
    summary.notes.forEach((note) => $("#pw-summary").append(h("p", {}, note)));
    const search = $<HTMLInputElement>("#pw-search").value.toLowerCase().trim();
    let shown = 0,
      total = 0;
    config.collections.forEach((c) => {
      const target = $(`#pw-rows-${c.key}`);
      clear(target);
      const records = state.records[c.key];
      total += records.length;
      const filtered = records.filter(
        (r) =>
          !search ||
          Object.values(r.values).some((v) => v.toLowerCase().includes(search)),
      );
      shown += filtered.length;
      if (!filtered.length)
        target.append(
          h(
            "p",
            { class: "note" },
            records.length
              ? "No records match this filter. Clear the search to see your saved work."
              : `No ${c.label.toLowerCase()} yet. Add ${/^[aeiou]/i.test(c.singular) ? "an" : "a"} ${c.singular} above, or load the fictional example to explore the workflow.`,
          ),
        );
      filtered.forEach((record) => {
        const v = record.values;
        const facts = h("dl", { class: "pw-facts" });
        c.fields
          .filter((f) => f.key !== "title" && v[f.key])
          .forEach((f) => {
            const value =
              f.kind === "url"
                ? h(
                    "a",
                    {
                      href: v[f.key],
                      target: "_blank",
                      rel: "noopener noreferrer",
                    },
                    v[f.key],
                  )
                : f.key === "reading" && /^\/(?!\/)/.test(v[f.key])
                  ? h("a", { href: url(v[f.key]) }, "Open reading or tool")
                  : v[f.key];
            facts.append(h("dt", {}, f.label), h("dd", {}, value));
          });
        const edit = h(
          "button",
          { type: "button", class: "btn btn-small btn-ghost" },
          `Edit ${v.title || c.singular}`,
        );
        const remove = h(
          "button",
          { type: "button", class: "btn btn-small btn-ghost" },
          `Delete ${v.title || c.singular}`,
        );
        edit.dataset.pwEdit = "true";
        remove.dataset.pwMutation = "true";
        edit.addEventListener("click", () => {
          if (busy || !hasCurrent) return;
          const editor = collectionEditors.get(c.key)!;
          if (view.snapshot().dirtyForms.includes(collectionForm(c.key))) {
            say(
              "Keep or discard this collection's unfinished fields before opening another record.",
            );
            editor.detail.open = true;
            return;
          }
          changed();
          editor.revision++;
          editor.edit = record.id;
          editor.admittedNew = false;
          clear(editor.fields);
          c.fields.forEach((f) =>
            editor.fields.append(
              inputFor(f, "pw-" + c.key, v, collectionForm(c.key)),
            ),
          );
          editor.title.textContent = "Edit " + c.singular;
          editor.cancel.hidden = false;
          editor.detail.open = true;
          editor.detail.scrollIntoView({ block: "center", behavior: "smooth" });
          editor.form
            .querySelector<HTMLInputElement>("input, textarea, select")
            ?.focus({ preventScroll: true });
        });
        let deleteReview: RRViewToken | null = null;
        remove.addEventListener("click", async () => {
          if (!writable()) return;
          if (!deleteReview || !view.isCurrent(deleteReview)) {
            changed();
            deleteReview = view.capture();
            remove.textContent = "Confirm delete " + c.singular;
            say(
              "Review this record deletion, then press Confirm again. Unfinished fields are kept.",
            );
            return;
          }
          const editor = collectionEditors.get(c.key)!;
          if (
            editor.edit === record.id &&
            view.snapshot().dirtyForms.includes(collectionForm(c.key))
          ) {
            say(
              "Keep or discard this record's unfinished fields before deleting it.",
            );
            return;
          }
          deleteReview = null;
          const next = structuredClone(state);
          if (!next.records[c.key].some((r) => r.id === record.id)) return;
          next.records[c.key] = next.records[c.key].filter(
            (r) => r.id !== record.id,
          );
          const result = await commit(
            next,
            "Record deleted. Guarded Undo is available in recovery.",
          );
          if (result.saved && result.current && editor.edit === record.id) {
            editor.reset();
            changed();
          }
        });
        const analysis = recordAnalysis(config, state, c.key, v);
        target.append(
          h(
            "article",
            { class: "pw-card" },
            h("h4", {}, v.title || c.singular),
            facts,
            analysis.length
              ? h(
                  "div",
                  { class: "pw-analysis" },
                  ...analysis.map((line) => h("p", {}, line)),
                )
              : null,
            h("div", { class: "btn-row" }, edit, remove),
          ),
        );
      });
    });
    $("#pw-filter-count").textContent =
      `${shown} of ${total} saved records shown. Exports include every saved record.`;
    $("#pw-draft").textContent = workspaceMarkdown(config, state);
  }
  const contextForm = $<HTMLFormElement>("#pw-context");
  contextForm.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  )!.dataset.pwSave = "true";
  contextForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!writable()) return;
    try {
      const next = structuredClone(state);
      next.context = formValues(contextForm, config.context);
      await commit(next, "Context saved and calculations updated.", "context");
    } catch (error) {
      say(errorText(error));
    }
  });
  $("#pw-search").addEventListener("input", () => {
    changed();
    render();
    refreshStatus();
  });
  $("#pw-preview").addEventListener("click", () => {
    if (!hasCurrent) return;
    $("#pw-draft").textContent = workspaceMarkdown(config, state);
    $<HTMLDetailsElement>("#pw-preview-detail").open = true;
    say(
      "Draft refreshed from the validated record snapshot. Unfinished fields are not included.",
    );
  });
  for (const [id, extension, body, media] of [
    [
      "pw-markdown",
      "kit.md",
      () => workspaceMarkdown(config, state),
      "text/markdown;charset=utf-8",
    ],
    [
      "pw-csv",
      "records.csv",
      () => workspaceCsv(config, state),
      "text/csv;charset=utf-8",
    ],
  ] as const)
    $("#" + id).addEventListener("click", () => {
      if (!hasCurrent) return;
      try {
        download("charitology-" + config.id + "-" + extension, body(), media);
        say(
          "Requested the complete validated record snapshot, including retained failed-save memory when present. Unfinished fields are separate; review before sharing.",
        );
      } catch (error) {
        say(errorText(error));
      }
    });
  $("#pw-export").addEventListener("click", () => {
    if (!session || !hasCurrent) return;
    try {
      const exported = session.exportNative();
      download(
        "charitology-" + config.id + "-backup.json",
        exported.text,
        "application/json",
      );
      say(
        "Requested native JSON from " +
          exported.persistence +
          ". Unfinished fields are not included.",
      );
    } catch (error) {
      say(errorText(error));
    }
  });
  document.getElementById("pw-transparency")?.addEventListener("click", () => {
    if (!hasCurrent) return;
    try {
      download("fund-transparency-planning-draft.md", fundTransparency(state));
      say(
        "Requested the selected-field transparency draft from the current validated records. No publication, grant or payment occurred.",
      );
    } catch (error) {
      say(errorText(error));
    }
  });
  document.getElementById("pw-calendar")?.addEventListener("click", () => {
    if (!hasCurrent) return;
    try {
      const calendar = summitCalendar(state);
      download(
        "tentative-summit-planning.ics",
        calendar.text,
        "text/calendar;charset=utf-8",
      );
      say(
        `Requested a tentative calendar: ${calendar.included} complete planning slot(s); ${calendar.excluded} incomplete or cancelled. No event announced or invitation sent.`,
      );
    } catch (error) {
      say(errorText(error));
    }
  });
  $("#pw-sample-discard").addEventListener("change", () => {
    view.changedView();
    controls?.noteViewMutation();
    sample = undefined;
    $("#pw-sample-preview").hidden = true;
    refreshStatus();
  });
  function reviewReplacement(
    next: ProgramState,
    kind: "example" | "replace",
    label: string,
  ) {
    if (!session || busy) return;
    const discardLocal = $<HTMLInputElement>("#pw-sample-discard").checked;
    sample = undefined;
    $("#pw-sample-preview").hidden = true;
    let pending: Promise<RRRestorePreview<typeof key>>;
    try {
      pending = session.previewReplace(next, { kind, discardLocal });
    } catch (error) {
      controls?.noteViewMutation();
      say(errorText(error));
      refreshStatus();
      return;
    }
    const token = view.capture();
    controls?.noteViewMutation();
    busy = true;
    refreshStatus();
    void pending
      .then((preview) => {
        if (disposed || !view.isCurrent(token)) return;
        sample = preview;
        $("#pw-sample-summary").textContent =
          label +
          ": " +
          Object.entries(preview.summary.counts)
            .map(([name, count]) => count + " " + name)
            .join(", ") +
          ". Apply replaces this whole local version and discards all unfinished forms under the checked permission. Other unfinished forms are not records in this replacement. No participants, funding or review authority is established. Review " +
          preview.reviewHash +
          ".";
        $("#pw-sample-preview").hidden = false;
      })
      .catch((error) => {
        if (!disposed && view.isCurrent(token)) say(errorText(error));
      })
      .finally(() => {
        busy = false;
        refreshStatus();
      });
  }
  $("#pw-sample").addEventListener("click", () => {
    const next = sampleWorkspace(config);
    next.updated = new Date().toISOString();
    reviewReplacement(next, "example", "FICTIONAL replacement");
  });
  $("#pw-context-replace").addEventListener("click", () => {
    if (!session?.snapshot().pendingPersist || !hasCurrent || busy) return;
    try {
      const next = structuredClone(state);
      next.context = formValues(contextForm, config.context);
      next.updated = new Date().toISOString();
      reviewReplacement(next, "replace", "Current context form");
    } catch (error) {
      say(errorText(error));
    }
  });
  $("#pw-sample-apply").addEventListener("click", () => {
    if (!session || !sample || busy) return;
    const selected = sample;
    sample = undefined;
    $("#pw-sample-preview").hidden = true;
    busy = true;
    refreshStatus();
    void session
      .applyRestore(selected)
      .then((result) => {
        if (disposed) return;
        if (
          (result.outcome === "saved" || result.outcome === "no-op") &&
          result.viewCurrent &&
          view.isCurrent(selected.view)
        ) {
          accept(result.snapshot, selected.view, true);
          say(
            "Saved the explicitly reviewed replacement. Guarded Undo is available in recovery.",
          );
        } else {
          accept(result.snapshot);
          if (view.isCurrent(result.view))
            say(
              "The replacement was not saved. Retained memory and unfinished fields remain available for backup.",
            );
        }
      })
      .catch((error) => {
        if (!disposed && view.isCurrent(selected.view)) say(errorText(error));
      })
      .finally(() => {
        busy = false;
        refreshStatus();
      });
  });
  $("#pw-sample-cancel").addEventListener("click", () => {
    changed();
    say("Replacement canceled. No replacement applied.");
  });
  $("#pw-record-recovery").addEventListener("click", invalidateSample, true);
  $("#pw-record-recovery").addEventListener("change", invalidateSample, true);
  window.addEventListener("storage", (event) => {
    if (disposed || !session || (event.key !== key && event.key !== null)) return;
    controls?.noteViewMutation();
    invalidateSample();
    const notice = session.noticeExternalChange(),
      token = view.capture();
    void notice
      .then((snapshot) => {
        if (disposed) return;
        accept(snapshot);
        if (view.isCurrent(token))
          say(
            "Saved bytes changed in another tab. Current records and unfinished fields stay here; review the saved copy in recovery.",
          );
      })
      .catch((error) => {
        if (!disposed && view.isCurrent(token)) say(errorText(error));
      });
  });
  window.addEventListener("beforeunload", (event) => {
    const snapshot = session?.snapshot();
    if (
      !disposed &&
      (view.snapshot().dirtyForms.length ||
        snapshot?.pendingPersist ||
        snapshot?.persistence === "unsaved")
    ) {
      event.preventDefault();
      event.returnValue = "";
    }
  });
  function dispose() {
    if (disposed) return;
    disposed = true;
    controls?.dispose();
    session?.dispose();
    if (!session) view.dispose();
  }
  window.addEventListener("pagehide", (event) => {
    if (!event.persisted) return dispose();
    if (disposed || !session || !controls) return;
    // A cached document will return with these same controls and private fields.
    // Revoke queued authority without closing the session or clearing any form.
    changed();
  });
  window.addEventListener("pageshow", async (event) => {
    if (!event.persisted || disposed) return;
    if (!session || !controls) {
      resumeCheckRequested = true;
      return;
    }
    changed();
    const notice = session.noticeExternalChange(),
      token = view.capture();
    try {
      const snapshot = await notice;
      if (disposed) return;
      accept(snapshot);
      if (view.isCurrent(token))
        say(
          snapshot.code === "ready"
            ? "Returned to this workspace. Unfinished fields remain here; save them deliberately."
            : "Saved bytes changed while this page was away. Unfinished fields remain here; review recovery before saving.",
        );
    } catch (error) {
      if (!disposed && view.isCurrent(token)) say(errorText(error));
    }
  });
  document.addEventListener("astro:before-swap", dispose);
  renderContext();
  buildCollections();
  render();
  refreshStatus();
  let initialView = view.capture();
  async function initialize() {
    const opened = await openRemainingRecordSession(key, { view });
    if (disposed) {
      opened.dispose();
      return;
    }
    session = opened;
    while (resumeCheckRequested) {
      resumeCheckRequested = false;
      const ownedInitial = view.isCurrent(initialView);
      const pending = session.noticeExternalChange(),
        noticeView = view.capture();
      await pending;
      if (disposed) {
        opened.dispose();
        return;
      }
      if (ownedInitial && view.isCurrent(noticeView)) initialView = noticeView;
    }
    controls = mountRemainingRecordRecoveryControls({
      host: $("#pw-record-recovery"),
      session,
      view,
      readForms,
      onAdopt: (snapshot, token) => accept(snapshot, token, true),
      onStatus: (snapshot) => accept(snapshot, undefined, false, false),
    });
    accept(session.snapshot());
    if (hasCurrent && view.isCurrent(initialView)) {
      renderContext();
      buildCollections();
    }
    $$<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
      "[data-pw-field]",
    ).forEach((field) => (field.disabled = false));
    refreshStatus();
    root.dataset.rrInitialization = "ready";
  }
  void initialize().catch((error) => {
    if (disposed) return;
    root.dataset.rrInitialization = "failed";
    // A render target may be missing. Do not call rendering/status helpers again.
    const status = root.querySelector<HTMLElement>("#pw-status");
    if (status)
      status.textContent =
        "Initialization failed: " +
        errorText(error) +
        ". Fields stay visible and disabled; reload before editing.";
    const saved = root.querySelector<HTMLElement>("#pw-save-state");
    if (saved) saved.textContent = "Record editor could not open";
    $$<
      | HTMLButtonElement
      | HTMLInputElement
      | HTMLSelectElement
      | HTMLTextAreaElement
    >("button,input,select,textarea", root).forEach(
      (field) => (field.disabled = true),
    );
    dispose();
  });
</script>
