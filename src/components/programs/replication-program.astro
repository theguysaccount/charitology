---
import ResearchWorkspace from "./ResearchWorkspace.astro";
import { researchProgramCatalog } from "../../lib/research-program-catalog";
import { url } from "../../lib/site";
const { interventions } = await researchProgramCatalog();
const fields = [
  {
    key: "title",
    label: "Replication project and version",
    required: true,
    group: "Claim and scope",
  },
  {
    key: "source",
    label: "Original study URL",
    type: "url" as const,
    required: true,
    group: "Claim and scope",
  },
  {
    key: "claim",
    label: "Exact claim, outcome, population and follow-up period",
    type: "textarea" as const,
    required: true,
    group: "Claim and scope",
  },
  {
    key: "kind",
    label: "Replication approach",
    type: "select" as const,
    required: true,
    group: "Claim and scope",
    options: [
      { value: "reproduce", label: "Reproduce original data and code" },
      {
        value: "reanalyse",
        label: "Reanalyze original data with a new method",
      },
      { value: "direct", label: "Collect new data with the original design" },
      { value: "context", label: "Test in another population or setting" },
    ],
  },
  {
    key: "change",
    label: "What differs from the original, and why?",
    type: "textarea" as const,
    required: true,
    group: "Design",
  },
  {
    key: "hypotheses",
    label: "Hypotheses and directional predictions",
    type: "textarea" as const,
    required: true,
    group: "Design",
  },
  {
    key: "sample",
    label: "Population, recruitment, assignment and sample-size rationale",
    type: "textarea" as const,
    required: true,
    group: "Design",
  },
  {
    key: "outcome",
    label: "Primary outcome, unit, measurement and time point",
    type: "textarea" as const,
    required: true,
    group: "Design",
  },
  {
    key: "estimand",
    label: "Effect to estimate and smallest meaningful difference",
    type: "textarea" as const,
    required: true,
    group: "Analysis",
  },
  {
    key: "analysis",
    label: "Estimator, uncertainty interval and decision criteria",
    type: "textarea" as const,
    required: true,
    group: "Analysis",
  },
  {
    key: "missing",
    label: "Missing data, exclusions and stopping rule",
    type: "textarea" as const,
    required: true,
    group: "Analysis",
  },
  {
    key: "multiple",
    label: "Multiple outcomes, subgroups and robustness checks",
    type: "textarea" as const,
    required: true,
    group: "Analysis",
  },
  {
    key: "access",
    label: "Data/code access, dependencies, license and audit trail",
    type: "textarea" as const,
    required: true,
    group: "Delivery and review",
  },
  {
    key: "ethics",
    label: "Consent, ethics review and safeguards, or why not applicable",
    type: "textarea" as const,
    required: true,
    group: "Delivery and review",
  },
  {
    key: "review",
    label: "Independent review and original-author response plan",
    type: "textarea" as const,
    required: true,
    group: "Delivery and review",
  },
  {
    key: "due",
    label: "Planned completion date",
    type: "date" as const,
    group: "Delivery and review",
  },
  {
    key: "amendments",
    label: "Changes since the previous version and whether results were known",
    type: "textarea" as const,
    group: "Version record",
  },
];
---

<section class="tool">
  <h2>Choose a claim worth checking</h2><p>
    Use the existing intervention register to locate a primary study.
    Distinguish re-running code from collecting new data, and write the plan
    before inspecting the result you are testing.
  </p><ul>
    {
      interventions.map((entry) => (
        <li>
          <a href={url(entry.href)}>{entry.title}</a> — current Record grade:{" "}
          {entry.evidence}; editorial draft
        </li>
      ))
    }
  </ul><p>
    <a href={url("/record/disagreements/deworming-long-run-effects/")}
      >See how a replication can change part of a finding</a
    > · <a href={url("/open-problems/the-replication-rate/")}
      >The replication-rate open problem</a>
  </p>
</section>
<ResearchWorkspace
  id="replication-program"
  title="Preregistration and replication planner"
  description="Freeze a complete, exportable local protocol. To amend it, fork a new draft and record the changes. This planner does not run a study, recruit participants or register a protocol with an external registry."
  fields={fields}
  freeze={true}
/>
