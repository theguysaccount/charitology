---
import ResearchWorkspace from "./ResearchWorkspace.astro";
import ArtifactResults from "../ArtifactResults.astro";
import { REPLICATION_RESEARCH_FIELDS } from "../../data/research-artifact-adapters";
import { researchProgramCatalog } from "../../lib/research-program-catalog";
import { url } from "../../lib/site";
const { interventions } = await researchProgramCatalog();
const fields = REPLICATION_RESEARCH_FIELDS;
---

<section class="tool">
  <h2>Choose a claim worth checking</h2><p>
    Use the existing intervention register to locate a primary study.
    Distinguish re-running code from collecting new data, and write the plan
    before inspecting the result you are testing.
  </p><ul>
    {
      interventions.map((entry) => (
        <li>
          <a href={url(entry.href)}>{entry.title}</a> — current Record grade:{" "}
          {entry.evidence}; editorial draft
        </li>
      ))
    }
  </ul><p>
    <a href={url("/record/disagreements/deworming-long-run-effects/")}
      >See how a replication can change part of a finding</a
    > · <a href={url("/open-problems/the-replication-rate/")}
      >The replication-rate open problem</a>
  </p>
</section>
<ArtifactResults program="replication-program" />

<ResearchWorkspace
  id="replication-program"
  title="Preregistration and replication planner"
  description="Freeze a complete, exportable local protocol. To amend it, fork a new draft and record the changes. This planner does not run a study, recruit participants or register a protocol with an external registry."
  fields={fields}
  freeze={true}
/>
