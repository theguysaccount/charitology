    border-radius: 4px;
    background: var(--series-1);
  }
  .ce-sens :global(.rb-base) {
    position: absolute;
    top: -7px;
    bottom: -7px;
    width: 0;
    border-left: 1.5px solid var(--ink);
    z-index: 1;
  }
  .ce-sens :global(.rb-value) {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--ink);
    text-align: right;
  }
  .ce-sens :global(.rb-axis) {
    display: grid;
    grid-template-columns: minmax(110px, 28%) minmax(0, 1fr) minmax(8.5rem, auto);
    gap: 0.75rem;
    padding: 0 0.25rem;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .ce-sens :global(.rb-ticks) {
    position: relative;
    height: 1.5em;
    border-top: 1px solid var(--axis);
  }
  .ce-sens :global(.rb-ticks span) {
    position: absolute;
    top: 0.25rem;
    transform: translateX(-50%);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .ce-sens :global(.rb-ticks span:first-child) {
    transform: none;
  }
  .ce-sens :global(.rb-ticks span:last-child) {
    transform: translateX(-100%);
  }
  @media (max-width: 640px) {
    .ce-sens :global(.rb-row) {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'label value' 'track track';
      row-gap: 0.15rem;
    }
    .ce-sens :global(.rb-label) {
      grid-area: label;
    }
    .ce-sens :global(.rb-value) {
      grid-area: value;
    }
    .ce-sens :global(.rb-track) {
      grid-area: track;
    }
    .ce-sens :global(.rb-base) {
      top: 0;
      bottom: 0;
    }
    .ce-sens :global(.rb-axis) {
      grid-template-columns: minmax(0, 1fr);
    }
    .ce-sens :global(.rb-axis > span) {
      display: none;
    }
  }
</style>

<script>
  import { $, clear, h } from '../../lib/client/dom';
  import { download, toCsv } from '../../lib/client/files';
  import { num, parseAmount, slugify } from '../../lib/client/format';
  import { load, save, validateToolStorage } from '../../lib/client/durable-store';
  import { histogram, quantile } from '../../lib/client/montecarlo';
  import { RANGED, dollars, dollarsTick, runModel, sensitivity, sig } from '../../lib/client/models';
  import type { ModelInputs, ModelRun, RangedKey } from '../../lib/client/models';
  import { renderHistogram, renderRangeBars } from '../../lib/client/charts';
  import { confirmTwice } from '../../lib/client/confirm';

  const DRAWS = 5000;
  const PARTS = ['low', 'likely', 'high'] as const;
  type Three = [string, string, string];
  interface Raw {
    name: string;
    unit: string;
    values: Record<RangedKey, Three>;
    discount: string;
    seed: string;
  }
  interface Saved extends Raw {
    id: string;
    savedAt: string;
  }
  type Field = RangedKey | 'discount' | 'seed';

  const LABELS: Record<RangedKey, string> = {
    cost: 'Total program cost',
    people: 'People reached',
    works: 'Chance it works as intended',
    effect: 'Effect per person, per year',
    years: 'Years the effect lasts',
    anyway: 'Share that would have happened anyway',
  };
  const PERCENT = new Set<RangedKey>(['works', 'anyway']);

  const EXAMPLE: Raw = {
    name: 'Example: school meals program, illustrative numbers',
    unit: 'extra school day attended',
    values: {
      cost: ['400,000', '500,000', '650,000'],
      people: ['4,000', '5,000', '5,500'],
      works: ['50', '70', '85'],
      effect: ['3', '6', '10'],
      years: ['1', '2', '3'],
      anyway: ['5', '15', '30'],
    },
    discount: '4',
    seed: '1',
  };

  const form = $<HTMLFormElement>('#ce-form');
  const nameEl = $<HTMLInputElement>('#ce-name');
  const unitEl = $<HTMLInputElement>('#ce-unit');
  const discountEl = $<HTMLInputElement>('#ce-discount');
  const seedEl = $<HTMLInputElement>('#ce-seed');
  const summary = $('#ce-summary');
  const out = $('#ce-out');
  const storeMsg = $('#ce-store-msg');
  const savedSel = $<HTMLSelectElement>('#ce-saved');
  const loadBtn = $<HTMLButtonElement>('#ce-load');
  const deleteBtn = $<HTMLButtonElement>('#ce-delete');
  const cell = (key: RangedKey, part: (typeof PARTS)[number]) => $<HTMLInputElement>(`#ce-${key}-${part}`);

  // ---------- Reading and writing the form ----------

  function readRaw(): Raw {
    const values = Object.fromEntries(RANGED.map((k) => [k, PARTS.map((p) => cell(k, p).value) as Three])) as Record<RangedKey, Three>;
    return { name: nameEl.value, unit: unitEl.value, values, discount: discountEl.value, seed: seedEl.value };
  }

  function fillRaw(r: Partial<Raw>) {
    nameEl.value = String(r.name ?? '').slice(0, 120);
    unitEl.value = String(r.unit ?? '').slice(0, 80);
    for (const k of RANGED) PARTS.forEach((p, i) => (cell(k, p).value = String(r.values?.[k]?.[i] ?? '').slice(0, 40)));
    discountEl.value = String(r.discount ?? '').slice(0, 20);
    seedEl.value = String(r.seed ?? '1').slice(0, 12);
    syncLabels();
  }

  const unitName = () => unitEl.value.trim() || 'outcome';

  function syncLabels() {
    const u = unitEl.value.trim();
    const tag = document.querySelector('[data-unit-for="effect"]');
    if (tag) tag.textContent = u ? `(in “${u}”)` : '(outcome units)';
    $('#ce-example-note').hidden = nameEl.value !== EXAMPLE.name;
  }

  const hasInput = () => {
    const r = readRaw();
    return Boolean(r.name.trim() || r.unit.trim() || r.discount.trim() || RANGED.some((k) => r.values[k].some((v) => v.trim())));
  };

  // ---------- Checking ----------

  /** A typed number, or NaN when the box holds no digits. */
  const parse = (raw: string) => (/\d/.test(raw) ? parseAmount(raw.trim()) : NaN);

  function rowError(k: RangedKey, raw: Three, [lo, mid, hi]: number[]): string {
    if (raw.some((s) => !s.trim())) return 'Enter a low, likely and high value. If you know it exactly, enter the same number in all three.';
    if ([lo, mid, hi].some(Number.isNaN)) return 'Use plain numbers, like 2,500 or 0.5.';
    if (k === 'cost' && lo <= 0) return 'Costs must be above zero.';
    if (k === 'people' && lo <= 0) return 'Enter a number of people above zero.';
    if (k === 'works' && (lo < 0 || hi > 100)) return 'Use percentages from 0 to 100.';
    if (k === 'anyway' && (lo < 0 || hi > 99)) return 'Use percentages from 0 to 99. At 100%, nothing would be the program’s doing.';
    if (k === 'effect' && lo < 0) return 'Use 0 or more. This kit can’t model harm; see its limits below.';
    if (k === 'years' && lo < 0) return 'Use 0 or more years.';
    if (!(lo <= mid && mid <= hi)) return 'Put the values in order: low, then likely, then high.';
    if ((k === 'works' || k === 'effect' || k === 'years') && !(mid > 0)) return 'The likely value must be above zero, or the likely case has no outcome to count.';
    return '';
  }

  function check(raw: Raw): { model?: ModelInputs; seed: number; errors: Partial<Record<Field, string>> } {
    const errors: Partial<Record<Field, string>> = {};
    const model = {} as ModelInputs;
    for (const k of RANGED) {
      const n = raw.values[k].map(parse);
      const err = rowError(k, raw.values[k], n);
      if (err) errors[k] = err;
      else model[k] = (PERCENT.has(k) ? n.map((x) => x / 100) : n) as [number, number, number];
    }
    const d = parse(raw.discount);
    if (!raw.discount.trim()) errors.discount = 'Enter a discount rate. Use 0 to count every year the same.';
    else if (!(d >= 0 && d < 100)) errors.discount = 'Use a rate from 0% to 99%.';
    else model.discount = d / 100;
    const seed = Number(raw.seed.trim());
    if (!Number.isInteger(seed) || seed < 1 || seed > 4294967295) errors.seed = 'Use a whole number of 1 or more.';
    return { model: Object.keys(errors).length ? undefined : model, seed, errors };
  }

  function showErrors(errors: Partial<Record<Field, string>>) {
    for (const k of RANGED) {
      $(`#ce-${k}-err`).textContent = errors[k] ?? '';
      PARTS.forEach((p) => cell(k, p).setAttribute('aria-invalid', errors[k] ? 'true' : 'false'));
    }
    for (const f of ['discount', 'seed'] as const) {
      $(`#ce-${f}-err`).textContent = errors[f] ?? '';
      $(`#ce-${f}`).setAttribute('aria-invalid', errors[f] ? 'true' : 'false');
    }
  }

  const fieldName = (f: Field) => (f === 'discount' ? 'Annual discount rate' : f === 'seed' ? 'Random seed' : LABELS[f]);

  // ---------- Running and drawing ----------

  interface Last {
    raw: Raw;
    model: ModelInputs;
    run: ModelRun;
    sens: ReturnType<typeof sensitivity>;
    unit: string;
  }
  let last: Last | undefined;

  function run(focusOnError = false): boolean {
    const raw = readRaw();
    const c = check(raw);
    showErrors(c.errors);
    const bad = Object.keys(c.errors) as Field[];
    if (!c.model) {
      summary.textContent = `Fix ${bad.length === 1 ? 'one input' : `${bad.length} inputs`} to run the model: ${bad.map(fieldName).join(', ')}.`;
      if (last) out.classList.add('ce-stale');
      if (focusOnError) {
        const first = bad[0];
        const target =
          first === 'discount' || first === 'seed'
            ? $<HTMLInputElement>(`#ce-${first}`)
            : (PARTS.map((p) => cell(first, p)).find((el) => !el.value.trim()) ?? cell(first, 'low'));
        target.focus();
      }
      return false;
    }
    last = { raw, model: c.model, run: runModel(c.model, DRAWS, c.seed), sens: sensitivity(c.model), unit: unitName() };
    // Show the results first, so the charts measure their real width.
    out.hidden = false;
    out.classList.remove('ce-stale');
    draw(last);
    return true;
  }

  function show(k: RangedKey, v: number, unit: string): string {
    if (k === 'cost') return dollars(v);
    if (PERCENT.has(k)) return `${sig(v * 100)}%`;
    if (k === 'years') return `${sig(v)} ${v === 1 ? 'year' : 'years'}`;
    if (k === 'effect') return `${sig(v)} “${unit}”`;
    return sig(v);
  }

  function kpi(label: string, value: string, note: string) {
    return h('div', { class: 'kpi' }, h('div', { class: 'k-label' }, label), h('div', { class: 'k-value' }, value), h('div', { class: 'k-note' }, note));
  }

  function draw({ model, run: r, sens, unit }: Last) {
    const per = `per “${unit}”`;
    const top = sens.rows[0];
    const moves = top && top.swing > 0;
    summary.textContent =
      `Median cost ${per}: ${dollars(r.cost.median)}. 90% of the ${num(r.draws)} draws fall between ${dollars(r.cost.p5)} and ${dollars(r.cost.p95)}.` +
      (moves ? ` The result depends most on ${LABELS[top.key].toLowerCase()}.` : '');

    const kpis = $('#ce-kpis');
    clear(kpis);
    kpis.append(
      kpi(`Median cost ${per}`, dollars(r.cost.median), `90% interval: ${dollars(r.cost.p5)} to ${dollars(r.cost.p95)}`),
      kpi('All inputs at likely', dollars(sens.base), 'One calculation with no uncertainty, for comparison'),
      kpi(`Total “${unit}”, median`, sig(r.outcome.median), `90% interval: ${sig(r.outcome.p5)} to ${sig(r.outcome.p95)}`),
    );

    // Histogram of the middle of the distribution; the far tails are reported, not drawn.
    const finite = r.costs.subarray(0, r.draws - r.none);
    const { bins, below, above } = histogram(finite, quantile(finite, 0.005), quantile(finite, 0.995), 28);
    const share = (n: number) => `${(Math.round((n / r.draws) * 1000) / 10).toFixed(1)}%`;
    renderHistogram($('#ce-hist'), bins, {
      total: r.draws,
      label: `Histogram of cost ${per} across ${num(r.draws)} draws. Median ${dollars(r.cost.median)}; 90% of draws between ${dollars(r.cost.p5)} and ${dollars(r.cost.p95)}.`,
      xTitle: `Cost ${per}`,
      yTitle: 'Share of draws',
      tick: dollarsTick,
      tip: (b) => `${dollars(b.x0)} to ${dollars(b.x1)}: ${num(b.count)} ${b.count === 1 ? 'draw' : 'draws'} (${share(b.count)})`,
      marker: { value: r.cost.median, label: `Median ${dollars(r.cost.median)}` },
    });
    const left = below + above;
    $('#ce-hist-note').textContent =
      `Each bar is the share of the ${num(r.draws)} draws whose cost ${per} landed in that range. The line marks the median.` +
      (left && bins.length
        ? ` ${num(left)} ${left === 1 ? 'draw falls' : 'draws fall'} outside ${dollars(bins[0].x0)} to ${dollars(bins[bins.length - 1].x1)}, so ${left === 1 ? 'it is' : 'they are'} left out of the chart but not out of the numbers.`
        : '') +
      (r.none ? ` ${num(r.none)} ${r.none === 1 ? 'draw' : 'draws'} produced no outcome at all.` : '');
    const tbody = $('#ce-hist-rows');
    clear(tbody);
    for (const b of bins) {
      tbody.append(h('tr', {}, h('td', {}, `${dollars(b.x0)} to ${dollars(b.x1)}`), h('td', { class: 'num' }, num(b.count)), h('td', { class: 'num' }, share(b.count))));
    }

    renderRangeBars(
      $('#ce-sens'),
      sens.rows.map((row) => ({
        label: LABELS[row.key],
        lo: row.lo,
        hi: row.hi,
        display: row.swing > 0 ? `${dollars(row.lo)} to ${dollars(row.hi)}` : `${dollars(row.lo)}, no range`,
        tip: `${LABELS[row.key]}: at low (${show(row.key, model[row.key][0], unit)}), ${dollars(row.atLow)} ${per}; at high (${show(row.key, model[row.key][2], unit)}), ${dollars(row.atHigh)}`,
      })),
      { label: `Cost ${per} as each input moves from low to high, biggest swing first`, tick: dollarsTick, base: sens.base },
    );
    $('#ce-driver').textContent = moves
      ? `The result moves most with ${LABELS[top.key].toLowerCase()}: from its low to its high value, the cost ${per} goes from ${dollars(top.atLow)} to ${dollars(top.atHigh)}. Better evidence on that input would narrow the result the most.`
      : 'None of the inputs has a range, so nothing moves the result. Add low and high values to see what it depends on.';
  }

  // ---------- Saved models ----------

  const KEY = 'ce-models';
  const localDate = (iso: string) => {
    const d = new Date(iso);
    return Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  };
  const isSaved = (m: unknown): m is Saved => {
    if (!m || typeof m !== 'object') return false;
    const v = m as Saved;
    return ['id', 'name', 'unit', 'discount', 'seed', 'savedAt'].every(key => typeof (v as unknown as Record<string, unknown>)[key] === 'string') && !!v.id && !Number.isNaN(Date.parse(v.savedAt)) && !!v.values && RANGED.every(key => Array.isArray(v.values[key]) && v.values[key].length === 3 && v.values[key].every(value => typeof value === 'string'));
  };
  validateToolStorage(KEY, value => Array.isArray(value) && value.every(isSaved) && new Set(value.map(m => m.id)).size === value.length);
  let models: Saved[] = (() => {
    const stored = load<unknown>(KEY, []);
    return Array.isArray(stored) ? stored.filter(isSaved) : [];
  })();

  function refreshSaved(selectId?: string) {
    clear(savedSel);
    if (!models.length) savedSel.append(h('option', { value: '' }, 'No saved models yet'));
    for (const m of [...models].sort((a, b) => String(b.savedAt).localeCompare(String(a.savedAt)))) {
      const when = localDate(m.savedAt);
      savedSel.append(h('option', { value: m.id }, when ? `${m.name} (${when})` : m.name));
    }
    savedSel.disabled = loadBtn.disabled = deleteBtn.disabled = !models.length;
    if (selectId) savedSel.value = selectId;
  }

  const tell = (text: string) => (storeMsg.textContent = text);

  $('#ce-save').addEventListener('click', () => {
    const raw = readRaw();
    const name = raw.name.trim() || 'Untitled model';
    nameEl.value = name;
    raw.name = name;
    const existing = models.find((m) => m.name.toLowerCase() === name.toLowerCase());
    const entry: Saved = { ...raw, id: existing?.id ?? `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`, savedAt: new Date().toISOString() };
    models = existing ? models.map((m) => (m.id === existing.id ? entry : m)) : [...models, entry];
    const ok = save(KEY, models);
    refreshSaved(entry.id);
    storeMsg.textContent = ok
      ? `${existing ? 'Updated' : 'Saved'} “${name}” in this browser.`
      : `Your browser is blocking storage, so “${name}” is kept only until you leave this page. Download the CSV to keep a copy.`;
    syncLabels();
  });

  loadBtn.addEventListener('click', () => {
    const m = models.find((x) => x.id === savedSel.value);
    if (!m) return;
    fillRaw(m);
    storeMsg.textContent = `Loaded “${m.name}”.`;
    run();
  });

  const resetDelete = confirmTwice(deleteBtn, {
    prompt: 'Click again to delete',
    message: 'Click Delete again to delete the selected model.',
    announce: tell,
    action: () => {
      const m = models.find((x) => x.id === savedSel.value);
      if (!m) return;
      models = models.filter((x) => x.id !== m.id);
      const ok = save(KEY, models);
      refreshSaved();
      storeMsg.textContent = `Deleted “${m.name}”.${ok ? '' : ' Storage is blocked, so this lasts only until you leave the page.'}`;
    },
  });
  savedSel.addEventListener('change', resetDelete);

  confirmTwice($<HTMLButtonElement>('#ce-example'), {
    prompt: 'Click again to replace your inputs',
    message: 'The example will replace your inputs. Click again to load it.',
    needed: hasInput,
    announce: tell,
    action: () => {
      fillRaw(EXAMPLE);
      storeMsg.textContent = 'Loaded the example. Its numbers are made up.';
      run();
    },
  });

  confirmTwice($<HTMLButtonElement>('#ce-clear'), {
    prompt: 'Click again to clear',
    message: 'Click again to clear every input. Saved models are kept.',
    needed: hasInput,
    announce: tell,
    action: () => {
      fillRaw({ seed: '1' });
      showErrors({});
      last = undefined;
      out.hidden = true;
      storeMsg.textContent = '';
      summary.textContent = 'Inputs cleared. Enter a low, likely and high value for every input, then run the model.';
    },
  });

  $('#ce-csv').addEventListener('click', () => {
    if (!last) return;
    const { raw, model, run: r, sens, unit } = last;
    const n = (v: number) => (Number.isFinite(v) ? Number(v.toPrecision(6)) : 'no outcome');
    const row = (section: string, item: string, value: unknown = '', unitLabel = '', low: unknown = '', likely: unknown = '', high: unknown = '') => ({
      section,
      item,
      low,
      likely,
      high,
      value,
      unit: unitLabel,
    });
    const natural = (k: RangedKey, i: number) => n(PERCENT.has(k) ? model[k][i] * 100 : model[k][i]);
    const units: Record<RangedKey, string> = { cost: '$', people: 'people', works: '%', effect: `${unit} per person per year`, years: 'years', anyway: '%' };
    const data = [
      row('model', 'Name', raw.name.trim() || 'Untitled model'),
      row('model', 'Outcome unit', unit),
      row('model', 'Draws', r.draws),
      row('model', 'Random seed', r.seed),
      row('model', 'Method', 'Monte Carlo; triangular distributions; inputs drawn independently; first year undiscounted'),
      row('model', 'Annual discount rate', n(model.discount * 100), '%'),
      ...RANGED.map((k) => row('input', LABELS[k], '', units[k], natural(k, 0), natural(k, 1), natural(k, 2))),
      row('summary', 'Cost per outcome, median', n(r.cost.median), '$'),
      row('summary', 'Cost per outcome, 5th percentile', n(r.cost.p5), '$'),
      row('summary', 'Cost per outcome, 95th percentile', n(r.cost.p95), '$'),
      row('summary', 'Cost per outcome, all inputs at likely', n(sens.base), '$'),
      row('summary', 'Total outcomes, median', n(r.outcome.median), unit),
      row('summary', 'Total outcomes, 5th percentile', n(r.outcome.p5), unit),
      row('summary', 'Total outcomes, 95th percentile', n(r.outcome.p95), unit),
      row('summary', 'Draws with no outcome', r.none),
      ...sens.rows.map((s) => row('sensitivity', LABELS[s.key], n(s.swing), '$ per outcome: input at low, input at high, swing', n(s.atLow), '', n(s.atHigh))),
    ];
    const file = `charitology-model-${slugify(raw.name) || 'untitled'}.csv`;
    download(file, toCsv(data, ['section', 'item', 'low', 'likely', 'high', 'value', 'unit']), 'text/csv;charset=utf-8');
  });

  // ---------- Wiring ----------

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (run(true)) $('#ce-kpis').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
  form.addEventListener('input', () => {
    syncLabels();
    let note = '';
    if (last && !out.hidden) {
      out.classList.add('ce-stale');
      note = 'You changed the inputs. Run the model again to update the results.';
    } else if (document.querySelector('.ce-err:not(:empty)')) {
      note = 'Run the model again to check your changes.';
    }
    if (note && summary.textContent !== note) summary.textContent = note;
  });
  refreshSaved();
  syncLabels();
</script>
