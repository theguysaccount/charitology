---
import Mark from './Mark.astro';
import ThemeControl from './ThemeControl.astro';
import { SITE, url } from '../lib/site';

const NAV = [
  { href: '/diagnosis/', label: 'Diagnosis', note: 'What is wrong with the system' },
  { href: '/method/', label: 'Method', note: 'How charitology works' },
  { href: '/programs/', label: 'Programs', note: 'The work of the field' },
  { href: '/tools/', label: 'Tools', note: 'Instruments anyone can use' },
  { href: '/record/', label: 'Record', note: 'What the field knows' },
  { href: '/for-charities/', label: 'For charities', note: 'Workspace, tools and benefits' },
  { href: '/open-problems/', label: 'Open Problems', note: 'What nobody knows yet' },
];

const path = Astro.url.pathname;
const current = (href: string) => {
  const section = url(href);
  if (path === section) return 'page';
  return path.startsWith(section) ? 'location' : undefined;
};
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label="Charitology home">
      <Mark />
      <span>Charitology</span>
    </a>
    <nav class="nav" aria-label="Main">
      {NAV.map((n) => <a href={url(n.href)} aria-current={current(n.href)}>{n.label}</a>)}
    </nav>
    <div class="header-tools">
      <a class="icon-btn" href={url('/search/')} aria-label="Search" title="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="M20 20l-4.2-4.2"></path>
        </svg>
      </a>
      <ThemeControl />
      <details class="menu" data-site-menu>
        <summary class="icon-btn" aria-label="Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav class="menu-panel" aria-label="Main menu">
          {NAV.map((n) => (
            <a href={url(n.href)} aria-current={current(n.href)}>
              {n.label}
              <small>{n.note}</small>
            </a>
          ))}
          <a href={url('/for-charities/start/')}>Start with one job<small>Practical steps for charity teams</small></a>
          <a href={url('/learn/')}>Teach and learn<small>Lessons, university routes and club materials</small></a>
          <a href={url('/manifesto/')}>Manifesto<small>Ten dollars</small></a>
          <a href={url('/contribute/')}>Contribute<small>Become a charitologist</small></a>
          <a href={url('/roadmap/')}>Full roadmap<small>All 66 original ideas and what comes next</small></a>
          <a href={SITE.repo} data-source-symbol="code">Charitology on GitHub<small>Source code and public issues</small></a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-site-menu]');
  document.addEventListener('pointerdown', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  menu?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !menu.open) return;
    menu.open = false;
    menu.querySelector('summary')?.focus();
  });
</script>
