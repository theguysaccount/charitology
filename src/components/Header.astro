---
import Mark from './Mark.astro';
import { SITE, url } from '../lib/site';

const NAV = [
  { href: '/diagnosis/', label: 'Diagnosis', note: 'What is wrong with the system' },
  { href: '/method/', label: 'Method', note: 'How charitology works' },
  { href: '/programs/', label: 'Programs', note: 'The work of the field' },
  { href: '/tools/', label: 'Tools', note: 'Instruments anyone can use' },
  { href: '/record/', label: 'Record', note: 'What the field knows' },
  { href: '/for-charities/', label: 'For charities', note: 'Workspace, tools and benefits' },
  { href: '/open-problems/', label: 'Open Problems', note: 'What nobody knows yet' },
];

const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(url(href)) ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label="Charitology home">
      <Mark />
      <span>Charitology</span>
    </a>
    <nav class="nav" aria-label="Main">
      {NAV.map((n) => <a href={url(n.href)} aria-current={current(n.href)}>{n.label}</a>)}
    </nav>
    <div class="header-tools">
      <a class="icon-btn" href={url('/search/')} aria-label="Search" title="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="M20 20l-4.2-4.2"></path>
        </svg>
      </a>
      <button class="icon-btn theme-btn" type="button" data-theme-toggle data-mode="system" aria-label="Color theme: match system" title="Color theme">
        <svg class="i-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="8"></circle>
          <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none"></path>
        </svg>
        <svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
        </svg>
        <svg class="i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
        </svg>
      </button>
      <a class="icon-btn" href={SITE.repo} aria-label="Charitology on GitHub" title="Charitology on GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"></path>
        </svg>
      </a>
      <details class="menu">
        <summary class="icon-btn" aria-label="Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav class="menu-panel" aria-label="Main menu">
          {NAV.map((n) => (
            <a href={url(n.href)} aria-current={current(n.href)}>
              {n.label}
              <small>{n.note}</small>
            </a>
          ))}
          <a href={url('/learn/')}>Teach and learn<small>Lessons, university routes and club materials</small></a>
          <a href={url('/manifesto/')}>Manifesto<small>Ten dollars</small></a>
          <a href={url('/contribute/')}>Contribute<small>Become a charitologist</small></a>
          <a href={url('/roadmap/')}>Full roadmap<small>All 66 original ideas and what comes next</small></a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .theme-btn svg {
    display: none;
  }
  .theme-btn[data-mode='system'] .i-system,
  .theme-btn[data-mode='light'] .i-light,
  .theme-btn[data-mode='dark'] .i-dark {
    display: block;
  }
</style>

<script>
  const KEY = 'charitology.theme';
  const ORDER = ['system', 'light', 'dark'] as const;
  type Mode = (typeof ORDER)[number];
  const LABELS: Record<Mode, string> = { system: 'match system', light: 'light', dark: 'dark' };

  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  let mode: Mode = 'system';
  try {
    const saved = localStorage.getItem(KEY);
    if (saved === 'light' || saved === 'dark') mode = saved;
  } catch {}

  function apply(next: Mode) {
    const root = document.documentElement;
    if (next === 'system') delete root.dataset.theme;
    else root.dataset.theme = next;
    btn?.setAttribute('data-mode', next);
    btn?.setAttribute('aria-label', `Color theme: ${LABELS[next]}`);
  }

  apply(mode);
  btn?.addEventListener('click', () => {
    mode = ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length];
    try {
      if (mode === 'system') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, mode);
    } catch {}
    apply(mode);
  });
</script>
