---
// Index page for Programs, Tools and the Record: grouped cards with status counts.
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
import CatalogCard from './CatalogCard.astro';
import SiteSymbol from './SiteSymbol.astro';
import type { SymbolName } from '../lib/site-identities';
import { STATUS } from '../lib/labels';
import { catalogGroups, statusCounts } from '../lib/content';

interface Props {
  collection: 'programs' | 'tools' | 'record';
  title: string;
  eyebrow: string;
  lede: string;
  description?: string;
}
const { collection, title, eyebrow, lede, description } = Astro.props;
const groups = await catalogGroups(collection);
const counts = await statusCounts(collection);
const total = Object.values(counts).reduce((a, b) => a + b, 0);
const base = `/${collection}/`;
const groupSymbols: Record<string, SymbolName> = {
  Research: 'flask', Funding: 'coins', 'People and education': 'school', Reach: 'globe',
  'For donors': 'gift', 'For nonprofits and funders': 'hands', 'For everyone': 'people',
  'Flagship references': 'book', 'Annual publications': 'calendar',
  'Research archives': 'archive', 'Thought and teaching': 'dialogue',
};
const groupId = (group: string) => `g-${group.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<Base title={title} description={description ?? lede}>
  <header class="page-head">
    <div class="wrap">
      <Crumbs items={[{ label: title }]} />
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <p class="meta status-line">
        {total} in all ·{' '}
        {
          (Object.keys(STATUS) as (keyof typeof STATUS)[])
            .filter((k) => counts[k] > 0)
            .map((k, i) => (
              <span title={STATUS[k].note}>
                {i > 0 && ' · '}
                {counts[k]} {STATUS[k].label.toLowerCase()}
              </span>
            ))
        }
      </p>
      <slot name="intro" />
      <nav class="catalog-jump" aria-label={`Browse ${title.toLowerCase()} by category`}>
        {groups.map((g) => <a href={`#${groupId(g.group)}`}>
          <SiteSymbol name={groupSymbols[g.group] ?? 'folder'} />{g.group}
        </a>)}
      </nav>
    </div>
  </header>
  {
    groups.map((g) => (
      <section class="wrap section-tight" aria-labelledby={groupId(g.group)}>
        <h2 id={groupId(g.group)} class="group-title">
          <SiteSymbol name={groupSymbols[g.group] ?? 'folder'} />{g.group}
        </h2>
        <div class="grid">
          {g.entries.map((entry) => (
            <CatalogCard entry={entry} base={base} />
          ))}
        </div>
      </section>
    ))
  }
  <slot />
</Base>

<style>
  .status-line {
    margin-top: 1.25rem;
  }
  .group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.35rem;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }
</style>
