---
import SiteSymbol from './SiteSymbol.astro';
import type { SymbolName } from '../lib/site-identities';

const modes = [
  { value: 'system', label: 'System', symbol: 'monitor' },
  { value: 'light', label: 'Light', symbol: 'sun' },
  { value: 'dark', label: 'Dark', symbol: 'moon' },
] as const satisfies ReadonlyArray<{ value: string; label: string; symbol: SymbolName }>;
---

<details class="theme-control" data-header-menu hidden>
  <summary class="icon-btn" title="Choose a color theme">
    {modes.map(({ value, label, symbol }) => (
      <span class="theme-current" data-theme-mode={value}>
        <SiteSymbol name={symbol} size="inline" />
        <span class="visually-hidden">Color theme: {label}</span>
      </span>
    ))}
    <span aria-hidden="true" class="theme-caption">Theme</span>
  </summary>
  <fieldset class="theme-options" id="site-theme">
    <legend class="visually-hidden">Color theme</legend>
    {modes.map(({ value, label, symbol }) => (
      <label>
        <input class="visually-hidden" type="radio" name="site-theme" value={value} autocomplete="off" checked={value === 'system'} />
        <span class="theme-option">
          <SiteSymbol name={symbol} size="inline" />
          <span>{label}</span>
        </span>
      </label>
    ))}
  </fieldset>
</details>

<style>
  .theme-control {
    position: relative;
    flex: none;
  }

  summary {
    width: 44px;
    height: 44px;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .theme-current {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    font: 650 0.78rem/1 var(--font-sans);
  }

  :global(:root:not([data-theme])) [data-theme-mode="system"],
  :global(:root[data-theme="light"]) [data-theme-mode="light"],
  :global(:root[data-theme="dark"]) [data-theme-mode="dark"] {
    display: flex;
  }

  .theme-caption {
    display: none;
  }

  @media (min-width: 360px) {
    summary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
      width: auto;
      padding-inline: 0.45rem;
    }

    .theme-caption {
      display: inline;
      font: 650 0.78rem/1 var(--font-sans);
    }
  }

  .theme-options {
    position: absolute;
    z-index: 1;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    display: grid;
    gap: 0.15rem;
    width: max-content;
    min-inline-size: 8rem;
    margin: 0;
    padding: 0.3rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  label {
    position: relative;
    cursor: pointer;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding-inline: 0.55rem;
    border-radius: 6px;
    color: var(--ink);
    font: 650 0.85rem/1.1 var(--font-sans);
  }

  .theme-control :global(.site-symbol) {
    --symbol-tile: 1.3rem;
    --symbol-size: 1.15rem;
    color: inherit;
    background: transparent;
  }

  label:hover input:not(:checked) + .theme-option {
    background: var(--bg-2);
  }

  input:checked + .theme-option {
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  input:focus-visible + .theme-option {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  @media (forced-colors: active) {
    input:checked + .theme-option {
      forced-color-adjust: none;
      background: Highlight;
      color: HighlightText;
      outline: 2px solid Highlight;
      outline-offset: -2px;
    }

    input:checked + .theme-option :global(.site-symbol) {
      --forced-symbol-ink: HighlightText;
    }

    input:focus-visible + .theme-option {
      outline: 2px dashed currentColor;
      outline-offset: -4px;
    }
  }
</style>

<script>
  const key = 'charitology.theme';
  const root = document.documentElement;
  const field = document.querySelector<HTMLFieldSetElement>('#site-theme');
  const disclosure = field?.closest('details');
  const meta = document.querySelector<HTMLMetaElement>('#site-theme-color');

  if (field && disclosure) {
    const options = [...field.querySelectorAll('input')];
    let preferences: Storage | undefined;
    try { preferences = window.localStorage; } catch {}

    function apply(value: string | null | undefined) {
      const mode = value === 'light' || value === 'dark' ? value : 'system';
      if (mode === 'system') {
        delete root.dataset.theme;
        meta?.setAttribute('media', 'not all');
      } else {
        root.dataset.theme = mode;
        meta?.setAttribute('content', mode === 'dark' ? '#121110' : '#f6f3ec');
        meta?.setAttribute('media', 'all');
      }
      for (const option of options) option.checked = option.value === mode;
    }

    apply(root.dataset.theme);
    disclosure.hidden = false;
    field.addEventListener('change', (event) => {
      const option = event.target;
      if (!(option instanceof HTMLInputElement) || !option.checked) return;
      apply(option.value);
      try {
        if (option.value === 'system') preferences?.removeItem(key);
        else preferences?.setItem(key, option.value);
      } catch {}
    });
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted || !preferences) return;
      try { apply(preferences.getItem(key)); } catch {}
    });
    window.addEventListener('storage', (event) => {
      if (preferences && event.storageArea === preferences && (event.key === key || event.key === null)) apply(event.newValue);
    });
  }
</script>
