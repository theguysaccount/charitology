<section id="depth-census">
  <h2>Your depth census</h2><p>
    Classify a documented set of activities. This is a local research sample,
    not an estimate of global charity. Amounts use one currency per file.
    Classifications are your hypotheses; evidence quality and impact are
    separate questions.
  </p><form id="census-form">
    <fieldset data-private-form-controls disabled>
    <div class="census-controls">
      <label>Activity<input name="activity" maxlength="200" required /></label
      ><label
        >Amount<input
          name="amount"
          type="number"
          min="0"
          max="1000000000"
          step="0.01"
          required
        /></label
      ><label
        >Depth<select name="depth"
          ><option value="unknown">Unclassified</option><option value="0"
            >0 · Relief</option
          ><option value="1">1 · Repair</option><option value="2"
            >2 · Prevention</option
          ><option value="3">3 · Structure</option><option value="4"
            >4 · Source</option
          ></select
        ></label
      >
    </div><label
      >Public source or classification rationale<textarea
        name="source"
        required
        maxlength="5000"
        rows="2"></textarea></label
    ><button class="btn" type="submit" id="census-submit">Add activity</button>
    <button class="btn btn-ghost" type="button" id="census-new"
      >Start another</button
    >
    </fieldset>
  </form><noscript
    ><p>
      This local form needs JavaScript. Its fields stay disabled until local
      editing is ready; nothing is submitted by this form.
    </p></noscript
  ><label
    >Currency for the whole sample<input
      id="census-currency"
      disabled
      value="USD"
      pattern="[A-Z]{3}"
      maxlength="3"
    /></label
  ><p id="census-status" role="status"></p><div id="census-results"></div><div
    id="census-rows"
  >
  </div><div class="census-controls">
    <button class="btn" id="census-csv">Export sample CSV</button><button
      class="btn btn-ghost"
      id="census-json">Export JSON backup</button
    >
  </div><div id="census-recovery"></div>
</section>
<script>
  import { download, toCsv } from "../lib/client/files";
  import {
    depthCoverage,
    safeCsvText,
    type DepthSample,
    type DepthRow,
  } from "../lib/client/completion-models";
  import {
    createRemainingRecordView,
    openRemainingRecordSession,
    remainingRecordHydratedString,
    type RRSession,
    type RRReadonly,
    type RRHydratedString,
    type RRViewToken,
  } from "../lib/client/remaining-record-recovery";
  import {
    mountRemainingRecordRecoveryControls,
    type RRRecoveryControls,
  } from "../lib/client/remaining-record-recovery-controls";
  const root = document.querySelector<HTMLElement>("#depth-census");
  if (root) {
    let resumeCheckRequested = false;
    root.dataset.rrInitialization = "opening";
    const form = root.querySelector<HTMLFormElement>("form")!;
    form.addEventListener("submit", (event) => event.preventDefault(), true);
    const key = "charitology-depth-census-v1" as const,
      view = createRemainingRecordView(key),
      fields = ["activity", "amount", "depth", "source"] as const;
    const fieldset = root.querySelector<HTMLFieldSetElement>(
        "[data-private-form-controls]",
      )!,
      currency = root.querySelector<HTMLInputElement>("#census-currency")!,
      status = root.querySelector<HTMLElement>("#census-status")!;
    let session: RRSession<typeof key> | null = null,
      controls: RRRecoveryControls | null = null,
      sample: RRReadonly<DepthSample> | null = null,
      initialized = false,
      disposed = false,
      busy = false;
    let editing: { id: string; admittedNew: boolean } | null = null;
    const hydrated = new Map<string, RRHydratedString>();
    const field = (name: string) => {
      const el = form.elements.namedItem(name);
      if (!(
        el instanceof HTMLInputElement ||
        el instanceof HTMLSelectElement ||
        el instanceof HTMLTextAreaElement
      ))
        throw Error("Missing activity field: " + name);
      return el;
    };
    const read = (name: string) =>
      remainingRecordHydratedString(
        field(name).value,
        hydrated.get(name) ?? null,
      );
    const rawValues = () =>
      Object.fromEntries(fields.map((name) => [name, field(name).value]));
    function reset() {
      editing = null;
      hydrated.clear();
      form.reset();
      root!.querySelector("#census-submit")!.textContent = "Add activity";
    }
    function intent() {
      view.changedView();
      controls?.noteViewMutation();
    }
    function dispose() {
      if (disposed) return;
      disposed = true;
      initialized = false;
      controls?.dispose();
      session?.dispose();
      view.dispose();
      fieldset.disabled = true;
      if (currency) currency.disabled = true;
    }
    function capabilities() {
      if (!session || disposed) return;
      const state = session.snapshot();
      fieldset.disabled = !state.hasCurrent;
      currency.disabled = !state.hasCurrent;
      root!.querySelector<HTMLButtonElement>("#census-submit")!.disabled =
        busy || !state.canWrite;
    }
    async function persist(
      candidate: DepthSample,
      formId: "activity" | "currency",
      onAdmitted?: () => void,
      resetEditor = false,
    ) {
      if (!session || disposed || busy) return;
      controls?.noteViewMutation();
      let captured;
      let token = view.capture();
      try {
        try {
          captured = session.captureSave(candidate, { form: formId });
        } finally {
          token = view.capture();
        }
      } catch (error) {
        if (!disposed && view.isCurrent(token))
          status.textContent =
            error instanceof Error
              ? error.message
              : "Saving was refused. Unfinished fields remain.";
        return;
      }
      onAdmitted?.();
      busy = true;
      root!.dataset.rrBusy = "true";
      capabilities();
      try {
        const result = await session.saveCaptured(captured);
        if (disposed) return;
        sample = result.snapshot.hasCurrent ? result.snapshot.value : null;
        render();
        controls?.refresh();
        if (view.isCurrent(result.view)) {
          if (result.outcome === "saved" || result.outcome === "no-op") {
            if (resetEditor) {
              reset();
              view.markClean("activity", result.view);
            }
            if (formId === "currency") view.markClean("currency", result.view);
            status.textContent =
              "Saved in this browser. User classifications remain hypotheses.";
          } else
            status.textContent =
              "The exact sample is retained in memory. Keep native and unfinished-field backups or Retry; newer fields remain on this page.";
        }
      } catch (error) {
        if (!disposed && view.isCurrent(token))
          status.textContent =
            error instanceof Error
              ? error.message
              : "Saving was refused. Unfinished fields remain.";
      } finally {
        busy = false;
        root!.dataset.rrBusy = "false";
        capabilities();
      }
    }
    function render() {
      const results = root!.querySelector<HTMLElement>("#census-results")!,
        list = root!.querySelector<HTMLElement>("#census-rows")!;
      results.replaceChildren();
      list.replaceChildren();
      if (!sample) {
        const p = document.createElement("p");
        p.textContent =
          "No validated current sample is available. Keep protected saved bytes and use reviewed recovery below.";
        results.append(p);
        return;
      }
      const { total, unknown } = depthCoverage({
        currency: sample.currency,
        rows: sample.rows.map((row) => ({ ...row })),
      });
      const summary = document.createElement("p");
      summary.textContent = `${sample.rows.length} activities · ${sample.currency} ${total.toLocaleString("en-US", { maximumFractionDigits: 2 })} recorded · ${total ? (((total - unknown) / total) * 100).toFixed(1) + "% of recorded money classified" : "Money coverage undefined for a zero total"}. Unclassified is not zero need.`;
      results.append(summary);
      const table = document.createElement("table");
      table.className = "data";
      const body = table.createTBody();
      for (const [value, label] of [
        ["0", "Relief"],
        ["1", "Repair"],
        ["2", "Prevention"],
        ["3", "Structure"],
        ["4", "Source"],
        ["unknown", "Unclassified"],
      ]) {
        const amount =
            sample.rows
              .filter((row) => row.depth === value)
              .reduce((n, row) => n + Math.round(row.amount * 100), 0) / 100,
          tr = body.insertRow(),
          th = document.createElement("th");
        th.scope = "row";
        th.textContent = label;
        tr.append(th);
        tr.insertCell().textContent =
          sample.currency +
          " " +
          amount.toLocaleString("en-US", { maximumFractionDigits: 2 });
        tr.insertCell().textContent = total
          ? ((100 * amount) / total).toFixed(1) + "%"
          : "Undefined";
      }
      results.append(table);
      if (!sample.rows.length) {
        const p = document.createElement("p");
        p.textContent =
          "No activity records yet. Add an actual record with a source or rationale.";
        list.append(p);
      }
      for (const row of sample.rows) {
        const card = document.createElement("div");
        card.className = "census-row";
        card.dataset.recordId = row.id;
        const p = document.createElement("p");
        p.textContent = `${row.activity} · ${sample.currency} ${row.amount} · ${row.depth === "unknown" ? "Unclassified" : "Depth " + row.depth}`;
        const source = document.createElement("p");
        source.textContent = row.source;
        const edit = document.createElement("button");
        edit.type = "button";
        edit.className = "btn btn-small btn-ghost";
        edit.textContent = "Edit";
        edit.addEventListener("click", () => {
          if (!initialized || disposed || busy) return;
          intent();
          const token = view.capture();
          if (
            view.snapshot().dirtyForms.includes("activity") &&
            !window.confirm(
              "Replace this unfinished activity with the selected saved row? Keep a field backup first if needed.",
            )
          )
            return;
          if (!view.isCurrent(token)) return;
          editing = { id: row.id, admittedNew: false };
          hydrated.clear();
          for (const name of fields) {
            const el = field(name),
              original = String(row[name]);
            el.value = original;
            hydrated.set(name, Object.freeze({ original, display: el.value }));
          }
          view.markClean("activity", token);
          root!.querySelector("#census-submit")!.textContent = "Save activity";
          form.scrollIntoView({ block: "center" });
        });
        const del = document.createElement("button");
        del.type = "button";
        del.className = "btn btn-small btn-ghost";
        del.textContent = "Delete";
        let armed: RRViewToken | null = null;
        del.addEventListener("click", () => {
          if (!initialized || disposed || busy || !sample) return;
          if (!armed || !view.isCurrent(armed)) {
            intent();
            armed = view.capture();
            del.textContent = "Confirm delete";
            status.textContent =
              "Press Confirm delete again for this activity and this version of unfinished fields. Keep copies first if needed.";
            return;
          }
          const next = {
            currency: sample.currency,
            rows: sample.rows
              .filter((item) => item.id !== row.id)
              .map((item) => ({ ...item })),
          };
          void persist(next, "activity", undefined, editing?.id === row.id).catch(
            (error) => {
              if (!disposed)
                status.textContent =
                  error instanceof Error
                    ? error.message
                    : "The deletion was refused. Fields remain.";
            },
          );
        });
        del.disabled = !session?.snapshot().canWrite;
        card.append(p, source, edit, document.createTextNode(" "), del);
        list.append(card);
      }
    }
    const changed = (event: Event) => {
      if (!initialized || disposed) return;
      const target = event.target as HTMLInputElement | null;
      if (target && fields.includes(target.name as (typeof fields)[number]))
        hydrated.delete(target.name);
      else hydrated.clear();
      view.changedForm("activity");
      controls?.noteViewMutation();
    };
    form.addEventListener("input", changed);
    form.addEventListener("change", changed);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!initialized || disposed || busy || !sample) return;
      try {
        if (
          editing &&
          !editing.admittedNew &&
          !sample.rows.some((row) => row.id === editing!.id)
        )
          throw Error(
            "The activity being edited disappeared from current records. Keep the form and start a deliberate new activity.",
          );
        const amountInput = field("amount") as HTMLInputElement,
          amountRaw = read("amount");
        if (!amountRaw.trim() || amountInput.validity.badInput)
          throw Error(
            "Enter a nonnegative amount. Incomplete numeric input remains on this page; it is not converted to zero.",
          );
        const proposed = editing ?? {
            id: crypto.randomUUID(),
            admittedNew: true,
          },
          row: DepthRow = {
            id: proposed.id,
            activity: read("activity"),
            source: read("source"),
            depth: read("depth"),
            amount: Math.round(Number(amountRaw) * 100) / 100,
          };
        const next = {
          currency: sample.currency,
          rows: sample.rows.some((item) => item.id === row.id)
            ? sample.rows.map((item) => (item.id === row.id ? row : { ...item }))
            : [...sample.rows.map((item) => ({ ...item })), row],
        };
        void persist(
          next,
          "activity",
          () => {
            editing = proposed;
          },
          true,
        ).catch((error) => {
          if (!disposed)
            status.textContent =
              error instanceof Error
                ? error.message
                : "Saving was refused; keep the current fields.";
        });
      } catch (error) {
        status.textContent =
          error instanceof Error
            ? error.message
            : "Saving was refused; keep the current fields.";
      }
    });
    root.querySelector("#census-new")!.addEventListener("click", () => {
      if (!initialized || disposed || busy) return;
      intent();
      const token = view.capture();
      if (
        view.snapshot().dirtyForms.includes("activity") &&
        !window.confirm(
          "Discard this unfinished activity form? Keep a field backup first if needed.",
        )
      )
        return;
      if (!view.isCurrent(token)) return;
      reset();
      view.markClean("activity", token);
    });
    currency.addEventListener("input", () => {
      if (!initialized || disposed) return;
      view.changedForm("currency");
      controls?.noteViewMutation();
    });
    currency.addEventListener("change", () => {
      if (!initialized || disposed || busy || !sample) return;
      view.changedForm("currency");
      controls?.noteViewMutation();
      if (!/^[A-Z]{3}$/.test(currency.value)) {
        status.textContent =
          "Use a three-letter uppercase currency code. The unfinished text remains here.";
        return;
      }
      if (sample.rows.length && currency.value !== sample.currency) {
        status.textContent =
          "Currency cannot change after adding amounts. Keep this field; export a separately converted sample with documented rates.";
        return;
      }
      void persist(
        {
          currency: currency.value,
          rows: sample.rows.map((row) => ({ ...row })),
        },
        "currency",
      ).catch((error) => {
        if (!disposed)
          status.textContent =
            error instanceof Error
              ? error.message
              : "Currency save refused; fields remain.";
      });
    });
    window.addEventListener("beforeunload", (event) => {
      if (!session || disposed) return;
      const state = session.snapshot();
      if (
        busy ||
        state.pendingPersist ||
        state.persistence === "unsaved" ||
        view.snapshot().dirtyForms.length
      ) {
        event.preventDefault();
        event.returnValue = "";
      }
    });
    window.addEventListener("pagehide", (event) => {
      if (!event.persisted) {
        dispose();
        return;
      }
      if (disposed || !initialized) return;

      view.changedView();
      controls?.noteViewMutation();
      render();
      status.textContent =
        "This page is preserved with its unfinished fields. Pending review and save authority was canceled.";
    });
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted || disposed) return;
      if (!initialized || !session) {
        resumeCheckRequested = true;
        return;
      }

      controls?.noteViewMutation();
      const notice = session.noticeExternalChange(),
        token = view.capture();
      void notice
        .then((state) => {
          if (disposed || !view.isCurrent(token)) return;
          controls?.refresh();
          status.textContent = state.pendingPersist
            ? "The saved copy was rechecked. The exact failed operation is still pending; use Retry. Newer unfinished fields were retained."
            : state.code === "conflict" ||
                state.code === "unavailable" ||
                state.code === "corrupt"
              ? state.message +
                " Unfinished fields were retained. Review recovery before saving."
              : "The actual saved copy was rechecked. Unfinished fields were retained. Submit deliberately to save current unfinished fields, or keep a form backup.";
        })
        .catch((error) => {
          if (!disposed && view.isCurrent(token))
            status.textContent =
              (error instanceof Error
                ? error.message
                : "Saved-copy check was refused.") +
              " Unfinished fields remain here.";
        });
    });
    async function initializeRemainingDepth() {
      try {
        session = await openRemainingRecordSession(key, { view });
        if (resumeCheckRequested) {
          resumeCheckRequested = false;
          await session.noticeExternalChange();
        }
        const initial = session.snapshot();
        sample = initial.hasCurrent ? initial.value : null;
        if (sample) currency.value = sample.currency;
        controls = mountRemainingRecordRecoveryControls({
          host: root!.querySelector<HTMLElement>("#census-recovery")!,
          session,
          view,
          readForms: () => [
            {
              form: "activity",
              editingId: editing?.id ?? null,
              values: rawValues(),
            },
            {
              form: "currency",
              editingId: null,
              values: { currency: currency.value },
            },
          ],
          onStatus(state) {
            if (disposed) return;
            sample = state.hasCurrent ? state.value : null;
            render();
            capabilities();
          },
          onAdopt(state, token) {
            if (disposed || !state.hasCurrent || !view.isCurrent(token)) return;
            sample = state.value;
            reset();
            currency.value = sample.currency;
            view.markClean("activity", token);
            view.markClean("currency", token);
            render();
          },
        });
        root!.querySelector("#census-json")!.addEventListener("click", () => {
          try {
            if (!session || disposed) return;
            const out = session.exportNative();
            download(
              "depth-census.json",
              out.text,
              "application/json;charset=utf-8",
            );
            status.textContent = `Requested the complete admitted sample (${out.persistence}). Unfinished fields have a separate backup.`;
          } catch (error) {
            status.textContent =
              error instanceof Error
                ? error.message
                : "No admitted sample is available.";
          }
        });
        root!.querySelector("#census-csv")!.addEventListener("click", () => {
          if (!sample || !session || disposed) return;
          download(
            "depth-census.csv",
            toCsv(
              sample.rows.map((row) => ({
                activity: safeCsvText(row.activity),
                currency: sample!.currency,
                amount: row.amount,
                depth: row.depth,
                source: safeCsvText(row.source),
                classification: "User hypothesis",
              })),
              [
                "activity",
                "currency",
                "amount",
                "depth",
                "source",
                "classification",
              ],
            ),
            "text/csv;charset=utf-8",
          );
          status.textContent = `Requested all admitted sample rows (${session.snapshot().persistence}). Unfinished fields remain separate.`;
        });
        window.addEventListener("storage", (event) => {
          if (disposed || (event.key !== key && event.key !== null) || !session)
            return;
          controls?.noteViewMutation();
          const notice = session.noticeExternalChange(),
            noticeToken = view.capture();
          void notice
            .then(() => {
              if (!disposed) controls?.refresh();
            })
            .catch((error) => {
              if (!disposed && view.isCurrent(noticeToken))
                status.textContent =
                  error instanceof Error
                    ? error.message
                    : "Saved sample changed; keep unfinished fields.";
            });
        });
        initialized = true;
        render();
        capabilities();
        root!.dataset.rrInitialization = "ready";
        status.textContent =
          initial.message ||
          "Sample editing is ready. Classifications remain hypotheses.";
      } catch (error) {
        dispose();
        root!.dataset.rrInitialization = "failed";
        status.textContent =
          "Local editing could not start. Fields stay disabled. " +
          (error instanceof Error ? error.message : "");
        throw error;
      }
    }
    void initializeRemainingDepth().catch(() => {});
  }
</script>
<style>
  [data-private-form-controls] {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  #depth-census {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1rem;
    margin: 2rem 0;
  }
  label {
    display: grid;
    gap: 0.35rem;
    font: 0.9rem var(--font-sans);
    margin: 0.8rem 0;
  }
  input,
  select,
  textarea {
    max-width: 100%;
    width: 100%;
  }
  .census-controls {
    display: flex;
    gap: 0.7rem;
    align-items: end;
    flex-wrap: wrap;
  }
  .census-controls label {
    flex: 1;
    min-width: min(100%, 150px);
  }
  #depth-census :global(.census-row) {
    border-bottom: 1px solid var(--rule);
    padding: 0.5rem 0;
  }
  #depth-census :global(.census-row p) {
    margin: 0.25rem 0;
    overflow-wrap: anywhere;
  }
  input[type="file"] {
    max-width: 250px;
  }
  table {
    width: 100%;
  }
</style>
