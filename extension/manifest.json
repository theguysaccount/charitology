{
  "manifest_version": 3,
  "name": "Charitology: Before You Give",
  "short_name": "Charitology",
  "version": "0.1.2",
  "description": "The Giver’s Checklist on selected fundraising sites, plus an explicit lookup in public charity registries. No analytics.",
  "homepage_url": "https://charitology.org/tools/browser-extension/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Charitology: before you give",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.gofundme.com/f/*",
        "https://gofundme.com/f/*",
        "https://www.justgiving.com/*",
        "https://www.every.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "before-you-give@charitology.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
