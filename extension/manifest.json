{
  "manifest_version": 3,
  "name": "Charitology: Before You Give",
  "short_name": "Charitology",
  "version": "0.1.0",
  "description": "The Giver’s Checklist on donation pages, plus a one-click lookup in the open charity registries. Collects nothing.",
  "homepage_url": "https://github.com/theguysaccount/charitology/tree/main/extension",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Charitology: before you give",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.gofundme.com/f/*",
        "https://gofundme.com/f/*",
        "https://www.justgiving.com/*",
        "https://www.every.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "before-you-give@charitology.org",
      "strict_min_version": "121.0"
    }
  }
}
